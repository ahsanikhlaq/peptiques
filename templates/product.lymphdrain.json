.png?v=1763652328\" }}\" style=\"\n          width: 60px;\n          height: 60px;\n          object-fit: contain;\n          margin-right: 10px;\n          border-radius: 8px;\n        \" alt=\"Product\">\n        <div>\n          <div style=\"font-weight: 600; font-size: 14px;\">{{ product_name | default: \"LymphDrain™\" }}</div>\n          <div style=\"font-size: 14px; color: {{ price_color | default: \"#387311\" }};\">{{ product_price | default: \"$53,49 (Pre-Cyber Week)\" }} <span style=\"text-decoration: line-through; color: #999;\">{{ product_original_price | default: \"$107,99\" }}</span></div>\n          <div style=\"font-size: 12px; color: #666;\">{{ purchase_text | default: \"📦 Purchased in 2025\" }}</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Review 2 -->\n    <div style=\"\n      display: flex;\n      flex-direction: column;\n      height: 100%;\n      background: {{ review_bg | default: \"#fff\" }};\n      border-radius: {{ review_border_radius | default: \"12px\" }};\n      border: {{ review_border_width | default: \"1px\" }} solid {{ review_border_color | default: \"#eee\" }};\n      box-shadow: {{ review_box_shadow | default: \"none\" }};\n      padding: {{ review_padding | default: \"16px\" }};\n      min-width: {{ review_min_width | default: \"280px\" }};\n      max-width: {{ review_max_width | default: \"320px\" }};\n      flex-shrink: 0;\n    \">\n      <img src=\"{{ review_2_image | default: \"https://cdn.shopify.com/s/files/1/0698/3532/5616/files/Screenshot_2025-12-05_at_21.11.42.png?v=1764965509\" }}\" style=\"\n        width: 100%;\n        border-radius: {{ image_border_radius | default: \"8px\" }};\n      \" alt=\"Review Photo\">\n      <div style=\"margin-top: 12px; color: {{ stars_color | default: \"#ffc157\" }}; font-size: {{ stars_font_size | default: \"14px\" }};\">★★★★★</div>\n      <div style=\"margin-top: 6px; font-size: 13px;\">\n        <span style=\"\n          background: {{ reviewer_badge_bg | default: \"#f1f3f4\" }};\n          padding: 3px 8px;\n          border-radius: 9999px;\n        \">{{ review_2_name | default: \"Maria T. 52\" }} {{ verified_badge | default: \"💎 Verified Buyer\" }}</span>\n      </div>\n      <p style=\"\n        font-size: {{ review_text_font_size | default: \"14px\" }};\n        color: {{ review_text_color | default: \"#333\" }};\n        margin-top: 10px;\n        line-height: 1.5;\n        flex-grow: 1;\n      \">\n        {{ review_2_text | default: \"Honestly better than I expected. I used to do lymphatic massages with a professional that cost me hundreds, but it never fixed the problem from the inside. This formula helped me so much that now I'm fitting into my old dresses, feeling lighter, and actually wanting to go out again for holidays included Christmas. I've already told 3 of my friends to get the 6-month bundle. Thank you!!!\" }}\n      </p>\n      <div style=\"\n        display: flex;\n        align-items: center;\n        background: {{ product_box_bg | default: \"#f8f8f8\" }};\n        padding: 10px;\n        border-radius: 8px;\n        margin-top: 16px;\n      \">\n        <img src=\"{{ product_image | default: \"https://cdn.shopify.com/s/files/1/0698/3532/5616/files/product-bottle_4b8020a5-9f8c-4dbd-9a2e-91d356a01778.png?v=1763652328\" }}\" style=\"\n          width: 60px;\n          height: 60px;\n          object-fit: contain;\n          margin-right: 10px;\n          border-radius: 8px;\n        \" alt=\"Product\">\n        <div>\n          <div style=\"font-weight: 600; font-size: 14px;\">{{ product_name | default: \"LymphDrain™\" }}</div>\n          <div style=\"font-size: 14px; color: {{ price_color | default: \"#387311\" }};\">{{ product_price | default: \"$53,49 (Pre-Cyber Week)\" }} <span style=\"text-decoration: line-through; color: #999;\">{{ product_original_price | default: \"$107,99\" }}</span></div>\n          <div style=\"font-size: 12px; color: #666;\">{{ purchase_text | default: \"📦 Purchased in 2025\" }}</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Review 3 -->\n    <div style=\"\n      display: flex;\n      flex-direction: column;\n      height: 100%;\n      background: {{ review_bg | default: \"#fff\" }};\n      border-radius: {{ review_border_radius | default: \"12px\" }};\n      border: {{ review_border_width | default: \"1px\" }} solid {{ review_border_color | default: \"#eee\" }};\n      box-shadow: {{ review_box_shadow | default: \"none\" }};\n      padding: {{ review_padding | default: \"16px\" }};\n      min-width: {{ review_min_width | default: \"280px\" }};\n      max-width: {{ review_max_width | default: \"320px\" }};\n      flex-shrink: 0;\n    \">\n      <img src=\"{{ review_3_image | default: \"https://cdn.shopify.com/s/files/1/0698/3532/5616/files/Screenshot_2025-12-05_at_19.37.21.png?v=1764959846\" }}\" style=\"\n        width: 100%;\n        border-radius: {{ image_border_radius | default: \"8px\" }};\n      \" alt=\"Review Photo\">\n      <div style=\"margin-top: 12px; color: {{ stars_color | default: \"#ffc157\" }}; font-size: {{ stars_font_size | default: \"14px\" }};\">★★★★★</div>\n      <div style=\"margin-top: 6px; font-size: 13px;\">\n        <span style=\"\n          background: {{ reviewer_badge_bg | default: \"#f1f3f4\" }};\n          padding: 3px 8px;\n          border-radius: 9999px;\n        \">{{ review_3_name | default: \"Emma, 58\" }} {{ verified_badge | default: \"💎 Verified Buyer\" }}</span>\n      </div>\n      <p style=\"\n        font-size: {{ review_text_font_size | default: \"14px\" }};\n        color: {{ review_text_color | default: \"#333\" }};\n        margin-top: 10px;\n        line-height: 1.5;\n        flex-grow: 1;\n      \">\n        {{ review_3_text | default: \"At 58, I'd pretty much accepted that feeling puffy and tired was just 'my life now.' My sister kept pushing me to try this after it worked for her. I didn't expect much honestly. But after about 3 weeks I woke up and my face didn't look swollen for the first time in months. Small thing maybe, but I actually felt like myself again. That's worth everything.\" }}\n      </p>\n      <div style=\"\n        display: flex;\n        align-items: center;\n        background: {{ product_box_bg | default: \"#f8f8f8\" }};\n        padding: 10px;\n        border-radius: 8px;\n        margin-top: 16px;\n      \">\n        <img src=\"{{ product_image | default: \"https://cdn.shopify.com/s/files/1/0698/3532/5616/files/product-bottle_4b8020a5-9f8c-4dbd-9a2e-91d356a01778.png?v=1763652328\" }}\" style=\"\n          width: 60px;\n          height: 60px;\n          object-fit: contain;\n          margin-right: 10px;\n          border-radius: 8px;\n        \" alt=\"Product\">\n        <div>\n          <div style=\"font-weight: 600; font-size: 14px;\">{{ product_name | default: \"LymphDrain™\" }}</div>\n          <div style=\"font-size: 14px; color: {{ price_color | default: \"#387311\" }};\">{{ product_price | default: \"$53,49 (Pre-Cyber Week)\" }} <span style=\"text-decoration: line-through; color: #999;\">{{ product_original_price | default: \"$107,99\" }}</span></div>\n          <div style=\"font-size: 12px; color: #666;\">{{ purchase_text | default: \"📦 Purchased in 2025\" }}</div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <style>\n    div[style*=\"overflow-x: auto\"] {\n      scrollbar-width: none;\n      -ms-overflow-style: none;\n    }\n    div[style*=\"overflow-x: auto\"]::-webkit-scrollbar {\n      display: none;\n    }\n  </style>\n</div>",
        "color_scheme": "background-1",
