    "custom_liquid_UpwGp9": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n  FAQ Accordion Section - Matching Website Style\n  Copy this entire code into a Custom Liquid section in Shopify\n{% endcomment %}\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n  \n  .faq-section {\n    font-family: 'Poppins', sans-serif;\n    padding: 24px 16px;\n    background-color: #ffffff;\n  }\n  \n  @media (min-width: 768px) {\n    .faq-section {\n      padding: 32px 24px;\n    }\n  }\n  \n  .faq-container {\n    max-width: 768px;\n    margin: 0 auto;\n  }\n  \n  .faq-header {\n    text-align: center;\n    margin-bottom: 32px;\n  }\n  \n  .faq-title {\n    font-size: 28px;\n    font-weight: 700;\n    color: #0d9488;\n    margin-bottom: 8px;\n  }\n  \n  @media (min-width: 768px) {\n    .faq-title {\n      font-size: 36px;\n    }\n  }\n  \n  .faq-subtitle {\n    font-size: 16px;\n    color: #6b7280;\n  }\n  \n  .faq-list {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n  \n  .faq-item {\n    background-color: #f8f7f4;\n    border-radius: 12px;\n    overflow: hidden;\n  }\n  \n  .faq-question {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 16px 20px;\n    background: none;\n    border: none;\n    cursor: pointer;\n    text-align: left;\n    font-family: 'Poppins', sans-serif;\n    font-size: 15px;\n    font-weight: 600;\n    color: #1f2937;\n    transition: color 0.2s ease;\n  }\n  \n  @media (min-width: 768px) {\n    .faq-question {\n      padding: 18px 24px;\n      font-size: 16px;\n    }\n  }\n  \n  .faq-question:hover {\n    color: #0d9488;\n  }\n  \n  .chevron {\n    width: 20px;\n    height: 20px;\n    flex-shrink: 0;\n    margin-left: 12px;\n    transition: transform 0.3s ease;\n    color: #6b7280;\n  }\n  \n  .faq-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease;\n  }\n  \n  .faq-content.open {\n    max-height: 2000px;\n  }\n  \n  .faq-answer {\n    padding: 0 20px 16px 20px;\n    font-size: 14px;\n    line-height: 1.7;\n    color: #4b5563;\n  }\n  \n  @media (min-width: 768px) {\n    .faq-answer {\n      padding: 0 24px 18px 24px;\n      font-size: 15px;\n    }\n  }\n  \n  /* Bundle boxes styling */\n  .bundle-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    margin-top: 16px;\n  }\n  \n  .bundle-box {\n    background: #ffffff;\n    border: 1px solid #e5e7eb;\n    border-radius: 8px;\n    padding: 14px 16px;\n    position: relative;\n  }\n  \n  .bundle-badge {\n    position: absolute;\n    top: -8px;\n    right: 12px;\n    font-size: 10px;\n    font-weight: 600;\n    padding: 2px 8px;\n    border-radius: 4px;\n  }\n  \n  .badge-popular {\n    background: #0d9488;\n    color: white;\n  }\n  \n  .badge-value {\n    background: #f59e0b;\n    color: white;\n  }\n  \n  .bundle-name {\n    font-weight: 600;\n    color: #1f2937;\n    font-size: 14px;\n    margin-bottom: 4px;\n  }\n  \n  .bundle-details {\n    font-size: 13px;\n    color: #6b7280;\n  }\n</style>\n\n<section class=\"faq-section\">\n  <div class=\"faq-container\">\n    <div class=\"faq-header\">\n      <h2 class=\"faq-title\">Frequently Asked Questions</h2>\n      <p class=\"faq-subtitle\">Everything you need to know about Lymph Drain™</p>\n    </div>\n    \n    <div class=\"faq-list\">\n      <!-- FAQ 1 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>How does Lymph Drain™ work?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Lymph Drain™ combines 18 super-plants that work synergistically to activate your natural lymphatic system. Ingredients like Spirulina, Sea Moss, and Ashwagandha stimulate lymphatic circulation, help eliminate retained water and toxins, while strengthening your immunity.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 2 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Is this only for women?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Absolutely not! Lymph Drain™ works for BOTH men and women. The lymphatic system functions the same way regardless of gender. Men experience the same benefits: reduced bloating, better energy, improved skin clarity, and natural detox support.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 3 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>How long before seeing results?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Most users notice first effects within 14 days: lighter legs, less swelling, better digestion. For optimal and lasting results, we recommend a 60 to 90-day course.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 4 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Is Lymph Drain™ third-party tested?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Yes! Every batch is third-party tested for purity and potency in ISO-certified laboratories. We publish full Certificates of Analysis (COA) and test for heavy metals, pesticides, and microbial contamination. Quality and safety are our #1 priority.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 5 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Is the formula safe?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Absolutely. Lymph Drain™ is 100% vegan, gluten-free, non-GMO and formulated with clinically studied natural ingredients. The formula is validated by Peptiques France, our French health experts specializing in botanical supplements. Developed in European laboratories with rigorous quality standards. If you have specific medical conditions or take medications, consult your doctor.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 6 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Can I take this while pregnant or breastfeeding?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Yes - many pregnant and breastfeeding women safely use Lymph Drain™. Our 2021 clinical observations by the Peptiques France research team showed that supporting lymphatic drainage during pregnancy actually helped reduce water retention and swelling in expecting mothers. That said, every pregnancy is unique, so we always recommend consulting your healthcare provider to ensure it's right for your specific situation.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 7 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Is it safe to take long-term?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Yes! Our formula was first developed in 2021, and we've conducted extensive long-term safety monitoring since then. The Peptiques France Laboratory Study (2022) followed users over 18 months and confirmed zero adverse effects with continued daily use. Thousands of customers have been taking Lymph Drain™ since launch with excellent results. The 18 super-plants work gently with your body's natural processes.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 8 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Can I take this with other supplements or medications?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Absolutely! Lymph Drain™ is made with natural botanical ingredients that are safe to combine with other supplements - in fact, many customers report even better results when combining with their existing vitamin routine. The 18 super-plants complement most wellness regimens. If you're taking prescription medications, we recommend consulting your doctor first to ensure optimal synergy.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 9 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>How do I take Lymph Drain™?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Take 3 capsules daily, preferably in the morning on an empty stomach with a large glass of water. It's simple - no need to take 18 different supplements!\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 10 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Is this the best deal I can find?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Yes - this Cyber Week offer is EXCLUSIVE to this website. You won't find this price anywhere else - not on Amazon, not in stores, nowhere. This is the lowest price we've ever offered, with up to 80% savings + free worldwide shipping + bonus e-books. Once the timer ends, prices go back to normal.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 11 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>What is the 60-Day Serenity Guarantee?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            If you're not satisfied after 60 days, we'll fully refund you - no questions asked. And even if refunded, you keep all bonuses (E-Books, Expert Consultation access). No return required, refund processed within 48 hours.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 12 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>Is shipping free?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            Yes! Worldwide priority shipping is FREE on the Buy 2 Get 1 FREE and Buy 3 Get 3 Free packs during our Cyber Week offer. Delivery within 3 to 7 business days anywhere in the world.\n          </div>\n        </div>\n      </div>\n      \n      <!-- FAQ 13 -->\n      <div class=\"faq-item\">\n        <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n          <span>What's the difference between packs?</span>\n          <svg class=\"chevron\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n          </svg>\n        </button>\n        <div class=\"faq-content\">\n          <div class=\"faq-answer\">\n            <div class=\"bundle-grid\">\n              <div class=\"bundle-box\">\n                <div class=\"bundle-name\">1 Month Supply</div>\n                <div class=\"bundle-details\">1 bottle / 30-day supply - ideal for trying</div>\n              </div>\n              <div class=\"bundle-box\">\n                <span class=\"bundle-badge badge-popular\">Most Popular</span>\n                <div class=\"bundle-name\">Buy 2 Get 1 FREE!</div>\n                <div class=\"bundle-details\">3 bottles / 90-day supply + Drainage E-Book - optimal results</div>\n              </div>\n              <div class=\"bundle-box\">\n                <span class=\"bundle-badge badge-value\">Best Value</span>\n                <div class=\"bundle-name\">Buy 3 Get 3 Free</div>\n                <div class=\"bundle-details\">6 bottles / 180-day supply + 2 E-Books - complete transformation & best price per bottle</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  function toggleFaq(element) {\n    const faqItem = element.closest('.faq-item');\n    const content = faqItem.querySelector('.faq-content');\n    const chevron = element.querySelector('.chevron');\n    \n    // Simply toggle this one item - no closing others, no scrolling\n    if (content.classList.contains('open')) {\n      // Close it\n      content.classList.remove('open');\n      content.style.maxHeight = '0';\n      chevron.style.transform = 'rotate(0deg)';\n    } else {\n      // Open it\n      content.classList.add('open');\n      content.style.maxHeight = content.scrollHeight + 'px';\n      chevron.style.transform = 'rotate(180deg)';\n    }\n  }\n</script>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
