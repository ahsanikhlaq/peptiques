n    font-size: 18px;\n    color: #6b7280;\n    max-width: 600px;\n    margin: 0 auto;\n    line-height: 1.6;\n  }\n  \n  /* Benefits Grid */\n  .benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n  \n  @media (min-width: 768px) {\n    .benefits-grid {\n      grid-template-columns: repeat(3, 1fr);\n    }\n  }\n  \n  .benefit-item {\n    text-align: center;\n  }\n  \n  .benefit-icon {\n    font-size: 40px;\n    margin-bottom: 12px;\n  }\n  \n  .benefit-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin-bottom: 4px;\n  }\n  \n  .benefit-desc {\n    font-size: 14px;\n    color: #6b7280;\n  }\n</style>\n\n<section class=\"problem-solution-section\">\n  <div class=\"problem-solution-container\">\n    \n    <!-- THE PROBLEM -->\n    <div class=\"problem-block\">\n      <span class=\"problem-badge\">❌ THE IGNORED PROBLEM</span>\n      <h2 class=\"problem-title\">Your lymphatic system is slowed down</h2>\n      <p class=\"problem-description\">\n        When it gets blocked, your body retains water, toxins, swelling. \n        No cream or massage can correct this from the outside.\n      </p>\n    </div>\n    \n    <!-- THE SOLUTION -->\n    <div class=\"solution-block\">\n      <div class=\"solution-header\">\n        <span class=\"solution-badge\">✅ THE SOLUTION</span>\n        <h3 class=\"solution-title\">Lymph Drain™ reactivates your lymphatic circulation</h3>\n        <p class=\"solution-description\">\n          18 synergistic super-plants to fluidify, deflate, detoxify and boost your vitality.\n        </p>\n      </div>\n      \n      <!-- Benefits Grid -->\n      <div class=\"benefits-grid\">\n        <div class=\"benefit-item\">\n          <div class=\"benefit-icon\">💧</div>\n          <h4 class=\"benefit-title\">Reduces water retention</h4>\n          <p class=\"benefit-desc\">Lighter legs</p>\n        </div>\n        \n        <div class=\"benefit-item\">\n          <div class=\"benefit-i