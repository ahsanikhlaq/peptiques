6px;\n    margin: 16px 0;\n  }\n  \n  .trust-intro-box p {\n    color: #166534;\n  }\n  \n  /* NEW: Catch box */\n  .catch-box {\n    background: #fefce8;\n    border: 2px dashed #ca8a04;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  /* NEW: Ask box */\n  .ask-box {\n    background: #fffbeb;\n    border: 1px solid #f59e0b;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  /* NEW: Shipping protection box */\n  .shipping-protection-box {\n    background: #eff6ff;\n    border: 2px solid #3b82f6;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .shipping-protection-box h4 {\n    color: #1e40af;\n  }\n  \n  .shipping-protection-box ul {\n    color: #1e3a8a;\n  }\n  \n  /* NEW: Shipping tip */\n  .shipping-tip {\n    background: #f5f5f5;\n    border-radius: 6px;\n    padding: 12px;\n    margin-top: 16px;\n    font-size: 13px;\n    color: #6b7280;\n  }\n</style>\n\n<div class=\"product-accordion-container\">\n  <!-- Section 1: Description -->\n  <div class=\"accordion-item\" data-accordion=\"description\">\n    <button class=\"accordion-header\">\n      <span>🌿 Description & Why This Has Changed Lives</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <p>\n        <strong>Lymph Drain™</strong> isn't just a supplement. \n        It's a <span class=\"text-primary\" style=\"font-weight: 600;\">scientific all-in-one formula</span> that combines \n        <strong>18 medicinal plants</strong> in a single daily capsule.\n      </p>\n      \n      <div class=\"why-box\">\n        <h4>🔬 WHY It Works:</h4>\n        <p style=\"margin-bottom: 8px;\">\n          Your lymphatic system slows down with age, stress and environmental toxins. \n          Result? Water retention, swelling, chronic fatigue, and weakened immune defenses.\n        </p>\n        <p style=\"font-weight: 700; color: #0d9488; margin-bottom: 0;\">\n          Lymph Drain™ naturally reactivates this system with 18 synergistic super-plants.\n        </p>\n      </div>\n\n      <h4 style=\"font-size: 16px;\">✨ The Power of 18 Plants:</h4>\n      \n      <div class=\"plants-section\">\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🌿 Spirulina & Sea Moss:</span> Mineral-rich superfoods that support lymphatic circulation and natural water balance.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🌿 Ashwagandha:</span> Powerful adaptogen that reduces stress (main cause of water retention) and strengthens immunity.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🌿 Chlorella & Burdock Root:</span> Deep detoxification and promote natural drainage of accumulated toxins.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🌿 Elderberry & Black Seed Oil:</span> Strengthen the immune system to protect your body from external aggressions.\n        </p>\n\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🌿 Turmeric & Black Pepper:</span> Natural anti-inflammatories that improve nutrient absorption and reduce swelling.\n        </p>\n\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🌿 + 10 other synergistic plants</span> (Moringa, Beet, Camu Camu, Amla...) that work together for optimal results.\n        </p>\n      </div>\n\n      <div class=\"green-box\">\n        <h4>✅ 100% Natural & No Compromise:</h4>\n        <ul>\n          <li>✓ <strong>Non-GMO</strong> - No genetically modified ingredients</li>\n          <li>✓ <strong>Gluten-Free</strong> - Suitable for intolerances</li>\n          <li>✓ <strong>Lactose-Free</strong> - 100% plant-based</li>\n          <li>✓ <strong>No Additives</strong> - No colorants, preservatives or chemicals</li>\n          <li>✓ <strong>Vegan & Cruelty-Free</strong> - Animal-friendly</li>\n        </ul>\n      </div>\n\n      <h4 style=\"font-size: 16px;\">🎯 What You'll REALLY Feel:</h4>\n      \n      <div class=\"timeline-section\">\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">✓ Week 1-2:</span> Feeling of lightness, less bloating, renewed energy.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">✓ Week 3-4:</span> Visible reduction in swelling, better sleep, improved digestion.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">✓ Week 5-8+:</span> Complete transformation - more toned body, radiant skin, vitality regained.\n        </p>\n      </div>\n\n      <div class=\"tip-box\">\n        <p style=\"margin-bottom: 0;\">\n          <span class=\"text-primary\" style=\"font-weight: 700;\">💡 Why 18 plants in one?</span> \n          Taking 18 separate supplements would cost over €400/month. Lymph Drain™ offers you this powerful synergy \n          for less than €1/day, with optimal bioavailability thanks to black pepper extract.\n        </p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 2: Know Exactly What's Inside -->\n  <div class=\"accordion-item\" data-accordion=\"ingredients\">\n    <button class=\"accordion-header\">\n      <span>🔬 Know Exactly What's Inside</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <p style=\"font-weight: 600; margin-bottom: 16px;\">\n        Discover exactly what each ingredient brings to your health:\n      </p>\n      \n      <div class=\"ingredient-item\">\n        <strong>Spirulina</strong> – Rich in phytonutrients that support vitality and immune balance\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Sea Moss</strong> – Mineral-rich algae promoting circulation and lymphatic flow\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Elderberry</strong> – Traditional berry extract supporting immunity for seasonal wellness\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Ashwagandha</strong> – Adaptogen that supports stress response and immune strength\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Chlorella</strong> – Green algae that supports cellular health and detoxification pathways\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Burdock Root</strong> – Traditional plant supporting healthy lymphatic circulation\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Black Seed Oil</strong> – Plant oil known to support immunity and respiratory health\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Bladderwrack</strong> – Sea plant supporting water balance and overall wellbeing\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Organic Amla Fruit</strong> – Antioxidant-rich fruit supporting immunity and vitality\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Beet Root</strong> – Supports healthy circulation and nutrient delivery\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Camu Camu</strong> – Powerful natural source of vitamin C for immune health\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Moringa Leaf</strong> – Nutrient-dense plant supporting energy and metabolic balance\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Turmeric Root</strong> – Powerful plant supporting balanced inflammatory response\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Spinach Leaf</strong> – Green superfood providing natural micronutrients\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Mulberry Leaf</strong> – Traditional wellness plant supporting metabolic balance\n      </div>\n      <div class=\"ingredient-item\">\n        <strong>Black Pepper Extract</strong> – Enhances nutrient absorption and bioavailability\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 3: How to Use -->\n  <div class=\"accordion-item\" data-accordion=\"how-to-use\">\n    <button class=\"accordion-header\">\n      <span>💊 How to Use</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <h4>🌿 Daily Routine (Recommended)</h4>\n      <p>\n        For consistent support of lymphatic flow and immune balance, we recommend splitting your daily dose:\n      </p>\n      <ul>\n        <li>\n          <strong>Morning:</strong> Take 2 capsules of Lymph Drain with water, preferably at breakfast. \n          This activates the plants (Spirulina, Ashwagandha) to support daily vitality and immune function.\n        </li>\n        <li>\n          <strong>Afternoon/Evening:</strong> Take the remaining capsule with water, preferably with a meal. \n          This helps maintain circulation and fluid movement as part of your body's natural cleansing cycle.\n        </li>\n      </ul>\n      <p style=\"font-weight: 600;\">Total Dosage: 3 capsules per day</p>\n\n      <h4>⚡ Pro Tips for Maximum Results</h4>\n      <ul>\n        <li>\n          <strong>Weeks 1-2:</strong> Establish your routine. Powerful ingredients (Elderberry, Black Seed Oil) \n          begin to fortify your immune system and support lymphatic pathways.\n        </li>\n        <li>\n          <strong>Week 3+:</strong> Maintain consistency. You should start feeling the cumulative benefits: \n          improved vitality, better water balance, strengthened immune defenses.\n        </li>\n        <li>\n          <strong>Stay Hydrated:</strong> Crucial for lymphatic support! Adequate water intake helps the body \n          process and drain fluids efficiently.\n        </li>\n        <li>\n          <strong>Combine with Movement:</strong> Walking, light massage or stretching naturally encourages \n          lymphatic movement. This will boost the detoxification benefits.\n        </li>\n      </ul>\n\n      <h4>🔍 What to Expect</h4>\n      <ul>\n        <li><strong>Days 1–7:</strong> Initial feeling of vitality and energy thanks to Spirulina and Chlorella.</li>\n        <li><strong>Weeks 2–4:</strong> Improved water balance and general feeling of lightness.</li>\n        <li><strong>Weeks 4–8+:</strong> Lasting wellness improvement, strengthened immune resilience, better body comfort.</li>\n      </ul>\n\n      <h4>🧊 Storage</h4>\n      <p style=\"margin-bottom: 0;\">\n        Store the bottle in a cool, dry place, away from direct sunlight and heat. \n        Keep the bottle tightly closed to preserve the freshness and potency of plant-based ingredients.\n      </p>\n    </div>\n  </div>\n\n  <!-- Section 4: Guarantee -->\n  <div class=\"accordion-item\" data-accordion=\"guarantee\">\n    <button class=\"accordion-header\">\n      <span>⭐ Our 60-Day Serenity Guarantee</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <div class=\"green-box\">\n        <p style=\"font-weight: 700; color: #166534; margin-bottom: 12px;\">\n          If you don't see ANY improvement… full refund.\n        </p>\n        \n        <p style=\"font-weight: 700; color: #15803d;\">\n          🎁 + 3 FREE BONUSES (even if refunded):\n        </p>\n        <ul>\n          <li>\n            ✅ <strong>180-day access to Lymphatic Drainage & Anti-Aging Program</strong>\n            <br />\n            <span class=\"bonus-text\">(value €2800)</span>\n          </li>\n          <li>\n            ✅ <strong>Personalized consultation with one of our experts (45 min)</strong>\n            <br />\n            <span class=\"bonus-text\">(value €170)</span>\n          </li>\n          <li>\n            ✅ <strong>€80 Peptiques® gift voucher</strong>\n          </li>\n        </ul>\n\n        <div class=\"green-inner-box\">\n          <p>⚠️ No return required</p>\n          <p>⚠️ No photo proof needed</p>\n          <p style=\"margin-bottom: 0;\">⚠️ Refund within 48h</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 5: Shipping & Returns - UPDATED COPYWRITING -->\n  <div class=\"accordion-item\" data-accordion=\"shipping\">\n    <button class=\"accordion-header\">\n      <span>🚚 Shipping & Returns</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      \n      <!-- RETURN POLICY SECTION -->\n      <h4>🔄 Return Policy</h4>\n      \n      <div class=\"trust-intro-box\">\n        <p style=\"font-weight: 700; font-size: 16px; color: #166534; margin-bottom: 8px;\">\n          Here's the truth: We trust you.\n        </p>\n        <p style=\"color: #166534; margin-bottom: 0;\">\n          With our <strong>60-Day Serenity Guarantee</strong>, you don't even need to return the product. \n          No shipping it back. No photos. No hoops to jump through.\n        </p>\n      </div>\n      \n      <div class=\"catch-box\">\n        <p style=\"font-weight: 700; color: #92400e; margin-bottom: 8px;\">\n          \"But what's the catch?\"\n        </p>\n        <p style=\"color: #78350f; margin-bottom: 0;\">\n          <strong>There isn't one.</strong>\n        </p>\n      </div>\n      \n      <p>\n        We're this confident because we've seen what happens when people actually commit to the formula. \n        Over <strong>34,801+ customers</strong> later, we know this works. But we also know that \n        <strong>YOU</strong> need to experience it yourself to believe it.\n      </p>\n      \n      <div class=\"ask-box\">\n        <p style=\"font-weight: 700; color: #92400e; margin-bottom: 12px;\">\n          📋 All we ask is simple:\n        </p>\n        <ul style=\"color: #78350f; margin-bottom: 0;\">\n          <li>✓ Give it an honest try (at least 30 days of consistent use)</li>\n          <li>✓ Pay attention to how you feel — the lightness, the energy, the changes</li>\n          <li>✓ If you genuinely don't see improvements, just be honest with us</li>\n        </ul>\n      </div>\n      \n      <p>\n        That's it. <strong>One email</strong> to our support team, and you'll have your \n        <strong>refund within 48 hours at contact@peptiques.com</strong>.\n      </p>\n      \n      <p style=\"font-style: italic; color: #6b7280;\">\n        We'd rather lose money on a refund than have you keep a product that didn't work for you. \n        That's not how we build trust.\n      </p>\n      \n      <!-- SHIPPING SECTION -->\n      <h4 style=\"margin-top: 24px;\">📦 Shipping</h4>\n      <ul>\n        <li>✓ <strong>FREE Worldwide Shipping</strong> on all bundles</li>\n        <li>✓ <strong>Fast delivery:</strong> 3-7 business days</li>\n        <li>✓ Ships from <strong>European, American & Australian</strong> warehouses\n          <br /><span style=\"font-size: 12px; color: #6b7280;\">(We ship from the warehouse closest to you for faster delivery)</span>\n        </li>\n        <li>✓ Real-time order tracking included</li>\n        <li>✓ Discreet & secure packaging — no product names visible</li>\n      </ul>\n      \n      <!-- SHIPPING PROTECTION SECTION -->\n      <div class=\"shipping-protection-box\">\n        <h4>🛡️ Shipping Protection</h4>\n        <p style=\"color: #1e40af; margin-bottom: 12px;\">\n          Our <strong>\"Buy 2 Get 1 FREE\"</strong> and <strong>\"Buy 3 Get 3 FREE\"</strong> bundles include \n          <strong>FREE Shipping Protection:</strong>\n        </p>\n        <ul>\n          <li>✓ Lost package? <strong>We reship at no cost</strong></li>\n          <li>✓ Damaged during transit? <strong>Full replacement guaranteed</strong></li>\n          <li>✓ No questions asked, no extra fees</li>\n        </ul>\n      </div>\n      \n      <div class=\"shipping-tip\">\n        💡 <strong>Single bottle orders</strong> ship with standard protection. \n        Upgrade to a bundle for complete peace of mind!\n      </div>\n\n      <div class=\"bottom-banner\">\n        <p>🔒 100% Risk-Free | ✈️ Free Shipping on Bundles | 🛡️ Protected Delivery</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function() {\n  function initAccordion() {\n    var container = document.querySelector('.product-accordion-container');\n    if (!container) {\n      setTimeout(initAccordion, 100);\n      return;\n    }\n    \n    var items = container.querySelectorAll('.accordion-item');\n    \n    items.forEach(function(item) {\n      var header = item.querySelector('.accordion-header');\n      \n      header.addEventListener('click', function(e) {\n        e.preventDefault();\n        e.stopPropagation();\n        \n        // Simply toggle this item - no closing others, no scrolling\n        item.classList.toggle('active');\n      });\n    });\n  }\n  \n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initAccordion);\n  } else {\n    initAccordion();\n  }\n})();\n</script>"
