          "settings": {
            "custom_liquid": "<!-- Payment Methods Grid -->\n<div class=\"payment-methods-container\">\n  <div class=\"payment-methods-grid\">\n    <!-- Visa -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/visa.svg\" alt=\"Visa\" class=\"payment-icon\">\n    <!-- Mastercard -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/master.svg\" alt=\"Mastercard\" class=\"payment-icon\">\n    <!-- American Express -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/american_express.svg\" alt=\"American Express\" class=\"payment-icon\">\n    <!-- Discover -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/discover.svg\" alt=\"Discover\" class=\"payment-icon\">\n    <!-- JCB -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/jcb.svg\" alt=\"JCB\" class=\"payment-icon\">\n    <!-- Diners Club -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/diners_club.svg\" alt=\"Diners Club\" class=\"payment-icon\">\n    <!-- Maestro -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/maestro.svg\" alt=\"Maestro\" class=\"payment-icon\">\n    <!-- UnionPay -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/unionpay.svg\" alt=\"UnionPay\" class=\"payment-icon\">\n    <!-- Stripe -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/stripe.svg\" alt=\"Stripe\" class=\"payment-icon\">\n    <!-- Apple Pay -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/apple_pay.svg\" alt=\"Apple Pay\" class=\"payment-icon\">\n    <!-- Google Pay -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/google_pay.svg\" alt=\"Google Pay\" class=\"payment-icon\">\n    <!-- Bancontact -->\n    <img src=\"https://raw.githubusercontent.com/activemerchant/payment_icons/refs/heads/master/app/assets/images/payment_icons/bancontact.svg\" alt=\"Bancontact\" class=\"payment-icon\">\n  </div>\n</div>\n\n<style>\n  .payment-methods-container {\n    width: 100%;\n    padding: 12px;\n  }\n  \n  .payment-methods-grid {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    align-items: center;\n    gap: 6px;\n  }\n  \n  .payment-icon {\n    height: 28px;\n    width: auto;\n    object-fit: contain;\n  }\n  \n  /* Mobile responsive */\n  @media (max-width: 768px) {\n    .payment-icon {\n      height: 20px;\n    }\n    \n    .payment-methods-grid {\n      gap: 4px;\n    }\n  }\n</style>"
