        "custom_liquid": "<style>\n  .ancient-wisdom-section {\n    position: relative;\n    padding: 80px 20px;\n    overflow: hidden;\n    /* EXPLICIT BACKGROUND COLOR + GRADIENT */\n    background-color: #78350f;\n    background: linear-gradient(to bottom, #78350f, #7c2d12, #451a03);\n  }\n  \n  /* Texture overlay */\n  .ancient-wisdom-texture {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse at 30% 20%, rgba(251, 191, 36, 0.08) 0%, transparent 50%),\n                radial-gradient(ellipse at 70% 80%, rgba(245, 158, 11, 0.06) 0%, transparent 50%);\n    z-index: 0;\n    pointer-events: none;\n  }\n  \n  /* Blur container - LOWEST z-index, stays behind everything */\n  .ancient-wisdom-blur-container {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    z-index: 0;\n    pointer-events: none;\n  }\n  \n  .ancient-wisdom-blur-1 {\n    position: absolute;\n    width: 400px;\n    height: 400px;\n    top: 10%;\n    left: -100px;\n    background: rgba(251, 191, 36, 0.15);\n    border-radius: 50%;\n    filter: blur(80px);\n  }\n  \n  .ancient-wisdom-blur-2 {\n    position: absolute;\n    width: 350px;\n    height: 350px;\n    bottom: 10%;\n    right: -80px;\n    background: rgba(245, 158, 11, 0.12);\n    border-radius: 50%;\n    filter: blur(70px);\n  }\n  \n  /* ALL CONTENT - z-index: 1 so it's above blurs but NOT above header/stickers */\n  .ancient-wisdom-content {\n    position: relative;\n    z-index: 1;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n  \n  .ancient-wisdom-badge {\n    display: inline-block;\n    background: rgba(254, 243, 199, 0.15);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid rgba(251, 191, 36, 0.3);\n    border-radius: 9999px;\n    padding: 12px 28px;\n    font-size: 14px;\n    font-weight: 700;\n    color: #fcd34d;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    margin-bottom: 24px;\n  }\n  \n  .ancient-wisdom-title {\n    font-size: 42px;\n    font-weight: 800;\n    color: #fef3c7;\n    margin-bottom: 16px;\n    line-height: 1.1;\n  }\n  \n  .ancient-wisdom-subtitle {\n    font-size: 20px;\n    color: #fde68a;\n    opacity: 0.9;\n    margin-bottom: 48px;\n    max-width: 700px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n  \n  .ancient-wisdom-image-container {\n    margin-bottom: 56px;\n    border-radius: 24px;\n    overflow: hidden;\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);\n    border: 1px solid rgba(251, 191, 36, 0.2);\n  }\n  \n  .ancient-wisdom-image {\n    width: 100%;\n    height: auto;\n    max-height: 500px;\n    object-fit: cover;\n    display: block;\n  }\n  \n  .ancient-wisdom-image-caption {\n    background: rgba(120, 53, 15, 0.8);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    padding: 16px 24px;\n    text-align: center;\n    color: #fde68a;\n    font-style: italic;\n    font-size: 15px;\n  }\n  \n  .ancient-stories-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 28px;\n    margin-bottom: 56px;\n  }\n  \n  @media (max-width: 768px) {\n    .ancient-stories-grid {\n      grid-template-columns: 1fr;\n    }\n    .ancient-wisdom-title {\n      font-size: 32px;\n    }\n    .ancient-wisdom-subtitle {\n      font-size: 18px;\n    }\n  }\n  \n  .ancient-story-card {\n    position: relative;\n    background: rgba(254, 243, 199, 0.1);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid rgba(251, 191, 36, 0.2);\n    border-radius: 20px;\n    padding: 32px 24px;\n    text-align: center;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n  \n  .ancient-story-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);\n  }\n  \n  .ancient-story-emoji {\n    font-size: 56px;\n    margin-bottom: 20px;\n    display: block;\n  }\n  \n  .ancient-story-title {\n    font-size: 22px;\n    font-weight: 700;\n    color: #fcd34d;\n    margin-bottom: 14px;\n  }\n  \n  .ancient-story-text {\n    font-size: 15px;\n    color: #fef3c7;\n    opacity: 0.9;\n    line-height: 1.7;\n  }\n  \n  .ancient-quote-block {\n    background: rgba(254, 243, 199, 0.08);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border-left: 4px solid #f59e0b;\n    border-radius: 0 16px 16px 0;\n    padding: 36px 40px;\n    margin-bottom: 56px;\n    max-width: 900px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n  \n  .ancient-quote-emoji {\n    font-size: 48px;\n    margin-bottom: 16px;\n    display: block;\n  }\n  \n  .ancient-quote-text {\n    font-size: 22px;\n    font-style: italic;\n    color: #fef3c7;\n    margin-bottom: 16px;\n    line-height: 1.6;\n  }\n  \n  .ancient-quote-source {\n    font-size: 15px;\n    color: #fcd34d;\n    font-weight: 600;\n  }\n  \n  .ancient-timeline {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 16px;\n    margin-bottom: 56px;\n    flex-wrap: wrap;\n  }\n  \n  @media (max-width: 768px) {\n    .ancient-timeline {\n      flex-direction: column;\n      align-items: center;\n    }\n  }\n  \n  .ancient-timeline-item {\n    text-align: center;\n    flex: 1;\n    min-width: 140px;\n  }\n  \n  .ancient-timeline-dot {\n    width: 16px;\n    height: 16px;\n    background: #f59e0b;\n    border-radius: 50%;\n    margin: 0 auto 12px;\n    box-shadow: 0 0 20px rgba(245, 158, 11, 0.6);\n  }\n  \n  .ancient-timeline-year {\n    font-size: 18px;\n    font-weight: 700;\n    color: #fcd34d;\n    margin-bottom: 6px;\n  }\n  \n  .ancient-timeline-text {\n    font-size: 14px;\n    color: #fef3c7;\n    opacity: 0.85;\n  }\n  \n  .ancient-closing-box {\n    background: rgba(254, 243, 199, 0.1);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid rgba(251, 191, 36, 0.25);\n    border-radius: 20px;\n    padding: 36px 32px;\n    max-width: 800px;\n    margin: 0 auto;\n  }\n  \n  .ancient-closing-text {\n    font-size: 20px;\n    color: #fef3c7;\n    line-height: 1.7;\n    font-style: italic;\n  }\n</style>\n\n<section class=\"ancient-wisdom-section\">\n  <!-- Background texture -->\n  <div class=\"ancient-wisdom-texture\"></div>\n  \n  <!-- Decorative blurs - z-index: 0, stays BEHIND content -->\n  <div class=\"ancient-wisdom-blur-container\">\n    <div class=\"ancient-wisdom-blur-1\"></div>\n    <div class=\"ancient-wisdom-blur-2\"></div>\n  </div>\n  \n  <!-- Content - z-index: 1, above blurs but below header/stickers -->\n  <div class=\"ancient-wisdom-content\" style=\"text-align: center;\">\n    \n    <!-- Badge -->\n    <span class=\"ancient-wisdom-badge\">🕉️ 5,000 YEARS OF SACRED WISDOM</span>\n    \n    <!-- Title -->\n    <h2 class=\"ancient-wisdom-title\">\"The King of Medicines\"</h2>\n    <p class=\"ancient-wisdom-subtitle\">\n      Why Buddhist monks, Ayurvedic healers, and spiritual seekers have treasured this single fruit for over 5,000 years\n    </p>\n    \n    <!-- Image -->\n    <div class=\"ancient-wisdom-image-container\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/0698/3532/5616/files/36f6f3b8-2064-4d87-93c8-1b04c6b06b60.jpg?v=1765237753\" \n        alt=\"Ancient monks in meditation\"\n        class=\"ancient-wisdom-image\"\n        loading=\"lazy\"\n      >\n      <div class=\"ancient-wisdom-image-caption\">\n        Tibetan monks have used Haritaki for centuries to deepen meditation and enhance spiritual clarity\n      </div>\n    </div>\n    \n    <!-- Ancient Stories Grid -->\n    <div class=\"ancient-stories-grid\">\n      <div class=\"ancient-story-card\">\n        <span class=\"ancient-story-emoji\">🧘</span>\n        <h3 class=\"ancient-story-title\">The Monks' Secret</h3>\n        <p class=\"ancient-story-text\">\n          For centuries, Tibetan and Indian monks have used Haritaki before meditation. They believed it cleared the mind, sharpened intuition, and connected them to higher consciousness. It was their daily ritual for spiritual awakening.\n        </p>\n      </div>\n      \n      <div class=\"ancient-story-card\">\n        <span class=\"ancient-story-emoji\">👁️</span>\n        <h3 class=\"ancient-story-title\">The Third Eye Awakening</h3>\n        <p class=\"ancient-story-text\">\n          In Ayurvedic tradition, Haritaki is called \"Abhaya\" — meaning fearless. Ancient texts claim it decalcifies and activates the pineal gland (third eye), enhancing intuition, dreams, and inner vision.\n        </p>\n      </div>\n      \n      <div class=\"ancient-story-card\">\n        <span class=\"ancient-story-emoji\">🪷</span>\n        <h3 class=\"ancient-story-title\">The Medicine Buddha's Fruit</h3>\n        <p class=\"ancient-story-text\">\n          In Buddhist iconography, the Medicine Buddha is always depicted holding a Haritaki fruit in his hand. It represents the most sacred healing medicine in all of Buddhist tradition — the ultimate gift of wellness.\n        </p>\n      </div>\n    </div>\n    \n    <!-- Quote Block -->\n    <div class=\"ancient-quote-block\">\n      <span class=\"ancient-quote-emoji\">📜</span>\n      <p class=\"ancient-quote-text\">\n        \"Haritaki is like a mother who cares for her children. It removes all diseases, sharpens the intellect, and bestows liberation of the soul.\"\n      </p>\n      <span class=\"ancient-quote-source\">— Charaka Samhita, Ancient Ayurvedic Text (2,000+ years old)</span>\n    </div>\n    \n    <!-- Timeline -->\n    <div class=\"ancient-timeline\">\n      <div class=\"ancient-timeline-item\">\n        <div class=\"ancient-timeline-dot\"></div>\n        <div class=\"ancient-timeline-year\">3000 BCE</div>\n        <div class=\"ancient-timeline-text\">First recorded in Indian Vedic texts</div>\n      </div>\n      <div class=\"ancient-timeline-item\">\n        <div class=\"ancient-timeline-dot\"></div>\n        <div class=\"ancient-timeline-year\">500 BCE</div>\n        <div class=\"ancient-timeline-text\">Adopted by Buddhist monks</div>\n      </div>\n      <div class=\"ancient-timeline-item\">\n        <div class=\"ancient-timeline-dot\"></div>\n        <div class=\"ancient-timeline-year\">800 CE</div>\n        <div class=\"ancient-timeline-text\">Spread via Silk Road to Tibet & China</div>\n      </div>\n      <div class=\"ancient-timeline-item\">\n        <div class=\"ancient-timeline-dot\"></div>\n        <div class=\"ancient-timeline-year\">Today</div>\n        <div class=\"ancient-timeline-text\">Validated by modern neuroscience</div>\n      </div>\n    </div>\n    \n    <!-- Closing -->\n    <div class=\"ancient-closing-box\">\n      <p class=\"ancient-closing-text\">\n        For 5,000 years, seekers of truth have trusted this single fruit to unlock their highest potential. \n        Monks, healers, and spiritual masters have passed down this wisdom through generations. \n        <strong style=\"color: #fcd34d;\">Now, it's your turn.</strong>\n      </p>\n    </div>\n    \n  </div>\n</section>",
