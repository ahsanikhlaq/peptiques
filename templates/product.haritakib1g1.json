        "custom_liquid_rykdaC": {
          "type": "custom-liquid",
          "name": "Custom Liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  Selling Fast Badge with Live Viewer Counter\n  Range: 353-530 viewers\n  Fast first 2 changes, then 4 seconds for continuous updates\n{% endcomment %}\n\n<style>\n  .selling-fast-container {\n    display: flex;\n    justify-content: center;\n    padding: 0;\n    margin: 0;\n  }\n  \n  .selling-fast-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background-color: #f0f9f4;\n    color: #004232;\n    padding: 4px 16px;\n    border-radius: 9999px;\n    font-size: 14px;\n    font-weight: 500;\n  }\n  \n  .pulse-dot {\n    position: relative;\n    width: 8px;\n    height: 8px;\n  }\n  \n  .pulse-dot-inner {\n    position: absolute;\n    width: 8px;\n    height: 8px;\n    background-color: #0a5c43;\n    border-radius: 50%;\n  }\n  \n  .pulse-dot-ping {\n    position: absolute;\n    width: 8px;\n    height: 8px;\n    background-color: #0a5c43;\n    border-radius: 50%;\n    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;\n    opacity: 0.75;\n  }\n  \n  @keyframes ping {\n    75%, 100% {\n      transform: scale(2);\n      opacity: 0;\n    }\n  }\n  \n  .viewer-count {\n    font-weight: 600;\n  }\n  \n  @media (max-width: 640px) {\n    .selling-fast-container {\n      padding: 0;\n    }\n    .selling-fast-badge {\n      padding: 3px 12px;\n      font-size: 12px;\n      gap: 6px;\n    }\n  }\n</style>\n\n<div class=\"selling-fast-container\">\n  <div class=\"selling-fast-badge\">\n    <div class=\"pulse-dot\">\n      <span class=\"pulse-dot-ping\"></span>\n      <span class=\"pulse-dot-inner\"></span>\n    </div>\n    <span>Final Units!</span>\n    <span class=\"viewer-count\" id=\"viewer-count\">353</span>\n    <span>viewing</span>\n  </div>\n</div>\n\n<script>\n  (function() {\n    var viewerCount = 353;\n    var countElement = document.getElementById('viewer-count');\n    var changeIndex = 0;\n    \n    // Initial sequence - first 2 are fast\n    var initialSequence = [\n      { count: 368, delay: 2000 },   // Fast - 2 seconds\n      { count: 389, delay: 1500 },   // Fast - 1.5 seconds\n      { count: 412, delay: 4000 },   // Normal - 4 seconds\n      { count: 438, delay: 4000 },   // Normal - 4 seconds\n      { count: 461, delay: 4000 },   // Normal - 4 seconds\n      { count: 483, delay: 4000 }    // Normal - 4 seconds\n    ];\n    \n    function runInitialSequence() {\n      if (changeIndex < initialSequence.length) {\n        setTimeout(function() {\n          viewerCount = initialSequence[changeIndex].count;\n          countElement.textContent = viewerCount;\n          changeIndex++;\n          runInitialSequence();\n        }, initialSequence[changeIndex].delay);\n      } else {\n        // Start continuous variation after initial sequence - every 4 seconds\n        setInterval(function() {\n          var random = Math.random();\n          var change;\n          \n          if (random < 0.55) {\n            // 55% chance to increase\n            change = Math.floor(Math.random() * 8) + 1;\n            viewerCount = Math.min(viewerCount + change, 530);\n          } else if (random < 0.85) {\n            // 30% chance to decrease\n            change = Math.floor(Math.random() * 8) + 1;\n            viewerCount = Math.max(viewerCount - change, 380);\n          }\n          // 15% chance to stay the same\n          \n          countElement.textContent = viewerCount;\n        }, 4000);\n      }\n    }\n    \n    runInitialSequence();\n  })();\n</script>"
          },
