    "custom_liquid_t4qirV": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  .bali-retreat-section {\n    position: relative;\n    overflow: hidden;\n    /* EXPLICIT BACKGROUND COLOR + GRADIENT - matches Ancient Wisdom */\n    background-color: #78350f;\n    background: linear-gradient(to bottom right, #78350f, #7c2d12, #451a03);\n    padding: 48px 16px;\n  }\n  \n  @media (min-width: 768px) {\n    .bali-retreat-section {\n      padding: 64px 24px;\n    }\n  }\n  \n  /* Decorative shapes - Z-INDEX 0 to stay BEHIND everything */\n  .bali-decoration-container {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    pointer-events: none;\n    z-index: 0;\n  }\n  \n  .bali-decoration {\n    position: absolute;\n    pointer-events: none;\n  }\n  \n  .bali-decoration-1 {\n    top: -50px;\n    right: -50px;\n    width: 200px;\n    height: 200px;\n    opacity: 0.15;\n  }\n  \n  .bali-decoration-2 {\n    bottom: -30px;\n    left: -30px;\n    width: 150px;\n    height: 150px;\n    opacity: 0.12;\n    transform: rotate(45deg);\n  }\n  \n  /* Content - Z-INDEX 1 but still below header */\n  .bali-content {\n    position: relative;\n    z-index: 1;\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n  \n  .bali-header {\n    text-align: center;\n    margin-bottom: 32px;\n  }\n  \n  .bali-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(251, 191, 36, 0.2);\n    border: 1px solid rgba(251, 191, 36, 0.4);\n    padding: 8px 16px;\n    border-radius: 9999px;\n    margin-bottom: 16px;\n  }\n  \n  .bali-badge span {\n    color: #fcd34d;\n    font-size: 14px;\n    font-weight: 600;\n  }\n  \n  .bali-title {\n    font-size: 28px;\n    font-weight: 700;\n    color: white;\n    margin-bottom: 8px;\n  }\n  \n  @media (min-width: 768px) {\n    .bali-title {\n      font-size: 36px;\n    }\n  }\n  \n  /* Changed from purple (#e9d5ff) to warm amber */\n  .bali-subtitle {\n    color: #fef3c7;\n    font-size: 16px;\n  }\n  \n  @media (min-width: 768px) {\n    .bali-subtitle {\n      font-size: 18px;\n    }\n  }\n  \n  /* Main card with glass effect - amber tint */\n  .bali-main-card {\n    background: rgba(254, 243, 199, 0.1);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(254, 243, 199, 0.2);\n    border-radius: 16px;\n    padding: 24px;\n    margin-bottom: 24px;\n  }\n  \n  @media (min-width: 768px) {\n    .bali-main-card {\n      padding: 32px;\n    }\n  }\n  \n  .bali-card-title {\n    font-size: 18px;\n    font-weight: 700;\n    color: white;\n    margin-bottom: 20px;\n    text-align: center;\n  }\n  \n  .bali-inclusions-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 12px;\n  }\n  \n  @media (min-width: 640px) {\n    .bali-inclusions-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n  \n  @media (min-width: 768px) {\n    .bali-inclusions-grid {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n  }\n  \n  .bali-inclusion-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    padding: 12px;\n    background: rgba(254, 243, 199, 0.05);\n    border-radius: 10px;\n    transition: background 0.2s;\n  }\n  \n  .bali-inclusion-item:hover {\n    background: rgba(254, 243, 199, 0.1);\n  }\n  \n  .bali-inclusion-icon {\n    font-size: 24px;\n    flex-shrink: 0;\n  }\n  \n  .bali-inclusion-text h4 {\n    color: white;\n    font-size: 14px;\n    font-weight: 600;\n    margin-bottom: 2px;\n  }\n  \n  /* Changed from purple (#d8b4fe) to warm amber */\n  .bali-inclusion-text p {\n    color: #fde68a;\n    font-size: 12px;\n    line-height: 1.4;\n    margin: 0;\n  }\n  \n  /* Also included section */\n  .bali-also-included {\n    margin-top: 20px;\n    padding-top: 20px;\n    border-top: 1px solid rgba(254, 243, 199, 0.15);\n  }\n  \n  .bali-also-title {\n    color: #fcd34d;\n    font-size: 14px;\n    font-weight: 600;\n    margin-bottom: 12px;\n  }\n  \n  .bali-also-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n  \n  .bali-also-item {\n    background: rgba(251, 191, 36, 0.15);\n    color: #fde68a;\n    font-size: 12px;\n    padding: 6px 12px;\n    border-radius: 6px;\n  }\n  \n  /* Selection criteria card - amber tint */\n  .bali-selection-card {\n    background: rgba(254, 243, 199, 0.08);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid rgba(254, 243, 199, 0.15);\n    border-radius: 12px;\n    padding: 20px;\n    text-align: center;\n  }\n  \n  .bali-selection-title {\n    color: white;\n    font-size: 16px;\n    font-weight: 700;\n    margin-bottom: 16px;\n  }\n  \n  .bali-selection-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 12px;\n  }\n  \n  @media (min-width: 640px) {\n    .bali-selection-grid {\n      grid-template-columns: repeat(3, 1fr);\n    }\n  }\n  \n  .bali-selection-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n  }\n  \n  .bali-selection-icon {\n    width: 40px;\n    height: 40px;\n    background: rgba(251, 191, 36, 0.2);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n  }\n  \n  .bali-selection-item h4 {\n    color: white;\n    font-size: 13px;\n    font-weight: 600;\n    margin: 0;\n  }\n  \n  /* Changed from purple (#d8b4fe) to warm amber */\n  .bali-selection-item p {\n    color: #fde68a;\n    font-size: 11px;\n    margin: 0;\n  }\n</style>\n\n<section class=\"bali-retreat-section\">\n  <!-- Decorative shapes - CONTAINED in their own div with z-index: 0 -->\n  <div class=\"bali-decoration-container\">\n    <div class=\"bali-decoration bali-decoration-1\">\n      <svg viewBox=\"0 0 200 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M100 0C120 40 160 60 200 100C160 140 120 160 100 200C80 160 40 140 0 100C40 60 80 40 100 0Z\" fill=\"rgba(254,243,199,0.3)\"/>\n      </svg>\n    </div>\n    <div class=\"bali-decoration bali-decoration-2\">\n      <svg viewBox=\"0 0 150 150\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"75\" cy=\"75\" r=\"75\" fill=\"rgba(254,243,199,0.2)\"/>\n      </svg>\n    </div>\n  </div>\n  \n  <div class=\"bali-content\">\n    <!-- Header -->\n    <div class=\"bali-header\">\n      <div class=\"bali-badge\">\n        <span>🌴</span>\n        <span>Exclusive Opportunity</span>\n      </div>\n      <h2 class=\"bali-title\">The Awakening Retreat — Bali, Ubud</h2>\n      <p class=\"bali-subtitle\">5-day all-inclusive spiritual journey for 2 selected customers each month</p>\n    </div>\n    \n    <!-- Main inclusions card -->\n    <div class=\"bali-main-card\">\n      <h3 class=\"bali-card-title\">✨ What's Included In Your Journey</h3>\n      \n      <div class=\"bali-inclusions-grid\">\n        <div class=\"bali-inclusion-item\">\n          <span class=\"bali-inclusion-icon\">✈️</span>\n          <div class=\"bali-inclusion-text\">\n            <h4>Round-Trip Flights</h4>\n            <p>From anywhere in the world, fully covered</p>\n          </div>\n        </div>\n        \n        <div class=\"bali-inclusion-item\">\n          <span class=\"bali-inclusion-icon\">🏨</span>\n          <div class=\"bali-inclusion-text\">\n            <h4>5-Star Resort</h4>\n            <p>Private villa in the heart of Ubud</p>\n          </div>\n        </div>\n        \n        <div class=\"bali-inclusion-item\">\n          <span class=\"bali-inclusion-icon\">🍽️</span>\n          <div class=\"bali-inclusion-text\">\n            <h4>Organic Meals</h4>\n            <p>Farm-to-table Balinese cuisine</p>\n          </div>\n        </div>\n        \n        <div class=\"bali-inclusion-item\">\n          <span class=\"bali-inclusion-icon\">🧘</span>\n          <div class=\"bali-inclusion-text\">\n            <h4>Daily Meditation</h4>\n            <p>Sunrise sessions over rice terraces</p>\n          </div>\n        </div>\n        \n        <div class=\"bali-inclusion-item\">\n          <span class=\"bali-inclusion-icon\">🔮</span>\n          <div class=\"bali-inclusion-text\">\n            <h4>1-on-1 Sessions</h4>\n            <p>Third Eye Activation with practitioners</p>\n          </div>\n        </div>\n        \n        <div class=\"bali-inclusion-item\">\n          <span class=\"bali-inclusion-icon\">🤝</span>\n          <div class=\"bali-inclusion-text\">\n            <h4>Meet Founders</h4>\n            <p>Private dinner with Dr. Bernard & Dr. Delcourt</p>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"bali-also-included\">\n        <p class=\"bali-also-title\">🌿 Also Included:</p>\n        <div class=\"bali-also-list\">\n          <span class=\"bali-also-item\">Sacred temple ceremonies</span>\n          <span class=\"bali-also-item\">Water purification rituals</span>\n          <span class=\"bali-also-item\">Jungle breathwork</span>\n          <span class=\"bali-also-item\">Sound healing</span>\n        </div>\n      </div>\n    </div>\n    \n    <!-- Selection criteria -->\n    <div class=\"bali-selection-card\">\n      <h3 class=\"bali-selection-title\">🏆 How Are Customers Selected?</h3>\n      \n      <div class=\"bali-selection-grid\">\n        <div class=\"bali-selection-item\">\n          <div class=\"bali-selection-icon\">👥</div>\n          <h4>Only 2 Per Month</h4>\n          <p>Intimate experience</p>\n        </div>\n        \n        <div class=\"bali-selection-item\">\n          <div class=\"bali-selection-icon\">⭐</div>\n          <h4>Bundle Priority</h4>\n          <p>Deep Transformation customers</p>\n        </div>\n        \n        <div class=\"bali-selection-item\">\n          <div class=\"bali-selection-icon\">📅</div>\n          <h4>Monthly Announcement</h4>\n          <p>Winners on the 1st</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
