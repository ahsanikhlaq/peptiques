    "pdp_faqs_xz4dnK": {
      "type": "pdp-faqs",
      "blocks": {
        "faq_BTTe8c": {
          "type": "faq",
          "settings": {
            "question": "Can I take this with other supplements or medications?",
            "answer": "<p>Yes. Haritaki is a whole-food herb, not a synthetic compound. That said, if you're on prescription meds, check with your doctor first.</p>",
            "open_by_default": false
          }
        },
        "faq_3ccUNX": {
          "type": "faq",
          "settings": {
            "question": "Is this vegan?",
            "answer": "<p>100%. Vegan, non-GMO, gluten-free. Just pure Terminalia chebula, nothing artificial, no fillers.</p>",
            "open_by_default": false
          }
        },
        "faq_jPmL6a": {
          "type": "faq",
          "settings": {
            "question": "Can this help with vivid dreams or deeper sleep?",
            "answer": "<p>Many users wake up remembering dreams they'd normally forget. Better pineal function = better melatonin = deeper, more restorative sleep.</p>",
            "open_by_default": false
          }
        },
        "faq_NDcjDf": {
          "type": "faq",
          "settings": {
            "question": "What does Haritaki actually do in the body?",
            "answer": "<p>The \"King of Medicines\" in Ayurveda. Supports gut health, mental clarity, and natural detox, used by healers for 5,000+ years.</p>",
            "open_by_default": false
          }
        },
        "faq_TbBdP3": {
          "type": "faq",
          "settings": {
            "question": "Is this safe to use long-term?",
            "answer": "<p>It's been used daily for 5,000 years. Third-party tested, zero known toxicity at recommended doses.</p>",
            "open_by_default": false
          }
        },
        "faq_fwFyhC": {
          "type": "faq",
          "settings": {
            "question": "How is this different from Haritaki powder?",
            "answer": "<p>Powder tastes terrible and oxidizes quickly. Capsules = consistent dose, no bitter taste, stays potent longer.</p>",
            "open_by_default": false
          }
        },
        "faq_4T8MaL": {
          "type": "faq",
          "settings": {
            "question": "Can I take it if I'm sensitive to detox effects?",
            "answer": "<p>Start with 1 capsule per day and build up. Haritaki is gentle, but everyone's body is different. Listen to yours.</p>",
            "open_by_default": false
          }
        },
        "faq_e39WLE": {
          "type": "faq",
          "settings": {
            "question": "Do I need to change my diet while using it?",
            "answer": "<p>No major changes are needed. Haritaki works with your current lifestyle. That said, cleaner eating = faster results. But it's not required.</p>",
            "open_by_default": false
          }
        },
        "faq_DLq4xx": {
          "type": "faq",
          "settings": {
            "question": "Will this help clear mental fog or improve focus?",
            "answer": "<p>When your gut is clogged, so is your brain. Haritaki clears the pathway. Users report sharper focus and clearer thinking within weeks.</p>",
            "open_by_default": false
          }
        },
        "faq_TYiHRP": {
          "type": "faq",
          "settings": {
            "question": "How long until I see results?",
            "answer": "<p>Most users report vivid dreams returning within 7 days. Mental clarity improvements often noticed within 2-3 weeks of consistent use.</p>",
            "open_by_default": false
          }
        },
        "faq_3t4ww3": {
          "type": "faq",
          "settings": {
            "question": "Where is the haritaki sourced?",
            "answer": "<p>100% Himalayan-sourced, organic, cold-processed to preserve active compounds.<br/><br/></p>",
            "open_by_default": false
          }
        },
        "faq_hzM6k3": {
          "type": "faq",
          "settings": {
            "question": "How does it actually decalcify the pineal gland?",
            "answer": "<p>Chebulinic Acid crosses the blood-brain barrier and helps remove calcium/fluoride deposits. Tannins provide neuroprotection during the process.</p>",
            "open_by_default": false
          }
        }
      },
