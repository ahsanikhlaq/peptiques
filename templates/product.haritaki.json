        "custom_liquid_YbdKwi": {
          "type": "custom-liquid",
          "name": "Custom Liquid",
          "settings": {
            "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n  \n  .product-accordion-container {\n    font-family: 'Poppins', sans-serif;\n    width: 100%;\n    max-width: 100%;\n  }\n  \n  .accordion-item {\n    border-bottom: 1px solid #e5e7eb;\n  }\n  \n  .accordion-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    width: 100%;\n    padding: 16px 0;\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    text-align: left;\n    font-family: 'Poppins', sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    color: #1a1a1a;\n    transition: all 0.2s;\n  }\n  \n  .accordion-header:hover {\n    opacity: 0.8;\n  }\n  \n  .accordion-icon {\n    width: 16px;\n    height: 16px;\n    transition: transform 0.3s ease;\n    flex-shrink: 0;\n    margin-left: 12px;\n  }\n  \n  .accordion-item.active .accordion-icon {\n    transform: rotate(180deg);\n  }\n  \n  .accordion-content {\n    display: none;\n    padding: 0 0 16px 0;\n    font-family: 'Poppins', sans-serif;\n    font-size: 14px;\n    line-height: 1.7;\n    color: #374151;\n  }\n  \n  .accordion-item.active .accordion-content {\n    display: block;\n  }\n  \n  .accordion-content p {\n    margin-bottom: 12px;\n    font-family: 'Poppins', sans-serif;\n  }\n  \n  .accordion-content strong {\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n  \n  .accordion-content h4 {\n    font-family: 'Poppins', sans-serif;\n    font-weight: 700;\n    font-size: 15px;\n    margin-bottom: 8px;\n    color: #1a1a1a;\n  }\n  \n  .accordion-content ul {\n    margin-left: 16px;\n    margin-bottom: 12px;\n  }\n  \n  .accordion-content li {\n    margin-bottom: 8px;\n    font-family: 'Poppins', sans-serif;\n  }\n  \n  /* Special boxes */\n  .why-box {\n    background: rgba(13, 148, 136, 0.1);\n    border: 1px solid rgba(13, 148, 136, 0.3);\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .why-box h4 {\n    color: #1a1a1a;\n    margin-bottom: 8px;\n  }\n  \n  .text-primary {\n    color: #0d9488;\n  }\n  \n  .green-box {\n    background: #f0fdf4;\n    border: 2px solid #16a34a;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .green-box h4 {\n    color: #166534;\n    margin-bottom: 8px;\n  }\n  \n  .green-box ul {\n    color: #14532d;\n  }\n  \n  .green-box li {\n    color: #14532d;\n  }\n  \n  .green-inner-box {\n    background: #dcfce7;\n    border-radius: 6px;\n    padding: 12px;\n    margin-top: 16px;\n    text-align: center;\n  }\n  \n  .green-inner-box p {\n    color: #166534;\n    font-weight: 700;\n    margin-bottom: 4px;\n  }\n  \n  .tip-box {\n    background: rgba(13, 148, 136, 0.05);\n    border: 1px solid rgba(13, 148, 136, 0.2);\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .bottom-banner {\n    background: rgba(13, 148, 136, 0.1);\n    border: 1px solid rgba(13, 148, 136, 0.3);\n    border-radius: 8px;\n    padding: 12px;\n    text-align: center;\n    margin-top: 16px;\n  }\n  \n  .bottom-banner p {\n    font-weight: 600;\n    margin: 0;\n  }\n  \n  /* Ingredient items */\n  .ingredient-item {\n    border-left: 4px solid #0d9488;\n    padding: 8px 0 8px 12px;\n    margin-bottom: 12px;\n  }\n  \n  .ingredient-item strong {\n    color: #1a1a1a;\n  }\n  \n  /* Benefits list */\n  .benefits-section {\n    padding-left: 12px;\n    margin: 12px 0;\n  }\n  \n  .benefits-section p {\n    margin-bottom: 10px;\n  }\n  \n  /* Timeline items */\n  .timeline-section {\n    padding-left: 12px;\n    margin: 12px 0;\n  }\n  \n  .timeline-section p {\n    margin-bottom: 10px;\n  }\n  \n  /* Bonus text */\n  .bonus-text {\n    font-size: 11px;\n    color: #6b7280;\n  }\n  \n  /* Trust intro box for return policy */\n  .trust-intro-box {\n    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);\n    border: 2px solid #16a34a;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .trust-intro-box p {\n    color: #166534;\n  }\n  \n  /* Catch box */\n  .catch-box {\n    background: #fefce8;\n    border: 2px dashed #ca8a04;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  /* Ask box */\n  .ask-box {\n    background: #fffbeb;\n    border: 1px solid #f59e0b;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  /* Shipping protection box */\n  .shipping-protection-box {\n    background: #eff6ff;\n    border: 2px solid #3b82f6;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .shipping-protection-box h4 {\n    color: #1e40af;\n  }\n  \n  .shipping-protection-box ul {\n    color: #1e3a8a;\n  }\n  \n  /* Shipping tip */\n  .shipping-tip {\n    background: #f5f5f5;\n    border-radius: 6px;\n    padding: 12px;\n    margin-top: 16px;\n    font-size: 13px;\n    color: #6b7280;\n  }\n  \n  /* Retreat box - special golden styling */\n  .retreat-box {\n    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);\n    border: 2px solid #d97706;\n    border-radius: 8px;\n    padding: 16px;\n    margin: 16px 0;\n  }\n  \n  .retreat-box h4 {\n    color: #92400e;\n    margin-bottom: 8px;\n  }\n  \n  .retreat-box p {\n    color: #78350f;\n  }\n</style>\n\n<div class=\"product-accordion-container\">\n  <!-- Section 1: Description -->\n  <div class=\"accordion-item\" data-accordion=\"description\">\n    <button class=\"accordion-header\">\n      <span>🧘 Description & Why This Has Awakened Thousands</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <p>\n        <strong>Haritaki™</strong> isn't just a supplement. \n        It's the <span class=\"text-primary\" style=\"font-weight: 600;\">ancient Ayurvedic secret</span> called \n        <strong>\"The King of Medicines\"</strong> — now in a convenient daily capsule designed to cleanse your pineal gland and awaken your Third Eye.\n      </p>\n      \n      <div class=\"why-box\">\n        <h4>🔮 WHY It Works:</h4>\n        <p style=\"margin-bottom: 8px;\">\n          Your pineal gland has been calcified for years by fluoride, processed foods, and environmental toxins. \n          Result? Brain fog, disconnection from intuition, restless sleep, and feeling spiritually \"blocked.\"\n        </p>\n        <p style=\"font-weight: 700; color: #0d9488; margin-bottom: 0;\">\n          Haritaki™ naturally decalcifies the pineal gland and supports the gut-brain axis — the foundation of mental clarity and spiritual connection.\n        </p>\n      </div>\n\n      <h4 style=\"font-size: 16px;\">✨ The Power of \"The King of Medicines\":</h4>\n      \n      <div class=\"benefits-section\">\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🧠 Pineal Gland Cleansing:</span> Haritaki has been used for 5,000+ years in Ayurveda specifically to decalcify and activate the pineal gland — the seat of intuition and spiritual vision.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">👁️ Third Eye Activation:</span> As your pineal gland cleanses, many users report enhanced intuition, vivid dreams, and a deeper connection to their inner wisdom.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">🧘 Mental Clarity & Focus:</span> Clear the brain fog that's been holding you back. Experience the sharp, present awareness you've been missing.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">💪 Gut-Brain Connection:</span> Haritaki supports healthy digestion and elimination — because a clean gut means a clear mind.\n        </p>\n\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">⚡ Sustained Natural Energy:</span> No caffeine, no crashes. Just clean, natural vitality that lasts all day.\n        </p>\n\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">😴 Deeper, More Restorative Sleep:</span> Many users report falling asleep faster and waking up truly rested — with vivid, meaningful dreams.\n        </p>\n      </div>\n\n      <div class=\"green-box\">\n        <h4>✅ 100% Pure & No Compromise:</h4>\n        <ul>\n          <li>✓ <strong>Single Ingredient</strong> - Pure Haritaki (Terminalia chebula), nothing else</li>\n          <li>✓ <strong>Non-GMO</strong> - Organically sourced from trusted farms</li>\n          <li>✓ <strong>Gluten-Free</strong> - Suitable for all dietary needs</li>\n          <li>✓ <strong>No Additives</strong> - No fillers, binders, or artificial anything</li>\n          <li>✓ <strong>Vegan & Cruelty-Free</strong> - Plant-based vegetable cellulose capsule</li>\n          <li>✓ <strong>Third-Party Tested</strong> - Verified for purity and potency</li>\n        </ul>\n      </div>\n\n      <h4 style=\"font-size: 16px;\">🎯 What You'll REALLY Experience:</h4>\n      \n      <div class=\"timeline-section\">\n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">✓ Week 1-2:</span> Improved digestion, better sleep quality, subtle mental clarity beginning to emerge.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">✓ Week 3-4:</span> Noticeable brain fog lifting, more vivid dreams, stronger sense of intuition and inner knowing.\n        </p>\n        \n        <p>\n          <span class=\"text-primary\" style=\"font-weight: 700;\">✓ Week 5-8+:</span> Deep spiritual connection, consistent mental sharpness, feeling truly present and aligned with your purpose.\n        </p>\n      </div>\n\n      <div class=\"tip-box\">\n        <p style=\"margin-bottom: 0;\">\n          <span class=\"text-primary\" style=\"font-weight: 700;\">💡 Why Haritaki?</span> \n          Called \"The King of Medicines\" in Ayurveda for over 5,000 years. Buddhist monks have used it for centuries to support meditation and spiritual practice. Now you can experience this ancient wisdom in a simple daily capsule.\n        </p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Section 2: What's Inside -->\n  <div class=\"accordion-item\" data-accordion=\"ingredients\">\n    <button class=\"accordion-header\">\n      <span>🔬 What's Inside (Pure & Simple)</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <p style=\"font-weight: 600; margin-bottom: 16px;\">\n        Unlike complex formulas with dozens of ingredients, Haritaki™ contains just ONE powerful ingredient:\n      </p>\n      \n      <div class=\"ingredient-item\">\n        <strong>Haritaki (Terminalia chebula)</strong> – The primary active ingredient, sourced from organic farms. Known as \"The King of Medicines\" in Ayurveda for its ability to support all three doshas and cleanse the entire system.\n      </div>\n      \n      <div class=\"ingredient-item\">\n        <strong>Vegetable Cellulose Capsule</strong> – 100% vegan, easy to digest, no animal products or gelatin.\n      </div>\n      \n      <div class=\"why-box\">\n        <h4>🌿 Why Just One Ingredient?</h4>\n        <p style=\"margin-bottom: 0;\">\n          Haritaki is so powerful that it doesn't need to be mixed with anything else. In Ayurveda, it's considered a <strong>\"Rasayana\"</strong> — a rejuvenating herb that supports longevity and spiritual development on its own. Adding more ingredients would only dilute its potency.\n        </p>\n      </div>\n      \n      <p style=\"margin-top: 16px; color: #6b7280;\">\n        ✓ Non-GMO ✓ Gluten-Free ✓ Vegan ✓ No Additives ✓ No Fillers ✓ Third-Party Tested\n      </p>\n    </div>\n  </div>\n\n  <!-- Section 3: How to Use -->\n  <div class=\"accordion-item\" data-accordion=\"how-to-use\">\n    <button class=\"accordion-header\">\n      <span>💊 How to Use</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <h4>🧘 Daily Ritual (Recommended)</h4>\n      <p>\n        For optimal pineal gland cleansing and spiritual awakening, we recommend:\n      </p>\n      <ul>\n        <li>\n          <strong>Morning:</strong> Take 1 capsule with water upon waking, before breakfast. \n          This prepares your system for the day and supports mental clarity from the start.\n        </li>\n        <li>\n          <strong>Evening:</strong> Take 1 capsule with water before bed. \n          This supports the body's natural nighttime detoxification and promotes vivid, meaningful dreams.\n        </li>\n      </ul>\n      <p style=\"font-weight: 600;\">Total Dosage: 2 capsules per day</p>\n\n      <h4>⚡ Tips for Maximum Awakening</h4>\n      <ul>\n        <li>\n          <strong>Week 1:</strong> Establish your routine. Your gut will begin adjusting as Haritaki starts its gentle cleansing action. Some users notice improved digestion almost immediately.\n        </li>\n        <li>\n          <strong>Week 2-3:</strong> The pineal gland cleansing deepens. Pay attention to your dreams — many users report them becoming more vivid and meaningful.\n        </li>\n        <li>\n          <strong>Week 4+:</strong> Full benefits emerge. Mental clarity, intuition, and spiritual connection continue to strengthen with consistent daily use.\n        </li>\n        <li>\n          <strong>Meditation Enhancement:</strong> Take your evening capsule 30 minutes before meditation for a deeper, more connected practice.\n        </li>\n        <li>\n          <strong>Stay Hydrated:</strong> Water helps flush toxins as the pineal gland cleanses. Aim for 8+ glasses daily.\n        </li>\n      </ul>\n\n      <h4>🔍 What to Expect</h4>\n      <ul>\n        <li><strong>Days 1–7:</strong> Improved digestion and elimination. Subtle increase in mental clarity.</li>\n        <li><strong>Days 7–21:</strong> Vivid dreams begin. Brain fog starts lifting. Intuition becomes sharper.</li>\n        <li><strong>Days 21–60+:</strong> Deep spiritual connection. Consistent mental sharpness. Feeling truly present and aligned.</li>\n      </ul>\n\n      <h4>🧊 Storage</h4>\n      <p style=\"margin-bottom: 0;\">\n        Store in a cool, dry place away from direct sunlight. Keep the bottle tightly closed to preserve freshness and potency.\n      </p>\n    </div>\n  </div>\n\n  <!-- Section 4: Guarantee - SPIRITUAL BONUSES -->\n  <div class=\"accordion-item\" data-accordion=\"guarantee\">\n    <button class=\"accordion-header\">\n      <span>⭐ Our 60-Day Awakening Guarantee</span>\n      <svg class=\"accordion-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <polyline points=\"6,9 12,15 18,9\"></polyline>\n      </svg>\n    </button>\n    <div class=\"accordion-content\">\n      <div class=\"green-box\">\n        <p style=\"font-weight: 700; color: #166534; margin-bottom: 12px;\">\n          If you don't experience ANY shift in clarity, intuition, or connection… full refund. No questions asked.\n        </p>\n        \n        <p style=\"font-weight: 700; color: #15803d;\">\n          🎁 + 4 FREE SPIRITUAL BONUSES (yours to keep even if refunded):\n        </p>\n        <ul>\n          <li>\n            ✅ <strong>1-on-1 Third Eye Activation Session (45 min)</strong>\n            <br />\n            <span class=\"bonus-text\">Personal guidance from our spiritual practitioners to accelerate your awakening (value $297)</span>\n          </li>\n          <li>\n            ✅ <strong>90-