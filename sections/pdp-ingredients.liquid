{% comment %}
  Ingredients That Just Do More — PDP section.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign bg_image = nil
  if s.bg_image_desktop != blank
    assign bg_image = s.bg_image_desktop
  endif
  assign mobile_bg_image = nil
  if s.bg_image_mobile != blank
    assign mobile_bg_image = s.bg_image_mobile
  elsif bg_image != blank
    assign mobile_bg_image = bg_image
  endif

  assign ingredient_count = 0
  assign badge_count = 0
  assign stat_count = 0
  for block in section.blocks
    case block.type
      when 'ingredient'
        assign ingredient_count = ingredient_count | plus: 1
      when 'badge'
        assign badge_count = badge_count | plus: 1
      when 'stat_bar'
        assign stat_count = stat_count | plus: 1
    endcase
  endfor
-%}

<style>
  /* ─── Section ───────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-section {
    padding: {{ s.section_padding_top | default: 48 }}px {{ s.section_padding_x | default: 16 }}px {{ s.section_padding_bottom | default: 48 }}px;
    color: {{ s.heading_color | default: '#ffffff' }};
    background-color: {{ s.card_background | default: '#47184d' }};
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    {% if mobile_bg_image != blank %}
      background-image:
        linear-gradient({{ s.overlay_color | default: '#2a1442' }}cc, {{ s.overlay_color | default: '#2a1442' }}cc),
        url({{ mobile_bg_image | image_url: width: 1200 }});
    {% else %}
      background-image:
        radial-gradient(ellipse 60% 50% at 20% 0%, rgba(255,255,255,0.08), transparent 60%),
        radial-gradient(ellipse 50% 60% at 100% 100%, rgba(255,255,255,0.06), transparent 65%),
        linear-gradient(160deg, {{ s.gradient_from | default: '#5a2a78' }} 0%, {{ s.card_background | default: '#3f1c5c' }} 55%, {{ s.gradient_to | default: '#2a1442' }} 100%);
    {% endif %}
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pi-section {
      padding: {{ s.section_padding_top_desktop | default: 80 }}px {{ s.section_padding_x_desktop | default: 50 }}px {{ s.section_padding_bottom_desktop | default: 80 }}px;
      {% if bg_image != blank %}
        background-image:
          linear-gradient({{ s.overlay_color | default: '#2a1442' }}cc, {{ s.overlay_color | default: '#2a1442' }}cc),
          url({{ bg_image | image_url: width: 2000 }});
      {% endif %}
    }
  }

  #shopify-section-{{ sid }} .pi-wrap {
    max-width: 1340px;
    margin-inline: auto;
  }

  /* ─── Heading & sub ─────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-heading {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: inherit;
    text-align: center;
    margin: 0 0 16px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.07em;
    font-size: clamp(1.75rem, 2.4vw + 1rem, 46px);
  }
  #shopify-section-{{ sid }} .pi-sub {
    color: {{ s.subheading_color | default: '#ffffff' }};
    text-align: center;
    max-width: 602px;
    margin: 0 auto 50px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    font-size: 16px;
    font-family: 'DM Sans', sans-serif;
  }

  /* ─── Ingredient cards ──────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin: 0 -{{ s.section_padding_x | default: 16 }}px 24px;
    padding: 0 {{ s.section_padding_x | default: 16 }}px 8px;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ sid }} .pi-cards::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pi-cards {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow-x: visible;
      margin: 0 0 12px;
      padding: 0;
      gap: 12px;
    }
  }
  #shopify-section-{{ sid }} .pi-card {
    scroll-snap-align: start;
    background: {{ s.card_color | default: '#ffffff' }};
    color: #1d1027;
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pi-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 170px;
      padding: 24px;
      gap: 60px;
      align-items: stretch;
    }
  }
  #shopify-section-{{ sid }} .pi-card-title {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    margin: 0 0 27px;
    color: inherit;
  }
  #shopify-section-{{ sid }} .pi-card-body {
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: #000;
    margin: 0;
    font-family: 'DM Sans', sans-serif;
  }
  #shopify-section-{{ sid }} .pi-card-image {
    order: -1;
    border-radius: 14px;
    overflow: hidden;
    background: #f3eaf9;
    aspect-ratio: 4 / 3;
    display: flex;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pi-card-image { order: 0; aspect-ratio: auto; }
  }
  #shopify-section-{{ sid }} .pi-card-image img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  /* ─── Badges ────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-badges {
    background: {{ s.badges_background | default: '#ffffff' }};
    border-radius: 16px;
    padding: 16px 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 14px;
    margin-bottom: 50px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pi-badges {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      padding: 24px 40px;
      gap: 0;
    }
  }
  #shopify-section-{{ sid }} .pi-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: {{ s.badge_text_color | default: '#1e0346' }};
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    font-family: 'DM Sans', sans-serif;
  }
  #shopify-section-{{ sid }} .pi-badge-x {
    width: 24px; height: 24px;
    border-radius: 50%;
    background: {{ s.badge_x_color | default: '#d23a3a' }};
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .pi-badge-x svg { width: 12px; height: 12px; }
  #shopify-section-{{ sid }} .pi-badge-label {
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  /* ─── Footer ────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pi-footer {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr);
      gap: 40px;
    }
  }

  /* ─── Left: image + desc ────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-footer-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }
  #shopify-section-{{ sid }} .pi-stat-label {
    color: #ffffff;
    margin: 20px 0 0;
    line-height: 1.3;
    font-weight: 400;
    font-size: 18px;
    font-family: 'DM Sans', sans-serif;
    opacity: 0.9;
  }

  /* ─── Bars: 3 dashed borders ────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-bars {
    display: flex;
    flex-direction: column;
    position: relative;
    gap: 28px;
  }
  #shopify-section-{{ sid }} .pi-bars::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 0; width: 0;
    border-left: 1.2px dashed #E3E3E3;
    pointer-events: none;
    z-index:1;
  }
  #shopify-section-{{ sid }} .pi-bars::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0; right: 0; width: 0;
    border-right: 1.2px dashed #E3E3E3;
    pointer-events: none;
     z-index:1;
  }
  #shopify-section-{{ sid }} .pi-bars-center {
    position: absolute;
    top: 0; bottom: 0; left: 50%; width: 0;
    border-left: 1.2px dashed #E3E3E3;
    pointer-events: none;
     z-index:1;
  }

  #shopify-section-{{ sid }} .pi-bar { padding: 0; z-index:2;}
  #shopify-section-{{ sid }} .pi-bar-label {
    color: #E3E3E3;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    margin: 22px 0 22px 30px;
    font-family: 'DM Sans', sans-serif;
  }

  /* ─── Bar track ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pi-bar-track {
    position: relative;
    height: 22px;
    border-radius: 3px;
    background: transparent;
    overflow: hidden;
  }

  /* Fill — starts at width:0, JS animates to data-w value */
  #shopify-section-{{ sid }} .pi-bar-fill {
    display: block !important;
    position: absolute;
    left: 0; top: 0;
    height: 100%;
    width: 0%;
    background: #ffffff;
    border-radius: 3px;
    transition: width 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Striped: white base + black diagonal lines */
  #shopify-section-{{ sid }} .pi-bar-fill--striped {
    background-color: #ffffff;
    background-image: repeating-linear-gradient(
      -45deg,
      #000000 0px, #000000 4px,
      transparent 4px, transparent 10px
    );
  }

  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pi-footer { display: none; }
    #shopify-section-{{ sid }} .pi-badges { margin-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pi-bar-fill { transition: none !important; }
  }
</style>

<section class="pi-section" {{ section.shopify_attributes }}>
  <div class="pi-wrap">

    <h2 class="pi-heading">{{ s.heading_text | default: 'Ingredients That Just Do More' }}</h2>

    {%- if s.subheading_text != blank -%}
      <p class="pi-sub">{{ s.subheading_text }}</p>
    {%- endif -%}

    {%- if ingredient_count > 0 -%}
      <div class="pi-cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' -%}
            <article class="pi-card" {{ block.shopify_attributes }}>
              <div>
                <h3 class="pi-card-title">{{ block.settings.title_text }}</h3>
                <p class="pi-card-body">{{ block.settings.body_text }}</p>
              </div>
              <div class="pi-card-image">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 400 | image_tag:
                       loading: 'lazy',
                       widths: '200,280,400',
                       sizes: '(min-width: 1024px) 170px, 130px',
                       alt: block.settings.title_text }}
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if badge_count > 0 -%}
      <div class="pi-badges" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <span class="pi-badge" role="listitem" {{ block.shopify_attributes }}>
              <span class="pi-badge-x" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                  <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
              </span>
              <span class="pi-badge-label">{{ block.settings.label_text }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.footer_image != blank or stat_count > 0 -%}
      <div class="pi-footer">

        {%- comment -%} LEFT: image + description {%- endcomment -%}
        <div class="pi-footer-left">
          {%- if s.footer_image != blank -%}
            {{ s.footer_image | image_url: width: 800 | image_tag:
                 class: 'pi-footer-image',
                 loading: 'lazy',
                 widths: '300,500,800',
                 sizes: '(min-width: 1024px) 38vw, 100vw',
                 alt: s.footer_image_alt | default: '' }}
          {%- endif -%}
          {%- if s.stat_label != blank -%}
            <p class="pi-stat-label">{{ s.stat_label }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} RIGHT: bars {%- endcomment -%}
        {%- if stat_count > 0 -%}
          <div class="pi-bars" id="pi-bars-{{ sid }}">
            <span class="pi-bars-center" aria-hidden="true"></span>
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat_bar' -%}
                <div class="pi-bar" {{ block.shopify_attributes }}>
                  <p class="pi-bar-label">{{ block.settings.label_text }}</p>
                  <div class="pi-bar-track">
                    <div
                      class="pi-bar-fill{% if block.settings.striped %} pi-bar-fill--striped{% endif %}"
                      data-w="{{ block.settings.fill_percent | default: 100 }}"
                    > </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var sId     = '{{ sid }}';
  var barsEl  = document.getElementById('pi-bars-' + sId);
  if (!barsEl) return;

  var triggered = false;

  function animate() {
    if (triggered) return;
    triggered = true;

    barsEl.querySelectorAll('.pi-bar').forEach(function (bar, i) {
      var fill = bar.querySelector('.pi-bar-fill');
      if (!fill) return;

      var tw    = parseFloat(fill.getAttribute('data-w')) || 0;
      var delay = 350 + i * 180;

      /* Reset to 0 without transition */
      fill.style.transition = 'none';
      fill.style.width = '0%';

      setTimeout(function () {
        fill.style.transition = 'width 1.6s cubic-bezier(0.22, 1, 0.36, 1)';
        fill.style.width = tw + '%';
      }, delay);
    });
  }

  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) {
        animate();
        obs.disconnect();
      }
    }, {
      threshold: 0.25,
      rootMargin: '0px 0px -100px 0px'
    });
    obs.observe(barsEl);
  } else {
    animate();
  }

  /* Shopify editor: re-trigger on section reload */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === sId) {
      triggered = false;
      setTimeout(animate, 300);
    }
  });
})();
</script>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "pi-ingredients",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Background image — Desktop" },
    { "type": "image_picker", "id": "bg_image_mobile",  "label": "Background image — Mobile (falls back to desktop)" },
    { "type": "color",        "id": "overlay_color",    "label": "Overlay color (over image)", "default": "#2a1442" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "card_background",   "label": "Section background",    "default": "#47184d" },
    { "type": "color", "id": "gradient_from",     "label": "Gradient start",        "default": "#5a2a78" },
    { "type": "color", "id": "gradient_to",       "label": "Gradient end",          "default": "#2a1442" },
    { "type": "color", "id": "heading_color",     "label": "Heading color",         "default": "#ffffff" },
    { "type": "color", "id": "subheading_color",  "label": "Subheading color",      "default": "#ffffff" },
    { "type": "color", "id": "card_color",        "label": "Ingredient card bg",    "default": "#ffffff" },
    { "type": "color", "id": "badges_background", "label": "Badges row background", "default": "#ffffff" },
    { "type": "color", "id": "badge_text_color",  "label": "Badge text color",      "default": "#1e0346" },
    { "type": "color", "id": "badge_x_color",     "label": "Badge X icon color",    "default": "#d23a3a" },

    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "heading_text",        "label": "Heading",    "default": "Ingredients That Just Do More" },
    { "type": "textarea", "id": "subheading_text",     "label": "Subheading", "default": "Unlike complex formulas with dozens of ingredients, Haritaki™ contains just ONE powerful ingredient:" },
    { "type": "text",     "id": "heading_font_family", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Footer section" },
    { "type": "image_picker", "id": "footer_image",     "label": "Footer left image" },
    { "type": "text",         "id": "footer_image_alt", "label": "Footer image alt text" },
    { "type": "textarea",     "id": "stat_label",       "label": "Description below image", "default": "Detox support for a lighter, cleaner daily routine" },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",            "label": "Padding top (Mobile)",     "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom",         "label": "Padding bottom (Mobile)",  "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x",              "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",    "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop", "label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",      "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient card",
      "settings": [
        { "type": "text",         "id": "title_text", "label": "Title" },
        { "type": "textarea",     "id": "body_text",  "label": "Body" },
        { "type": "image_picker", "id": "image",      "label": "Image" }
      ]
    },
    {
      "type": "badge",
      "name": "Free-from badge",
      "settings": [
        { "type": "text", "id": "label_text", "label": "Label", "default": "Non-GMO" }
      ]
    },
    {
      "type": "stat_bar",
      "name": "Stat progress bar",
      "settings": [
        { "type": "text",     "id": "label_text",   "label": "Label",        "default": "Supports Natural Detox" },
        { "type": "range",    "id": "fill_percent", "label": "Fill %",       "min": 0, "max": 100, "step": 5, "default": 100, "unit": "%" },
        { "type": "checkbox", "id": "striped",      "label": "Striped fill (black stripes)", "default": false }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Ingredients",
      "category": "Custom",
      "blocks": [
        { "type": "ingredient", "settings": { "title_text": "Haritaki (Terminalia chebula)", "body_text": "The primary active ingredient, sourced from organic farms. Known as 'The King of Medicines' in Ayurveda for its ability to support all three doshas and cleanse the entire system." } },
        { "type": "ingredient", "settings": { "title_text": "Vegetable Cellulose Capsule",  "body_text": "100% vegan and easy to digest, made without animal products or gelatin for a cleaner, lighter formula that fits seamlessly into your everyday wellness routine." } },
        { "type": "badge", "settings": { "label_text": "Non-GMO" } },
        { "type": "badge", "settings": { "label_text": "Gluten-Free" } },
        { "type": "badge", "settings": { "label_text": "No Additives" } },
        { "type": "badge", "settings": { "label_text": "No Fillers" } },
        { "type": "badge", "settings": { "label_text": "Vegan" } },
        { "type": "badge", "settings": { "label_text": "Third-Party Tested" } },
        { "type": "stat_bar", "settings": { "label_text": "Supports Natural Detox", "fill_percent": 100, "striped": false } },
        { "type": "stat_bar", "settings": { "label_text": "Sharpens Mental Focus",  "fill_percent": 65,  "striped": true  } }
      ]
    }
  ]
}
{% endschema %}
