{% comment %}
  Footer — pixel-perfect match to reference images.
  Desktop: newsletter 2-col | logo + 3 cols | disclaimer + social pills
  Mobile:  newsletter full | accordion | social circles | payment image (1 combined image)
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings
  assign link_col_count = 0
  assign social_count   = 0
  for block in section.blocks
    case block.type
      when 'link_column'
        assign link_col_count = link_col_count | plus: 1
      when 'social_link'
        assign social_count = social_count | plus: 1
    endcase
  endfor
-%}

<style>
/* ── SECTION ── */
#shopify-section-{{ sid }} .pf-section {
  background-color: {{ s.bg_color | default: '#47184d' }};
  color: {{ s.text_color | default: '#ffffff' }};
  {% if s.bg_image_desktop != blank %}
    background-image: url({{ s.bg_image_desktop | image_url: width: 2400 }});
    background-size: cover;
    background-position: center;
  {% endif %}
}
@media (max-width: 768px) {
  {% if s.bg_image_mobile != blank %}
    #shopify-section-{{ sid }} .pf-section {
      background-image: url({{ s.bg_image_mobile | image_url: width: 800 }});
      background-size: cover;
      background-position: center;
    }
  {% endif %}
}

/* ── WRAP ── */
#shopify-section-{{ sid }} .pf-section {
  padding: {{ s.section_padding_top | default: 40 }}px
           {{ s.section_padding_x | default: 20 }}px
           {{ s.section_padding_bottom | default: 24 }}px;
}
#shopify-section-{{ sid }} .pf-wrap{
    max-width: 1340px;
  margin: 0 auto;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-section {
    padding: {{ s.section_padding_top_desktop | default: 64 }}px
             {{ s.section_padding_x_desktop | default: 80 }}px
             {{ s.section_padding_bottom_desktop | default: 48 }}px;
  }
}

/* ══════════════════════
   ROW 1 — NEWSLETTER
══════════════════════ */
#shopify-section-{{ sid }} .pf-newsletter {
  padding-bottom: 6px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-newsletter {
    display: grid;
    grid-template-columns: 510px 1fr;
    align-items: center;
    gap: 250px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }
}

#shopify-section-{{ sid }} .pf-nl-heading {
  font-family: 'Georgia';
  font-weight: 400;
  font-size: 46px;
  line-height: 100%;
  letter-spacing: -7%;
  margin: 0 0 20px;
  color: #FFFFFF;
}
#shopify-section-{{ sid }} .pf-nl-sub {
  font-family: 'DM Sans';
  font-weight: 400;
  font-size: 16px;
  line-height: 100%;
  letter-spacing: 0;
  color: #FFFFFF;
  margin: 0;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-nl-sub { margin-bottom: 0; }
}

/* ── FORM WRAPPER — Mobile ── */
#shopify-section-{{ sid }} .pf-nl-form {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 0px;
}
#shopify-section-{{ sid }} .pf-newsletter > div:last-child {
  width: 100%;
}

/* ── MOBILE: input — separate rounded box ── */
#shopify-section-{{ sid }} .pf-nl-input {
  flex: 1 1 auto;
  min-width: 0;
  background: transparent;
  border: 1.5px solid rgba(255, 255, 255, 0.55);
  border-radius: 5px;
  color: inherit;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  padding: 12px 10px 12px 20px;
  outline: none !important;
  box-shadow: none !important;
  -webkit-appearance: none;
  line-height: 100%;
  letter-spacing: 0;
}

/* ── PLACEHOLDER FIX — all browsers ── */
#shopify-section-{{ sid }} .pf-nl-input::-webkit-input-placeholder {
  color: #fff;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  opacity: 1;
}
#shopify-section-{{ sid }} .pf-nl-input::-moz-placeholder {
  color: #fff;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  opacity: 1;
}
#shopify-section-{{ sid }} .pf-nl-input:-ms-input-placeholder {
  color: #fff;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
}
#shopify-section-{{ sid }} .pf-nl-input::placeholder {
  color: #fff;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  opacity: 1;
}

#shopify-section-{{ sid }} .pf-nl-input:focus {
  outline: none !important;
  box-shadow: none !important;
  border-color: rgba(255,255,255,0.9);
}

/* Mobile button: white JOIN NOW — separate pill, stays at end */
#shopify-section-{{ sid }} .pf-nl-btn {
  flex-shrink: 0;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'DM Sans', system-ui, sans-serif;
  transition: opacity 0.15s;
  background: #ffffff;
  color: #47184D;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0;
  padding: 12px 20px;
  border-radius: 50px;
  white-space: nowrap;
  margin-left: 20px;
}
#shopify-section-{{ sid }} .pf-nl-btn:hover { opacity: 0.88; }
#shopify-section-{{ sid }} .pf-btn-text  { display: inline; }
#shopify-section-{{ sid }} .pf-btn-arrow { display: none; }

/* ── DESKTOP: input full width, arrow button INSIDE on right ── */
@media (min-width: 769px) {
  /* gap:0 removes reserved space so input stretches 100% */
  #shopify-section-{{ sid }} .pf-nl-form {
    position: relative;
    align-items: center;
    gap: 0;
    width: 100%;
  }
  /* Input: full width, right padding for arrow button */
  #shopify-section-{{ sid }} .pf-nl-input {
    flex: 1 1 100%;
    width: 100%;
    border-radius: 10px !important;
    padding: 23px 58px 23px 16px !important;
    font-size: 20px !important;
    font-family: 'DM Sans', system-ui, sans-serif !important;
    font-weight: 400 !important;
    outline: none !important;
    box-shadow: none !important;
    border: 1px solid #BFD2DD !important;
    letter-spacing: -0.8px;
    line-height: 100%;
  }
  #shopify-section-{{ sid }} .pf-nl-input:focus {
    outline: none !important;
    box-shadow: none !important;
    border-color: rgba(255,255,255,0.8) !important;
  }
  /* Desktop placeholder */
  #shopify-section-{{ sid }} .pf-nl-input::-webkit-input-placeholder { font-size: 20px; }
  #shopify-section-{{ sid }} .pf-nl-input::-moz-placeholder           { font-size: 20px; }
  #shopify-section-{{ sid }} .pf-nl-input::placeholder                 { font-size: 20px; }
  /* Button: absolute inside input on the right */
  #shopify-section-{{ sid }} .pf-nl-btn {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    background: white;
    color: #ffffff;
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .pf-btn-text  { display: none; }
  #shopify-section-{{ sid }} .pf-btn-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ sid }} .pf-btn-arrow svg { width: 18px; height: 18px; color: #47184D; }
}

#shopify-section-{{ sid }} .pf-nl-msg {
  margin-top: 8px;
  font-size: 13px;
  font-family: 'DM Sans', system-ui, sans-serif;
  display: block;
}
#shopify-section-{{ sid }} .pf-nl-msg--error  { color: #ffb3b3; }
#shopify-section-{{ sid }} .pf-nl-msg--success { color: #cdb6e6; }

/* ══════════════════════
   ROW 2 — LOGO + COLS
══════════════════════ */
#shopify-section-{{ sid }} .pf-row2 { padding: 0; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row2 {
    display: grid;
    grid-template-columns: 536px 1fr;
    gap: 225px;
    align-items: center;
    padding: 36px 0;
    border-bottom: 1px solid #BFD2DD;
  }
}

/* Logo: desktop only */
#shopify-section-{{ sid }} .pf-logo-wrap { display: none; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .pf-logo-wrap { display: block; padding-top: 4px; } }

#shopify-section-{{ sid }} .pf-logo {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(1.6rem, 2.2vw, 2.4rem);
  font-weight: 400;
  letter-spacing: 0.05em;
  color: inherit;
  text-decoration: none;
  display: inline-flex;
  align-items: baseline;
  line-height: 1;
}
#shopify-section-{{ sid }} .pf-logo sup { font-size: 0.35em; vertical-align: super; margin-left: 0.06em; }
#shopify-section-{{ sid }} .pf-logo img { max-width: 100%; height: auto; display: block; }

/* Columns grid */
#shopify-section-{{ sid }} .pf-cols { width: 100%; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-cols {
    display: grid;
    grid-template-columns: repeat({{ link_col_count | at_least: 1 }}, minmax(0,1fr));
    gap: 0px;
  }
}

#shopify-section-{{ sid }} .pf-col {
  border-bottom: 1px solid rgba(255,255,255,0.2);
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .pf-col { border-bottom: none; } }

#shopify-section-{{ sid }} .pf-col-title {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 18px;
  font-weight: 500;
  color: inherit;
  margin: 0;
  padding: 14px 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
  letter-spacing: 0;
  background: none;
  border: none;
  width: 100%;
  text-align: left;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-col-title {
    font-family: 'DM Sans';
    font-weight: 700;
    font-size: 18px;
    line-height: 120%;
    letter-spacing: 0;
    padding: 0 0 19px;
    cursor: default;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .pf-col-title .pf-plus { display: none; }
}

#shopify-section-{{ sid }} .pf-plus {
  width: 13px; height: 13px;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}
#shopify-section-{{ sid }} .pf-col-title.open .pf-plus { transform: rotate(45deg); }

#shopify-section-{{ sid }} .pf-col-links {
  list-style: none;
  margin: 0; padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding-bottom 0.35s ease;
  padding-bottom: 0;
}
#shopify-section-{{ sid }} .pf-col-links.open { max-height: 500px; padding-bottom: 16px; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-col-links {
    max-height: none !important;
    overflow: visible !important;
    padding-bottom: 0 !important;
  }
}
#shopify-section-{{ sid }} .pf-col-links a {
  font-family: 'DM Sans';
  font-weight: 500;
  font-size: 16px;
  line-height: 19.6px;
  letter-spacing: -2%;
  color: #FFFFFF;
  text-decoration: none;
  display: block;
}
#shopify-section-{{ sid }} .pf-col-links a:hover { opacity: 1; text-decoration: underline; }

/* ══════════════════════
   ROW 3 — BOTTOM
══════════════════════ */
#shopify-section-{{ sid }} .pf-bottom {
  padding-top: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  text-align: center;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    padding-top: 40px;
    border-top: 1px solid rgba(255,255,255,0.2);
    gap: 40px;
  }
}

#shopify-section-{{ sid }} .pf-disclaimer {
  font-family: 'DM Sans';
  font-weight: 400;
  font-size: 16px;
  line-height: 20px;
  letter-spacing: 0.6px;
  margin: 0;
  max-width: 540px;
  color: #fff;
}

/* Social */
#shopify-section-{{ sid }} .pf-social {
  display: flex;
  {% comment %} flex-direction: column; {% endcomment %}
  align-items: center !important;
  gap: 32px;
  flex-shrink: 0;
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .pf-social { align-items: flex-end; } }

#shopify-section-{{ sid }} .pf-social-label {
  font-family: 'DM Sans';
  font-weight: 400;
  font-size: 16px;
  line-height: 100%;
  letter-spacing: 0.6px;
  color: #fff;
}
#shopify-section-{{ sid }} .pf-social-list {
  display: flex;
  align-items: center;
  gap: 22px;
}

#shopify-section-{{ sid }} .pf-soc-a:hover { background: rgba(255,255,255,0.25); }
#shopify-section-{{ sid }} .pf-soc-a img,
#shopify-section-{{ sid }} .pf-soc-a svg { width: 20px; height: 20px; display: block; color: currentColor; }
#shopify-section-{{ sid }} .pf-soc-text { display: none; }

/* Desktop: pills */
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-soc-a {
    width: 123px;
    height: auto;
    border-radius: 999px;
    padding: 6.5px 6.5px 6.5px 10px;
    gap: 13px;
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    justify-content: flex-start;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid #FFFFFF;
    text-decoration: none;
  }
  #shopify-section-{{ sid }} .pf-soc-a img,
  #shopify-section-{{ sid }} .pf-soc-a svg { width: 20px; height: 20px; }
  #shopify-section-{{ sid }} .pf-soc-text {
    display: inline;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }
}

/* ══════════════════════
   PAYMENT IMAGE — Mobile only
══════════════════════ */
#shopify-section-{{ sid }} .pf-payment {
  padding-top: 20px;
  width: 100%;
  display: flex;
  justify-content: center;
}
#shopify-section-{{ sid }} .pf-payment img { max-width: 100%; height: auto; display: block; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .pf-payment { display: none; } }

@media (max-width: 768px) {
  #shopify-section-{{ sid }} .pf-nl-heading {
    font-family: 'Georgia';
    font-weight: 400;
    font-size: 30px;
    line-height: 110%;
    letter-spacing: -4%;
    margin: 0 0 15px;
    color: #FFFFFF;
  }
  #shopify-section-{{ sid }} .pf-nl-sub {
    font-size: 14.6px;
    line-height: 18.8px;
    letter-spacing: -3%;
    margin: 0 0 25px;
  }
  #shopify-section-{{ sid }} .pf-disclaimer {
    display: none;
  }
  #shopify-section-{{ sid }} .pf-social {
    display: flex;
    align-items: center !important;
    gap: 17px;
    flex-shrink: 0;
    flex-direction: column;
  }
  #shopify-section-{{ sid }} .pf-soc-a {
    width: 100%;
  }
  #shopify-section-{{ sid }} .pf-soc-a img {
    width: 30px;
    height: 30px;
  }
  #shopify-section-{{ sid }} .pf-social-label {
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0;
    color: #fff;
  }
}
</style>

<section class="pf-section" {{ section.shopify_attributes }}>
  <div class="pf-wrap">

    {%- comment -%}── ROW 1: NEWSLETTER ──{%- endcomment -%}
    <div class="pf-newsletter">
      <div>
        {%- if s.news_heading != blank -%}
          <h2 class="pf-nl-heading">{{ s.news_heading }}</h2>
        {%- endif -%}
        {%- if s.news_subtext != blank -%}
          <p class="pf-nl-sub">{{ s.news_subtext }}</p>
        {%- endif -%}
      </div>
      <div id="pf-nl-wrap-{{ sid }}">
        {%- comment -%}
          Using form 'customer' — same as newsletter section.
          id: param removed from form tag — that caused the Liquid error before.
        {%- endcomment -%}
        {%- form 'customer', class: 'pf-nl-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            id="pf-nl-email-{{ sid }}"
            class="pf-nl-input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ s.input_placeholder | default: 'Email Address' }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            aria-required="true"
            required>
          <button type="submit" class="pf-nl-btn" name="commit" aria-label="Subscribe">
            <span class="pf-btn-text">{{ s.submit_label | default: 'JOIN NOW' }}</span>
            <span class="pf-btn-arrow" aria-hidden="true">
              {%- if s.arrow_icon_image != blank -%}
                {{ s.arrow_icon_image | image_url: width: 48 | image_tag: loading: 'lazy', width: 20, height: 20, alt: '', style: 'display:block;filter:brightness(10)' }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="13 6 19 12 13 18"/>
                </svg>
              {%- endif -%}
            </span>
          </button>
          {%- if form.errors -%}
            <p class="pf-nl-msg pf-nl-msg--error">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="pf-nl-msg pf-nl-msg--success">
              {{ s.success_message | default: "Thanks for subscribing!" }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%}── ROW 2: LOGO + COLUMNS ──{%- endcomment -%}
    <div class="pf-row2">

      <div class="pf-logo-wrap">
        {%- if s.logo_image != blank -%}
          <a href="{{ routes.root_url }}" class="pf-logo" aria-label="{{ shop.name }}">
            {{ s.logo_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="pf-logo">
            {{ s.logo_text | default: 'PEPTIQUES' }}<sup>{{ s.logo_mark | default: '®' }}</sup>
          </a>
        {%- endif -%}
      </div>

      {%- if link_col_count > 0 -%}
        <div class="pf-cols">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link_column' -%}
              <div class="pf-col" {{ block.shopify_attributes }}>
                <button class="pf-col-title" aria-expanded="false" type="button">
                  {{ block.settings.title }}
                  <svg class="pf-plus" viewBox="0 0 18 18" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="9" y1="2" x2="9" y2="16"/>
                    <line x1="2" y1="9" x2="16" y2="9"/>
                  </svg>
                </button>
                <ul class="pf-col-links">
                  {%- assign nav = linklists[block.settings.menu] -%}
                  {%- for link in nav.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%}── ROW 3: DISCLAIMER + SOCIAL ──{%- endcomment -%}
    <div class="pf-bottom">

      <p class="pf-disclaimer">
        {{ s.disclaimer_text | default: "These statements have not been reviewed by the FDA. This product is not meant to diagnose, treat, cure, or prevent any disease." }}
      </p>

      {%- if social_count > 0 -%}
        <div class="pf-social">
          {%- if s.social_label != blank -%}
            <span class="pf-social-label">{{ s.social_label }}</span>
          {%- endif -%}
          <div class="pf-social-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_link' -%}
                <a href="{{ block.settings.url | default: '#' }}"
                   class="pf-soc-a"
                   target="_blank" rel="noopener"
                   aria-label="{{ block.settings.label }}"
                   {{ block.shopify_attributes }}>
                  {%- if block.settings.icon_image != blank -%}
                    {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', width: 20, height: 20, alt: '' }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <circle cx="12" cy="12" r="7"/>
                    </svg>
                  {%- endif -%}
                  <span class="pf-soc-text">{{ block.settings.label }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    </div>

    {%- comment -%}── PAYMENT IMAGE: Mobile only — 1 combined image ──{%- endcomment -%}
    {%- if s.payment_image != blank -%}
      <div class="pf-payment">
        {{ s.payment_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Payment methods' }}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var sid = '{{ sid }}';

  function initAccordion() {
    var sec = document.getElementById('shopify-section-' + sid);
    if (!sec) return;
    var titles = sec.querySelectorAll('.pf-col-title');

    function isMobile() { return window.innerWidth <= 768; }

    function closeAll() {
      titles.forEach(function (btn) {
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        var ul = btn.nextElementSibling;
        if (ul) ul.classList.remove('open');
      });
    }

    titles.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!isMobile()) return;
        var ul = btn.nextElementSibling;
        var wasOpen = btn.classList.contains('open');
        closeAll();
        if (!wasOpen) {
          btn.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          if (ul) ul.classList.add('open');
        }
      });
    });

    window.addEventListener('resize', function () { if (!isMobile()) closeAll(); });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAccordion(); });
  } else {
    initAccordion();
  }
})();
</script>

