{% comment %}
  Footer — matches reference image structure exactly.
  Mobile (max 768px):
    - Newsletter full width (heading + subtext + email input + JOIN NOW pill button)
    - Accordion columns full width, one per row, + icon right
    - Social: only icon circles, no text, no pill border
    - Payment icons row at very bottom
    - Logo hidden on mobile
  Desktop (769px+):
    - Newsletter row (left heading+subtext, right input + circular arrow button)
    - Logo left + columns right (3 col grid)
    - Social: icon + text pills
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign link_col_count = 0
  assign social_count   = 0
  for block in section.blocks
    case block.type
      when 'link_column'
        assign link_col_count = link_col_count | plus: 1
      when 'social_link'
        assign social_count = social_count | plus: 1
    endcase
  endfor
-%}

<style>
/* ═══════════════════════════════
   SECTION BG
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-section {
  position: relative;
  color: {{ s.text_color | default: '#ffffff' }};
  background-color: {{ s.background_color | default: '#47184d' }};
  {% if s.background_image_desktop != blank %}
    background-image: url({{ s.background_image_desktop | image_url: width: 2400 }});
    background-size: cover;
    background-position: center center;
  {% endif %}
}
@media (max-width: 768px) {
  {% if s.background_image_mobile != blank %}
    #shopify-section-{{ sid }} .pf-section {
      background-image: url({{ s.background_image_mobile | image_url: width: 1200 }});
      background-size: cover;
      background-position: center center;
    }
  {% endif %}
}

/* ═══════════════════════════════
   WRAP
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-wrap {
  position: relative;
  z-index: 1;
  max-width: 1340px;
  margin-inline: auto;
  padding: {{ s.section_padding_top | default: 32 }}px
           {{ s.section_padding_x | default: 20 }}px
           {{ s.section_padding_bottom | default: 24 }}px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-wrap {
    padding: {{ s.section_padding_top_desktop | default: 64 }}px
             {{ s.section_padding_x_desktop | default: 80 }}px
             {{ s.section_padding_bottom_desktop | default: 48 }}px;
  }
}

/* ═══════════════════════════════
   ROW 1 — NEWSLETTER
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-row-news {
  padding-bottom: 24px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row-news {
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(0,1.2fr);
    align-items: center;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid {{ s.divider_color | default: 'rgba(255,255,255,0.2)' }};
  }
}

#shopify-section-{{ sid }} .pf-news-heading {
  font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
  color: inherit;
  margin: 0 0 8px;
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.02em;
  font-size: clamp(1.6rem, 5vw, 40px);
}
#shopify-section-{{ sid }} .pf-news-sub {
  font-family: 'DM Sans', system-ui, sans-serif;
  color: inherit;
  font-size: 14px;
  line-height: 1.5;
  margin: 0 0 20px;
  opacity: 0.85;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-news-sub { margin-bottom: 0; }
}

/* ───────────────────────────────
   EMAIL FORM
   Mobile: outlined input + white pill "JOIN NOW" button
   Desktop: outlined input + circular dark arrow button
─────────────────────────────── */
#shopify-section-{{ sid }} .pf-news-form {
  display: flex;
  align-items: stretch;
  gap: 0;
  width: 100%;
}

/* INPUT — shared base */
#shopify-section-{{ sid }} .pf-news-input {
  flex: 1 1 auto;
  background: transparent;
  border: 1.5px solid {{ s.input_border_color | default: 'rgba(255,255,255,0.55)' }};
  color: {{ s.text_color | default: '#ffffff' }};
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 15px;
  padding: 13px 16px;
  outline: 0;
  min-width: 0;
  /* Mobile: pill left side */
  border-radius: 50px 0 0 50px;
  border-right: none;
}
#shopify-section-{{ sid }} .pf-news-input::placeholder {
  color: {{ s.input_placeholder_color | default: 'rgba(255,255,255,0.6)' }};
}
#shopify-section-{{ sid }} .pf-news-input:focus {
  border-color: {{ s.input_focus_border_color | default: '#ffffff' }};
}

/* SUBMIT — Mobile: white pill "JOIN NOW" */
#shopify-section-{{ sid }} .pf-news-submit {
  flex-shrink: 0;
  background: {{ s.submit_background | default: '#ffffff' }};
  color: {{ s.submit_color | default: '#3f1c5c' }};
  border: none;
  padding: 13px 22px;
  border-radius: 0 50px 50px 0;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.04em;
  cursor: pointer;
  white-space: nowrap;
  transition: opacity 150ms;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}
#shopify-section-{{ sid }} .pf-news-submit:hover { opacity: 0.88; }

/* Submit text span — shown on mobile */
#shopify-section-{{ sid }} .pf-submit-text { display: inline; }
/* Submit arrow icon — hidden on mobile */
#shopify-section-{{ sid }} .pf-submit-arrow { display: none; }

/* DESKTOP overrides */
@media (min-width: 769px) {
  /* Input: rectangular left side */
  #shopify-section-{{ sid }} .pf-news-input {
    border-radius: 8px 0 0 8px;
    padding: 14px 18px;
    font-size: 14px;
    border: 1.5px solid {{ s.input_border_color | default: 'rgba(255,255,255,0.45)' }};
    border-right: none;
  }

  /* Submit: circular dark arrow button */
  #shopify-section-{{ sid }} .pf-news-submit {
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
    background: {{ s.submit_bg_desktop | default: '#1a0a2e' }};
    color: #ffffff;
    flex-shrink: 0;
    align-self: center;
    margin-left: -1px;
  }
  /* Hide text, show arrow */
  #shopify-section-{{ sid }} .pf-submit-text { display: none; }
  #shopify-section-{{ sid }} .pf-submit-arrow { display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ sid }} .pf-submit-arrow svg { width: 18px; height: 18px; }
}

#shopify-section-{{ sid }} .pf-news-message {
  margin-top: 8px; font-size: 13px;
  color: {{ s.success_color | default: '#cdb6e6' }};
}
#shopify-section-{{ sid }} .pf-news-error {
  margin-top: 8px; font-size: 13px;
  color: {{ s.error_color | default: '#ffb3b3' }};
}

/* ═══════════════════════════════
   ROW 2 — LOGO + COLUMNS
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-row-cols {
  padding: 0;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row-cols {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: flex-start;
    padding: 40px 0;
    border-bottom: 1px solid {{ s.divider_color | default: 'rgba(255,255,255,0.2)' }};
  }
}

/* Logo — hidden on mobile */
#shopify-section-{{ sid }} .pf-logo-wrap { display: none; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-logo-wrap { display: block; }
}
#shopify-section-{{ sid }} .pf-logo {
  font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
  color: inherit;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  font-size: clamp(2rem, 3vw, 3.5rem);
  text-decoration: none;
  display: inline-flex;
  align-items: baseline;
}
#shopify-section-{{ sid }} .pf-logo sup {
  font-size: 0.35em;
  vertical-align: super;
  margin-left: 0.1em;
}
#shopify-section-{{ sid }} .pf-logo img {
  max-width: 160px;
  height: auto;
  display: block;
}

/* ═══════════════════════════════
   ACCORDION COLUMNS
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-cols { width: 100%; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-cols {
    display: grid;
    grid-template-columns: repeat({{ link_col_count | at_least: 1 }}, minmax(0,1fr));
    gap: 24px;
  }
}

/* Each column */
#shopify-section-{{ sid }} .pf-col {
  border-bottom: 1px solid {{ s.divider_color | default: 'rgba(255,255,255,0.2)' }};
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-col { border-bottom: none; }
}

/* Title row */
#shopify-section-{{ sid }} .pf-col-title {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.2;
  color: {{ s.col_title_color | default: '#ffffff' }};
  margin: 0;
  padding: 16px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
  letter-spacing: 0;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-col-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    cursor: default;
    padding: 0 0 14px;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .pf-col-title .pf-acc-icon { display: none; }
}

/* Plus/X icon */
#shopify-section-{{ sid }} .pf-acc-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition: transform 300ms ease;
}
#shopify-section-{{ sid }} .pf-col-title.is-open .pf-acc-icon {
  transform: rotate(45deg);
}

/* List */
#shopify-section-{{ sid }} .pf-col-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  overflow: hidden;
  max-height: 0;
  transition: max-height 350ms ease, padding-bottom 350ms ease;
  padding-bottom: 0;
}
#shopify-section-{{ sid }} .pf-col-list.is-open {
  max-height: 600px;
  padding-bottom: 16px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-col-list {
    max-height: none !important;
    overflow: visible !important;
    padding-bottom: 0 !important;
    transition: none !important;
  }
}
#shopify-section-{{ sid }} .pf-col-list a {
  color: inherit;
  text-decoration: none;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
  opacity: 0.85;
  display: block;
}
#shopify-section-{{ sid }} .pf-col-list a:hover {
  opacity: 1;
  text-decoration: underline;
}

/* ═══════════════════════════════
   ROW 3 — BOTTOM: DISCLAIMER + SOCIAL
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-row-bottom {
  padding-top: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  text-align: center;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    padding-top: 32px;
    border-top: 1px solid {{ s.divider_color | default: 'rgba(255,255,255,0.2)' }};
  }
}

#shopify-section-{{ sid }} .pf-disclaimer {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 12px;
  line-height: 1.6;
  color: inherit;
  opacity: 0.75;
  margin: 0;
  max-width: 480px;
}

/* ───────────────────────────────
   SOCIAL
─────────────────────────────── */
#shopify-section-{{ sid }} .pf-social-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-social-wrap { align-items: flex-end; }
}
#shopify-section-{{ sid }} .pf-social-label {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px;
  color: inherit;
  opacity: 0.8;
}
#shopify-section-{{ sid }} .pf-social-list {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Mobile: icon only circles */
#shopify-section-{{ sid }} .pf-social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 1.5px solid rgba(255,255,255,0.35);
  color: inherit;
  text-decoration: none;
  transition: background 150ms;
  flex-shrink: 0;
}
#shopify-section-{{ sid }} .pf-social-link:hover { background: rgba(255,255,255,0.25); }
#shopify-section-{{ sid }} .pf-social-link img {
  width: 20px; height: 20px;
  object-fit: contain; display: block;
}
#shopify-section-{{ sid }} .pf-social-link svg {
  width: 20px; height: 20px;
  color: currentColor;
}
#shopify-section-{{ sid }} .pf-social-link-text { display: none; }

/* Desktop: pill with icon + text */
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-social-link {
    width: auto;
    height: auto;
    border-radius: 999px;
    padding: 7px 14px 7px 10px;
    gap: 8px;
    justify-content: flex-start;
    background: rgba(255,255,255,0.1);
    border: 1px solid {{ s.social_border_color | default: 'rgba(255,255,255,0.35)' }};
  }
  #shopify-section-{{ sid }} .pf-social-link img { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .pf-social-link svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .pf-social-link-text {
    display: inline;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }
}

/* ═══════════════════════════════
   PAYMENT ICONS ROW
   Mobile only (shown below social)
═══════════════════════════════ */
#shopify-section-{{ sid }} .pf-payment-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding-top: 16px;
  border-top: 1px solid {{ s.divider_color | default: 'rgba(255,255,255,0.2)' }};
  width: 100%;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-payment-row { display: none; }
}
#shopify-section-{{ sid }} .pf-payment-icon {
  height: 26px;
  width: auto;
  border-radius: 4px;
  display: block;
  filter: brightness(1);
}
</style>

<section class="pf-section" {{ section.shopify_attributes }}>
  <div class="pf-wrap">

    {%- comment -%}═══ ROW 1: NEWSLETTER ═══{%- endcomment -%}
    <div class="pf-row-news">
      <div class="pf-news-text">
        {% if s.news_heading != blank %}
          <h2 class="pf-news-heading">{{ s.news_heading }}</h2>
        {% endif %}
        {% if s.news_subtext != blank %}
          <p class="pf-news-sub">{{ s.news_subtext }}</p>
        {% endif %}
      </div>

      <div class="pf-news-form-wrap">
        {%- form 'customer', class: 'pf-news-form', id: 'pf-news-form-' | append: sid -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="pf-news-input"
            id="pf-news-email-{{ sid }}"
            placeholder="{{ s.input_placeholder | default: 'Email Address' }}"
            autocomplete="email"
            required
            aria-label="{{ s.input_aria_label | default: 'Email address' }}">
          <button type="submit" class="pf-news-submit" aria-label="{{ s.submit_aria_label | default: 'Subscribe' }}">
            {%- comment -%} Mobile: text label {%- endcomment -%}
            <span class="pf-submit-text">{{ s.submit_label | default: 'JOIN NOW' }}</span>
            {%- comment -%} Desktop: arrow icon {%- endcomment -%}
            <span class="pf-submit-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="13 6 19 12 13 18"/>
              </svg>
            </span>
          </button>
          {%- if form.posted_successfully? -%}
            <p class="pf-news-message">{{ s.success_message | default: "Thanks for subscribing!" }}</p>
          {%- elsif form.errors -%}
            <p class="pf-news-error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%}═══ ROW 2: LOGO (desktop) + ACCORDION COLUMNS ═══{%- endcomment -%}
    <div class="pf-row-cols">

      {%- comment -%} Logo — desktop only {%- endcomment -%}
      <div class="pf-logo-wrap">
        {% if s.logo_image != blank %}
          <a href="{{ routes.root_url }}" class="pf-logo" aria-label="{{ shop.name }}">
            {{
              s.logo_image
              | image_url: width: 400
              | image_tag: loading: 'lazy', widths: '160,320,400', alt: shop.name
            }}
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="pf-logo">
            {{ s.logo_text | default: 'PEPTIQUES' }}<sup>{{ s.logo_mark | default: '®' }}</sup>
          </a>
        {% endif %}
      </div>

      {%- comment -%} Link Columns {%- endcomment -%}
      {% if link_col_count > 0 %}
        <div class="pf-cols">
          {% for block in section.blocks %}
            {% if block.type == 'link_column' %}
              <div class="pf-col" {{ block.shopify_attributes }}>
                <h3 class="pf-col-title" role="button" aria-expanded="false" tabindex="0">
                  {{ block.settings.title }}
                  <svg class="pf-acc-icon" viewBox="0 0 18 18" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round"
                       aria-hidden="true">
                    <line x1="9" y1="2" x2="9" y2="16"/>
                    <line x1="2" y1="9" x2="16" y2="9"/>
                  </svg>
                </h3>
                <ul class="pf-col-list">
                  {%- assign nav = linklists[block.settings.menu] -%}
                  {% for link in nav.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>

    {%- comment -%}═══ ROW 3: DISCLAIMER + SOCIAL ═══{%- endcomment -%}
    <div class="pf-row-bottom">

      <p class="pf-disclaimer">
        {{ s.disclaimer_text | default: "These statements have not been reviewed by the FDA. This product is not meant to diagnose, treat, cure, or prevent any disease." }}
      </p>

      {% if social_count > 0 %}
        <div class="pf-social-wrap">
          {% if s.social_label != blank %}
            <span class="pf-social-label">{{ s.social_label }}</span>
          {% endif %}
          <div class="pf-social-list">
            {% for block in section.blocks %}
              {% if block.type == 'social_link' %}
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  class="pf-social-link"
                  rel="noopener"
                  target="_blank"
                  aria-label="{{ block.settings.label }}"
                  {{ block.shopify_attributes }}>
                  {% if block.settings.icon_image != blank %}
                    {{
                      block.settings.icon_image
                      | image_url: width: 48
                      | image_tag: loading: 'lazy', width: 20, height: 20, alt: ''
                    }}
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <circle cx="12" cy="12" r="6"/>
                    </svg>
                  {% endif %}
                  <span class="pf-social-link-text">{{ block.settings.label }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

    </div>

    {%- comment -%}═══ PAYMENT ICONS — Mobile only ═══{%- endcomment -%}
    {% unless shop.enabled_payment_types == empty %}
      <div class="pf-payment-row">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'pf-payment-icon' }}
        {% endfor %}
      </div>
    {% endunless %}

  </div>
</section>

<script>
(function() {
  function initAcc() {
    var section = document.querySelector('#shopify-section-{{ sid }}');
    if (!section) return;
    var titles = section.querySelectorAll('.pf-col-title');

    function isMobile() { return window.innerWidth <= 768; }

    function closeAll() {
      titles.forEach(function(t) {
        t.classList.remove('is-open');
        t.setAttribute('aria-expanded', 'false');
        var list = t.nextElementSibling;
        if (list) list.classList.remove('is-open');
      });
    }

    titles.forEach(function(title) {
      title.addEventListener('click', function() {
        if (!isMobile()) return;
        var list = title.nextElementSibling;
        var isOpen = title.classList.contains('is-open');
        closeAll();
        if (!isOpen) {
          title.classList.add('is-open');
          title.setAttribute('aria-expanded', 'true');
          if (list) list.classList.add('is-open');
        }
      });
      title.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          title.click();
        }
      });
    });

    window.addEventListener('resize', function() {
      if (!isMobile()) closeAll();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAcc);
  } else {
    initAcc();
  }
})();
</script>

{% schema %}
{
  "name": "Footer (Figma)",
  "tag": "section",
  "class": "pf-footer",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color",         "label": "Fallback bg color",       "default": "#47184d" },
    { "type": "color", "id": "text_color",               "label": "Text color",               "default": "#ffffff" },
    { "type": "color", "id": "divider_color",            "label": "Divider color",            "default": "#ffffff" },
    { "type": "color", "id": "col_title_color",          "label": "Column title color",       "default": "#ffffff" },
    { "type": "color", "id": "input_border_color",       "label": "Input border",             "default": "#bfd2dd" },
    { "type": "color", "id": "input_focus_border_color", "label": "Input focus border",       "default": "#ffffff" },
