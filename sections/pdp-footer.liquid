{% comment %}
  Footer — newsletter, logo + link columns (linklist), social (image_picker icons).
  Mobile (max 768px):
    - Newsletter stacked
    - Logo + mobile-only image side by side
    - Link columns: seedhi list, koi accordion nahi
    - Social: label text + icon image dono dikhein
    - Alag mobile background image
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign link_col_count = 0
  assign social_count   = 0
  for block in section.blocks
    case block.type
      when 'link_column'
        assign link_col_count = link_col_count | plus: 1
      when 'social_link'
        assign social_count = social_count | plus: 1
    endcase
  endfor
-%}

<style>
/* ════════════════════════════════════════
   SECTION — background directly on section
   ════════════════════════════════════════ */
#shopify-section-{{ sid }} .pf-section {
  position: relative;
  overflow: hidden;
  color: {{ s.text_color | default: '#ffffff' }};
  background-color: {{ s.background_color | default: '#47184d' }};
  {% if s.background_image_desktop != blank %}
    background-image: url({{ s.background_image_desktop | image_url: width: 2400 }});
    background-size: cover;
    background-position: center center;
  {% endif %}
}
@media (max-width: 768px) {
  {% if s.background_image_mobile != blank %}
    #shopify-section-{{ sid }} .pf-section {
      background-image: url({{ s.background_image_mobile | image_url: width: 1200 }});
      background-size: cover;
      background-position: center center;
    }
  {% endif %}
}

/* ════════════════════════════════════════
   WRAP
   ════════════════════════════════════════ */
#shopify-section-{{ sid }} .pf-wrap {
  position: relative;
  z-index: 1;
  max-width: 1340px;
  margin-inline: auto;
  padding: {{ s.section_padding_top | default: 40 }}px
           {{ s.section_padding_x | default: 20 }}px
           {{ s.section_padding_bottom | default: 32 }}px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-wrap {
    padding: {{ s.section_padding_top_desktop | default: 64 }}px
             {{ s.section_padding_x_desktop | default: 80 }}px
             {{ s.section_padding_bottom_desktop | default: 48 }}px;
  }
}

/* ════════════════════════════════════════
   ROWS
   ════════════════════════════════════════ */
#shopify-section-{{ sid }} .pf-row {
  padding: {{ s.row_padding_y | default: 28 }}px 0;
}
#shopify-section-{{ sid }} .pf-row + .pf-row {
  border-top: 1px solid {{ s.divider_color | default: 'rgba(255,255,255,0.18)' }};
}

/* ════════════════════════════════════════
   ROW 1 — NEWSLETTER
   ════════════════════════════════════════ */
#shopify-section-{{ sid }} .pf-row--news {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row--news {
    grid-template-columns: minmax(0,1fr) minmax(0,1.4fr);
    align-items: center;
    gap: 32px;
  }
}
#shopify-section-{{ sid }} .pf-news-heading {
  font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
  color: inherit;
  margin: 0 0 12px;
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.04em;
  font-size: clamp(1.6rem, 5vw, 46px);
}
#shopify-section-{{ sid }} .pf-news-sub {
  color: {{ s.sub_color | default: '#ffffff' }};
  font-size: 14px;
  line-height: 1.5;
  margin: 0;
}
#shopify-section-{{ sid }} .pf-news-form {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}
#shopify-section-{{ sid }} .pf-news-input {
  flex: 1 1 auto;
  background: transparent;
  border: 1px solid {{ s.input_border_color | default: '#bfd2dd' }};
  color: {{ s.text_color | default: '#ffffff' }};
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.2;
  padding: 13px 54px 13px 16px;
  border-radius: 10px;
  outline: 0;
  min-width: 0;
  width: 100%;
}
#shopify-section-{{ sid }} .pf-news-input::placeholder {
  color: {{ s.input_placeholder_color | default: 'rgba(255,255,255,0.6)' }};
}
#shopify-section-{{ sid }} .pf-news-input:focus {
  border-color: {{ s.input_focus_border_color | default: '#ffffff' }};
}
#shopify-section-{{ sid }} .pf-news-submit {
  position: absolute;
  right: 4px;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 0;
  cursor: pointer;
  background: {{ s.submit_background | default: '#ffffff' }};
  color: {{ s.submit_color | default: '#3f1c5c' }};
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 160ms ease;
  flex-shrink: 0;
}
#shopify-section-{{ sid }} .pf-news-submit:active { transform: translateY(-50%) scale(0.94); }
#shopify-section-{{ sid }} .pf-news-submit svg { width: 14px; height: 14px; }
#shopify-section-{{ sid }} .pf-news-message {
  margin-top: 8px; font-size: 13px;
  color: {{ s.success_color | default: '#cdb6e6' }};
}
#shopify-section-{{ sid }} .pf-news-error {
  margin-top: 8px; font-size: 13px;
  color: {{ s.error_color | default: '#ffb3b3' }};
}

/* ════════════════════════════════════════
   ROW 2 — LOGO + COLUMNS
   ════════════════════════════════════════ */
#shopify-section-{{ sid }} .pf-row--cols {
  display: flex;
  flex-direction: column;
  gap: 28px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row--cols {
    flex-direction: row;
    align-items: flex-start;
    gap: 48px;
  }
}

/* Logo side */
#shopify-section-{{ sid }} .pf-logo-side {
  flex-shrink: 0;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-logo-side { width: 220px; }
}

/* On mobile: logo + mobile image sit side by side */
#shopify-section-{{ sid }} .pf-logo-mobile-row {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

/* Mobile-only image — hidden on desktop */
#shopify-section-{{ sid }} .pf-mobile-only-img {
  display: block;
  max-width: 110px;
  height: auto;
  border-radius: 6px;
  object-fit: contain;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-mobile-only-img { display: none !important; }
}

/* Logo */
#shopify-section-{{ sid }} .pf-logo {
  font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
  color: inherit;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  font-size: clamp(2rem, 5vw, 5rem);
  display: inline-flex;
  align-items: baseline;
  text-decoration: none;
}
#shopify-section-{{ sid }} .pf-logo sup {
  font-size: 0.35em;
  line-height: 1;
  margin-left: 0.1em;
  vertical-align: super;
}
#shopify-section-{{ sid }} .pf-logo img {
  max-width: 160px;
  height: auto;
  display: block;
}

/* Columns side */
#shopify-section-{{ sid }} .pf-cols-side {
  flex: 1;
  min-width: 0;
}
#shopify-section-{{ sid }} .pf-cols {
  display: grid;
  grid-template-columns: repeat({{ link_col_count | at_least: 2 }}, minmax(0,1fr));
  gap: 20px 12px;
}

/* Column title */
#shopify-section-{{ sid }} .pf-col-title {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: {{ s.col_title_color | default: '#ffffff' }};
  margin: 0 0 12px;
}

/* ─── ANTI-ACCORDION: force list always visible ─── */
#shopify-section-{{ sid }} .pf-col-list,
#shopify-section-{{ sid }} .pf-col-list[aria-hidden],
#shopify-section-{{ sid }} .pf-col-list[hidden] {
  list-style: none !important;
  padding: 0 !important;
  margin: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 9px !important;
  max-height: none !important;
  height: auto !important;
  overflow: visible !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}
#shopify-section-{{ sid }} .pf-col-list li {
  display: list-item !important;
  visibility: visible !important;
  opacity: 1 !important;
}
#shopify-section-{{ sid }} .pf-col-list a {
  color: inherit !important;
  text-decoration: none;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}
#shopify-section-{{ sid }} .pf-col-list a:hover { text-decoration: underline; }

/* ════════════════════════════════════════
   ROW 3 — DISCLAIMER + SOCIAL
   ════════════════════════════════════════ */
#shopify-section-{{ sid }} .pf-row--bottom {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-row--bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
}
#shopify-section-{{ sid }} .pf-disclaimer {
  color: {{ s.sub_color | default: '#ffffff' }};
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 12px;
  line-height: 1.6;
  letter-spacing: 0.01em;
  margin: 0;
  max-width: 480px;
}

/* Social */
#shopify-section-{{ sid }} .pf-social-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .pf-social-wrap { align-items: flex-end; }
}
#shopify-section-{{ sid }} .pf-social-label {
  color: {{ s.sub_color | default: '#ffffff' }};
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px;
  letter-spacing: 0.03em;
}
#shopify-section-{{ sid }} .pf-social-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
#shopify-section-{{ sid }} .pf-social-link {
  display: inline-flex !important;
  align-items: center;
  gap: 8px;
  color: inherit;
  text-decoration: none;
  border: 1px solid {{ s.social_border_color | default: 'rgba(255,255,255,0.4)' }};
  padding: 6px 12px 6px 8px;
  border-radius: 999px;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  transition: border-color 150ms;
}
#shopify-section-{{ sid }} .pf-social-link:hover {
  border-color: {{ s.text_color | default: '#ffffff' }};
}
#shopify-section-{{ sid }} .pf-social-icon {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
#shopify-section-{{ sid }} .pf-social-icon img {
  width: 14px;
  height: 14px;
  object-fit: contain;
  display: block;
}
#shopify-section-{{ sid }} .pf-social-icon svg {
  width: 11px; height: 11px;
  color: currentColor;
}
/* Label text — always show */
#shopify-section-{{ sid }} .pf-social-link-text {
  display: inline !important;
  visibility: visible !important;
  opacity: 1 !important;
  max-width: none !important;
  width: auto !important;
  overflow: visible !important;
}
</style>

<section class="pf-section" {{ section.shopify_attributes }}>
  <div class="pf-wrap">

    {%- comment -%}═══ ROW 1: NEWSLETTER ═══{%- endcomment -%}
    <div class="pf-row pf-row--news">
      <div>
        {% if s.news_heading != blank %}
          <h2 class="pf-news-heading">{{ s.news_heading }}</h2>
        {% endif %}
        {% if s.news_subtext != blank %}
          <p class="pf-news-sub">{{ s.news_subtext }}</p>
        {% endif %}
      </div>
      <div>
        {%- form 'customer', class: 'pf-news-form', id: 'pf-news-form-' | append: sid -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="pf-news-input"
            id="pf-news-email-{{ sid }}"
            placeholder="{{ s.input_placeholder | default: 'Enter Your Email' }}"
            autocomplete="email"
            required
            aria-label="{{ s.input_aria_label | default: 'Email address' }}">
          <button type="submit" class="pf-news-submit" aria-label="{{ s.submit_aria_label | default: 'Subscribe' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
          {%- if form.posted_successfully? -%}
            <p class="pf-news-message">{{ s.success_message | default: "Thanks for subscribing!" }}</p>
          {%- elsif form.errors -%}
            <p class="pf-news-error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%}═══ ROW 2: LOGO + COLUMNS ═══{%- endcomment -%}
    <div class="pf-row pf-row--cols">

      <div class="pf-logo-side">
        <div class="pf-logo-mobile-row">

          {%- comment -%} Logo {%- endcomment -%}
          {% if s.logo_image != blank %}
            <a href="{{ routes.root_url }}" class="pf-logo" aria-label="{{ shop.name }}">
              {{
                s.logo_image
                | image_url: width: 600
                | image_tag: loading: 'lazy', widths: '200,400,600', alt: shop.name
              }}
            </a>
          {% else %}
            <a href="{{ routes.root_url }}" class="pf-logo">
              {{ s.logo_text | default: 'PEPTIQUES' }}<sup>{{ s.logo_mark | default: '®' }}</sup>
            </a>
          {% endif %}

          {%- comment -%} Mobile-only image — shows beside logo on mobile, hidden on desktop {%- endcomment -%}
          {% if s.mobile_logo_image != blank %}
            {{
              s.mobile_logo_image
              | image_url: width: 300
              | image_tag:
                  class: 'pf-mobile-only-img',
                  loading: 'lazy',
                  widths: '110,220,300',
                  alt: s.mobile_logo_image_alt | default: ''
            }}
          {% endif %}

        </div>
      </div>

      {% if link_col_count > 0 %}
        <div class="pf-cols-side">
          <div class="pf-cols">
            {% for block in section.blocks %}
              {% if block.type == 'link_column' %}
                <div {{ block.shopify_attributes }}>
                  <h3 class="pf-col-title">{{ block.settings.title }}</h3>
                  <ul class="pf-col-list">
                    {%- assign nav = linklists[block.settings.menu] -%}
                    {% for link in nav.links %}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

    </div>

    {%- comment -%}═══ ROW 3: DISCLAIMER + SOCIAL ═══{%- endcomment -%}
    <div class="pf-row pf-row--bottom">

      <p class="pf-disclaimer">
        {{ s.disclaimer_text | default: "These statements have not been reviewed by the FDA. This product is not meant to diagnose, treat, cure, or prevent any disease." }}
      </p>

      {% if social_count > 0 %}
        <div class="pf-social-wrap">
          {% if s.social_label != blank %}
            <span class="pf-social-label">{{ s.social_label }}</span>
          {% endif %}
          <div class="pf-social-list">
            {% for block in section.blocks %}
              {% if block.type == 'social_link' %}
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  class="pf-social-link"
                  rel="noopener"
                  target="_blank"
                  {{ block.shopify_attributes }}>
                  <span class="pf-social-icon">
                    {% if block.settings.icon_image != blank %}
                      {{
                        block.settings.icon_image
                        | image_url: width: 48
                        | image_tag: loading: 'lazy', width: 14, height: 14, alt: ''
                      }}
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <circle cx="12" cy="12" r="5"/>
                      </svg>
                    {% endif %}
                  </span>
                  <span class="pf-social-link-text">{{ block.settings.label }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Footer (Figma)",
  "tag": "section",
  "class": "pf-footer",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color",         "label": "Fallback bg color (no image)", "default": "#47184d" },
    { "type": "color", "id": "text_color",               "label": "Text color",                   "default": "#ffffff" },
    { "type": "color", "id": "sub_color",                "label": "Subtle text color",             "default": "#ffffff" },
    { "type": "color", "id": "divider_color",            "label": "Row divider color",             "default": "#ffffff" },
    { "type": "color", "id": "col_title_color",          "label": "Column title color",            "default": "#ffffff" },
    { "type": "color", "id": "input_border_color",       "label": "Input border",                  "default": "#bfd2dd" },
    { "type": "color", "id": "input_focus_border_color", "label": "Input focus border",            "default": "#ffffff" },
    { "type": "color", "id": "input_placeholder_color",  "label": "Input placeholder",             "default": "#bba0d4" },
    { "type": "color", "id": "submit_background",        "label": "Submit button bg",              "default": "#ffffff" },
    { "type": "color", "id": "submit_color",             "label": "Submit button icon",            "default": "#3f1c5c" },
    { "type": "color", "id": "success_color",            "label": "Success message color",         "default": "#cdb6e6" },
    { "type": "color", "id": "error_color",              "label": "Error message color",           "default": "#ffb3b3" },
    { "type": "color", "id": "social_border_color",      "label": "Social link border",            "default": "#9b87b3" },

    { "type": "header", "content": "Background Images (No overlay)" },
    { "type": "image_picker", "id": "background_image_desktop", "label": "Background — Desktop (768px se upar)" },
    { "type": "image_picker", "id": "background_image_mobile",  "label": "Background — Mobile (768px se neeche)" },

    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (text ko override karta hai)" },
    { "type": "text",         "id": "logo_text",  "label": "Logo text (agar image nahi)", "default": "PEPTIQUES" },
    { "type": "text",         "id": "logo_mark",  "label": "Logo trademark symbol",       "default": "®" },

    { "type": "header", "content": "Mobile Image (logo row, desktop hidden)" },
    { "type": "image_picker", "id": "mobile_logo_image",     "label": "Mobile-only image" },
    { "type": "text",         "id": "mobile_logo_image_alt", "label": "Image alt text", "default": "Footer image" },

    { "type": "header", "content": "Newsletter" },
    { "type": "text",     "id": "news_heading",      "label": "Heading",           "default": "Sign Up For Our Newsletter" },
    { "type": "textarea", "id": "news_subtext",      "label": "Subtext",           "default": "Exclusive deals for subscribers if you register from this website" },
    { "type": "text",     "id": "input_placeholder", "label": "Input placeholder", "default": "Enter Your Email" },
    { "type": "text",     "id": "input_aria_label",  "label": "Input aria-label",  "default": "Email address" },
    { "type": "text",     "id": "submit_aria_label", "label": "Submit aria-label", "default": "Subscribe" },
    { "type": "text",     "id": "success_message",   "label": "Success message",   "default": "Thanks for subscribing!" },

    { "type": "header", "content": "Disclaimer & Social" },
    { "type": "textarea", "id": "disclaimer_text", "label": "Disclaimer text", "default": "These statements have not been reviewed by the FDA. This product is not meant to diagnose, treat, cure, or prevent any disease." },
    { "type": "text",     "id": "social_label",    "label": "Social section label", "default": "Check our Social Media" },

    { "type": "header", "content": "Typography" },
    { "type": "text", "id": "heading_font_family", "label": "Heading/logo font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",            "label": "Padding top (Mobile)",     "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "section_padding_bottom",         "label": "Padding bottom (Mobile)",  "min": 0, "max": 200, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "section_padding_x",              "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "section_padding_top_desktop",    "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "section_padding_bottom_desktop", "label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x_desktop",      "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "row_padding_y",                  "label": "Row vertical padding",     "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "EXPLORE"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu (Online Store Navigation se select karo)"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label text (e.g. Facebook)",
          "default": "Facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (PNG/SVG ~32x32px)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Footer (Figma)",
