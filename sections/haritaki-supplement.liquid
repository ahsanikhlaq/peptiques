{% comment %}
  Haritaki — "isn't just a supplement" benefits section.
  Built from Figma: Trypeptiques 2.0 / PDP Page (12 May 2026).
{% endcomment %}

{%- liquid
  assign heading_font   = section.settings.headingFontFamily_text   | default: 'Georgia, "Times New Roman", serif'
  assign body_font      = section.settings.bodyFontFamily_text      | default: '"DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif'
  assign section_id     = section.id
  assign s              = section.settings
-%}

<style>
  :root {
    --hs-{{ section_id }}-pt: {{ s.sectionPaddingTop_responsive_range_mobile    | default: s.sectionPaddingTop_responsive_range_desktop    | default: 48 }}px;
    --hs-{{ section_id }}-pb: {{ s.sectionPaddingBottom_responsive_range_mobile | default: s.sectionPaddingBottom_responsive_range_desktop | default: 48 }}px;
    --hs-{{ section_id }}-pl: {{ s.sectionPaddingLeft_responsive_range_mobile   | default: s.sectionPaddingLeft_responsive_range_desktop   | default: 16 }}px;
    --hs-{{ section_id }}-pr: {{ s.sectionPaddingRight_responsive_range_mobile  | default: s.sectionPaddingRight_responsive_range_desktop  | default: 16 }}px;
    --hs-{{ section_id }}-inner-pt: {{ s.innerPaddingTop_responsive_range_mobile    | default: s.innerPaddingTop_responsive_range_desktop    | default: 32 }}px;
    --hs-{{ section_id }}-inner-pb: {{ s.innerPaddingBottom_responsive_range_mobile | default: s.innerPaddingBottom_responsive_range_desktop | default: 32 }}px;
    --hs-{{ section_id }}-inner-px: {{ s.innerPaddingX_responsive_range_mobile      | default: s.innerPaddingX_responsive_range_desktop      | default: 20 }}px;
  }

  @media (min-width: 768px) {
    :root {
      --hs-{{ section_id }}-pt: {{ s.sectionPaddingTop_responsive_range_desktop    | default: 80 }}px;
      --hs-{{ section_id }}-pb: {{ s.sectionPaddingBottom_responsive_range_desktop | default: 80 }}px;
      --hs-{{ section_id }}-pl: {{ s.sectionPaddingLeft_responsive_range_desktop   | default: 50 }}px;
      --hs-{{ section_id }}-pr: {{ s.sectionPaddingRight_responsive_range_desktop  | default: 50 }}px;
      --hs-{{ section_id }}-inner-pt: {{ s.innerPaddingTop_responsive_range_desktop    | default: 80 }}px;
      --hs-{{ section_id }}-inner-pb: {{ s.innerPaddingBottom_responsive_range_desktop | default: 80 }}px;
      --hs-{{ section_id }}-inner-px: {{ s.innerPaddingX_responsive_range_desktop      | default: 60 }}px;
    }
  }

  #shopify-section-{{ section_id }} .hs-section{
    padding-top: var(--hs-{{ section_id }}-pt);
    padding-bottom: var(--hs-{{ section_id }}-pb);
    padding-left: var(--hs-{{ section_id }}-pl);
    padding-right: var(--hs-{{ section_id }}-pr);
    background: {{ s.outerBackground_color | default: '#ffffff' }};
  }

  #shopify-section-{{ section_id }} .hs-card{
    --hs-grad-from: {{ s.gradientFrom_color | default: '#5a2a78' }};
    --hs-grad-via:  {{ s.gradientVia_color  | default: '#3f1c5c' }};
    --hs-grad-to:   {{ s.gradientTo_color   | default: '#2a1442' }};
    width: 100%;
    max-width: {{ s.cardMaxWidth_number | default: 1340 }}px;
    margin-inline: auto;
    border-radius: {{ s.cardRadius_number | default: 24 }}px;
    padding-top: var(--hs-{{ section_id }}-inner-pt);
    padding-bottom: var(--hs-{{ section_id }}-inner-pb);
    padding-left: var(--hs-{{ section_id }}-inner-px);
    padding-right: var(--hs-{{ section_id }}-inner-px);
    color: #fff;
    overflow: hidden;
    background-color: var(--hs-grad-via);
    background-size: cover;
    background-position: {{ s.cardBackgroundPosition_text | default: 'center center' }};
    background-repeat: no-repeat;
  }

  {%- assign hs_overlay = s.cardBackgroundOverlay_color | default: '#2a1442' -%}
  {%- assign hs_desktop_bg = s.cardBackgroundImage_desktop_picker | default: s.cardBackgroundImage_picker -%}
  {%- assign hs_mobile_bg  = s.cardBackgroundImage_mobile_picker  | default: hs_desktop_bg -%}

  /* Mobile (and default) card background */
  #shopify-section-{{ section_id }} .hs-card{
    {%- if hs_mobile_bg != blank -%}
      background-image:
        linear-gradient({{ hs_overlay }}, {{ hs_overlay }}),
        url({{ hs_mobile_bg | image_url: width: 900 }});
    {%- else -%}
      background-image:
        radial-gradient(ellipse 80% 60% at 85% 30%, rgba(255,255,255,0.10), transparent 60%),
        radial-gradient(ellipse 70% 50% at 10% 85%, rgba(255,255,255,0.06), transparent 65%),
        linear-gradient(135deg, var(--hs-grad-from) 0%, var(--hs-grad-via) 55%, var(--hs-grad-to) 100%);
    {%- endif -%}
  }

  /* Desktop override */
  @media (min-width: 1024px){
    #shopify-section-{{ section_id }} .hs-card{
      {%- if hs_desktop_bg != blank -%}
        background-image:
          linear-gradient({{ hs_overlay }}, {{ hs_overlay }}),
          url({{ hs_desktop_bg | image_url: width: 1800 }});
      {%- else -%}
        background-image:
          radial-gradient(ellipse 80% 60% at 85% 30%, rgba(255,255,255,0.10), transparent 60%),
          radial-gradient(ellipse 70% 50% at 10% 85%, rgba(255,255,255,0.06), transparent 65%),
          linear-gradient(135deg, var(--hs-grad-from) 0%, var(--hs-grad-via) 55%, var(--hs-grad-to) 100%);
      {%- endif -%}
    }
  }

  #shopify-section-{{ section_id }} .hs-grid{
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section_id }} .hs-grid{
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 48px;
    }
  }

  #shopify-section-{{ section_id }} .hs-heading{
    font-family: {{ heading_font }};
    color: {{ s.headingTextColor_color | default: '#ffffff' }};
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    font-size: clamp(1.75rem, 2.4vw + 1rem, {{ s.headingSize_desktop_number | default: 46 }}px);
  }

  #shopify-section-{{ section_id }} .hs-description{
    font-family: {{ body_font }};
    color: {{ s.descriptionTextColor_color | default: 'rgba(255,255,255,0.78)' }};
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    max-width: 56ch;
    font-size: clamp(0.9375rem, 0.3vw + 0.85rem, {{ s.descriptionSize_desktop_number | default: 15 }}px);
  }

  #shopify-section-{{ section_id }} .hs-list{
    display: flex;
    flex-direction: column;
    gap: {{ s.itemGap_number | default: 10 }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section_id }} .hs-item{
    background: {{ s.itemBackground_color | default: 'rgba(255,255,255,0.96)' }};
    color: #1d1027;
    border-radius: {{ s.itemRadius_number | default: 14 }}px;
    box-shadow: 0 1px 0 rgba(255,255,255,0.4) inset, 0 4px 16px rgba(0,0,0,0.08);
    overflow: hidden;
  }

  #shopify-section-{{ section_id }} .hs-item-summary{
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  #shopify-section-{{ section_id }} .hs-item-summary::-webkit-details-marker{ display:none; }
  #shopify-section-{{ section_id }} .hs-item-summary::marker{ display:none; }

  #shopify-section-{{ section_id }} .hs-item-icon{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: {{ s.iconBackground_color | default: '#f3eaf9' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ s.iconColor_color | default: '#5a2a78' }};
    flex-shrink: 0;
  }
  #shopify-section-{{ section_id }} .hs-item-icon svg,
  #shopify-section-{{ section_id }} .hs-item-icon img{
    width: 20px;
    height: 20px;
    max-width: 100%;
    max-height: 100%;
  }

  #shopify-section-{{ section_id }} .hs-item-text{ min-width: 0; }
  #shopify-section-{{ section_id }} .hs-item-title{
    font-family: {{ body_font }};
    font-weight: 600;
    font-size: clamp(0.95rem, 0.2vw + 0.9rem, 1rem);
    line-height: 1.3;
    color: #1d1027;
    margin: 0;
  }
  #shopify-section-{{ section_id }} .hs-item-subtitle{
    font-family: {{ body_font }};
    font-weight: 400;
    font-size: clamp(0.8125rem, 0.15vw + 0.78rem, 0.875rem);
    line-height: 1.4;
    color: #6b5b78;
    margin: 2px 0 0;
  }

  #shopify-section-{{ section_id }} .hs-item-toggle{
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #6b5b78;
    flex-shrink: 0;
    transition: transform 200ms ease;
  }
  #shopify-section-{{ section_id }} details[open] .hs-item-toggle{
    transform: rotate(45deg);
  }
  #shopify-section-{{ section_id }} .hs-item-toggle svg{ width: 14px; height: 14px; }

  #shopify-section-{{ section_id }} .hs-item-body{
    padding: 0 18px 16px 68px;
    font-family: {{ body_font }};
    font-size: 0.875rem;
    line-height: 1.5;
    color: #4d3f59;
  }
  #shopify-section-{{ section_id }} .hs-item-body > :first-child{ margin-top: 0; }
  #shopify-section-{{ section_id }} .hs-item-body > :last-child{ margin-bottom: 0; }

  #shopify-section-{{ section_id }} .hs-media{
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    order: -1;
  }
  {%- if s.hideImageOnMobile_checkbox -%}
    @media (max-width: 1023.98px){
      #shopify-section-{{ section_id }} .hs-media{ display: none; }
    }
  {%- endif -%}
  @media (min-width: 1024px) {
    #shopify-section-{{ section_id }} .hs-media{ order: 0; }
  }
  #shopify-section-{{ section_id }} .hs-media img{
    width: 100%;
    height: auto;
    max-width: {{ s.imageMaxWidth_number | default: 520 }}px;
    max-height: {{ s.imageMaxHeight_number | default: 560 }}px;
    object-fit: contain;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section_id }} .hs-item-toggle{ transition: none; }
  }
</style>

<div
  class="hs-section"
  role="region"
  aria-labelledby="hs-heading-{{ section_id }}"
  {{ section.shopify_attributes }}
>
  <div class="hs-card">
    <div class="hs-grid">
      <div class="hs-content">
        <h2 id="hs-heading-{{ section_id }}" class="hs-heading">
          {{- s.heading_text | default: 'Haritaki™ isn’t just a supplement' -}}
        </h2>

        {%- if s.description_richtext != blank -%}
          <div class="hs-description">{{ s.description_richtext }}</div>
        {%- else -%}
          <p class="hs-description">
            {{- s.description_text | default: 'It’s the ancient Ayurvedic secret called “The King of Medicines” — now in a convenient daily capsule designed to cleanse your pineal gland and awaken your Third Eye.' -}}
          </p>
        {%- endif -%}

        <ul class="hs-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li class="hs-item" {{ block.shopify_attributes }} itemscope itemtype="https://schema.org/Thing">
                <details class="hs-details"{% if block.settings.open_checkbox %} open{% endif %}>
                  <summary class="hs-item-summary" aria-controls="hs-body-{{ block.id }}">
                    <span class="hs-item-icon" aria-hidden="true">
                      {%- if block.settings.icon_image != blank -%}
                        {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,80', alt: '' }}
                      {%- elsif block.settings.icon_svg != blank -%}
                        {{ block.settings.icon_svg }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
                      {%- endif -%}
                    </span>
                    <span class="hs-item-text">
                      <span class="hs-item-title" itemprop="name">{{ block.settings.title_text }}</span>
                      {%- if block.settings.subtitle_text != blank -%}
                        <span class="hs-item-subtitle" itemprop="description">{{ block.settings.subtitle_text }}</span>
                      {%- endif -%}
                    </span>
                    <span class="hs-item-toggle" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
                    </span>
                  </summary>
                  {%- if block.settings.body_richtext != blank -%}
                    <div id="hs-body-{{ block.id }}" class="hs-item-body">{{ block.settings.body_richtext }}</div>
                  {%- endif -%}
                </details>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="hs-media">
        {%- if s.image_picker != blank -%}
          {{ s.image_picker
            | image_url: width: 1040
            | image_tag:
              loading: 'lazy',
              widths: '320,480,640,820,1040',
              sizes: '(min-width: 1024px) 480px, 90vw',
              alt: s.image_alt_text | default: 'Haritaki capsules stacked',
              class: 'hs-image',
              fetchpriority: 'low'
          }}
        {%- else -%}
          <img
            src="{{ 'placeholder-product.svg' | asset_url }}"
            alt="{{ s.image_alt_text | default: 'Haritaki capsules' }}"
            loading="lazy"
            decoding="async"
            width="520"
            height="560"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} JSON-LD: ItemList of benefits for SEO {%- endcomment -%}
{%- capture jsonld_items -%}
  {%- assign idx = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'benefit' -%}
      {%- assign idx = idx | plus: 1 -%}
      {
        "@type": "ListItem",
        "position": {{ idx }},
        "item": {
          "@type": "Thing",
          "name": {{ block.settings.title_text | json }},
          "description": {{ block.settings.subtitle_text | strip_html | json }}
        }
      }{% unless forloop.last %},{% endunless %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ s.heading_text | default: "Haritaki isn't just a supplement" | json }},
  "description": {{ s.description_text | default: "Ancient Ayurvedic Haritaki — The King of Medicines — in a daily capsule." | strip_html | json }},
  "itemListElement": [{{ jsonld_items }}]
}
</script>

<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section_id }}');
    if (!root) return;
    var summaries = root.querySelectorAll('.hs-item-summary');
    summaries.forEach(function(sum){
      var details = sum.parentElement;
      sum.setAttribute('aria-expanded', details.open ? 'true' : 'false');
      details.addEventListener('toggle', function(){
        sum.setAttribute('aria-expanded', details.open ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Haritaki Benefits",
  "tag": "section",
  "class": "hs-haritaki-supplement",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Spacing — Desktop" },
    { "type": "range", "id": "sectionPaddingTop_responsive_range_desktop",    "label": "Section padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "sectionPaddingBottom_responsive_range_desktop", "label": "Section padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "sectionPaddingLeft_responsive_range_desktop",   "label": "Section padding left (Desktop)",   "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "sectionPaddingRight_responsive_range_desktop",  "label": "Section padding right (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "innerPaddingTop_responsive_range_desktop",      "label": "Card padding top (Desktop)",       "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "innerPaddingBottom_responsive_range_desktop",   "label": "Card padding bottom (Desktop)",    "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "innerPaddingX_responsive_range_desktop",        "label": "Card padding horizontal (Desktop)","min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },

    { "type": "header", "content": "Spacing — Mobile" },
    { "type": "range", "id": "sectionPaddingTop_responsive_range_mobile",    "label": "Section padding top (Mobile)",    "min": 0, "max": 200, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "sectionPaddingBottom_responsive_range_mobile", "label": "Section padding bottom (Mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "sectionPaddingLeft_responsive_range_mobile",   "label": "Section padding left (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "sectionPaddingRight_responsive_range_mobile",  "label": "Section padding right (Mobile)",  "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "innerPaddingTop_responsive_range_mobile",      "label": "Card padding top (Mobile)",       "min": 0, "max": 160, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "innerPaddingBottom_responsive_range_mobile",   "label": "Card padding bottom (Mobile)",    "min": 0, "max": 160, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "innerPaddingX_responsive_range_mobile",        "label": "Card padding horizontal (Mobile)","min": 0, "max": 80,  "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "cardMaxWidth_number", "label": "Card max width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1340 },
    { "type": "range", "id": "cardRadius_number",   "label": "Card radius",     "min": 0,   "max": 40,   "step": 2,  "unit": "px", "default": 24 },
    { "type": "range", "id": "imageMaxWidth_number","label": "Image max width", "min": 240, "max": 800,  "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "imageMaxHeight_number","label": "Image max height","min": 240, "max": 800, "step": 10, "unit": "px", "default": 560 },

    { "type": "header", "content": "Card background image (optional — overrides gradient)" },
    { "type": "image_picker", "id": "cardBackgroundImage_desktop_picker", "label": "Card background image — Desktop", "info": "Used at ≥ 1024px. Recommend a JPG/WebP at ≥ 1800px wide." },
    { "type": "image_picker", "id": "cardBackgroundImage_mobile_picker",  "label": "Card background image — Mobile",  "info": "Used under 1024px. Recommend a JPG/WebP at ≥ 900px wide. Falls back to the desktop image if blank." },
    { "type": "image_picker", "id": "cardBackgroundImage_picker",         "label": "Card background image — Shared (fallback)", "info": "Used when neither desktop nor mobile is set." },
    { "type": "color",        "id": "cardBackgroundOverlay_color",        "label": "Overlay color (over image)", "default": "#2a1442", "info": "Solid color overlay rendered on top of the background image. Adjust with the gradient settings if you want translucency via the radial accents." },
    { "type": "text",         "id": "cardBackgroundPosition_text",        "label": "Background position",   "default": "center center", "info": "CSS background-position, e.g. \"center center\", \"top right\"." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "outerBackground_color",   "label": "Outer page background", "default": "#ffffff" },
    { "type": "color", "id": "gradientFrom_color",      "label": "Card gradient — start", "default": "#5a2a78" },
    { "type": "color", "id": "gradientVia_color",       "label": "Card gradient — mid",   "default": "#3f1c5c" },
    { "type": "color", "id": "gradientTo_color",        "label": "Card gradient — end",   "default": "#2a1442" },
    { "type": "color", "id": "headingTextColor_color",  "label": "Heading color",         "default": "#ffffff" },
    { "type": "color", "id": "descriptionTextColor_color","label": "Description color",   "default": "#e8dcef" },
    { "type": "color", "id": "itemBackground_color",    "label": "Item background",       "default": "#ffffff" },
    { "type": "color", "id": "iconBackground_color",    "label": "Icon background",       "default": "#f3eaf9" },
    { "type": "color", "id": "iconColor_color",         "label": "Icon color",            "default": "#5a2a78" },

    { "type": "header", "content": "Typography" },
    { "type": "text",  "id": "headingFontFamily_text", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },
    { "type": "text",  "id": "bodyFontFamily_text",    "label": "Body font-family",    "default": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" },
    { "type": "range", "id": "headingSize_desktop_number",     "label": "Heading size (Desktop, px)",     "min": 24, "max": 80, "step": 1, "unit": "px", "default": 46 },
    { "type": "range", "id": "descriptionSize_desktop_number", "label": "Description size (Desktop, px)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "heading_text",          "label": "Heading",     "default": "Haritaki™ isn’t just a supplement" },
    { "type": "richtext", "id": "description_richtext",  "label": "Description (rich text)" },
    { "type": "textarea", "id": "description_text",      "label": "Description (plain fallback)", "default": "It’s the ancient Ayurvedic secret called “The King of Medicines” — now in a convenient daily capsule designed to cleanse your pineal gland and awaken your Third Eye." },
    { "type": "range",    "id": "itemGap_number",        "label": "Gap between items", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 10 },
    { "type": "range",    "id": "itemRadius_number",     "label": "Item radius",       "min": 0, "max": 28, "step": 2, "unit": "px", "default": 14 },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image_picker",   "label": "Capsules image" },
    { "type": "text",         "id": "image_alt_text", "label": "Image alt text", "default": "Stack of Haritaki capsules" },
    { "type": "checkbox",     "id": "hideImageOnMobile_checkbox", "label": "Hide image on mobile", "default": true, "info": "Matches the Figma mobile layout where the image is omitted." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
