{% comment %}
  Choose Your Daily Practice v3
  Fix: pre-pass index approach, inline loops, auto compare_at_price total, bullets/footer as blocks
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign s   = section.settings -%}

{%- comment -%}
  PRE-PASS — collect each tab block's forloop index
  Builds: _ts_arr e.g. ["0","4","9"] = start positions of each tab block
{%- endcomment -%}
{%- assign _ts_str = '' -%}
{%- assign _pbi    = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'tab' -%}
    {%- assign _ts_str = _ts_str | append: _pbi | append: '|' -%}
  {%- endif -%}
  {%- assign _pbi = _pbi | plus: 1 -%}
{%- endfor -%}
{%- assign _ts_arr = _ts_str | split: '|' -%}

<style>
/* ══════════════════════════════════════
   SECTION bg
══════════════════════════════════════ */
#shopify-section-{{ sid }} {
  background: radial-gradient(
    ellipse at 50% -10%,
    {{ s.bg_top    | default: '#f5eafd' }} 0%,
    {{ s.bg_bottom | default: '#e4cff3' }} 100%
  );
}
#shopify-section-{{ sid }} .cdp-wrap {
  max-width: 1200px; margin: 0 auto;
  padding: {{ s.pt_m | default: 48 }}px {{ s.px_m | default: 20 }}px {{ s.pb_m | default: 48 }}px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-wrap {
    padding: {{ s.pt_d | default: 72 }}px {{ s.px_d | default: 60 }}px {{ s.pb_d | default: 72 }}px;
  }
}

/* HEADER */
#shopify-section-{{ sid }} .cdp-header { text-align: center; margin-bottom: 28px; }
#shopify-section-{{ sid }} .cdp-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 400; font-size: 34px; color: #1a0a2e; margin: 0 0 10px; line-height: 1.15;
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-title { font-size: 44px; } }
#shopify-section-{{ sid }} .cdp-sub {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px; color: #5a2872; margin: 0 auto; line-height: 1.55; max-width: 460px;
}

/* DESKTOP TABS */
#shopify-section-{{ sid }} .cdp-tabs-d { display: none; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-tabs-d {
    display: flex; gap: 0; margin-bottom: 14px; border-radius: 12px; overflow: hidden;
    background: rgba(255,255,255,0.55); border: 1px solid rgba(190,150,220,0.35);
  }
  #shopify-section-{{ sid }} .cdp-tab-btn {
    flex: 1 1 0; display: flex; flex-direction: column; align-items: flex-start;
    padding: 15px 22px; border: none; border-right: 1px solid rgba(190,150,220,0.35);
    background: transparent; cursor: pointer; text-align: left; transition: background 0.2s;
  }
  #shopify-section-{{ sid }} .cdp-tab-btn:last-child { border-right: none; }
  #shopify-section-{{ sid }} .cdp-tab-btn.cdp-active { background: #3e1047; }
  #shopify-section-{{ sid }} .cdp-tab-name {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 15px; font-weight: 600; color: #1a0a2e; display: block; margin-bottom: 3px;
  }
  #shopify-section-{{ sid }} .cdp-tab-btn.cdp-active .cdp-tab-name { color: #fff; }
  #shopify-section-{{ sid }} .cdp-tab-note {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 12px; color: #7a4a90; display: block; line-height: 1.3;
  }
  #shopify-section-{{ sid }} .cdp-tab-btn.cdp-active .cdp-tab-note { color: rgba(255,255,255,0.7); }
}

/* MOBILE TAB CARDS */
#shopify-section-{{ sid }} .cdp-tabs-m {
  display: flex; gap: 10px; overflow-x: auto;
  scrollbar-width: none; padding-bottom: 4px; margin-bottom: 20px;
}
#shopify-section-{{ sid }} .cdp-tabs-m::-webkit-scrollbar { display: none; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-tabs-m { display: none; } }
#shopify-section-{{ sid }} .cdp-card-btn {
  flex: 0 0 120px; height: 155px; border-radius: 12px;
  overflow: hidden; position: relative; display: block;
  border: 2.5px solid transparent; cursor: pointer; padding: 0;
  background: #c9a0e0; transition: border-color 0.2s; flex-shrink: 0;
}
#shopify-section-{{ sid }} .cdp-card-btn.cdp-active { border-color: #3e1047; }
#shopify-section-{{ sid }} .cdp-card-img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; display: block; z-index: 1;
}
#shopify-section-{{ sid }} .cdp-card-text {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(to top, rgba(35,5,55,0.9) 0%, rgba(35,5,55,0.05) 100%);
  padding: 28px 8px 9px; text-align: left; z-index: 2;
}
#shopify-section-{{ sid }} .cdp-card-name {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 12px; font-weight: 700; color: #fff; display: block; line-height: 1.25;
}
#shopify-section-{{ sid }} .cdp-card-note {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 10px; color: rgba(255,255,255,0.8); display: block; margin-top: 2px; line-height: 1.2;
}

/* PANELS */
#shopify-section-{{ sid }} .cdp-panel { display: none; }
#shopify-section-{{ sid }} .cdp-panel.cdp-active { display: flex; flex-direction: column; gap: 14px; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-panel.cdp-active {
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start;
  }
}

/* LEFT PANEL */
#shopify-section-{{ sid }} .cdp-left {
  background: #3e1047; border-radius: 16px; padding: 28px 22px 24px;
  color: #fff; display: flex; flex-direction: column; order: 2;
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-left { order: 1; padding: 40px 36px 32px; } }
#shopify-section-{{ sid }} .cdp-l-heading {
  font-family: Georgia, 'Times New Roman', serif; font-style: italic;
  font-weight: 400; font-size: 24px; color: #fff; margin: 0 0 14px; line-height: 1.25;
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-l-heading { font-size: 30px; } }
#shopify-section-{{ sid }} .cdp-l-desc {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13.5px;
  color: rgba(255,255,255,0.82); line-height: 1.65; margin-bottom: 20px;
}
#shopify-section-{{ sid }} .cdp-l-desc p { margin: 0 0 8px; }
#shopify-section-{{ sid }} .cdp-l-desc p:last-child { margin-bottom: 0; }
#shopify-section-{{ sid }} .cdp-l-sub {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 15px;
  font-weight: 700; color: #fff; margin: 0 0 14px;
}
#shopify-section-{{ sid }} .cdp-bullets {
  list-style: none; margin: 0 0 0; padding: 0;
  display: flex; flex-direction: column; gap: 10px;
}
#shopify-section-{{ sid }} .cdp-bullets li {
  display: flex; align-items: flex-start; gap: 10px;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13.5px; color: rgba(255,255,255,0.88); line-height: 1.5;
}
#shopify-section-{{ sid }} .cdp-check {
  flex-shrink: 0; width: 20px; height: 20px;
  background: #22c55e; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; margin-top: 1px;
}
#shopify-section-{{ sid }} .cdp-check svg { width: 11px; height: 11px; }
#shopify-section-{{ sid }} .cdp-spacer { flex: 1; min-height: 20px; }
#shopify-section-{{ sid }} .cdp-cta {
  display: block; width: 100%; background: #fff; color: #3e1047;
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px; font-weight: 800;
  letter-spacing: 0.07em; text-align: center; text-decoration: none; text-transform: uppercase;
  padding: 16px 24px; border-radius: 50px; border: none;
  cursor: pointer; transition: opacity 0.15s; margin-top: 20px; margin-bottom: 14px;
}
#shopify-section-{{ sid }} .cdp-cta:hover { opacity: 0.88; }
#shopify-section-{{ sid }} .cdp-foot {
  display: flex; align-items: center; justify-content: center; gap: 0; flex-wrap: wrap;
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 11.5px; color: rgba(255,255,255,0.62);
}
#shopify-section-{{ sid }} .cdp-foot-item {
  display: flex; align-items: center; gap: 5px; padding: 0 10px;
}
#shopify-section-{{ sid }} .cdp-foot-item + .cdp-foot-item {
  border-left: 1px solid rgba(255,255,255,0.3);
}
#shopify-section-{{ sid }} .cdp-foot-icon { width: 14px; height: 14px; object-fit: contain; display: block; }
#shopify-section-{{ sid }} .cdp-foot-item svg { width: 13px; height: 13px; flex-shrink: 0; }

/* RIGHT PANEL */
#shopify-section-{{ sid }} .cdp-right { order: 1; display: flex; flex-direction: column; gap: 12px; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-right { order: 2; } }
#shopify-section-{{ sid }} .cdp-pcard {
  background: #fff; border-radius: 16px; padding: 18px 16px 14px;
  box-shadow: 0 2px 20px rgba(60,10,80,0.08);
}
#shopify-section-{{ sid }} .cdp-r-heading {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px; font-weight: 600;
  color: #1a0a2e; margin: 0 0 3px;
}
#shopify-section-{{ sid }} .cdp-r-gifts {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 11.5px;
  color: #7a4a90; margin: 0 0 10px; display: none;
}
@media (max-width: 768px) { #shopify-section-{{ sid }} .cdp-r-gifts { display: block; } }

/* Product rows */
#shopify-section-{{ sid }} .cdp-prod-list { display: flex; flex-direction: column; }
#shopify-section-{{ sid }} .cdp-prod-row {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 0; border-bottom: 1px dashed #d8c8ea;
}
#shopify-section-{{ sid }} .cdp-prod-row:first-child { border-top: 1px dashed #d8c8ea; }

/* FREE rows — mobile only */
#shopify-section-{{ sid }} .cdp-free-list { display: none; }
@media (max-width: 768px) {
  #shopify-section-{{ sid }} .cdp-free-list { display: flex; flex-direction: column; gap: 6px; margin-top: 6px; }
}
#shopify-section-{{ sid }} .cdp-free-row {
  display: flex; align-items: center; gap: 10px;
  border: 1.5px dashed #22c55e; border-radius: 10px; padding: 9px 10px; background: #f0fdf4;
}
#shopify-section-{{ sid }} .cdp-pimg {
  width: 44px; height: 44px; flex-shrink: 0; border-radius: 7px; overflow: hidden; background: #f5eefe;
}
#shopify-section-{{ sid }} .cdp-pimg img { width: 100%; height: 100%; object-fit: cover; display: block; }
#shopify-section-{{ sid }} .cdp-pinfo { flex: 1 1 auto; min-width: 0; }
#shopify-section-{{ sid }} .cdp-ptitle {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 12.5px; color: #1a0a2e; line-height: 1.35; display: block;
}
#shopify-section-{{ sid }} .cdp-pprice {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px; font-weight: 600; color: #1a0a2e; white-space: nowrap; flex-shrink: 0;
}
#shopify-section-{{ sid }} .cdp-free-r { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
#shopify-section-{{ sid }} .cdp-free-tag {
  background: #16a34a; color: #fff; font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 10.5px; font-weight: 700; padding: 3px 8px; border-radius: 4px; white-space: nowrap;
}
#shopify-section-{{ sid }} .cdp-plus-c {
  width: 27px; height: 27px; border-radius: 50%; border: 1.8px solid #3e1047;
  background: transparent; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
#shopify-section-{{ sid }} .cdp-plus-c svg { width: 12px; height: 12px; color: #3e1047; }

/* Total row */
#shopify-section-{{ sid }} .cdp-total {
  display: flex; align-items: center; justify-content: space-between; padding-top: 12px; margin-top: 4px;
}
#shopify-section-{{ sid }} .cdp-total-lbl {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px; font-weight: 500; color: #1a0a2e;
}
#shopify-section-{{ sid }} .cdp-total-vals { display: flex; align-items: baseline; gap: 8px; }
#shopify-section-{{ sid }} .cdp-cmp-val {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px; color: #aaa; text-decoration: line-through;
}
#shopify-section-{{ sid }} .cdp-kit-price {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 15px; font-weight: 700; color: #1a0a2e;
}

/* Bottom image — desktop only */
#shopify-section-{{ sid }} .cdp-btm-img { display: none; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-btm-img { display: block; border-radius: 16px; overflow: hidden; } }
#shopify-section-{{ sid }} .cdp-btm-img img { width: 100%; height: auto; display: block; }
</style>

<section class="cdp-outer" {{ section.shopify_attributes }}>
<div class="cdp-wrap">

  {%- comment -%}── HEADER ──{%- endcomment -%}
  <div class="cdp-header">
    {%- if s.heading != blank -%}<h2 class="cdp-title">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subtext  != blank -%}<p  class="cdp-sub">{{ s.subtext }}</p>{%- endif -%}
  </div>

  {%- comment -%}── DESKTOP TABS ──{%- endcomment -%}
  <div class="cdp-tabs-d">
    {%- assign tab_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        <button class="cdp-tab-btn{% if tab_i == 0 %} cdp-active{% endif %}"
                data-idx="{{ tab_i }}" type="button" {{ block.shopify_attributes }}>
          <span class="cdp-tab-name">{{ block.settings.tab_title | default: 'Kit Tab' }}</span>
          {%- if block.settings.tab_subtitle != blank -%}
            <span class="cdp-tab-note">{{ block.settings.tab_subtitle }}</span>
          {%- endif -%}
        </button>
        {%- assign tab_i = tab_i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%}── MOBILE TAB CARDS ──{%- endcomment -%}
  <div class="cdp-tabs-m">
    {%- assign tab_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        <button class="cdp-card-btn{% if tab_i == 0 %} cdp-active{% endif %}"
                data-idx="{{ tab_i }}" type="button">
          {%- if block.settings.tab_image != blank -%}
            {{ block.settings.tab_image | image_url: width: 300
               | image_tag: loading: 'lazy', class: 'cdp-card-img', alt: block.settings.tab_title }}
          {%- endif -%}
          <div class="cdp-card-text">
            <span class="cdp-card-name">{{ block.settings.tab_title | default: 'Kit Tab' }}</span>
            {%- if block.settings.tab_subtitle != blank -%}
              <span class="cdp-card-note">{{ block.settings.tab_subtitle }}</span>
            {%- endif -%}
          </div>
        </button>
        {%- assign tab_i = tab_i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%}── PANELS ──{%- endcomment -%}
  {%- assign tab_counter = 0 -%}
  {%- for outer_block in section.blocks -%}
    {%- if outer_block.type == 'tab' -%}

      {%- comment -%} Range: _ts = this tab's index, _te = next tab's index (or end) {%- endcomment -%}
      {%- assign _ts     = _ts_arr[tab_counter] | plus: 0 -%}
      {%- assign _tc_nxt = tab_counter | plus: 1 -%}
      {%- assign _te_raw = _ts_arr[_tc_nxt] -%}
      {%- if _te_raw == blank -%}
        {%- assign _te = section.blocks.size -%}
      {%- else -%}
        {%- assign _te = _te_raw | plus: 0 -%}
      {%- endif -%}

      <div class="cdp-panel{% if tab_counter == 0 %} cdp-active{% endif %}" data-panel="{{ tab_counter }}">

        {%- comment -%}══ LEFT PANEL ══{%- endcomment -%}
        <div class="cdp-left">

          {%- if outer_block.settings.l_heading != blank -%}
            <h3 class="cdp-l-heading">{{ outer_block.settings.l_heading }}</h3>
          {%- endif -%}
          {%- if outer_block.settings.l_desc != blank -%}
            <div class="cdp-l-desc">{{ outer_block.settings.l_desc }}</div>
          {%- endif -%}
          {%- if outer_block.settings.l_sub != blank -%}
            <h4 class="cdp-l-sub">{{ outer_block.settings.l_sub }}</h4>
          {%- endif -%}

          {%- comment -%}
            BULLETS — iterate all blocks, pick bullet_item blocks in this tab's range
            _b_open: tracks whether <ul> has been opened
          {%- endcomment -%}
          {%- assign _b_open = false -%}
          {%- assign _bci    = 0 -%}
          {%- for b in section.blocks -%}
            {%- if _bci > _ts and _bci < _te and b.type == 'bullet_item' -%}
              {%- unless _b_open -%}<ul class="cdp-bullets">{%- assign _b_open = true -%}{%- endunless -%}
              <li {{ b.shopify_attributes }}>
                <span class="cdp-check">
                  <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polyline points="2,6.5 5,9.5 10,3" stroke="white" stroke-width="2.2"
                              stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {{ b.settings.text }}
              </li>
            {%- endif -%}
            {%- assign _bci = _bci | plus: 1 -%}
          {%- endfor -%}
          {%- if _b_open -%}</ul>{%- endif -%}

          <div class="cdp-spacer"></div>

          {%- if outer_block.settings.btn_text != blank -%}
            <a href="{{ outer_block.settings.btn_url | default: '#' }}" class="cdp-cta">
              {{ outer_block.settings.btn_text }}
            </a>
          {%- endif -%}

          {%- comment -%} FOOTER ITEMS {%- endcomment -%}
          {%- assign _f_open = false -%}
          {%- assign _fci    = 0 -%}
          {%- for b in section.blocks -%}
            {%- if _fci > _ts and _fci < _te and b.type == 'footer_item' -%}
              {%- unless _f_open -%}<div class="cdp-foot">{%- assign _f_open = true -%}{%- endunless -%}
              <span class="cdp-foot-item" {{ b.shopify_attributes }}>
                {%- if b.settings.icon_image != blank -%}
                  {{ b.settings.icon_image | image_url: width: 40
                     | image_tag: loading: 'lazy', class: 'cdp-foot-icon',
                       width: 14, height: 14, alt: '' }}
                {%- else -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="10" cy="10" r="7.5"/>
                    <line x1="10" y1="7" x2="10" y2="10.5"/>
                    <circle cx="10" cy="13" r="0.7" fill="currentColor" stroke="none"/>
                  </svg>
                {%- endif -%}
                {{ b.settings.text }}
              </span>
            {%- endif -%}
            {%- assign _fci = _fci | plus: 1 -%}
          {%- endfor -%}
          {%- if _f_open -%}</div>{%- endif -%}

        </div>

        {%- comment -%}══ RIGHT PANEL ══{%- endcomment -%}
        <div class="cdp-right">
          <div class="cdp-pcard">

            {%- if outer_block.settings.r_heading != blank -%}
              <p class="cdp-r-heading">{{ outer_block.settings.r_heading }}</p>
            {%- endif -%}
            {%- if outer_block.settings.gifts_label != blank -%}
              <p class="cdp-r-gifts">{{ outer_block.settings.gifts_label }}</p>
            {%- endif -%}

            {%- comment -%} PRODUCTS {%- endcomment -%}
            {%- assign _pr_open = false -%}
            {%- assign _pri     = 0 -%}
            {%- for b in section.blocks -%}
              {%- if _pri > _ts and _pri < _te and b.type == 'tab_product' -%}
                {%- assign _prod = b.settings.product -%}
                {%- if _prod != blank -%}
                  {%- unless _pr_open -%}<div class="cdp-prod-list">{%- assign _pr_open = true -%}{%- endunless -%}
                  <div class="cdp-prod-row" {{ b.shopify_attributes }}>
                    <div class="cdp-pimg">
                      {%- if _prod.featured_image != blank -%}
                        {{ _prod.featured_image | image_url: width: 120
                           | image_tag: loading: 'lazy', alt: _prod.title }}
                      {%- endif -%}
                    </div>
                    <div class="cdp-pinfo">
                      <span class="cdp-ptitle">{{ _prod.title }}</span>
                    </div>
                    <span class="cdp-pprice">{{ _prod.price | money_without_trailing_zeros }}</span>
                  </div>
                {%- endif -%}
              {%- endif -%}
              {%- assign _pri = _pri | plus: 1 -%}
            {%- endfor -%}
            {%- if _pr_open -%}</div>{%- endif -%}

            {%- comment -%} FREE ITEMS — mobile only via CSS {%- endcomment -%}
            {%- assign _fr_open = false -%}
            {%- assign _fri     = 0 -%}
            {%- for b in section.blocks -%}
              {%- if _fri > _ts and _fri < _te and b.type == 'free_item' -%}
                {%- assign _fprod = b.settings.product -%}
                {%- if _fprod != blank -%}
                  {%- unless _fr_open -%}<div class="cdp-free-list">{%- assign _fr_open = true -%}{%- endunless -%}
                  <div class="cdp-free-row" {{ b.shopify_attributes }}>
                    <div class="cdp-pimg">
                      {%- if _fprod.featured_image != blank -%}
                        {{ _fprod.featured_image | image_url: width: 120
                           | image_tag: loading: 'lazy', alt: _fprod.title }}
                      {%- endif -%}
                    </div>
                    <div class="cdp-pinfo">
                      <span class="cdp-ptitle">{{ _fprod.title }}</span>
                    </div>
                    <div class="cdp-free-r">
                      <span class="cdp-free-tag">Free</span>
                      <span class="cdp-plus-c">
                        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round">
                          <line x1="6" y1="2" x2="6" y2="10"/>
                          <line x1="2" y1="6" x2="10" y2="6"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
              {%- assign _fri = _fri | plus: 1 -%}
            {%- endfor -%}
            {%- if _fr_open -%}</div>{%- endif -%}

            {%- comment -%}
              TOTAL
              _sum_p = sum of product.price         → main kit price (no strikethrough)
              _sum_c = sum of compare_at_price      → strikethrough (only if products have compare_at_price)
              kit_price field = optional manual override for main price
            {%- endcomment -%}
            {%- assign _sum_p      = 0 -%}
            {%- assign _sum_c      = 0 -%}
            {%- assign _has_cmp    = false -%}
            {%- assign _tbi        = 0 -%}
            {%- for b in section.blocks -%}
              {%- if _tbi > _ts and _tbi < _te and b.type == 'tab_product' -%}
                {%- assign _tp = b.settings.product -%}
                {%- if _tp != blank -%}
                  {%- assign _sum_p = _sum_p | plus: _tp.price -%}
                  {%- if _tp.compare_at_price > 0 -%}
                    {%- assign _sum_c   = _sum_c | plus: _tp.compare_at_price -%}
                    {%- assign _has_cmp = true -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
              {%- assign _tbi = _tbi | plus: 1 -%}
            {%- endfor -%}

            {%- if _sum_p > 0 or outer_block.settings.kit_price != blank -%}
              <div class="cdp-total">
                <span class="cdp-total-lbl">Total kit value</span>
                <div class="cdp-total-vals">
                  {%- if _has_cmp -%}
                    <span class="cdp-cmp-val">{{ _sum_c | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                  {%- if outer_block.settings.kit_price != blank -%}
                    <span class="cdp-kit-price">{{ outer_block.settings.kit_price }}</span>
                  {%- elsif _sum_p > 0 -%}
                    <span class="cdp-kit-price">{{ _sum_p | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          </div>

          {%- if outer_block.settings.bottom_image != blank -%}
            <div class="cdp-btm-img">
              {{ outer_block.settings.bottom_image | image_url: width: 900
                 | image_tag: loading: 'lazy', alt: outer_block.settings.tab_title }}
            </div>
          {%- endif -%}

        </div>

      </div>

      {%- assign tab_counter = tab_counter | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

</div>
</section>

<script>
(function () {
  var sid = '{{ sid }}';
  function init() {
    var sec = document.getElementById('shopify-section-' + sid);
    if (!sec) return;
    var btnsD  = sec.querySelectorAll('.cdp-tab-btn');
    var btnsM  = sec.querySelectorAll('.cdp-card-btn');
    var panels = sec.querySelectorAll('.cdp-panel');
    function activate(idx) {
      btnsD.forEach(function(b)  { b.classList.remove('cdp-active'); });
      btnsM.forEach(function(b)  { b.classList.remove('cdp-active'); });
      panels.forEach(function(p) { p.classList.remove('cdp-active'); });
      var dBtn  = sec.querySelector('.cdp-tab-btn[data-idx="'  + idx + '"]');
      var mBtn  = sec.querySelector('.cdp-card-btn[data-idx="' + idx + '"]');
      var panel = sec.querySelector('.cdp-panel[data-panel="'  + idx + '"]');
      if (dBtn)  dBtn.classList.add('cdp-active');
      if (mBtn)  mBtn.classList.add('cdp-active');
      if (panel) panel.classList.add('cdp-active');
    }
    btnsD.forEach(function(btn) { btn.addEventListener('click', function() { activate(parseInt(btn.dataset.idx, 10)); }); });
    btnsM.forEach(function(btn) { btn.addEventListener('click', function() { activate(parseInt(btn.dataset.idx, 10)); }); });
  }
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
})();
</script>

