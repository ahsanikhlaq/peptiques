{% comment %}
  Choose Your Daily Practice v4
  - free_item: 4 products selectable
  - free items visible on both mobile + desktop
  - SEO: h2 for section, h3 for panels, proper aria labels
  - Logic same, schema clean
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign s   = section.settings -%}

{%- assign ts_str = '' -%}
{%- assign pbi    = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'tab' -%}
    {%- assign ts_str = ts_str | append: pbi | append: '|' -%}
  {%- endif -%}
  {%- assign pbi = pbi | plus: 1 -%}
{%- endfor -%}
{%- assign ts_arr = ts_str | split: '|' -%}

<style>
#shopify-section-{{ sid }} .cdp-outer  {
background-color: #FFFFFC;
background-image: linear-gradient(
  90deg,
  #F5E1FF 0%,
  #FFFFFF 50%,
  #F5E1FF 100%
);
}
#shopify-section-{{ sid }} .cdp-outer {
  padding: {{ s.pt_m | default: 48 }}px {{ s.px_m | default: 20 }}px {{ s.pb_m | default: 48 }}px;
}
#shopify-section-{{ sid }} .cdp-wrap {
  max-width: 1340px; margin: 0 auto;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-outer {
    padding: {{ s.pt_d | default: 72 }}px {{ s.px_d | default: 60 }}px {{ s.pb_d | default: 72 }}px;
  }
}

/* HEADER */
#shopify-section-{{ sid }} .cdp-header { text-align: center; margin-bottom: 50px; }
#shopify-section-{{ sid }} .cdp-title {
    font-family: 'Georgia';
    font-weight: 400;
    font-size: 46px;
    line-height: 100%;
    letter-spacing: -7%;
    text-align: center;
    color:#000000;
    margin:0 0 16px;
}
#shopify-section-{{ sid }} .cdp-sub {
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: -3%;
    text-align: center;
    color: rgba(0, 0, 0, 1);
    margin: 0 auto;
    max-width: 442px;
}

/* DESKTOP TABS */
#shopify-section-{{ sid }} .cdp-tabs-d { display: none; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-tabs-d {
    display: flex;
    gap: 0;
    margin-bottom: 22px;
    padding: 10px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(234, 221, 255, 1);
    list-style: none;
    margin-top: 0;
  }
  #shopify-section-{{ sid }} .cdp-tab-btn {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0px;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s;
    border-radius: 12px;
  }
  #shopify-section-{{ sid }} .cdp-tab-btn:last-child { border-right: none; }
  #shopify-section-{{ sid }} .cdp-tab-btn.cdp-active { background: rgba(71, 24, 77, 1); }
  #shopify-section-{{ sid }} .cdp-tab-name {
    font-family: 'Georgia';
    font-weight: 700;
    font-size: 19px;
    line-height: 22.8px;
    letter-spacing: 0;
    text-align: center;
    margin-bottom: 4px;
    color:rgba(0, 0, 0, 1);
  }
  #shopify-section-{{ sid }} .cdp-tab-btn.cdp-active .cdp-tab-name { color: rgba(255, 255, 255, 1); }
  #shopify-section-{{ sid }} .cdp-tab-note {
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: -3%;
    text-align: center;
    color:rgba(0, 0, 0, 1);
  }
  #shopify-section-{{ sid }} .cdp-tab-btn.cdp-active .cdp-tab-note { color: rgba(255, 255, 255, 1); }
}

/* MOBILE TAB CARDS */
#shopify-section-{{ sid }} .cdp-tabs-m {
  display: flex; gap: 10px; overflow-x: auto;
  scrollbar-width: none; padding-bottom: 4px; margin-bottom: 20px;
  list-style: none; padding-left: 0; margin-top: 0;
}
#shopify-section-{{ sid }} .cdp-tabs-m::-webkit-scrollbar { display: none; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-tabs-m { display: none; } }
#shopify-section-{{ sid }} .cdp-card-btn {
  flex: 0 0 130px; border-radius: 12px; overflow: hidden; position: relative;
  border: 2.5px solid transparent; cursor: pointer; padding: 0;
  background: #e8d5f0; transition: border-color 0.2s; flex-shrink: 0;
  display: flex; flex-direction: column;
}
#shopify-section-{{ sid }} .cdp-card-btn.cdp-active { border-color: #3e1047; }
#shopify-section-{{ sid }} .cdp-card-img-wrap {
  flex: 0 0 110px; height: 110px; position: relative; overflow: hidden;
}
#shopify-section-{{ sid }} .cdp-card-img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; display: block; z-index: 1;
}
#shopify-section-{{ sid }} .cdp-card-text {
  padding: 8px 9px 10px; text-align: left; flex-shrink: 0;
  background: rgba(220,195,238,0.9); transition: background 0.2s;
}
#shopify-section-{{ sid }} .cdp-card-btn.cdp-active .cdp-card-text { background: #3e1047; }
#shopify-section-{{ sid }} .cdp-card-name {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 12px; font-weight: 700; color: #1a0a2e; display: block; line-height: 1.25;
}
#shopify-section-{{ sid }} .cdp-card-btn.cdp-active .cdp-card-name { color: #fff; }
#shopify-section-{{ sid }} .cdp-card-note {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 10px; color: #5a2872; display: block; margin-top: 2px; line-height: 1.2;
}
#shopify-section-{{ sid }} .cdp-card-btn.cdp-active .cdp-card-note { color: rgba(255,255,255,0.8); }

/* PANELS */
#shopify-section-{{ sid }} .cdp-panel { display: none; }
#shopify-section-{{ sid }} .cdp-panel.cdp-active { display: flex; flex-direction: column; gap: 14px; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-panel.cdp-active {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0px; align-items: start;
  }
}

/* LEFT PANEL */
#shopify-section-{{ sid }} .cdp-left {
  background: rgba(71, 24, 77, 1); border-radius: 12px 0px 0px 12px; padding: 28px 22px 24px;
  color: #fff; display: flex; flex-direction: column; order: 2;
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-left { order: 1; padding: 40px;height: 100%; } }
#shopify-section-{{ sid }} .cdp-l-heading {
    font-family: 'Georgia';
    font-weight: 400;
    font-size: 32px;
    line-height: 100%;
    letter-spacing: -7%;
    vertical-align: middle;
    color:rgba(255, 255, 255, 1);
    margin:0 0 20px;
}
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-l-heading { font-size: 30px; } }
#shopify-section-{{ sid }} .cdp-l-desc {
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -3%;
   color:rgba(255, 255, 255, 1);
    margin:0 0 40px;
}
#shopify-section-{{ sid }} .cdp-l-desc p { margin: 0 0 8px; }
#shopify-section-{{ sid }} .cdp-l-desc p:last-child { margin-bottom: 0; }
#shopify-section-{{ sid }} .cdp-l-sub {
    font-family: 'Georgia';
    font-weight: 400;
    font-size: 24px;
    line-height: 100%;
    letter-spacing: -7%;
    vertical-align: middle;
    color: #fff; margin: 0 0 20px;
}
#shopify-section-{{ sid }} .cdp-bullets {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-direction: column; gap: 10px;
}
#shopify-section-{{ sid }} .cdp-bullets li {
    display: flex; align-items: flex-start; gap: 12px;
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: -3%;
}
#shopify-section-{{ sid }} .cdp-check {
  flex-shrink: 0; width: 20px; height: 20px;
  background: #22c55e; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; margin-top: 1px;
}
#shopify-section-{{ sid }} .cdp-check svg { width: 11px; height: 11px; }
#shopify-section-{{ sid }} .cdp-spacer { flex: 1; min-height: 20px; }
#shopify-section-{{ sid }} .cdp-cta {
  display: block; width: 100%; background: #fff; color: #3e1047;
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px; font-weight: 800;
  letter-spacing: 0.07em; text-align: center; text-decoration: none; text-transform: uppercase;
  padding: 16px 24px; border-radius: 50px; border: none;
  cursor: pointer; transition: opacity 0.15s; margin-top: 20px; margin-bottom: 14px;
}
#shopify-section-{{ sid }} .cdp-cta:hover { opacity: 0.88; }
#shopify-section-{{ sid }} .cdp-foot {
  display: flex; align-items: center; justify-content: center; gap: 0; flex-wrap: wrap;
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 11.5px; color: rgba(255,255,255,0.62);
}
#shopify-section-{{ sid }} .cdp-foot-item {
  display: flex; align-items: center; gap: 5px; padding: 0 10px;
}
#shopify-section-{{ sid }} .cdp-foot-item + .cdp-foot-item {
  border-left: 1px solid rgba(255,255,255,0.3);
}
#shopify-section-{{ sid }} .cdp-foot-icon { width: 14px; height: 14px; object-fit: contain; display: block; }
#shopify-section-{{ sid }} .cdp-foot-item svg { width: 13px; height: 13px; flex-shrink: 0; }

/* RIGHT PANEL */
#shopify-section-{{ sid }} .cdp-right { order: 1; display: flex; flex-direction: column; gap: 12px; }
@media (min-width: 769px) { #shopify-section-{{ sid }} .cdp-right { order: 2; background: rgba(234, 221, 255, 1);
        padding: 32px;
        border-radius: 0 12px 12px 0; } }
#shopify-section-{{ sid }} .cdp-pcard {
  background: #fff; border-radius: 16px; padding: 18px 16px 14px;
  box-shadow: 0 2px 20px rgba(60,10,80,0.08);
}
#shopify-section-{{ sid }} .cdp-r-heading {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px; font-weight: 600;
  color: #1a0a2e; margin: 0 0 3px;
}
#shopify-section-{{ sid }} .cdp-r-gifts {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 11.5px;
  color: #7a4a90; margin: 0 0 10px;
}

/* Product rows */
#shopify-section-{{ sid }} .cdp-prod-list { display: flex; flex-direction: column; }
#shopify-section-{{ sid }} .cdp-prod-row {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 0; border-bottom: 1px dashed #d8c8ea;
}
#shopify-section-{{ sid }} .cdp-prod-row:first-child { border-top: 1px dashed #d8c8ea; }

/* FREE ITEMS — mobile always, desktop only if show_on_desktop checked */
#shopify-section-{{ sid }} .cdp-free-list {
  display: flex; flex-direction: column; gap: 6px; margin-top: 6px;
}
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-free-list { display: none; }
  #shopify-section-{{ sid }} .cdp-free-list.cdp-show-desktop { display: flex; }
}
#shopify-section-{{ sid }} .cdp-free-row {
  position: relative; border: 1.5px dashed #22c55e; border-radius: 10px;
  padding: 10px; background: #f0fdf4;
}
#shopify-section-{{ sid }} .cdp-free-badge {
  position: absolute; top: -1px; right: 10px;
  background: #16a34a; color: #fff;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 11px; font-weight: 700;
  padding: 3px 10px 3px 7px; border-radius: 0 0 8px 8px;
  display: flex; align-items: center; gap: 4px;
}
#shopify-section-{{ sid }} .cdp-free-badge svg { width: 13px; height: 13px; }
#shopify-section-{{ sid }} .cdp-free-body {
  display: flex; align-items: center; gap: 10px; padding-top: 4px;
}
#shopify-section-{{ sid }} .cdp-free-imgs {
  display: flex; align-items: center; flex-shrink: 0;
  position: relative;
}
#shopify-section-{{ sid }} .cdp-free-imgs .cdp-pimg {
  position: relative; z-index: 1;
}
#shopify-section-{{ sid }} .cdp-free-imgs .cdp-pimg + .cdp-pimg {
  margin-left: 6px;
}
#shopify-section-{{ sid }} .cdp-plus-icon {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 22px; height: 22px;
  background: #fff;
  border-radius: 50%;
  border: 1.5px solid #d1fae5;
  display: flex; align-items: center; justify-content: center;
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 14px; font-weight: 700; color: #16a34a;
  line-height: 1; flex-shrink: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,0.10);
}
#shopify-section-{{ sid }} .cdp-free-title {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px; color: #1a0a2e; line-height: 1.4; flex: 1;
}
#shopify-section-{{ sid }} .cdp-pimg {
  width: 44px; height: 44px; flex-shrink: 0; border-radius: 7px;
  overflow: hidden; background: #f5eefe;
}
#shopify-section-{{ sid }} .cdp-pimg img { width: 100%; height: 100%; object-fit: cover; display: block; }
#shopify-section-{{ sid }} .cdp-pinfo { flex: 1 1 auto; min-width: 0; }
#shopify-section-{{ sid }} .cdp-ptitle {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 12.5px; color: #1a0a2e; line-height: 1.35; display: block;
}
#shopify-section-{{ sid }} .cdp-pprice {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px; font-weight: 600; color: #1a0a2e; white-space: nowrap; flex-shrink: 0;
}

/* Total row */
#shopify-section-{{ sid }} .cdp-total {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 12px; margin-top: 4px;
}
#shopify-section-{{ sid }} .cdp-total-lbl {
  font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px;
  font-weight: 500; color: #1a0a2e;
}
#shopify-section-{{ sid }} .cdp-total-vals { display: flex; align-items: baseline; gap: 8px; }
#shopify-section-{{ sid }} .cdp-cmp-val {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 13px; color: #aaa; text-decoration: line-through;
}
#shopify-section-{{ sid }} .cdp-kit-price {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 15px; font-weight: 700; color: #1a0a2e;
}

/* Bottom image desktop only */
#shopify-section-{{ sid }} .cdp-btm-img { display: none; }
@media (min-width: 769px) {
  #shopify-section-{{ sid }} .cdp-btm-img { display: block; border-radius: 16px; overflow: hidden; }
}
#shopify-section-{{ sid }} .cdp-btm-img img { width: 100%; height: auto; display: block; }
</style>

<section class="cdp-outer" aria-label="{{ s.heading | escape }}" {{ section.shopify_attributes }}>
  <div class="cdp-wrap">

    {%- comment -%}── HEADER ──{%- endcomment -%}
    <header class="cdp-header">
      {%- if s.heading != blank -%}
        <h2 class="cdp-title">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subtext != blank -%}
        <p class="cdp-sub">{{ s.subtext }}</p>
      {%- endif -%}
    </header>

    {%- comment -%}── DESKTOP TABS ──{%- endcomment -%}
    <nav class="cdp-tabs-d" aria-label="Kit tabs" role="tablist">
      {%- assign tab_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <button
            class="cdp-tab-btn{% if tab_i == 0 %} cdp-active{% endif %}"
            data-idx="{{ tab_i }}"
            type="button"
            role="tab"
            aria-selected="{% if tab_i == 0 %}true{% else %}false{% endif %}"
            aria-controls="cdp-panel-{{ sid }}-{{ tab_i }}"
            id="cdp-tab-{{ sid }}-{{ tab_i }}"
            {{ block.shopify_attributes }}>
            <span class="cdp-tab-name">{{ block.settings.tab_title | default: 'Kit Tab' }}</span>
            {%- if block.settings.tab_subtitle != blank -%}
              <span class="cdp-tab-note">{{ block.settings.tab_subtitle }}</span>
            {%- endif -%}
          </button>
          {%- assign tab_i = tab_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%}── MOBILE TAB CARDS ──{%- endcomment -%}
    <div class="cdp-tabs-m" role="tablist" aria-label="Kit tabs mobile">
      {%- assign tab_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <button
            class="cdp-card-btn{% if tab_i == 0 %} cdp-active{% endif %}"
            data-idx="{{ tab_i }}"
            type="button"
            role="tab"
            aria-selected="{% if tab_i == 0 %}true{% else %}false{% endif %}"
            aria-controls="cdp-panel-{{ sid }}-{{ tab_i }}"
            aria-label="{{ block.settings.tab_title | default: 'Kit Tab' | escape }}">
            <div class="cdp-card-img-wrap">
              {%- if block.settings.tab_image != blank -%}
                {{ block.settings.tab_image
                   | image_url: width: 300
                   | image_tag: loading: 'lazy', class: 'cdp-card-img',
                     alt: block.settings.tab_title | escape }}
              {%- endif -%}
            </div>
            <div class="cdp-card-text">
              <span class="cdp-card-name">{{ block.settings.tab_title | default: 'Kit Tab' }}</span>
              {%- if block.settings.tab_subtitle != blank -%}
                <span class="cdp-card-note">{{ block.settings.tab_subtitle }}</span>
              {%- endif -%}
            </div>
          </button>
          {%- assign tab_i = tab_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%}── PANELS ──{%- endcomment -%}
    {%- assign tab_counter = 0 -%}
    {%- for outer_block in section.blocks -%}
      {%- if outer_block.type == 'tab' -%}

        {%- assign ts     = ts_arr[tab_counter] | plus: 0 -%}
        {%- assign tc_nxt = tab_counter | plus: 1 -%}
        {%- assign te_raw = ts_arr[tc_nxt] -%}
        {%- if te_raw == blank -%}
          {%- assign te = section.blocks.size -%}
        {%- else -%}
          {%- assign te = te_raw | plus: 0 -%}
        {%- endif -%}

        <div
          class="cdp-panel{% if tab_counter == 0 %} cdp-active{% endif %}"
          data-panel="{{ tab_counter }}"
          id="cdp-panel-{{ sid }}-{{ tab_counter }}"
          role="tabpanel"
          aria-labelledby="cdp-tab-{{ sid }}-{{ tab_counter }}"
          {% unless tab_counter == 0 %}hidden{% endunless %}>

          {%- comment -%}══ LEFT ══{%- endcomment -%}
          <div class="cdp-left">

            {%- if outer_block.settings.l_heading != blank -%}
              <h3 class="cdp-l-heading">{{ outer_block.settings.l_heading }}</h3>
            {%- endif -%}
            {%- if outer_block.settings.l_desc != blank -%}
              <div class="cdp-l-desc">{{ outer_block.settings.l_desc }}</div>
            {%- endif -%}
            {%- if outer_block.settings.l_sub != blank -%}
              <p class="cdp-l-sub">{{ outer_block.settings.l_sub }}</p>
            {%- endif -%}

            {%- comment -%} FIX 1 (b_open): ul always rendered, items looped inside — no conditional open/close tags {%- endcomment -%}
            <ul class="cdp-bullets">
              {%- assign bci = 0 -%}
              {%- for b in section.blocks -%}
                {%- if bci > ts and bci < te and b.type == 'bullet_item' -%}
                  <li {{ b.shopify_attributes }}>
                    <span class="cdp-check" aria-hidden="true">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <polyline points="2,6.5 5,9.5 10,3" stroke="white" stroke-width="2.2"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    {{ b.settings.text }}
                  </li>
                {%- endif -%}
                {%- assign bci = bci | plus: 1 -%}
              {%- endfor -%}
            </ul>

            <div class="cdp-spacer"></div>

            {%- if outer_block.settings.btn_text != blank -%}
              <a href="{{ outer_block.settings.btn_url | default: '#' }}" class="cdp-cta">
                {{ outer_block.settings.btn_text }}
              </a>
            {%- endif -%}

            {%- comment -%} FIX 2 (f_open): div always rendered, items looped inside — no conditional open/close tags {%- endcomment -%}
            <div class="cdp-foot" role="list" aria-label="Guarantees">
              {%- assign fci = 0 -%}
              {%- for b in section.blocks -%}
                {%- if fci > ts and fci < te and b.type == 'footer_item' -%}
                  <span class="cdp-foot-item" role="listitem" {{ b.shopify_attributes }}>
                    {%- if b.settings.icon_image != blank -%}
                      {{ b.settings.icon_image
                         | image_url: width: 40
                         | image_tag: loading: 'lazy', class: 'cdp-foot-icon',
                           width: 14, height: 14, alt: '' }}
                    {%- else -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <circle cx="10" cy="10" r="7.5"/>
                        <line x1="10" y1="7" x2="10" y2="10.5"/>
                        <circle cx="10" cy="13" r="0.7" fill="currentColor" stroke="none"/>
                      </svg>
                    {%- endif -%}
                    {{ b.settings.text }}
                  </span>
                {%- endif -%}
                {%- assign fci = fci | plus: 1 -%}
              {%- endfor -%}
            </div>

          </div>

          {%- comment -%}══ RIGHT ══{%- endcomment -%}
          <div class="cdp-right">
            <div class="cdp-pcard">

              {%- if outer_block.settings.r_heading != blank -%}
                <h3 class="cdp-r-heading">{{ outer_block.settings.r_heading }}</h3>
              {%- endif -%}
              {%- if outer_block.settings.gifts_label != blank -%}
                <p class="cdp-r-gifts">{{ outer_block.settings.gifts_label }}</p>
              {%- endif -%}

              {%- comment -%} FIX 3 (pr_open): ul always rendered, products looped inside — no conditional open/close tags {%- endcomment -%}
              <ul class="cdp-prod-list" aria-label="Kit products">
                {%- assign pri = 0 -%}
                {%- for b in section.blocks -%}
                  {%- if pri > ts and pri < te and b.type == 'tabproduct' -%}
                    {%- assign prod = b.settings.product -%}
                    {%- if prod != blank -%}
                      <li class="cdp-prod-row" {{ b.shopify_attributes }}>
                        <div class="cdp-pimg">
                          {%- if prod.featured_image != blank -%}
                            {{ prod.featured_image
                               | image_url: width: 120
                               | image_tag: loading: 'lazy', alt: prod.title | escape }}
                          {%- endif -%}
                        </div>
                        <div class="cdp-pinfo">
                          <span class="cdp-ptitle">{{ prod.title }}</span>
                        </div>
                        <span class="cdp-pprice">{{ prod.price | money_without_trailing_zeros }}</span>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                  {%- assign pri = pri | plus: 1 -%}
                {%- endfor -%}
              </ul>

              {%- comment -%} FIX 4 (fr_open): ul always rendered, free items looped inside — no conditional open/close tags {%- endcomment -%}
              {%- comment -%} Pre-scan show_on_desktop from first free_item in this tab range {%- endcomment -%}
              {%- assign fr_desktop = false -%}
              {%- assign frdi = 0 -%}
              {%- for b in section.blocks -%}
                {%- if frdi > ts and frdi < te and b.type == 'free_item' and fr_desktop == false -%}
                  {%- if b.settings.show_on_desktop -%}{%- assign fr_desktop = true -%}{%- endif -%}
                {%- endif -%}
                {%- assign frdi = frdi | plus: 1 -%}
              {%- endfor -%}
              <ul class="cdp-free-list{% if fr_desktop %} cdp-show-desktop{% endif %}" aria-label="Free gifts">
                {%- assign fri = 0 -%}
                {%- for b in section.blocks -%}
                  {%- if fri > ts and fri < te and b.type == 'free_item' -%}
                    {%- assign fp1 = b.settings.product_1 -%}
                    {%- assign fp2 = b.settings.product_2 -%}
                    {%- assign fp3 = b.settings.product_3 -%}
                    {%- assign fp4 = b.settings.product_4 -%}
                    {%- if fp1 != blank -%}
                      <li class="cdp-free-row" {{ b.shopify_attributes }}>
                        <div class="cdp-free-badge" aria-label="Free gift">
                          <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M8 1a2 2 0 0 1 1.732 3H13a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.268A2 2 0 0 1 8 1zm0 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM3 8h5v7H4a1 1 0 0 1-1-1V8zm6 0h4v6a1 1 0 0 1-1 1H9V8z"/>
                          </svg>
                          Free
                        </div>
                        <div class="cdp-free-body">
                          <div class="cdp-free-imgs" aria-hidden="true">
                            <div class="cdp-pimg">
                              {%- if fp1.featured_image != blank -%}
                                {{ fp1.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                              {%- endif -%}
                            </div>
                            {%- if fp2 != blank -%}
                              <span class="cdp-plus-icon" aria-hidden="true">+</span>
                              <div class="cdp-pimg">
                                {%- if fp2.featured_image != blank -%}
                                  {{ fp2.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            {%- if fp3 != blank -%}
                              <span class="cdp-plus-icon" aria-hidden="true">+</span>
                              <div class="cdp-pimg">
                                {%- if fp3.featured_image != blank -%}
                                  {{ fp3.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            {%- if fp4 != blank -%}
                              <span class="cdp-plus-icon" aria-hidden="true">+</span>
                              <div class="cdp-pimg">
                                {%- if fp4.featured_image != blank -%}
                                  {{ fp4.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          </div>
                          <span class="cdp-free-title">
                            {{ fp1.title }}
                            {%- if fp2 != blank -%} + {{ fp2.title }}{%- endif -%}
                            {%- if fp3 != blank -%} + {{ fp3.title }}{%- endif -%}
                            {%- if fp4 != blank -%} + {{ fp4.title }}{%- endif -%}
                          </span>
                        </div>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                  {%- assign fri = fri | plus: 1 -%}
                {%- endfor -%}
              </ul>

              {%- comment -%} TOTAL — 100% original logic, zero changes {%- endcomment -%}
              {%- assign sum_p   = 0 -%}
                {%- assign sum_c   = 0 -%}
                {%- assign has_cmp = false -%}
                {%- assign tbi     = 0 -%}

                {%- for b in section.blocks -%}
                {%- if tbi > ts and tbi < te and b.type == 'tabproduct' -%}
                    {%- assign tp = b.settings.product -%}

                    {%- if tp != blank -%}
                    {%- assign sum_p = sum_p | plus: tp.price -%}

                    {%- if tp.compare_at_price > 0 -%}
                        {%- assign sum_c   = sum_c | plus: tp.compare_at_price -%}
                        {%- assign has_cmp = true -%}
                    {%- endif -%}

                    {%- endif -%}
                {%- endif -%}

                {%- assign tbi = tbi | plus: 1 -%}
                {%- endfor -%}

              {%- if sum_p > 0 or outer_block.settings.kitprice != blank -%}
                <div class="cdp-total">
                  <span class="cdp-total-lbl">Total kit value</span>
                  <div class="cdp-total-vals">
                    {%- if has_cmp -%}
                      <s class="cdp-cmp-val" aria-label="Original price">{{ sum_c | money_without_trailing_zeros }}</s>
                    {%- endif -%}
                    {%- if outer_block.settings.kitprice != blank -%}
                      <strong class="cdp-kit-price">{{ outer_block.settings.kitprice }}</strong>
                    {%- elsif sum_p > 0 -%}
                      <strong class="cdp-kit-price">{{ sum_p | money_without_trailing_zeros }}</strong>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            </div>

            {%- if outer_block.settings.bottom_image != blank -%}
              <div class="cdp-btm-img">
                {{ outer_block.settings.bottom_image
                   | image_url: width: 900
                   | image_tag: loading: 'lazy', alt: outer_block.settings.tab_title | escape }}
              </div>
            {%- endif -%}

          </div>

        </div>

        {%- assign tab_counter = tab_counter | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

  </div>
</section>

<script>
(function () {
  var sid = '{{ sid }}';
  function init() {
    var sec = document.getElementById('shopify-section-' + sid);
    if (!sec) return;
    var btnsD  = sec.querySelectorAll('.cdp-tab-btn');
    var btnsM  = sec.querySelectorAll('.cdp-card-btn');
    var panels = sec.querySelectorAll('.cdp-panel');

    function activate(idx) {
      btnsD.forEach(function(b) {
        b.classList.remove('cdp-active');
        b.setAttribute('aria-selected', 'false');
      });
      btnsM.forEach(function(b) {
        b.classList.remove('cdp-active');
        b.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function(p) {
        p.classList.remove('cdp-active');
        p.setAttribute('hidden', '');
      });

      var dBtn  = sec.querySelector('.cdp-tab-btn[data-idx="'  + idx + '"]');
      var mBtn  = sec.querySelector('.cdp-card-btn[data-idx="' + idx + '"]');
      var panel = sec.querySelector('.cdp-panel[data-panel="'  + idx + '"]');

      if (dBtn)  { dBtn.classList.add('cdp-active');  dBtn.setAttribute('aria-selected', 'true'); }
      if (mBtn)  { mBtn.classList.add('cdp-active');  mBtn.setAttribute('aria-selected', 'true'); }
      if (panel) { panel.classList.add('cdp-active'); panel.removeAttribute('hidden'); }
    }

    btnsD.forEach(function(btn) {
      btn.addEventListener('click', function() { activate(parseInt(btn.dataset.idx, 10)); });
    });
    btnsM.forEach(function(btn) {
      btn.addEventListener('click', function() { activate(parseInt(btn.dataset.idx, 10)); });
    });
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', init)
    : init();
})();
</script>

