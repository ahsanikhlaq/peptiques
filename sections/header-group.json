        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  .alura-header-bar-wrapper {\n    background-color: #FFFFFF;\n    display: flex;\n    justify-content: center;\n  }\n\n  .alura-header-bar {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 7px 14px;\n    font-size: 13.2px;\n    font-weight: 500;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    color: #000000;\n    max-width: 800px;\n    width: 100%;\n    gap: 14px;\n    box-sizing: border-box;\n  }\n\n  .alura-header-bar .item {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    white-space: nowrap;\n  }\n\n  .alura-header-bar .icon {\n    width: 13px;\n    height: 13px;\n    display: inline-block;\n    vertical-align: middle;\n  }\n\n  .alura-header-bar .icon-outline {\n    fill: none;\n    stroke: #000000;\n    stroke-width: 1.6;\n  }\n\n  .alura-header-bar .stars {\n    display: flex;\n    gap: 1.5px;\n  }\n\n  .alura-header-bar .star {\n    background-color: #00B67A;\n    width: 13px;\n    height: 13px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .alura-header-bar .star svg {\n    fill: white;\n    width: 8px;\n    height: 8px;\n  }\n\n  @media (max-width: 500px) {\n    .alura-header-bar {\n      font-size: 12px;\n      gap: 10px;\n      padding: 6px 10px;\n    }\n\n    .alura-header-bar .icon {\n      width: 12px;\n      height: 12px;\n    }\n\n    .alura-header-bar .star {\n      width: 12px;\n      height: 12px;\n    }\n\n    .alura-header-bar .star svg {\n      width: 7px;\n      height: 7px;\n    }\n  }\n</style>\n\n<div class=\"alura-header-bar-wrapper\">\n  <div class=\"alura-header-bar\">\n    <span class=\"item\">\n      <!-- Gift Icon -->\n      <svg class=\"icon icon-outline\" viewBox=\"0 0 24 24\">\n        <path d=\"M20 12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-7\"/>\n        <path d=\"M4 12h16\"/>\n        <path d=\"M12 22V12\"/>\n        <path d=\"M12 8h8v4H4V8h8z\"/>\n        <path d=\"M9.5 3a1.5 1.5 0 1 1 0 3c-1.5 0-3-1.5-3-3s1.5-1.5 3 0z\"/>\n        <path d=\"M14.5 3a1.5 1.5 0 1 1 0 3c-1.5 0-3-1.5-3-3s1.5-1.5 3 0z\"/>\n      </svg>\n      <span>Free Gifts</span>\n    </span>\n\n    <span class=\"item\">\n      <!-- Heart Icon -->\n      <svg class=\"icon icon-outline\" viewBox=\"0 0 24 24\">\n        <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 \n                 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09\n                 C13.09 3.81 14.76 3 16.5 3 \n                 19.58 3 22 5.42 22 8.5\n                 c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n      </svg>\n      <span>22,000+ Members</span>\n      <span class=\"stars\">\n        {% for _ in (1..5) %}\n        <span class=\"star\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24\n                     l-7.19-.61L12 2 9.19 8.63 2 9.24\n                     l5.46 4.73L5.82 21z\"/>\n          </svg>\n        </span>\n        {% endfor %}\n      </span>\n    </span>\n  </div>\n</div>",
