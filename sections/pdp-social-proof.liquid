{% comment %}
  Social Proof — auto-scrolling customer photo row + Swiper reviews slider
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign photo_count  = 0
  assign review_count = 0
  for block in section.blocks
    case block.type
      when 'photo'
        assign photo_count = photo_count | plus: 1
      when 'review'
        assign review_count = review_count | plus: 1
    endcase
  endfor
-%}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css">

<style>
  #shopify-section-{{ sid }} .ps-section {
    padding: {{ s.section_padding_top | default: 48 }}px 0 {{ s.section_padding_bottom | default: 48 }}px;
    background: linear-gradient(90deg, #F5E1FF 0%, #FFFFFF 50%, #F5E1FF 100%);
    color: {{ s.text_color | default: '#000000' }};
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ps-section {
      padding: {{ s.section_padding_top_desktop | default: 80 }}px 0 {{ s.section_padding_bottom_desktop | default: 80 }}px;
    }
  }

  #shopify-section-{{ sid }} .ps-head {
    max-width: 1340px;
    margin: 0 auto {{ s.head_margin_bottom | default: 32 }}px;
    padding: 0 {{ s.section_padding_x | default: 16 }}px;
    text-align: center;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ps-head { padding: 0 {{ s.section_padding_x_desktop | default: 50 }}px; }
  }
  #shopify-section-{{ sid }} .ps-heading {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: #000000;
    margin: 0 0 16px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.07em;
    font-size: clamp(1.75rem, 2.4vw + 1rem, 46px);
  }
  #shopify-section-{{ sid }} .ps-sub {
    font-family: 'DM Sans';
    color: {{ s.sub_color | default: '#000000' }};
    margin: 0 auto;
    max-width: 602px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    font-size: 16px;
  }

  /* ─── Photo strip ──────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ps-photos {
    overflow: hidden;
    margin: {{ s.photos_margin_top | default: 24 }}px 0 {{ s.photos_margin_bottom | default: 32 }}px;
    mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  #shopify-section-{{ sid }} .ps-photos-track {
    display: flex;
    gap: {{ s.photo_gap | default: 12 }}px;
    padding: 12px 0;
    background: #FFFFFF;
    width: max-content;
    animation: ps-marquee-{{ sid }} {{ s.photo_speed_seconds | default: 40 }}s linear infinite;
  }
  #shopify-section-{{ sid }} .ps-photos:hover .ps-photos-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ps-photos-track { animation: none; }
  }
  @keyframes ps-marquee-{{ sid }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  #shopify-section-{{ sid }} .ps-photo {
    flex: 0 0 auto;
    width: {{ s.photo_width_mobile | default: 150 }}px;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    background: #e8dcef;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ps-photo {
      width: {{ s.photo_width_desktop | default: 200 }}px;
    }
  }
  #shopify-section-{{ sid }} .ps-photo img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  /* ─── Swiper Reviews ────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ps-reviews-wrap {
    max-width: 1340px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ps-reviews-wrap {
      padding: 0 {{ s.section_padding_x_desktop | default: 50 }}px;
    }
  }

  #shopify-section-{{ sid }} .ps-review {
    padding: 24px 16px;
    color: inherit;
    text-align: center;
  }
  #shopify-section-{{ sid }} .ps-review-quote {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    font-weight: 400;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
    color: #000000;
  }
  #shopify-section-{{ sid }} .ps-review-body {
    font-family: 'DM Sans';
    color: #000000;
    font-size: 14.6px;
    line-height: 18.8px;
    letter-spacing: -0.03em;
    margin: 0 auto 16px;
  }
  #shopify-section-{{ sid }} .ps-review-meta {
    font-family: 'DM Sans';
    color: #000000;
    font-size: 14px;
    line-height: 20.3px;
    letter-spacing: -0.03em;
    font-weight: 500;
    margin: 0 0 8px;
  }
  #shopify-section-{{ sid }} .ps-stars {
    display: inline-flex;
    gap: 2px;
    color: {{ s.stars_color | default: '#f5b301' }};
  }
  #shopify-section-{{ sid }} .ps-stars svg { width: 16px; height: 16px; }

  /* ─── Nav buttons ───────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ps-nav {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-top: 32px;
  }
  #shopify-section-{{ sid }} .ps-nav-btn {
    width: 50px; height: 50px;
    border-radius: 50%;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 160ms ease, transform 160ms ease;
    color: #ffffff;
  }
  #shopify-section-{{ sid }} .ps-nav-btn--prev {
    background: {{ s.nav_prev_background | default: '#bba0d4' }};
  }
  #shopify-section-{{ sid }} .ps-nav-btn--next {
    background: {{ s.nav_next_background | default: '#3f1c5c' }};
  }
  #shopify-section-{{ sid }} .ps-nav-btn:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .ps-nav-btn:active { transform: translateY(1px); }
  #shopify-section-{{ sid }} .ps-nav-btn.swiper-button-disabled {
    cursor: not-allowed;
    transform: none;
  }
  #shopify-section-{{ sid }} .ps-nav-btn svg { width: 19px; height: 19px; }

  /* ─── Mobile overrides ──────────────────────────────────────── */
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .ps-heading {
      font-size: 30px;
      line-height: 110%;
      letter-spacing: -0.04em;
      max-width: 100%;
      margin: 0 auto 8px;
    }
    #shopify-section-{{ sid }} .ps-sub {
      font-size: 14.6px;
      line-height: 18.8px;
      letter-spacing: -0.03em;
      text-align: center;
      max-width: 100%;
    }
    #shopify-section-{{ sid }} .ps-head { margin: 0 auto 24px; }
    #shopify-section-{{ sid }} .ps-photo { border-radius: 6.8px; }
    #shopify-section-{{ sid }} .ps-photos-track { gap: 6.6px; padding: 6.6px 0; }
    #shopify-section-{{ sid }} .ps-photos { margin: 0px 0 24px; }
    #shopify-section-{{ sid }} .ps-review { padding: 0; }
    #shopify-section-{{ sid }} .ps-nav { gap: 10px; margin-top: 16px; }
    #shopify-section-{{ sid }} .ps-nav-btn svg { width: 14px; height: 14px; }
    #shopify-section-{{ sid }} .ps-nav-btn { width: 35px; height: 35px; }
    #shopify-section-{{ sid }} .ps-review-quote {
      font-size: 20px;
      line-height: 22.7px;
      letter-spacing: -0.03em;
      text-align: center;
      margin: 0 0 10px;
    }
    #shopify-section-{{ sid }} .ps-review-body {
      font-size: 12.8px;
      line-height: 15.4px;
      letter-spacing: -0.03em;
      margin: 0 auto 10px;
    }
    #shopify-section-{{ sid }} .ps-review-meta {
      font-size: 12px;
      line-height: 120%;
      letter-spacing: -0.03em;
    }
  }

  /* ══ SCROLL ANIMATIONS ════════════════════════════════════════ */
  #shopify-section-{{ sid }}.pb-js [data-pb-anim] {
    opacity: 0;
    will-change: opacity, transform;
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim="up"] { transform: translateY(28px); }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim].pb-visible {
    opacity: 1;
    transform: translateX(0) translateY(0);
    will-change: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }}.pb-js [data-pb-anim] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<section class="ps-section" {{ section.shopify_attributes }}>
  <div class="ps-head" data-pb-anim="up" data-pb-delay="0">
    <h2 class="ps-heading">{{ s.heading_text | default: 'Ingredients That Just Do More' }}</h2>
    {%- if s.subheading_text != blank -%}
      <p class="ps-sub">{{ s.subheading_text }}</p>
    {%- endif -%}
  </div>

  {%- if photo_count > 0 -%}
    <div
      class="ps-photos"
      aria-label="{{ s.photos_aria_label | default: 'Customer photos' }}"
      data-pb-anim="up"
      data-pb-delay="80"
    >
      <div class="ps-photos-track">
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'photo' -%}
              <div class="ps-photo"
                   aria-hidden="{% if pass == 2 %}true{% else %}false{% endif %}"
                   {%- if pass == 1 -%}{{ block.shopify_attributes }}{%- endif -%}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 400 | image_tag:
                       loading: 'lazy',
                       widths: '160,240,320,400',
                       sizes: '(min-width: 1024px) 160px, 130px',
                       alt: block.settings.alt_text | default: 'Customer photo' }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if review_count > 0 -%}
    <div class="ps-reviews-wrap" data-pb-anim="up" data-pb-delay="160">
      <div class="swiper ps-swiper-{{ sid }}">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <article class="swiper-slide ps-review" {{ block.shopify_attributes }}>
                <p class="ps-review-quote">"{{ block.settings.quote_text }}"</p>
                {%- if block.settings.body_text != blank -%}
                  <p class="ps-review-body">{{ block.settings.body_text }}</p>
                {%- endif -%}
                <p class="ps-review-meta">{{ block.settings.author_label | default: 'Verified Review' }}</p>
                <span class="ps-stars" aria-label="{{ block.settings.stars | default: 5 }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.stars -%}
                      <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z"/></svg>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="ps-nav">
        <button type="button" class="ps-nav-btn ps-nav-btn--prev" id="ps-prev-{{ sid }}" aria-label="Previous review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        </button>
        <button type="button" class="ps-nav-btn ps-nav-btn--next" id="ps-next-{{ sid }}" aria-label="Next review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js"></script>
<script>
(function () {
  var sid     = '{{ sid }}';
  var prevBtn = document.getElementById('ps-prev-' + sid);
  var nextBtn = document.getElementById('ps-next-' + sid);

  var PREV_BG = '{{ s.nav_prev_background | default: "#bba0d4" }}';
  var NEXT_BG = '{{ s.nav_next_background | default: "#3f1c5c" }}';

  var swiper = new Swiper('.ps-swiper-' + sid, {
    slidesPerView: 4,
    spaceBetween: {{ s.review_gap | default: 16 }},
    centeredSlides: false,
    breakpoints: {
      0: {
        slidesPerView: 1.2,
        centeredSlides: true,
        spaceBetween: 12
      },
      1024: {
        slidesPerView: {{ s.reviews_per_view | default: 4 }},
        centeredSlides: false,
        spaceBetween: {{ s.review_gap | default: 16 }}
      }
    },
    on: {
      init:        updateNavColors,
      slideChange: updateNavColors,
    }
  });

  if (prevBtn) prevBtn.addEventListener('click', function () {
    swiper.slidePrev();
  });
  if (nextBtn) nextBtn.addEventListener('click', function () {
    swiper.slideNext();
  });

  function updateNavColors() {
    if (!prevBtn || !nextBtn) return;
    if (swiper.isEnd) {
      prevBtn.style.background = NEXT_BG;
      nextBtn.style.background = PREV_BG;
    } else {
      prevBtn.style.background = PREV_BG;
      nextBtn.style.background = NEXT_BG;
    }
  }

  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === sid) {
      swiper.update();
      updateNavColors();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Social Proof",
  "tag": "section",
  "class": "ps-social-proof",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background",  "label": "Section background",  "default": "#f6efff" },
    { "type": "color", "id": "text_color",           "label": "Heading / quote color","default": "#1d1027" },
    { "type": "color", "id": "sub_color",            "label": "Subtle text color",    "default": "#5b4f6b" },
    { "type": "color", "id": "stars_color",          "label": "Stars color",          "default": "#f5b301" },
    { "type": "color", "id": "nav_prev_background",  "label": "Prev button bg",       "default": "#bba0d4" },
    { "type": "color", "id": "nav_next_background",  "label": "Next button bg",       "default": "#3f1c5c" },

    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "heading_text",        "label": "Heading",    "default": "Ingredients That Just Do More" },
    { "type": "textarea", "id": "subheading_text",     "label": "Subheading", "default": "Unlike complex formulas with dozens of ingredients, Haritaki™ contains just ONE powerful ingredient:" },
    { "type": "text",     "id": "heading_font_family", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Photo strip" },
    { "type": "range", "id": "photo_speed_seconds", "label": "Loop duration",        "min": 10, "max": 120, "step": 5,  "unit": "s",  "default": 40 },
    { "type": "range", "id": "photo_gap",           "label": "Gap between photos",   "min": 0,  "max": 40,  "step": 2,  "unit": "px", "default": 12 },
    { "type": "range", "id": "photo_width_mobile",  "label": "Photo width (Mobile)", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 130 },
    { "type": "range", "id": "photo_width_desktop", "label": "Photo width (Desktop)","min": 100,"max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "photos_margin_top",   "label": "Photos top margin",    "min": 0,  "max": 80,  "step": 4,  "unit": "px", "default": 24 },
    { "type": "range", "id": "photos_margin_bottom","label": "Photos bottom margin", "min": 0,  "max": 80,  "step": 4,  "unit": "px", "default": 32 },
    { "type": "text",  "id": "photos_aria_label",   "label": "Photos aria-label",    "default": "Customer photos" },

    { "type": "header", "content": "Reviews" },
    { "type": "range", "id": "reviews_per_view", "label": "Reviews visible (Desktop)", "min": 1, "max": 5, "step": 1,  "default": 4 },
    { "type": "range", "id": "review_gap",       "label": "Gap between reviews",       "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "head_margin_bottom",            "label": "Heading margin bottom",    "min": 0, "max": 80,  "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "section_padding_top",           "label": "Padding top (Mobile)",     "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom",        "label": "Padding bottom (Mobile)",  "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x",             "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",   "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop","label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",     "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Customer photo",
      "settings": [
        { "type": "image_picker", "id": "image",    "label": "Image" },
        { "type": "text",         "id": "alt_text", "label": "Alt text", "default": "Customer photo" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text",     "id": "quote_text",   "label": "Quote (will be wrapped in \"\")" },
        { "type": "textarea", "id": "body_text",    "label": "Body" },
        { "type": "text",     "id": "author_label", "label": "Author label", "default": "Verified Review" },
        { "type": "range",    "id": "stars",        "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Social Proof",
      "category": "Custom",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "review", "settings": { "quote_text": "My clarity came back.",               "body_text": "My gut felt off, my sleep was broken, and my mind felt foggy. Haritaki helped me feel lighter, clearer, and more like myself again." } },
        { "type": "review", "settings": { "quote_text": "My mind feels clear again.",           "body_text": "Cleaner digestion, steadier energy, and a noticeably sharper sense of focus throughout the day." } },
        { "type": "review", "settings": { "quote_text": "Simple, powerful, and easy to trust.", "body_text": "I love that it's just one ingredient, but the impact feels bigger across energy, clarity, and balance." } },
        { "type": "review", "settings": { "quote_text": "It helped me feel aligned again.",     "body_text": "Less fog, better rhythm, and a more connected feeling from morning to night." } }
      ]
    }
  ]
}
{% endschema %}