<script>
  document.addEventListener('DOMContentLoaded', function () {

    function updateCtaButtonsWithSaveText() {
      var selectedBundle = document.querySelector('.bundle-option.is-selected');
      if (!selectedBundle) return;
      var saveEl = selectedBundle.querySelector('.bundle-option__save');
      var saveText = saveEl ? saveEl.textContent.trim() : '';
      var percentMatch = saveText.match(/(\d+)\s*%/);
      var percent = percentMatch ? percentMatch[1] : null;

      var ctaButtons = document.querySelectorAll('.ritual-kit__cta-btn');
      ctaButtons.forEach(function (btn) {
        if (!btn.dataset.originalText) {
          btn.dataset.originalText = btn.textContent.trim();
        }
        if (percent) {
          btn.textContent = 'SAVE ' + percent + '% + FREE GIFTS';
        } else {
          btn.textContent = btn.dataset.originalText;
        }
      });
    }

    updateCtaButtonsWithSaveText();

    document.querySelectorAll('.bundle-option').forEach(function (option) {
      option.addEventListener('click', function () {
        setTimeout(updateCtaButtonsWithSaveText, 10);
      });
    });

    document.querySelectorAll('.ritual-kit__cta-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();

        var items = [];

        var selectedBundle = document.querySelector('.bundle-option.is-selected');
        if (selectedBundle) {
          var bundleRadio = selectedBundle.querySelector('input[type="radio"]');
          var bundleVariantId = bundleRadio ? bundleRadio.getAttribute('id') : null;
          var bundleQty = parseInt(selectedBundle.getAttribute('data-all-qty'), 10) || 1;
          if (bundleVariantId) {
            items.push({ id: parseInt(bundleVariantId, 10), quantity: bundleQty });
          }
        }

        var kitProductsRaw = btn.getAttribute('data-kit-products');
        if (kitProductsRaw) {
          try {
            var decoded = kitProductsRaw
              .replace(/&quot;/g, '"').replace(/&#39;/g, "'")
              .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
            var kitProducts = JSON.parse(decoded);
            kitProducts.forEach(function (kp) {
              if (!kp.variant_id) return;
              var item = { id: parseInt(kp.variant_id, 10), quantity: 1 };
              if (kp.selling_plan) item.selling_plan = parseInt(kp.selling_plan, 10);
              items.push(item);
            });
          } catch (err) {
            console.error('[CTA] Could not parse kit products', err);
          }
        }

        if (items.length === 0) {
          alert('Nothing to add to cart');
          return;
        }

        var cartDrawer = document.querySelector('cart-drawer');

        var formData = new FormData();
        items.forEach(function (item, index) {
          formData.append('items[' + index + '][id]', item.id);
          formData.append('items[' + index + '][quantity]', item.quantity);
          if (item.selling_plan) {
            formData.append('items[' + index + '][selling_plan]', item.selling_plan);
          }
        });

        formData.append('sections', 'cart-drawer,cart-icon-bubble');
        formData.append('sections_url', window.location.pathname);

        btn.disabled = true;
        var originalText = btn.textContent;
        btn.textContent = 'Adding...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Accept': 'application/javascript',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: formData
        })
          .then(function (res) { return res.json(); })
          .then(function (response) {
            console.log('[CTA] Cart response:', response);

            if (response.status && response.status !== 200) {
              alert(response.description || response.message || 'Could not add to cart');
              btn.disabled = false;
              btn.textContent = originalText;
              return;
            }

            // Update sections
            if (response.sections) {
              if (response.sections['cart-drawer']) {
                var drawerContainer = document.getElementById('CartDrawer');
                var parsedDrawer = new DOMParser().parseFromString(response.sections['cart-drawer'], 'text/html');
                var newDrawerContent = parsedDrawer.querySelector('#CartDrawer');
                if (drawerContainer && newDrawerContent) {
                  drawerContainer.innerHTML = newDrawerContent.innerHTML;
                }
              }
              if (response.sections['cart-icon-bubble']) {
                var bubbleContainer = document.getElementById('cart-icon-bubble');
                var parsedBubble = new DOMParser().parseFromString(response.sections['cart-icon-bubble'], 'text/html');
                var newBubbleContent = parsedBubble.querySelector('.shopify-section') || parsedBubble.body;
                if (bubbleContainer && newBubbleContent) {
                  bubbleContainer.innerHTML = newBubbleContent.innerHTML;
                }
              }
            }

            // ===== Remove ALL empty-state classes so the new items show =====
            var drawerEl = document.querySelector('cart-drawer');
            if (drawerEl) {
              drawerEl.classList.remove('is-empty');
              drawerEl.classList.remove('cart-empty');
              drawerEl.classList.remove('drawer--empty');
            }
            var cartItemsEl = document.querySelector('cart-drawer-items');
            if (cartItemsEl) {
              cartItemsEl.classList.remove('is-empty');
            }
            var cartDrawerInner = document.querySelector('.cart-drawer');
            if (cartDrawerInner) {
              cartDrawerInner.classList.remove('is-empty');
              cartDrawerInner.classList.remove('cart-drawer--empty');
            }
            document.body.classList.remove('cart-empty');

            // Open the drawer
            if (cartDrawer && typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            } else if (cartDrawer) {
              cartDrawer.classList.add('animate', 'active');
              document.body.classList.add('overflow-hidden');
            }

            btn.disabled = false;
            btn.textContent = originalText;
          })
          .catch(function (err) {
            console.error('[CTA] Error:', err);
            alert('Error: ' + (err.message || 'Unknown error'));
            btn.disabled = false;
            btn.textContent = originalText;
          });
      });
    });
  });
</script>

