{% comment %}
  Benefits — PDP benefits section (Haritaki accordion + image).
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign bg_image = nil
  if s.bg_image_desktop != blank
    assign bg_image = s.bg_image_desktop
  endif

  assign mobile_bg_image = nil
  if s.bg_image_mobile != blank
    assign mobile_bg_image = s.bg_image_mobile
  elsif bg_image != blank
    assign mobile_bg_image = bg_image
  endif

  assign heading_text = s.heading_text | default: "Haritaki™ isn't just a supplement"
-%}

<style>
  /* ── Section shell ────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-section {
    padding: {{ s.section_padding_top | default: 48 }}px {{ s.section_padding_x | default: 0 }}px {{ s.section_padding_bottom | default: 48 }}px;
    background: {{ s.outer_background | default: '#ffffff' }};
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pb-section {
      padding: {{ s.section_padding_top_desktop | default: 80 }}px {{ s.section_padding_x_desktop | default: 0 }}px {{ s.section_padding_bottom_desktop | default: 80 }}px;
    }
  }

  /* ── Card ─────────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-card {
    max-width: 100%;
    margin-inline: auto;
    border-radius: {{ s.card_radius | default: 0 }}px;
    padding: 40px 16px;
    color: {{ s.heading_color | default: '#ffffff' }};
    overflow: hidden;
    background-color: {{ s.card_background | default: '#3f1c5c' }};
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
  }
  {% if mobile_bg_image != blank %}
  @media (max-width: 1023px) {
    #shopify-section-{{ sid }} .pb-card {
      background-image: url({{ mobile_bg_image | image_url: width: 900 }});
    }
  }
  {% endif %}
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pb-card {
      padding: 80px 0px;
      {% if bg_image != blank %}
        background-image: url({{ bg_image | image_url: width: 1800 }});
      {% endif %}
    }
  }

  /* ── Grid ─────────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pb-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 48px;
      padding: 0px 50px;
    }
  }

  /* ── Heading ──────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-heading {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: #fff;
    font-size: 46px;
    font-style: normal;
    font-weight: 400;
    line-height: 100%;
    letter-spacing: -3.22px;
    margin: 0 0 20px;
    max-width: 600px;
    width: 100%;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pb-heading {
      font-size: 30px;
      font-weight: 400;
      line-height: 110%;
      letter-spacing: -4%;
      margin: 0 0 10px;
    }
  }

  /* ── Description (richtext) ───────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-desc {
    color: #fff;
    font-family: "DM Sans";
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: -0.48px;
    max-width: 600px;
    width: 100%;
    margin: 0 0 42px;
  }
  #shopify-section-{{ sid }} .pb-desc p {
    margin: 0 0 8px;
  }
  #shopify-section-{{ sid }} .pb-desc p:last-child {
    margin-bottom: 0;
  }
  #shopify-section-{{ sid }} .pb-desc strong { font-weight: 700; }
  #shopify-section-{{ sid }} .pb-desc a { color: inherit; }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pb-desc {
      font-size: 14.6px;
      line-height: 18.8px;
      letter-spacing: -3%;
      margin-bottom: 200px;
    }
  }

  /* ── Benefit list ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pb-list { gap: 12px; }
  }

  /* ── Benefit item ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-item {
    background: #ffffff;
    color: #1d1027;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: default;
  }
  #shopify-section-{{ sid }} .pb-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.13);
  }

  /* ── Row ──────────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pb-row {
      padding: 10px;
      gap: 10px;
      align-items: start;
    }
  }

  /* ── Icon ─────────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: {{ s.icon_background | default: '#f3eaf9' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ s.icon_color | default: '#5a2a78' }};
    flex-shrink: 0;
  }
  .pb-icon img { width: 100%; }
  #shopify-section-{{ sid }} .pb-icon svg { width: 20px; height: 20px; }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pb-icon { width: 36px; height: 36px; }
  }

  /* ── Title ────────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-title {
    color: var(--Black, #000);
    font-family: 'Georgia';
    font-size: 18.8px;
    font-weight: 400;
    line-height: 120%;
    letter-spacing: -0.564px;
    margin: 0;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pb-title {
      font-size: 16px;
      line-height: 120%;
      letter-spacing: 0%;
    }
  }

  /* ── Subtitle ─────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-subtitle {
    color: #665169;
    font-family: "DM Sans";
    font-size: 12.8px;
    font-weight: 400;
    line-height: 15.4px;
    letter-spacing: -0.384px;
    margin: 0;
    display: block;
  }

  /* ── pb-text ──────────────────────────────────────────────────── */
  .pb-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @media (max-width: 768px) {
    .pb-text { gap: 6px; }
  }

  /* ── Media / image col ────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pb-media {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: end;
    order: -1;
  }
  {% if s.hide_image_on_mobile %}
    @media (max-width: 1023.98px) {
      #shopify-section-{{ sid }} .pb-media { display: none; }
    }
  {% endif %}
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pb-media { order: 0; }
  }
  #shopify-section-{{ sid }} .pb-media img {
    width: 100%;
    height: auto;
    max-width: 520px;
    max-height: 560px;
    object-fit: contain;
    display: block;
  }

  /* ── Icon + text row ──────────────────────────────────────────── */
  .main-img-faq {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .main-img-faq { gap: 10px; }
  }

  /* ══ SCROLL ANIMATIONS ════════════════════════════════════════ */
  #shopify-section-{{ sid }}.pb-js [data-pb-anim] {
    opacity: 0;
    will-change: opacity, transform;
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim="up"]    { transform: translateY(28px); }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim="left"]  { transform: translateX(-36px); }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim="right"] { transform: translateX(36px); }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim].pb-visible {
    opacity: 1;
    transform: translateX(0) translateY(0);
    will-change: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }}.pb-js [data-pb-anim] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<div
  class="pb-section"
  {{ section.shopify_attributes }}
  aria-label="{{ heading_text | escape }}"
>
  <div class="pb-card" role="region" aria-label="{{ heading_text | escape }}">
    <div class="pb-grid">

      {%- comment -%} ── LEFT: text + benefit list ── {%- endcomment -%}
      <div class="pb-content">

        <h2
          class="pb-heading"
          data-pb-anim="left"
          data-pb-delay="0"
        >{{ heading_text }}</h2>

        {%- if s.description_text != blank -%}
          <div
            class="pb-desc"
            data-pb-anim="left"
            data-pb-delay="80"
          >{{ s.description_text }}</div>
        {%- endif -%}

        <ul class="pb-list" role="list" aria-label="Product benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              {%- assign delay_ms = forloop.index0 | times: 70 | plus: 120 -%}
              <li
                class="pb-item"
                {{ block.shopify_attributes }}
                data-pb-anim="up"
                data-pb-delay="{{ delay_ms }}"
              >
                <div class="pb-row">
                  <div class="main-img-faq">
                    <span class="pb-icon" aria-hidden="true">
                      {%- if block.settings.icon_image != blank -%}
                        {{ block.settings.icon_image
                            | image_url: width: 80
                            | image_tag:
                                loading: 'lazy',
                                widths: '40,80',
                                alt: '' }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
                      {%- endif -%}
                    </span>
                    <span class="pb-text">
                      <span class="pb-title">{{ block.settings.title_text }}</span>
                      {%- if block.settings.subtitle_text != blank -%}
                        <span class="pb-subtitle">{{ block.settings.subtitle_text }}</span>
                      {%- endif -%}
                    </span>
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} ── RIGHT: product image ── {%- endcomment -%}
      <div
        class="pb-media"
        data-pb-anim="right"
        data-pb-delay="100"
      >
        {%- if s.image != blank -%}
          {{ s.image
              | image_url: width: 1040
              | image_tag:
                  loading: 'lazy',
                  widths: '320,480,640,820,1040',
                  sizes: '(min-width: 1024px) 480px, 90vw',
                  alt: s.image_alt | default: 'Haritaki capsules' }}
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "pb-benefits",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Background image — Desktop" },
    { "type": "image_picker", "id": "bg_image_mobile",  "label": "Background image — Mobile (falls back to desktop)" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "outer_background",  "label": "Outer background",  "default": "#ffffff" },
    { "type": "color", "id": "card_background",   "label": "Card background",   "default": "#3f1c5c" },
    { "type": "color", "id": "heading_color",     "label": "Heading color",     "default": "#ffffff" },
    { "type": "color", "id": "description_color", "label": "Description color", "default": "#e8dcef" },
    { "type": "color", "id": "icon_color",        "label": "Icon color",        "default": "#5a2a78" },
    { "type": "color", "id": "icon_background",   "label": "Icon background",   "default": "#f3eaf9" },

    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "heading_text",        "label": "Heading",             "default": "Haritaki™ isn't just a supplement" },
    { "type": "richtext", "id": "description_text",    "label": "Description",         "default": "<p>It's the ancient Ayurvedic secret called \"The King of Medicines\" — now in a convenient daily capsule designed to cleanse your pineal gland and awaken your Third Eye.</p>" },
    { "type": "text",     "id": "heading_font_family", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image",              "label": "Capsules image" },
    { "type": "text",         "id": "image_alt",          "label": "Image alt text",       "default": "Haritaki capsules" },
    { "type": "checkbox",     "id": "hide_image_on_mobile","label": "Hide image on mobile", "default": true },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",            "label": "Padding top (Mobile)",     "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom",         "label": "Padding bottom (Mobile)",  "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x",              "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",    "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop", "label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",      "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "card_radius",                    "label": "Card radius",              "min": 0, "max": 40,  "step": 2, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text",         "id": "title_text",    "label": "Title" },
        { "type": "text",         "id": "subtitle_text", "label": "Subtitle" },
        { "type": "image_picker", "id": "icon_image",    "label": "Icon (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Benefits",
      "category": "Custom",
      "blocks": [
        { "type": "benefit", "settings": { "title_text": "Pineal Gland Cleansing",        "subtitle_text": "Supports natural detox and inner clarity." } },
        { "type": "benefit", "settings": { "title_text": "Third Eye Activation",           "subtitle_text": "Supports vivid dreams and deeper connection." } },
        { "type": "benefit", "settings": { "title_text": "Mental Clarity & Focus",         "subtitle_text": "Helps clear brain fog and sharpen awareness." } },
        { "type": "benefit", "settings": { "title_text": "Gut-Brain Connection",           "subtitle_text": "Helps improve clarity and concentration." } },
        { "type": "benefit", "settings": { "title_text": "Sustained Natural Energy",       "subtitle_text": "All-day clean energy without the crash." } },
        { "type": "benefit", "settings": { "title_text": "Deeper, More Restorative Sleep", "subtitle_text": "Supports deeper sleep and more vivid dreams." } }
      ]
    }
  ]
}
{% endschema %}