{% comment %}
  Nature Card — "Only Nature, Nothing Fake" + "Suggested use".
  Fresh, minimal rewrite (defensive Liquid, only 6-digit hex defaults,
  no chained `default:`, very simple schema).
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign badge_count = 0
  assign ingredient_count = 0
  for block in section.blocks
    case block.type
      when 'badge'
        assign badge_count = badge_count | plus: 1
      when 'ingredient'
        assign ingredient_count = ingredient_count | plus: 1
    endcase
  endfor
-%}

<style>
  #shopify-section-{{ sid }} .nc-section{
    padding: 48px 16px;
    background: {{ s.outer_background | default: '#f5f0fc' }};
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .nc-section{ padding: 80px 50px; }
  }

  #shopify-section-{{ sid }} .nc-wrap{
    max-width: 1340px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .nc-wrap{
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  #shopify-section-{{ sid }} .nc-card{
    border-radius: 20px;
    padding: 28px 24px;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .nc-card{ padding: 48px 48px; }
  }

  /* Left card (light) */
  #shopify-section-{{ sid }} .nc-left{
    background: {{ s.left_bg | default: '#f5edff' }};
    color: {{ s.left_text | default: '#1d1027' }};
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  #shopify-section-{{ sid }} .nc-heading{
    font-family: {{ s.heading_font | default: 'Georgia, "Times New Roman", serif' }};
    color: inherit;
    margin: 0 0 8px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 1.8vw + 1rem, 36px);
  }
  #shopify-section-{{ sid }} .nc-subheading{
    color: {{ s.left_subtle | default: '#5b4f6b' }};
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }
  #shopify-section-{{ sid }} .nc-badges{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 8px;
  }
  @media (min-width: 540px){
    #shopify-section-{{ sid }} .nc-badges{ grid-template-columns: repeat(4, 1fr); }
  }
  #shopify-section-{{ sid }} .nc-badge{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  #shopify-section-{{ sid }} .nc-badge-icon{
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid {{ s.badge_ring | default: '#5a2a78' }};
    color: {{ s.badge_icon | default: '#5a2a78' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .nc-badge-icon img{
    width: 70%; height: 70%; object-fit: contain; display: block;
  }
  #shopify-section-{{ sid }} .nc-badge-label{
    margin: 0;
    font-size: 12px;
    color: inherit;
    line-height: 1.3;
  }

  #shopify-section-{{ sid }} .nc-cta{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: {{ s.cta_bg | default: '#3f1c5c' }};
    color: {{ s.cta_text | default: '#ffffff' }};
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 13px;
    border-radius: 999px;
    padding: 16px 24px;
    border: 0;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(63,28,92,0.22);
  }
  #shopify-section-{{ sid }} .nc-cta:hover{ background: {{ s.cta_hover_bg | default: '#5a2a78' }}; }

  #shopify-section-{{ sid }} .nc-footer{
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    justify-content: center;
    color: {{ s.left_subtle | default: '#5b4f6b' }};
    font-size: 13px;
  }

  /* Right card (dark) */
  #shopify-section-{{ sid }} .nc-right{
    background: {{ s.right_bg | default: '#3f1c5c' }};
    color: {{ s.right_text | default: '#ffffff' }};
  }
  #shopify-section-{{ sid }} .nc-right-heading{
    font-family: {{ s.heading_font | default: 'Georgia, "Times New Roman", serif' }};
    margin: 0 0 8px;
    font-weight: 400;
    line-height: 1.15;
    font-size: clamp(1.25rem, 1vw + 1rem, 28px);
    color: inherit;
  }
  #shopify-section-{{ sid }} .nc-right-intro{
    color: rgba(255,255,255,0.85);
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.5;
  }
  #shopify-section-{{ sid }} .nc-right-label{
    font-weight: 600;
    font-size: 14px;
    margin: 0 0 8px;
    color: inherit;
  }
  #shopify-section-{{ sid }} .nc-table{
    background: rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0 0 16px;
  }
  #shopify-section-{{ sid }} .nc-row{
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    padding: 8px 0;
    font-size: 14px;
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .nc-row + .nc-row{
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  #shopify-section-{{ sid }} .nc-row-head{
    font-weight: 600;
    border-bottom: 1px solid rgba(255,255,255,0.18);
    padding-bottom: 8px;
    margin-bottom: 4px;
  }
  #shopify-section-{{ sid }} .nc-row em{
    font-style: italic;
    display: block;
    font-size: 12px;
    opacity: 0.85;
  }
  #shopify-section-{{ sid }} .nc-disclaimer{
    background: rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }
</style>

<section class="nc-section" {{ section.shopify_attributes }}>
  <div class="nc-wrap">

    <article class="nc-card nc-left">
      <div>
        <h2 class="nc-heading">{{ s.left_heading | default: 'Only Nature, Nothing Fake' }}</h2>
        {% if s.left_sub != blank %}<p class="nc-subheading">{{ s.left_sub }}</p>{% endif %}
      </div>

      {% if badge_count > 0 %}
        <div class="nc-badges">
          {% for block in section.blocks %}
            {% if block.type == 'badge' %}
              <div class="nc-badge" {{ block.shopify_attributes }}>
                <div class="nc-badge-icon">
                  {% if block.settings.icon_image != blank %}
                    {{ block.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.label }}
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/></svg>
                  {% endif %}
                </div>
                <p class="nc-badge-label">{{ block.settings.label }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div>
        {% if s.cta_text != blank %}
          <a href="{{ s.cta_url | default: '#' }}" class="nc-cta">{{ s.cta_text }}</a>
        {% endif %}
        {% if s.footer_text != blank %}
          <div class="nc-footer" style="margin-top: 12px;">{{ s.footer_text }}</div>
        {% endif %}
      </div>
    </article>

    <article class="nc-card nc-right">
      <h3 class="nc-right-heading">{{ s.right_heading | default: 'Suggested use:' }}</h3>
      {% if s.right_intro != blank %}<p class="nc-right-intro">{{ s.right_intro }}</p>{% endif %}
      <p class="nc-right-label">{{ s.right_label | default: 'each serving contains' }}</p>

      <div class="nc-table">
        <div class="nc-row nc-row-head">
          <span>{{ s.amount_header | default: 'Amount Per Serving' }}</span>
          <span></span>
          <span>{{ s.dv_header | default: '%DV' }}</span>
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <div class="nc-row" {{ block.shopify_attributes }}>
              <span>
                {{ block.settings.name }}
                {% if block.settings.subtitle != blank %}<em>({{ block.settings.subtitle }})</em>{% endif %}
              </span>
              <span>{{ block.settings.amount }}</span>
              <span>{{ block.settings.dv }}</span>
            </div>
          {% endif %}
        {% endfor %}
        {% if s.daily_value_note != blank %}
          <p style="margin: 8px 0 0; font-size: 12px; color: rgba(255,255,255,0.7);">{{ s.daily_value_note }}</p>
        {% endif %}
      </div>

      {% if s.disclaimer_text != blank %}
        <p class="nc-disclaimer">{{ s.disclaimer_text }}</p>
      {% endif %}
    </article>

  </div>
</section>

{% schema %}
{
  "name": "Nature Card",
  "tag": "section",
  "class": "nc-nature-card",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "outer_background", "label": "Section background", "default": "#f5f0fc" },
    { "type": "color", "id": "left_bg",          "label": "Left card bg",       "default": "#f5edff" },
    { "type": "color", "id": "left_text",        "label": "Left card text",     "default": "#1d1027" },
    { "type": "color", "id": "left_subtle",      "label": "Left subtle text",   "default": "#5b4f6b" },
    { "type": "color", "id": "badge_ring",       "label": "Badge ring",         "default": "#5a2a78" },
    { "type": "color", "id": "badge_icon",       "label": "Badge icon",         "default": "#5a2a78" },
    { "type": "color", "id": "cta_bg",           "label": "CTA bg",             "default": "#3f1c5c" },
    { "type": "color", "id": "cta_text",         "label": "CTA text",           "default": "#ffffff" },
    { "type": "color", "id": "cta_hover_bg",     "label": "CTA hover bg",       "default": "#5a2a78" },
    { "type": "color", "id": "right_bg",         "label": "Right card bg",      "default": "#3f1c5c" },
    { "type": "color", "id": "right_text",       "label": "Right card text",   "default": "#ffffff" },

    { "type": "header", "content": "Left content" },
    { "type": "text",     "id": "left_heading", "label": "Heading",     "default": "Only Nature, Nothing Fake" },
    { "type": "textarea", "id": "left_sub",     "label": "Subheading",  "default": "Real Ayurvedic wisdom designed to deliver clarity, balance, and results" },
    { "type": "text",     "id": "cta_text",     "label": "CTA text",    "default": "UNLOCK YOUR TRUE POWER" },
    { "type": "url",      "id": "cta_url",      "label": "CTA URL" },
    { "type": "text",     "id": "footer_text",  "label": "Footer text", "default": "Stop or Cancel Anytime | Refills Ship Every 90 days" },

    { "type": "header", "content": "Right content" },
    { "type": "text",     "id": "right_heading",     "label": "Heading",     "default": "Suggested use:" },
    { "type": "textarea", "id": "right_intro",       "label": "Intro",       "default": "Take two capsules per day one in the morning, another in the evening." },
    { "type": "text",     "id": "right_label",       "label": "Table label", "default": "each serving contains" },
    { "type": "text",     "id": "amount_header",     "label": "Amount header","default": "Amount Per Serving" },
    { "type": "text",     "id": "dv_header",         "label": "DV header",   "default": "%DV" },
    { "type": "text",     "id": "daily_value_note",  "label": "Daily value note", "default": "*Daily value not established" },
    { "type": "textarea", "id": "disclaimer_text",   "label": "Disclaimer",  "default": "* These supplements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." },

    { "type": "header", "content": "Typography" },
    { "type": "text", "id": "heading_font", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Free-from badge",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon (image, optional)" },
        { "type": "text",         "id": "label",      "label": "Label", "default": "Plastic Free" }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient row",
      "settings": [
        { "type": "text", "id": "name",     "label": "Name",     "default": "Haritaki fruit powder" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (italic, in parens)", "default": "Terminalia chebula" },
        { "type": "text", "id": "amount",   "label": "Amount",   "default": "500 mg" },
        { "type": "text", "id": "dv",       "label": "%DV value","default": "**" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Nature Card",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "No Synthetic" } },
        { "type": "badge", "settings": { "label": "Non Gmo" } },
        { "type": "badge", "settings": { "label": "Sugar Free" } },
        { "type": "badge", "settings": { "label": "Gluten Free" } },
        { "type": "ingredient", "settings": { "name": "Haritaki fruit powder", "subtitle": "Terminalia chebula", "amount": "500 mg", "dv": "**" } }
      ]
    }
  ]
}
{% endschema %}
