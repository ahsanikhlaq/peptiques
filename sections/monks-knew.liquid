{% comment %}
  Monks Knew 5,000 Years Ago — fourth PDP section.
  Built from Figma: Trypeptiques 2.0 / PDP (Frame 2147243115 / Frame 2147243117).
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.headingFontFamily_text | default: 'Georgia, "Times New Roman", serif'
  assign body_font    = section.settings.bodyFontFamily_text    | default: '"DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif'
  assign sid          = section.id
  assign s            = section.settings

  assign embed_url = ''
  if s.video_url contains 'youtube.com' or s.video_url contains 'youtu.be'
    assign yt_id = s.video_url | split: 'v=' | last | split: '&' | first
    if s.video_url contains 'youtu.be/'
      assign yt_id = s.video_url | split: 'youtu.be/' | last | split: '?' | first
    endif
    assign embed_url = 'https://www.youtube.com/embed/' | append: yt_id | append: '?autoplay=1&rel=0'
  elsif s.video_url contains 'vimeo.com'
    assign vid = s.video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first
    assign embed_url = 'https://player.vimeo.com/video/' | append: vid | append: '?autoplay=1'
  endif

  assign badge_count = 0
  assign footer_count = 0
  for block in section.blocks
    case block.type
      when 'trust_badge'
        assign badge_count = badge_count | plus: 1
      when 'footer_item'
        assign footer_count = footer_count | plus: 1
    endcase
  endfor
-%}

<style>
  :root {
    --mk-{{ sid }}-pt: {{ s.sectionPaddingTop_responsive_range_mobile    | default: s.sectionPaddingTop_responsive_range_desktop    | default: 48 }}px;
    --mk-{{ sid }}-pb: {{ s.sectionPaddingBottom_responsive_range_mobile | default: s.sectionPaddingBottom_responsive_range_desktop | default: 48 }}px;
    --mk-{{ sid }}-pl: {{ s.sectionPaddingLeft_responsive_range_mobile   | default: s.sectionPaddingLeft_responsive_range_desktop   | default: 16 }}px;
    --mk-{{ sid }}-pr: {{ s.sectionPaddingRight_responsive_range_mobile  | default: s.sectionPaddingRight_responsive_range_desktop  | default: 16 }}px;
  }
  @media (min-width: 1024px) {
    :root {
      --mk-{{ sid }}-pt: {{ s.sectionPaddingTop_responsive_range_desktop    | default: 80 }}px;
      --mk-{{ sid }}-pb: {{ s.sectionPaddingBottom_responsive_range_desktop | default: 80 }}px;
      --mk-{{ sid }}-pl: {{ s.sectionPaddingLeft_responsive_range_desktop   | default: 50 }}px;
      --mk-{{ sid }}-pr: {{ s.sectionPaddingRight_responsive_range_desktop  | default: 50 }}px;
    }
  }

  #shopify-section-{{ sid }} .mk-section{
    padding: var(--mk-{{ sid }}-pt) var(--mk-{{ sid }}-pr) var(--mk-{{ sid }}-pb) var(--mk-{{ sid }}-pl);
    background: {{ s.sectionBackground_color | default: '#f3e8ff' }};
  }

  #shopify-section-{{ sid }} .mk-container{
    max-width: {{ s.containerMaxWidth_number | default: 1340 }}px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.gridGap_mobile_number | default: 24 }}px;
    align-items: stretch;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .mk-container{
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: {{ s.gridGap_desktop_number | default: 32 }}px;
    }
  }

  #shopify-section-{{ sid }} .mk-media{
    position: relative;
    border-radius: {{ s.mediaRadius_number | default: 20 }}px;
    overflow: hidden;
    background: {{ s.mediaBackground_color | default: '#cdb6e6' }};
    aspect-ratio: 1 / 1;
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .mk-media img,
  #shopify-section-{{ sid }} .mk-media video,
  #shopify-section-{{ sid }} .mk-media iframe{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    border: 0;
  }
  #shopify-section-{{ sid }} .mk-play{
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: 0;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    z-index: 2;
    transition: transform 180ms ease, background 180ms ease;
  }
  #shopify-section-{{ sid }} .mk-play:hover{ transform: translate(-50%, -50%) scale(1.06); background: #fff; }
  #shopify-section-{{ sid }} .mk-play svg{ width: 24px; height: 24px; color: #1d1027; margin-left: 3px; }
  @media (prefers-reduced-motion: reduce){ #shopify-section-{{ sid }} .mk-play{ transition: none; } }

  #shopify-section-{{ sid }} .mk-content{
    background: {{ s.contentBackground_color | default: '#f6efff' }};
    border-radius: {{ s.contentRadius_number | default: 20 }}px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .mk-content{ padding: 48px 56px; }
  }

  #shopify-section-{{ sid }} .mk-heading{
    font-family: {{ heading_font }};
    color: {{ s.headingTextColor_color | default: '#1d1027' }};
    text-align: center;
    margin: 0 0 12px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 2vw + 1rem, {{ s.headingSize_desktop_number | default: 42 }}px);
  }
  #shopify-section-{{ sid }} .mk-subheading{
    font-family: {{ body_font }};
    color: {{ s.subheadingTextColor_color | default: '#5b4f6b' }};
    text-align: center;
    margin: 0 auto 32px;
    line-height: 1.5;
    max-width: 42ch;
    font-size: clamp(0.875rem, 0.3vw + 0.8rem, 1rem);
  }

  #shopify-section-{{ sid }} .mk-badges{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    margin: 0 0 28px;
  }
  #shopify-section-{{ sid }} .mk-badge{
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4px 10px;
    gap: 10px;
  }
  #shopify-section-{{ sid }} .mk-badge + .mk-badge{
    border-left: 1px solid {{ s.badgeDividerColor_color | default: 'rgba(29,16,39,0.12)' }};
  }
  #shopify-section-{{ sid }} .mk-badge-icon{
    width: {{ s.badgeIconSize_number | default: 44 }}px;
    height: {{ s.badgeIconSize_number | default: 44 }}px;
    display: inline-flex; align-items: center; justify-content: center;
    color: {{ s.badgeIconColor_color | default: '#5a2a78' }};
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .mk-badge-icon img{
    width: 100%; height: 100%; object-fit: contain; display: block;
  }
  #shopify-section-{{ sid }} .mk-badge-label{
    font-family: {{ body_font }};
    color: {{ s.badgeLabelColor_color | default: '#1d1027' }};
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
    max-width: 14ch;
    margin: 0;
  }

  #shopify-section-{{ sid }} .mk-cta{
    display: inline-flex;
    align-items: center; justify-content: center;
    background: {{ s.ctaBackground_color | default: '#3f1c5c' }};
    color: {{ s.ctaTextColor_color | default: '#ffffff' }};
    text-decoration: none;
    font-family: {{ body_font }};
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 13px;
    border-radius: {{ s.ctaRadius_number | default: 999 }}px;
    padding: 16px 24px;
    border: 0;
    cursor: pointer;
    width: 100%;
    box-shadow: 0 8px 22px rgba(63,28,92,0.22);
    transition: background 160ms ease, transform 160ms ease;
  }
  #shopify-section-{{ sid }} .mk-cta:hover{ background: {{ s.ctaHoverBackground_color | default: '#5a2a78' }}; }
  #shopify-section-{{ sid }} .mk-cta:active{ transform: translateY(1px); }

  #shopify-section-{{ sid }} .mk-footer{
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    font-family: {{ body_font }};
    color: {{ s.footerTextColor_color | default: '#5b4f6b' }};
    font-size: 13px;
  }
  #shopify-section-{{ sid }} .mk-footer-item{
    display: inline-flex; align-items: center; gap: 6px;
  }
  #shopify-section-{{ sid }} .mk-footer-divider{
    color: {{ s.footerDividerColor_color | default: 'rgba(29,16,39,0.24)' }};
  }
  #shopify-section-{{ sid }} .mk-footer-icon{ width: 14px; height: 14px; }

  #shopify-section-{{ sid }} .mk-player{
    position: fixed; inset: 0;
    background: rgba(8,2,14,0.85);
    display: none;
    align-items: center; justify-content: center;
    z-index: 9999;
    padding: 16px;
  }
  #shopify-section-{{ sid }} .mk-player[aria-hidden="false"]{ display: flex; }
  #shopify-section-{{ sid }} .mk-player-inner{
    position: relative;
    width: min(100%, 960px);
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 16px;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .mk-player-inner > iframe,
  #shopify-section-{{ sid }} .mk-player-inner > video{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border: 0;
  }
  #shopify-section-{{ sid }} .mk-player-close{
    position: absolute; top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: 0;
    cursor: pointer;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .mk-player-close svg{ width: 16px; height: 16px; color: #1d1027; }
</style>

<section class="mk-section" role="region" aria-labelledby="mk-heading-{{ sid }}" {{ section.shopify_attributes }}>
  <div class="mk-container">
    <div class="mk-media" data-mk-media data-embed="{{ embed_url }}" data-mp4="{{ s.video_file.src | default: '' }}">
      {%- if s.poster_image != blank -%}
        {{ s.poster_image | image_url: width: 1200 | image_tag:
             loading: 'lazy',
             widths: '480,640,900,1200',
             sizes: '(min-width: 1024px) 50vw, 100vw',
             alt: s.poster_alt_text | default: 'Haritaki video' }}
      {%- endif -%}
      {%- if embed_url != '' or s.video_file != blank -%}
        <button type="button" class="mk-play" data-mk-play aria-label="{{ s.video_aria_label_text | default: 'Play video' }}">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8V4z"/></svg>
        </button>
      {%- endif -%}
    </div>

    <div class="mk-content">
      <h2 id="mk-heading-{{ sid }}" class="mk-heading">{{ s.heading_text | default: 'Monks knew 5,000 years ago, now you do too' }}</h2>
      {%- if s.subheading_text != blank -%}
        <p class="mk-subheading">{{ s.subheading_text }}</p>
      {%- endif -%}

      {%- if badge_count > 0 -%}
        <div class="mk-badges" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              {%- assign b = block.settings -%}
              <div class="mk-badge" role="listitem" {{ block.shopify_attributes }}>
                <div class="mk-badge-icon">
                  {%- if b.icon_image != blank -%}
                    {{ b.icon_image | image_url: width: 120 | image_tag:
                         loading: 'lazy',
                         widths: '44,88,120',
                         alt: b.label_text }}
                  {%- elsif b.icon_svg != blank -%}
                    {{ b.icon_svg }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  {%- endif -%}
                </div>
                <p class="mk-badge-label">{{ b.label_text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.cta_text != blank -%}
        <a href="{{ s.cta_url | default: '#' }}" class="mk-cta" {% if s.cta_open_new_tab_checkbox %}target="_blank" rel="noopener"{% endif %}>
          {{ s.cta_text | default: 'UNLOCK YOUR TRUE POWER' }}
        </a>
      {%- endif -%}

      {%- if footer_count > 0 -%}
        <div class="mk-footer">
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_item' -%}
              {%- assign b = block.settings -%}
              {%- unless forloop.first -%}<span class="mk-footer-divider" aria-hidden="true">|</span>{%- endunless -%}
              <span class="mk-footer-item" {{ block.shopify_attributes }}>
                {%- if b.icon_svg != blank -%}{{ b.icon_svg }}{%- endif -%}
                <span>{{ b.label_text }}</span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if embed_url != '' or s.video_file != blank -%}
    <div class="mk-player" data-mk-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="Video player">
      <div class="mk-player-inner" data-mk-modal-inner></div>
      <button type="button" class="mk-player-close" data-mk-modal-close aria-label="Close video">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ sid }}');
    if (!root) return;
    var media = root.querySelector('[data-mk-media]');
    var play  = root.querySelector('[data-mk-play]');
    var modal = root.querySelector('[data-mk-modal]');
    var inner = root.querySelector('[data-mk-modal-inner]');
    var close = root.querySelector('[data-mk-modal-close]');
    if (!media || !modal) return;

    function open(){
      var embed = media.getAttribute('data-embed');
      var mp4   = media.getAttribute('data-mp4');
      inner.innerHTML = '';
      if (embed){
        var f = document.createElement('iframe');
        f.src = embed;
        f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
        f.allowFullscreen = true;
        f.loading = 'lazy';
        inner.appendChild(f);
      } else if (mp4){
        var v = document.createElement('video');
        v.src = mp4; v.controls = true; v.autoplay = true; v.playsInline = true;
        inner.appendChild(v);
      } else {
        return;
      }
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }
    function shut(){
      inner.innerHTML = '';
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }
    play && play.addEventListener('click', open);
    close && close.addEventListener('click', shut);
    modal.addEventListener('click', function(e){ if (e.target === modal) shut(); });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') shut();
    });
  })();
</script>

