{% comment %}
  Marquee — horizontal running text bar.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign item_count = 0
  for block in section.blocks
    if block.type == 'item'
      assign item_count = item_count | plus: 1
    endif
  endfor

  assign ls_value = s.letter_spacing | default: 6
  assign ls_em = ls_value | divided_by: 100.0
-%}

<style>
  #shopify-section-{{ sid }} .pm-bar{
    width: 100%;
    background: {{ s.background_color | default: '#3f1c5c' }};
    color: {{ s.text_color | default: '#ffffff' }};
    overflow: hidden;
    min-height: {{ s.bar_height | default: 56 }}px;
    display: flex;
    align-items: center;
  }
  #shopify-section-{{ sid }} .pm-track{
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    will-change: transform;
    animation: pm-marquee-{{ sid }} {{ s.duration_seconds | default: 30 }}s linear infinite;
  }
  #shopify-section-{{ sid }} .pm-bar:hover .pm-track{
    {% if s.pause_on_hover %}animation-play-state: paused;{% endif %}
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ sid }} .pm-track{ animation: none; }
  }
  @keyframes pm-marquee-{{ sid }}{
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  #shopify-section-{{ sid }} .pm-item{
    flex: 0 0 auto;
    padding: 0 {{ s.item_gap | default: 40 }}px;
    font-family: 'Inter';
    font-size: {{ s.font_size | default: 14 }}px;
    font-weight: {{ s.font_weight | default: 600 }};
    letter-spacing: {{ ls_em }}em;
    text-transform: {{ s.text_transform | default: 'uppercase' }};
    white-space: nowrap;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #FFFFFF;
  }
  #shopify-section-{{ sid }} .pm-item-icon{
    width: {{ s.icon_size | default: 20 }}px;
    height: {{ s.icon_size | default: 20 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: {{ s.icon_color | default: '#ffffff' }};
  }
  #shopify-section-{{ sid }} .pm-item-icon svg{ width: 100%; height: 100%; }
  #shopify-section-{{ sid }} .pm-item-icon img{ width: 100%; height: 100%; object-fit: contain; display: block; }
  @media (max-width:768px){
    #shopify-section-{{ sid }} .pm-bar { min-height: 60px; }
    #shopify-section-{{ sid }} .pm-item {
      padding: 0 12px;
      font-family: 'DM Sans';
      font-weight: 500;
      font-size: 14.6px;
      line-height: 100%;
      letter-spacing: -3%;
    }
  }

  /* ══ SCROLL ANIMATIONS ════════════════════════════════════════ */
  #shopify-section-{{ sid }}.pb-js [data-pb-anim] {
    opacity: 0;
    will-change: opacity, transform;
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim="up"] { transform: translateY(20px); }
  #shopify-section-{{ sid }}.pb-js [data-pb-anim].pb-visible {
    opacity: 1;
    transform: translateY(0);
    will-change: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }}.pb-js [data-pb-anim] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<div
  class="pm-bar"
  role="region"
  aria-label="{{ s.aria_label | default: 'Promotional bar' }}"
  {{ section.shopify_attributes }}
  data-pb-anim="up"
  data-pb-delay="0"
>
  <div class="pm-track">
    {% for pass in (1..2) %}
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <span class="pm-item" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            {% if block.settings.icon_image != blank %}
              <span class="pm-item-icon">
                {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '36,72', alt: '' }}
              </span>
            {% elsif block.settings.icon_svg != blank %}
              <span class="pm-item-icon">{{ block.settings.icon_svg }}</span>
            {% else %}
              <span class="pm-item-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0.5" y="0.5" width="19" height="19" rx="9.5" fill="white"/>
                  <rect x="0.5" y="0.5" width="19" height="19" rx="9.5" stroke="#47184D"/>
                  <path d="M14 7L8.5 12.5L6 10" stroke="#47184D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {% endif %}
            <span>{{ block.settings.label }}</span>
          </span>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "pm-marquee",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#47184d" },
    { "type": "color", "id": "text_color",       "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "icon_color",       "label": "Icon color (for SVG icons)", "default": "#ffffff" },

    { "type": "header", "content": "Animation" },
    { "type": "range",    "id": "duration_seconds", "label": "Loop duration (full pass)", "min": 5, "max": 120, "step": 5, "unit": "s", "default": 30 },
    { "type": "checkbox", "id": "pause_on_hover",   "label": "Pause on hover", "default": true },

    { "type": "header", "content": "Typography" },
    { "type": "text",  "id": "font_family",    "label": "Font-family", "default": "inherit" },
    { "type": "range", "id": "font_size",      "label": "Font size",   "min": 10, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "font_weight",    "label": "Font weight", "min": 300, "max": 900, "step": 100, "default": 500 },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 0 },
    { "type": "select","id": "text_transform", "label": "Text transform",
      "options": [
        { "value": "uppercase",  "label": "UPPERCASE" },
        { "value": "none",       "label": "Normal" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "bar_height", "label": "Bar height",  "min": 32, "max": 120, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "item_gap",   "label": "Item gap",    "min": 8,  "max": 120, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "icon_size",  "label": "Icon size",   "min": 10, "max": 40,  "step": 1, "unit": "px", "default": 20 },

    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Free from" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text",         "id": "label",      "label": "Label", "default": "NO SOY" },
        { "type": "image_picker", "id": "icon_image", "label": "Icon (image, optional)" },
        { "type": "html",         "id": "icon_svg",   "label": "Icon (inline SVG, optional)" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Marquee",
      "category": "Custom",
      "blocks": [
        { "type": "item", "settings": { "label": "NO SOY" } },
        { "type": "item", "settings": { "label": "NO FAT" } },
        { "type": "item", "settings": { "label": "NO CASEIN" } },
        { "type": "item", "settings": { "label": "NO ARTIFICIAL ADDITIVES" } },
        { "type": "item", "settings": { "label": "NO SUGAR" } },
        { "type": "item", "settings": { "label": "NO GLUTEN" } },
        { "type": "item", "settings": { "label": "NO GMOS" } },
        { "type": "item", "settings": { "label": "NO GLYPHOSATE" } },
        { "type": "item", "settings": { "label": "NO HORMONES" } },
        { "type": "item", "settings": { "label": "NO ANTIBIOTICS" } }
      ]
    }
  ]
}
{% endschema %}
