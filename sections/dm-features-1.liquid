      --{{ section.id }}--imageHeight_responsive_range: {{ section.settings.imageHeight_responsive_range_desktop }}px;
      --{{ section.id }}--imageImageAspectRatio_responsive_select: {{ section.settings.imageImageAspectRatio_responsive_select_desktop }};
    }
  }
</style>


<div class="block relative w-full transition-colors " style="background: {{ section.settings.sectionBackground_color }}; padding-top: var(--{{ section.id }}--sectionPaddingTop_responsive_range); padding-bottom: var(--{{ section.id }}--sectionPaddingBottom_responsive_range); padding-left: var(--{{ section.id }}--sectionPaddingLeft_responsive_range); padding-right: var(--{{ section.id }}--sectionPaddingRight_responsive_range);">
  <div class="mx-auto " style="max-width: {{ section.settings.sectionMaxWidth_number }}px;">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-20 items-center ">
      <div class="flex flex-col gap-4 md:gap-8 order-2 md:order-1">
        <h2 class=" {{ section.settings.titleTextStyle_font_mobile }} sm:{{ section.settings.titleTextStyle_font_desktop }} dropmagic-text" style="text-align: var(--{{ section.id }}--titleTextAlign_text_alignment); color: {{ section.settings.titleTextColor_color }};">{{ section.settings.title_text }}</h2>
        <div class="flex flex-col gap-4 ">
          <div class="flex flex-col w-full gap-y-3 ">
            {%- for block in section.blocks -%}

              {%- case block.type -%}
                {%- when 'dm-features-1-block' -%}
                {% render 'dm-features-1-block' block: block, cardStyle_select: block.settings.cardStyle_select, cardSize_select: block.settings.cardSize_select, cardRadius_range: block.settings.cardRadius_range, cardBackground_color: block.settings.cardBackground_color, cardBorder_color: block.settings.cardBorder_color, cardBorderWidth_number: block.settings.cardBorderWidth_number, title_text: block.settings.title_text, titleTextColor_color: block.settings.titleTextColor_color, titleTextStyle_font_desktop: block.settings.titleTextStyle_font_desktop, titleTextStyle_font_mobile: block.settings.titleTextStyle_font_mobile, titleTextAlign_text_alignment_desktop: block.settings.titleTextAlign_text_alignment_desktop, titleTextAlign_text_alignment_mobile: block.settings.titleTextAlign_text_alignment_mobile, description_text: block.settings.description_text, descriptionTextColor_color: block.settings.descriptionTextColor_color, descriptionTextStyle_font_desktop: block.settings.descriptionTextStyle_font_desktop, descriptionTextStyle_font_mobile: block.settings.descriptionTextStyle_font_mobile, descriptionTextAlign_text_alignment_desktop: block.settings.descriptionTextAlign_text_alignment_desktop, descriptionTextAlign_text_alignment_mobile: block.settings.descriptionTextAlign_text_alignment_mobile, icon_icon: block.settings.icon_icon, iconIconColor_color: block.settings.iconIconColor_color, iconIconSize_responsive_range_desktop: block.settings.iconIconSize_responsive_range_desktop, iconIconSize_responsive_range_mobile: block.settings.iconIconSize_responsive_range_mobile %}{%- endcase -%}
            {%- endfor -%}
          </div>
          <div class="flex flex-col gap-2 items-center">


            {%- capture button_classes -%}
              {% render 'dm_classname_utils'
               , type: "button",
               button_style: settings.button_style,
               button_variant: section.settings.button1ButtonVariant_select,
               button_size: section.settings.button1ButtonSize_select,
               button_width: "full" %}
            {%- endcapture -%}

            {% if section.settings.button1ButtonLink_link == "#add-to-cart" or section.settings.button1ButtonLink_link == nil %}
              <!-- If add to cart we render the form -->
              <dm-product-form class="w-full">
                {%- unless product_form_id -%}
                  {% assign product_form_id = 'product-form-dm-features-1' | append: section.id %}
                {%- endunless -%}
                {%- form 'product',
 product,
 id: product_form_id,
 class: 'form',
 novalidate: 'novalidate',
 data-type: 'add-to-cart-form'
 -%}
                  <input
                    type="hidden"
                    name="id"
                    class="product-variant-id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                    {% if section.settings.skip_cart %}data-skip-cart="true"{% endif %}>
                  <button
                    name="add"
                    type="submit"
                    style="{% if section.settings.button1ButtonRadius_number != nil %}border-radius: {{ section.settings.button1ButtonRadius_number }}px;{% endif %}"
                    class="gap-2.5 group rounded-md  text-center inline-flex items-center justify-center transition-all duration-150 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 {{ button_classes | strip }} {% if section.settings.button1Hide_responsive_checkbox_mobile %}dm-hidden sm:flex{% elsif section.settings.button1Hide_responsive_checkbox_desktop %}sm:dm-hidden{% endif %} ">

                    <p class=" {{ section.settings.button1TextTextStyle_font_mobile }} sm:{{ section.settings.button1TextTextStyle_font_desktop }} dropmagic-text" style="text-align: var(--{{ section.id }}--button1TextTextAlign_text_alignment); color: {{ section.settings.button1TextTextColor_color }};">{{ section.settings.button1Text_text }}</p>
                    {% if section.settings.button1Icon_icon %}
                      {% unless section.settings.button1Icon_icon == blank %}
                        {% assign icon_text = section.settings.button1Icon_icon | strip %}
                        {% if icon_text contains "<svg" %}
                          <div
                            data-dm-element="icon"
                            class="w-fit translate-x-0 group-hover:translate-x-1 transition-transform"
                            style="aspect-ratio: 1/1; color: {{ section.settings.button1IconIconColor_color }}; width: var(--{{ section.id }}--button1IconIconSize_responsive_range); height: var(--{{ section.id }}--button1IconIconSize_responsive_range);">{{ section.settings.button1Icon_icon }}</div>
                        {% else %}
                          <div
                            data-dm-element="icon"
                            class="w-fit translate-x-0 group-hover:translate-x-1 transition-transform"
                            style="font-size: var(--{{ section.id }}--button1IconIconSize_responsive_range);">{{ section.settings.button1Icon_icon }}</div>
                        {% endif %}
                      {% endunless %}
                  {% else %}
                    {% endif %}

                  </button>
                {%- endform -%}
              </dm-product-form>

            {% else %}
              {% unless section.settings.button1Hide_responsive_checkbox_mobile and section.settings.button1Hide_responsive_checkbox_desktop %}
                <!-- If link we put an <a> tag -->
                <a
                  class="gap-2.5 group rounded-md  text-center inline-flex items-center justify-center transition-all duration-150 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 {{ button_classes | strip }} {% if section.settings.button1Hide_responsive_checkbox_mobile %}dm-hidden sm:flex{% elsif section.settings.button1Hide_responsive_checkbox_desktop %}sm:dm-hidden{% endif %}"
                  href="{% if section.settings.button1ButtonLink_link == "#scroll-to-product" %}#product-hero-section{% else %}{{ section.settings.button1ButtonLink_link }}{% endif %}"
                  style="{% if section.settings.button1ButtonRadius_number != nil %}border-radius: {{ section.settings.button1ButtonRadius_number }}px;{% endif %}">

                  <p class=" {{ section.settings.button1TextTextStyle_font_mobile }} sm:{{ section.settings.button1TextTextStyle_font_desktop }} dropmagic-text" style="text-align: var(--{{ section.id }}--button1TextTextAlign_text_alignment); color: {{ section.settings.button1TextTextColor_color }};">{{ section.settings.button1Text_text }}</p>
                  {% if section.settings.button1Icon_icon %}
                    {% unless section.settings.button1Icon_icon == blank %}
                      {% assign icon_text = section.settings.button1Icon_icon | strip %}
                      {% if icon_text contains "<svg" %}
                        <div
                          data-dm-element="icon"
                          class="w-fit translate-x-0 group-hover:translate-x-1 transition-transform"
                          style="aspect-ratio: 1/1; color: {{ section.settings.button1IconIconColor_color }}; width: var(--{{ section.id }}--button1IconIconSize_responsive_range); height: var(--{{ section.id }}--button1IconIconSize_responsive_range);">{{ section.settings.button1Icon_icon }}</div>
                      {% else %}
                        <div
                          data-dm-element="icon"
                          class="w-fit translate-x-0 group-hover:translate-x-1 transition-transform"
                          style="font-size: var(--{{ section.id }}--button1IconIconSize_responsive_range);">{{ section.settings.button1Icon_icon }}</div>
                      {% endif %}
                    {% endunless %}
                {% else %}
                  {% endif %}

                </a>
              {% endunless %}
            {% endif %}

            <p class="text-center w-full {{ section.settings.buttonSubtitleTextStyle_font_mobile }} sm:{{ section.settings.buttonSubtitleTextStyle_font_desktop }} dropmagic-text" style="text-align: var(--{{ section.id }}--buttonSubtitleTextAlign_text_alignment); color: {{ section.settings.buttonSubtitleTextColor_color }};">{{ section.settings.buttonSubtitle_text }}</p>
          </div>
        </div>
      </div>

      <div class="relative order-1 md:order-2">

        {% unless section.settings.imageImageHide_responsive_checkbox_mobile and section.settings.imageImageHide_responsive_checkbox_desktop %}

          {% assign media_style_value = settings.media_style %}
          {% if section.settings.imageImageStyle_select != blank %}
            {% assign media_style_value = section.settings.imageImageStyle_select %}
          {% endif %}
          {% if section.settings.imageImageMask_media_mask != blank %}
            {% assign media_style_value = "none" %}
          {% endif %}


          {%- capture media_classes -%}
            {% render 'dm_classname_utils'
             , type: "media",
             media_style: media_style_value %}
          {%- endcapture -%}

          {% if section.settings.imageImageMask_media_mask != blank %}
            {% assign id_part = section.settings.imageImageMask_media_mask | split: 'id="' | last | split: '"' | first %}
            <svg
              width="0"
              height="0"
              style="position: absolute;">
              <defs>{{ section.settings.imageImageMask_media_mask }}</defs>
            </svg>
          {% endif %}

          {% liquid
    if imageHeight_responsive_range_mobile != blank
      assign mobile_width = 'w-auto'
    else
      assign mobile_width = 'w-full'
    endif

    if imageHeight_responsive_range_desktop != blank
      assign desktop_width = 'sm:w-auto'
    else
      assign desktop_width = 'sm:w-full'
    endif

    assign width_classes = mobile_width | append: ' ' | append: desktop_width
  %}

          {% if section.settings.image_media != blank or section.settings.image_media_video != blank %}
            <div class="relative max-w-full  {% if section.settings.imageImageHide_responsive_checkbox_mobile %}dm-hidden sm:flex{% elsif section.settings.imageImageHide_responsive_checkbox_desktop %}sm:dm-hidden{% endif %}" style="aspect-ratio: var(--{{ section.id }}--imageImageAspectRatio_responsive_select); height: var(--{{ section.id }}--imageHeight_responsive_range);">

              {% assign video_extensions = '.mp4,.webm,.mov,.avi,.avif,.m4v' | split: ',' %}
              {% assign is_valid_video = false %}
              {% for ext in video_extensions %}
                {% if section.settings.image_media_video contains ext %}
                  {% assign is_valid_video = true %}
                  {% break %}
                {% endif %}
              {% endfor %}

              {% if section.settings.image_media_video != blank and is_valid_video %}
                {% assign video_url = section.settings.image_media_video | split: '?' | first %}
                {% assign video_params = section.settings.image_media_video | split: '?' | last | split: '&' %}
                {% assign video_attrs = '' %}
                {% for param in video_params %}
                  {% assign key_value = param | split: '=' %}
                  {% assign key = key_value | first | downcase %}
                  {% assign value = key_value | last %}
                  {% case key %}
                    {% when 'loop' %}
                    {% assign video_attrs = video_attrs | append: ' loop' %}
                    {% when 'autoplay' %}
                    {% assign video_attrs = video_attrs | append: ' autoplay' %}
                    {% when 'muted' %}
                    {% assign video_attrs = video_attrs | append: ' muted' %}
                    {% when 'controls' %}
                    {% assign video_attrs = video_attrs | append: ' controls' %}
                    {% when 'playsinline' %}
                    {% assign video_attrs = video_attrs | append: ' playsinline' %}
                  {% endcase %}
                {% endfor %}
                <video
                  src="{{ video_url }}"
                  alt=" "
                  preload="metadata"
                  draggable="false"
                  class="border-solid h-full object-cover {{ media_classes | strip }} {{ width_classes }}"
                  style="{% if id_part != blank %}clip-path: url(#{{id_part}}); -webkit-clip-path: url(#{{id_part}});{% endif %} {% if section.settings.imageImageBorder_number != blank %} border-width: {{ section.settings.imageImageBorder_number }}px;{% endif %} {% if section.settings.imageImageBorder_color != blank %} border-color:{{ section.settings.imageImageBorder_color }};{% endif %} {% if section.settings.imageImageRadius_number != blank %} border-radius: {{ section.settings.imageImageRadius_number }}px;{% endif %} {% if section.settings.imageImagePosition_select != blank %} object-position: {{ section.settings.imageImagePosition_select }};{% endif %}"
                  {{ video_attrs }}></video>
              {% else %}
                <img
                  src="{{ section.settings.image_media | image_url }}"
                  alt=" "
                  draggable="false"
                  class="border-solid h-full object-cover {{ media_classes | strip }} {{ width_classes }}"
                  style="{% if id_part != blank %}clip-path: url(#{{id_part}}); -webkit-clip-path: url(#{{id_part}});{% endif %} {% if section.settings.imageImageBorder_number != blank %} border-width: {{ section.settings.imageImageBorder_number }}px;{% endif %} {% if section.settings.imageImageBorder_color != blank %} border-color:{{ section.settings.imageImageBorder_color }};{% endif %} {% if section.settings.imageImageRadius_number != blank %} border-radius: {{ section.settings.imageImageRadius_number }}px;{% endif %} {% if section.settings.imageImagePosition_select != blank %} object-position: {{ section.settings.imageImagePosition_select }};{% endif %}">
              {% endif %}
            </div>
          {% else %}
            <div class="relative max-w-full  {{ media_align_class }} {% if section.settings.imageImageHide_responsive_checkbox_mobile %}dm-hidden sm:flex{% elsif section.settings.imageImageHide_responsive_checkbox_desktop %}sm:dm-hidden{% endif %}" style="aspect-ratio: var(--{{ section.id }}--imageImageAspectRatio_responsive_select);">
              {{ 'image' | placeholder_svg_tag: width_classes | strip }}
            </div>
          {% endif %}
        {% endunless %}

      </div>
    </div>
  </div>
  {{ section.settings.bottom_mask }}</div>


