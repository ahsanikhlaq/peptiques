{% comment %}
  Only Nature / Suggested Use — two-card section.
  Left card: "Only Nature, Nothing Fake" + 6 free-from icons + CTA.
  Right card: "Suggested use:" + ingredient table.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign badge_count = 0
  assign ingredient_count = 0
  for block in section.blocks
    case block.type
      when 'badge'
        assign badge_count = badge_count | plus: 1
      when 'ingredient'
        assign ingredient_count = ingredient_count | plus: 1
    endcase
  endfor
-%}

<style>
  #shopify-section-{{ sid }} .pn-section{
    padding: {{ s.section_padding_top | default: 48 }}px {{ s.section_padding_x | default: 16 }}px {{ s.section_padding_bottom | default: 48 }}px;
    background: {{ s.outer_background | default: '#f5f0fc' }};
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .pn-section{
      padding: {{ s.section_padding_top_desktop | default: 80 }}px {{ s.section_padding_x_desktop | default: 50 }}px {{ s.section_padding_bottom_desktop | default: 80 }}px;
    }
  }

  #shopify-section-{{ sid }} .pn-wrap{
    max-width: 1340px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .pn-wrap{
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
    }
  }

  #shopify-section-{{ sid }} .pn-card{
    border-radius: {{ s.card_radius | default: 20 }}px;
    padding: 28px 24px;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .pn-card{ padding: 48px 56px; }
  }

  /* Left card — Only Nature */
  #shopify-section-{{ sid }} .pn-left{
    background: {{ s.left_background | default: '#f5edff' }};
    color: {{ s.left_text_color | default: '#1d1027' }};
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  #shopify-section-{{ sid }} .pn-heading{
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: inherit;
    margin: 0 0 8px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 1.8vw + 1rem, 36px);
  }
  #shopify-section-{{ sid }} .pn-sub{
    color: {{ s.left_sub_color | default: '#5b4f6b' }};
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  #shopify-section-{{ sid }} .pn-badges{
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 8px;
  }
  @media (min-width: 1024px){
    #shopify-section-{{ sid }} .pn-badges{
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ sid }} .pn-badge{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  #shopify-section-{{ sid }} .pn-badge-icon{
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid {{ s.badge_ring_color | default: '#5a2a78' }};
    color: {{ s.badge_icon_color | default: '#5a2a78' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .pn-badge-icon img{
    width: 75%; height: 75%; object-fit: contain;
  }
  #shopify-section-{{ sid }} .pn-badge-label{
    font-size: 12px;
    color: {{ s.badge_label_color | default: '#1d1027' }};
    margin: 0;
    line-height: 1.3;
    max-width: 12ch;
  }

  #shopify-section-{{ sid }} .pn-cta{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ s.cta_background | default: '#3f1c5c' }};
    color: {{ s.cta_text_color | default: '#ffffff' }};
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 13px;
    border-radius: 999px;
    padding: 16px 24px;
    border: 0;
    cursor: pointer;
    width: 100%;
    box-shadow: 0 8px 22px rgba(63,28,92,0.22);
  }
  #shopify-section-{{ sid }} .pn-cta:hover{ background: {{ s.cta_hover_background | default: '#5a2a78' }}; }

  #shopify-section-{{ sid }} .pn-footer{
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    color: {{ s.left_sub_color | default: '#5b4f6b' }};
    font-size: 13px;
  }

  /* Right card — Suggested use */
  #shopify-section-{{ sid }} .pn-right{
    background: {{ s.right_background | default: '#3f1c5c' }};
    color: {{ s.right_text_color | default: '#ffffff' }};
  }
  #shopify-section-{{ sid }} .pn-right-heading{
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    margin: 0 0 8px;
    font-weight: 400;
    font-size: clamp(1.25rem, 1vw + 1rem, 28px);
    color: inherit;
  }
  #shopify-section-{{ sid }} .pn-right-intro{
    color: rgba(255,255,255,0.85);
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.5;
  }
  #shopify-section-{{ sid }} .pn-right-label{
    font-weight: 600;
    font-size: 14px;
    margin: 0 0 8px;
    color: inherit;
  }
  #shopify-section-{{ sid }} .pn-right-rule{
    border: 0;
    border-top: 1px solid rgba(255,255,255,0.18);
    margin: 8px 0 18px;
  }
  #shopify-section-{{ sid }} .pn-ingredient-table{
    background: rgba(255,255,255,0.06);
    border-radius: 12px;
    overflow: hidden;
    padding: 12px 16px;
    margin: 0 0 16px;
  }
  #shopify-section-{{ sid }} .pn-amount-row{
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    padding: 8px 0;
    align-items: baseline;
    font-size: 14px;
    line-height: 1.4;
    color: inherit;
  }
  #shopify-section-{{ sid }} .pn-amount-row + .pn-amount-row{
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  #shopify-section-{{ sid }} .pn-amount-row em{ font-style: italic; opacity: 0.85; display: block; font-size: 12px; }
  #shopify-section-{{ sid }} .pn-amount-row-head{
    font-weight: 600;
    border-bottom: 1px solid rgba(255,255,255,0.18);
    padding-bottom: 8px;
    margin-bottom: 4px;
  }
  #shopify-section-{{ sid }} .pn-disclaimer{
    background: rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }
</style>

<section class="pn-section" {{ section.shopify_attributes }}>
  <div class="pn-wrap">
    <article class="pn-card pn-left">
      <div>
        <h2 class="pn-heading">{{ s.left_heading | default: 'Only Nature, Nothing Fake' }}</h2>
        {% if s.left_subheading != blank %}
          <p class="pn-sub">{{ s.left_subheading }}</p>
        {% endif %}
      </div>

      {% if badge_count > 0 %}
        <div class="pn-badges" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'badge' %}
              <div class="pn-badge" role="listitem" {{ block.shopify_attributes }}>
                <div class="pn-badge-icon">
                  {% if block.settings.icon_image != blank %}
                    {{ block.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '56,112,120', alt: block.settings.label }}
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
                  {% endif %}
                </div>
                <p class="pn-badge-label">{{ block.settings.label }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div>
        {% if s.cta_text != blank %}
          <a href="{{ s.cta_url | default: '#' }}" class="pn-cta">{{ s.cta_text }}</a>
        {% endif %}
        {% if s.footer_text != blank %}
          <div class="pn-footer">{{ s.footer_text }}</div>
        {% endif %}
      </div>
    </article>

    <article class="pn-card pn-right">
      <h3 class="pn-right-heading">{{ s.right_heading | default: 'Suggested use:' }}</h3>
      {% if s.right_intro != blank %}
        <p class="pn-right-intro">{{ s.right_intro }}</p>
      {% endif %}
      <p class="pn-right-label">{{ s.right_table_label | default: 'each serving contains' }}</p>
      <hr class="pn-right-rule">

      <div class="pn-ingredient-table">
        <div class="pn-amount-row pn-amount-row-head">
          <span>{{ s.amount_header_label | default: 'Amount Per Serving' }}</span>
          <span></span>
          <span>{{ s.dv_header_label | default: '%DV' }}</span>
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <div class="pn-amount-row" {{ block.shopify_attributes }}>
              <span>
                {{ block.settings.name }}
                {% if block.settings.subtitle != blank %}<em>({{ block.settings.subtitle }})</em>{% endif %}
              </span>
              <span>{{ block.settings.amount }}</span>
              <span>{{ block.settings.dv }}</span>
            </div>
          {% endif %}
        {% endfor %}
        {% if s.daily_value_note != blank %}
          <p style="margin: 8px 0 0; font-size: 12px; color: rgba(255,255,255,0.7);">{{ s.daily_value_note }}</p>
        {% endif %}
      </div>

      {% if s.disclaimer_text != blank %}
        <p class="pn-disclaimer">{{ s.disclaimer_text }}</p>
      {% endif %}
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Only Nature & Suggested Use",
  "tag": "section",
  "class": "pn-only-nature",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "outer_background",     "label": "Outer background",   "default": "#f5f0fc" },
    { "type": "color", "id": "left_background",      "label": "Left card bg",       "default": "#f5edff" },
    { "type": "color", "id": "left_text_color",      "label": "Left card text",     "default": "#1d1027" },
    { "type": "color", "id": "left_sub_color",       "label": "Left card subtle",   "default": "#5b4f6b" },
    { "type": "color", "id": "badge_ring_color",     "label": "Badge ring color",   "default": "#5a2a78" },
    { "type": "color", "id": "badge_icon_color",     "label": "Badge icon color",   "default": "#5a2a78" },
    { "type": "color", "id": "badge_label_color",    "label": "Badge label color",  "default": "#1d1027" },
    { "type": "color", "id": "cta_background",       "label": "CTA background",     "default": "#3f1c5c" },
    { "type": "color", "id": "cta_text_color",       "label": "CTA text color",     "default": "#ffffff" },
    { "type": "color", "id": "cta_hover_background", "label": "CTA hover bg",       "default": "#5a2a78" },
    { "type": "color", "id": "right_background",     "label": "Right card bg",      "default": "#3f1c5c" },
    { "type": "color", "id": "right_text_color",     "label": "Right card text",    "default": "#ffffff" },

    { "type": "header", "content": "Left content" },
    { "type": "text",     "id": "left_heading",     "label": "Heading",     "default": "Only Nature, Nothing Fake" },
    { "type": "textarea", "id": "left_subheading",  "label": "Subheading",  "default": "Real Ayurvedic wisdom designed to deliver clarity, balance, and results" },
    { "type": "text",     "id": "cta_text",         "label": "CTA text",    "default": "UNLOCK YOUR TRUE POWER" },
    { "type": "url",      "id": "cta_url",          "label": "CTA URL" },
    { "type": "text",     "id": "footer_text",      "label": "Footer text", "default": "Stop or Cancel Anytime | Refills Ship Every 90 days" },

    { "type": "header", "content": "Right content" },
    { "type": "text",     "id": "right_heading",       "label": "Heading",        "default": "Suggested use:" },
    { "type": "textarea", "id": "right_intro",         "label": "Intro line",     "default": "Take two capsules per day one in the morning, another in the evening." },
    { "type": "text",     "id": "right_table_label",   "label": "Table label",    "default": "each serving contains" },
    { "type": "text",     "id": "amount_header_label", "label": "Amount header",  "default": "Amount Per Serving" },
    { "type": "text",     "id": "dv_header_label",     "label": "%DV header",     "default": "%DV" },
    { "type": "text",     "id": "daily_value_note",    "label": "Daily value note","default": "*Daily value not established" },
    { "type": "textarea", "id": "disclaimer_text",     "label": "Disclaimer",     "default": "* These supplements have not been evaluated the Food and Drug Administration. This product is not intended To diagnose, treat, cure, or prevent any disease." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "text",  "id": "heading_font_family", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",          "label": "Padding top (Mobile)",     "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom",       "label": "Padding bottom (Mobile)",  "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x",            "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",  "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop","label": "Padding bottom (Desktop)","min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",    "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Free-from badge",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon (image, optional)" },
        { "type": "text",         "id": "label",      "label": "Label", "default": "Plastic Free" }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient row",
      "settings": [
        { "type": "text", "id": "name",      "label": "Name",     "default": "Haritaki fruit powder" },
        { "type": "text", "id": "subtitle",  "label": "Subtitle (italic, in parentheses)", "default": "Terminalia chebula" },
        { "type": "text", "id": "amount",    "label": "Amount",   "default": "500 mg" },
        { "type": "text", "id": "dv",        "label": "%DV value","default": "**" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Only Nature & Suggested Use",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "No Synthetic" } },
        { "type": "badge", "settings": { "label": "Non Gmo" } },
        { "type": "badge", "settings": { "label": "Sugar Free" } },
        { "type": "badge", "settings": { "label": "Gluten Free" } },
        { "type": "ingredient", "settings": { "name": "Haritaki fruit powder", "subtitle": "Terminalia chebula", "amount": "500 mg", "dv": "**" } }
      ]
    }
  ]
}
{% endschema %}
