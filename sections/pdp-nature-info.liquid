{% comment %}
  Nature Info — "Only Nature, Nothing Fake" + "Suggested use".
  Bare-minimum rewrite to dodge whatever was tripping the previous
  pdp-nature-card section: no Liquid block counting, no `case`/`when`,
  no `image_tag` filter chaining, no inline styles. Just plain Liquid
  for content and one short <style> block for layout.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ni-section {
    padding: 48px 16px;
    background: #f5f0fc;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ni-section { padding: 80px 50px; }
  }
  #shopify-section-{{ section.id }} .ni-wrap {
    max-width: 1340px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ni-wrap { grid-template-columns: 1fr 1fr; gap: 24px; }
  }
  #shopify-section-{{ section.id }} .ni-card {
    border-radius: 20px;
    padding: 28px 24px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ni-card { padding: 48px; }
  }
  #shopify-section-{{ section.id }} .ni-left {
    background: #f5edff;
    color: #1d1027;
  }
  #shopify-section-{{ section.id }} .ni-right {
    background: #3f1c5c;
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .ni-h2 {
    font-family: Georgia, "Times New Roman", serif;
    margin: 0 0 12px;
    font-weight: 400;
    line-height: 1.1;
    font-size: 30px;
  }
  #shopify-section-{{ section.id }} .ni-sub {
    color: #5b4f6b;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 24px;
  }
  #shopify-section-{{ section.id }} .ni-badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0 0 24px;
  }
  @media (min-width: 540px) {
    #shopify-section-{{ section.id }} .ni-badges { grid-template-columns: repeat(4, 1fr); }
  }
  #shopify-section-{{ section.id }} .ni-badge {
    text-align: center;
    font-size: 12px;
    color: #1d1027;
  }
  #shopify-section-{{ section.id }} .ni-badge-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid #5a2a78;
    color: #5a2a78;
    margin: 0 auto 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .ni-cta {
    display: block;
    text-align: center;
    background: #3f1c5c;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 13px;
    border-radius: 999px;
    padding: 16px 24px;
  }
  #shopify-section-{{ section.id }} .ni-footer {
    margin-top: 12px;
    text-align: center;
    color: #5b4f6b;
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .ni-rh {
    font-family: Georgia, "Times New Roman", serif;
    margin: 0 0 8px;
    font-weight: 400;
    font-size: 24px;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .ni-rintro {
    color: rgba(255,255,255,0.85);
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 20px;
  }
  #shopify-section-{{ section.id }} .ni-rlabel {
    font-weight: 600;
    font-size: 14px;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .ni-table {
    background: rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0 0 16px;
    font-size: 14px;
  }
  #shopify-section-{{ section.id }} .ni-trow {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
  }
  #shopify-section-{{ section.id }} .ni-trow + .ni-trow {
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  #shopify-section-{{ section.id }} .ni-disc {
    background: rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255,255,255,0.85);
  }
</style>

<section class="ni-section">
  <div class="ni-wrap">

    <div class="ni-card ni-left">
      <h2 class="ni-h2">{{ section.settings.left_heading }}</h2>
      <p class="ni-sub">{{ section.settings.left_sub }}</p>

      <div class="ni-badges">
        {% for block in section.blocks %}
          {% if block.type == 'badge' %}
            <div class="ni-badge">
              <div class="ni-badge-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/></svg>
              </div>
              <div>{{ block.settings.label }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <a href="{{ section.settings.cta_url | default: '#' }}" class="ni-cta">{{ section.settings.cta_text }}</a>
      <div class="ni-footer">{{ section.settings.footer_text }}</div>
    </div>

    <div class="ni-card ni-right">
      <h3 class="ni-rh">{{ section.settings.right_heading }}</h3>
      <p class="ni-rintro">{{ section.settings.right_intro }}</p>
      <p class="ni-rlabel">{{ section.settings.right_label }}</p>

      <div class="ni-table">
        <div class="ni-trow"><span>{{ section.settings.amount_header }}</span><span>{{ section.settings.dv_header }}</span></div>
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <div class="ni-trow">
              <span>{{ block.settings.name }} <em>({{ block.settings.subtitle }})</em></span>
              <span>{{ block.settings.amount }} &nbsp; {{ block.settings.dv }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <p class="ni-disc">{{ section.settings.disclaimer }}</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Nature Info",
  "tag": "section",
  "class": "ni-nature-info",
  "settings": [
    { "type": "text",     "id": "left_heading",  "label": "Left heading",     "default": "Only Nature, Nothing Fake" },
    { "type": "textarea", "id": "left_sub",      "label": "Left subheading",  "default": "Real Ayurvedic wisdom designed to deliver clarity, balance, and results" },
    { "type": "text",     "id": "cta_text",      "label": "CTA text",         "default": "UNLOCK YOUR TRUE POWER" },
    { "type": "url",      "id": "cta_url",       "label": "CTA URL" },
    { "type": "text",     "id": "footer_text",   "label": "Footer text",      "default": "Stop or Cancel Anytime | Refills Ship Every 90 days" },
    { "type": "text",     "id": "right_heading", "label": "Right heading",    "default": "Suggested use:" },
    { "type": "textarea", "id": "right_intro",   "label": "Right intro",      "default": "Take two capsules per day one in the morning, another in the evening." },
    { "type": "text",     "id": "right_label",   "label": "Right label",      "default": "each serving contains" },
    { "type": "text",     "id": "amount_header", "label": "Amount header",    "default": "Amount Per Serving" },
    { "type": "text",     "id": "dv_header",     "label": "DV header",        "default": "%DV" },
    { "type": "textarea", "id": "disclaimer",    "label": "Disclaimer",       "default": "* These supplements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Plastic Free" }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name",     "label": "Name",     "default": "Haritaki fruit powder" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Terminalia chebula" },
        { "type": "text", "id": "amount",   "label": "Amount",   "default": "500 mg" },
        { "type": "text", "id": "dv",       "label": "%DV",      "default": "**" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Nature Info",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "No Synthetic" } },
        { "type": "badge", "settings": { "label": "Non Gmo" } },
        { "type": "badge", "settings": { "label": "Sugar Free" } },
        { "type": "badge", "settings": { "label": "Gluten Free" } },
        { "type": "ingredient", "settings": { "name": "Haritaki fruit powder", "subtitle": "Terminalia chebula", "amount": "500 mg", "dv": "**" } }
      ]
    }
  ]
}
{% endschema %}
