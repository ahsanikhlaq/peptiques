{% comment %}
  Nature Info — "Only Nature, Nothing Fake" + "Suggested use".
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign badge_count  = badge_blocks.size
-%}

<style>
  #shopify-section-{{ sid }} .ni-section {
    padding: 40px 16px;
    background: #ffffff;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ni-section { padding: 88px 50px; }
  }

  #shopify-section-{{ sid }} .ni-wrap {
    max-width: 1340px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ni-wrap { grid-template-columns: 1fr 1fr; gap: 40px; }
  }

  #shopify-section-{{ sid }} .ni-card {
    border-radius: 16px;
    padding: 28px 24px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ni-card { padding: 40px; }
  }

  /* ─── Left card ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ni-left {
    background: linear-gradient(to right, #f5e1ff 0%, #ffffff 50%, #f5e1ff 100%);
    color: #000000;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0;
  }

  #shopify-section-{{ sid }} .ni-h2 {
    font-family: 'Georgia', serif;
    font-weight: 400;
    font-size: 46px;
    line-height: 100%;
    letter-spacing: -0.07em;
    color: #000000;
    margin: 0 0 16px;
  }
  #shopify-section-{{ sid }} .ni-sub {
    color: #000000;
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    margin: 0;
  }

  /* ─── Badge grid ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ni-badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 40px 0 40px;
    gap: 0;
  }
  @media (min-width: 540px) {
    #shopify-section-{{ sid }} .ni-badges {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px 0;
    }
  }

  #shopify-section-{{ sid }} .ni-badge {
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    color: #47184d;
    position: relative;
    letter-spacing: 0;
  }

  /* Mobile: 2-col — border after odd items */
  #shopify-section-{{ sid }} .ni-badge:nth-child(odd) {
    border-right: 0.79px solid #0000003D;
  }

  @media (min-width: 540px) {
    #shopify-section-{{ sid }} .ni-badge {
      border-right: 0.79px solid #0000003D;
      border-top: none;
    }
    #shopify-section-{{ sid }} .ni-badge:nth-child(4n) {
      border-right: none;
    }
  }

  /* Badge icon */
  #shopify-section-{{ sid }} .ni-badge-icon {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    border: 1.5px solid #47184d;
    color: #47184d;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .ni-badge-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }
  #shopify-section-{{ sid }} .ni-badge-icon svg {
    width: 22px; height: 22px;
  }

  /* ─── CTA button ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ni-cta {
    display: block;
    text-align: center;
    background: #47184d;
    color: #ffffff;
    border: 1px solid #ffffff;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    font-size: 14px;
    border-radius: 100px;
    padding: 20px 24px;
  }

  /* ─── Footer ─────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ni-footer {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14.2px;
    line-height: 17px;
    letter-spacing: -0.43px;
    color: #000000;
  }
  #shopify-section-{{ sid }} .ni-footer-item {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .ni-footer-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #47184d;
  }
  #shopify-section-{{ sid }} .ni-footer-icon img {
    width: 100%; height: 100%;
    object-fit: contain; display: block;
  }
  #shopify-section-{{ sid }} .ni-footer-icon svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .ni-footer-divider {
    color: #000000;
    font-size: 16px;
    line-height: 1;
  }

  /* ─── Right card ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .ni-right {
    background: #47184d;
    color: #ffffff;
    border: 1px solid #e1dcf4;
    border-radius: 20px;
  }
  #shopify-section-{{ sid }} .ni-rh {
    font-family: Georgia, serif;
    margin: 0 0 12px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-size: 30px;
    color: inherit;
  }
  #shopify-section-{{ sid }} .ni-rintro {
    color: #ffffff;
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    line-height: 1.2;
    margin: 0 0 32px;
    letter-spacing: 0;
  }
  #shopify-section-{{ sid }} .ni-rlabel {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    line-height: 1.2;
    font-size: 20px;
    margin: 0 0 32px;
    padding: 16px 0;
    border-bottom: 1px solid #e1dcf4;
    letter-spacing: 0;
  }

  /* Amount Per Serving header — OUTSIDE white box, white text */
  #shopify-section-{{ sid }} .ni-table-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: 0;
  }
  /* Empty middle cell for header alignment */
  #shopify-section-{{ sid }} .ni-table-header .ni-th-mid {
    min-width: 60px;
  }

  /* White ingredient box */
  #shopify-section-{{ sid }} .ni-table {
    background: #ffffff;
    border: 1px solid #e1dcf4;
    border-radius: 12px;
    padding: 24px;
    margin: 0 0 32px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #47184d;
    line-height: 1.2;
    letter-spacing: 0;
  }
  #shopify-section-{{ sid }} .ni-trow {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: flex-start;
    gap: 0 99px;
    padding: 0px 0;
  }
  #shopify-section-{{ sid }} .ni-trow em {
    display: block;
    font-style: italic;
    font-weight: 400;
    color: #000000;
    line-height: 20px;
    margin-top: 4px;
  }
  #shopify-section-{{ sid }} .ni-dv-note {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #47184d;
    margin: 12px 0 0;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ sid }} .ni-disc {
    background: #ffffff;
    font-family: 'DM Sans', sans-serif;
    border: 1px solid #e1dcf4;
    border-radius: 12px;
    padding: 25px;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: #000000;
    margin:0;
  }
  @media (max-width:768px){
     #shopify-section-{{ sid }} .ni-wrap {
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #shopify-section-{{ sid }} .ni-card {
    border-radius: 12px;
    padding: 24px 16px;
  }
  #shopify-section-{{ sid }} .ni-h2 {
    font-family: 'Georgia', serif;
    font-weight: 400;
    font-size: 30px;
    line-height: 110.00000000000001%;
    max-width: 241px;
    letter-spacing: -4%;
    color: #000000;
    text-align: center;
    margin: 0 auto 10px;
  }
  #shopify-section-{{ sid }} .ni-sub{
    font-size: 14.6px;
    line-height: 18.8px;
    letter-spacing: -3%;
    text-align: center;
    max-width: 260px;
    margin: 0 auto;
  }
 #shopify-section-{{ sid }} .ni-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 34px 0 34px;
    gap: 16px 0;
  }
  #shopify-section-{{ sid }} .ni-badge-icon {
    width: 50px;
    height: 50px;
  }
  #shopify-section-{{ sid }} .ni-badge {
    font-size: 12.8px;
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .ni-cta {
    padding: 14px 24px;
  }
  #shopify-section-{{ sid }} .ni-footer{
    margin-top: 12px;
  }
  #shopify-section-{{ sid }} .ni-footer-item {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 6px;
    white-space: nowrap;
}
  }
</style>

<section class="ni-section" {{ section.shopify_attributes }}>
  <div class="ni-wrap">

    {%- comment -%} LEFT card {%- endcomment -%}
    <div class="ni-card ni-left">
      <div>
      <h2 class="ni-h2">{{ s.left_heading }}</h2>
      <p class="ni-sub">{{ s.left_sub }}</p>

      <div class="ni-badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="ni-badge" {{ block.shopify_attributes }}>
              <div class="ni-badge-icon">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 140 | image_tag:
                       loading: 'lazy', widths: '66,100,140', alt: block.settings.label }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="12" cy="12" r="10"/>
                  </svg>
                {%- endif -%}
              </div>
              <div>{{ block.settings.label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      </div>
      <div>
      <a href="{{ s.cta_url | default: '#' }}" class="ni-cta">{{ s.cta_text }}</a>

      <div class="ni-footer">
        <div class="ni-footer-item">
          <span class="ni-footer-icon">
            {%- if s.footer_icon_1 != blank -%}
              {{ s.footer_icon_1 | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="9" y1="8" x2="9" y2="16"/>
                <line x1="15" y1="8" x2="15" y2="16"/>
              </svg>
            {%- endif -%}
          </span>
          <span>{{ s.footer_text_1 | default: 'Stop or Cancel Anytime' }}</span>
        </div>
        <span class="ni-footer-divider">|</span>
        <div class="ni-footer-item">
          <span class="ni-footer-icon">
            {%- if s.footer_icon_2 != blank -%}
              {{ s.footer_icon_2 | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"/>
                <path d="M3.51 15a9 9 0 1 0 .49-3"/>
              </svg>
            {%- endif -%}
          </span>
          <span>{{ s.footer_text_2 | default: 'Refills Ship Every 90 days' }}</span>
        </div>
      </div>
      </div>
    </div>

    {%- comment -%} RIGHT card {%- endcomment -%}
    <div class="ni-card ni-right">
      <h3 class="ni-rh">{{ s.right_heading }}</h3>
      <p class="ni-rintro">{{ s.right_intro }}</p>
      <p class="ni-rlabel">{{ s.right_label }}</p>

      {%- comment -%} Amount Per Serving header — bahar, white text {%- endcomment -%}
      <div class="ni-table-header">
        <span>{{ s.amount_header }}</span>
        <span class="ni-th-mid"></span>
        <span>{{ s.dv_header }}</span>
      </div>

      {%- comment -%} White ingredient card {%- endcomment -%}
      <div class="ni-table">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' -%}
            <div class="ni-trow" {{ block.shopify_attributes }}>
              <span>{{ block.settings.name }} <em>({{ block.settings.subtitle }})</em></span>
              <span>{{ block.settings.amount }}</span>
              <span>{{ block.settings.dv }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if s.dv_note != blank -%}
          <p class="ni-dv-note">{{ s.dv_note }}</p>
        {%- endif -%}
      </div>

      <p class="ni-disc">{{ s.disclaimer }}</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Nature Info",
  "tag": "section",
  "class": "ni-nature-info",
  "settings": [
    { "type": "header", "content": "Left card" },
    { "type": "text",     "id": "left_heading", "label": "Heading",     "default": "Only Nature, Nothing Fake" },
    { "type": "textarea", "id": "left_sub",     "label": "Subheading",  "default": "Real Ayurvedic wisdom designed to deliver clarity, balance, and results" },
    { "type": "text",     "id": "cta_text",     "label": "CTA text",    "default": "UNLOCK YOUR TRUE POWER" },
    { "type": "url",      "id": "cta_url",      "label": "CTA URL" },

    { "type": "header", "content": "Footer (below button)" },
    { "type": "image_picker", "id": "footer_icon_1", "label": "Footer icon 1 (left of divider)" },
    { "type": "text",         "id": "footer_text_1", "label": "Footer text 1", "default": "Stop or Cancel Anytime" },
    { "type": "image_picker", "id": "footer_icon_2", "label": "Footer icon 2 (right of divider)" },
    { "type": "text",         "id": "footer_text_2", "label": "Footer text 2", "default": "Refills Ship Every 90 days" },

    { "type": "header", "content": "Right card" },
    { "type": "text",     "id": "right_heading", "label": "Right heading", "default": "Suggested use:" },
    { "type": "textarea", "id": "right_intro",   "label": "Right intro",   "default": "Take two capsules per day one in the morning, another in the evening." },
    { "type": "text",     "id": "right_label",   "label": "Right label",   "default": "each serving contains" },
    { "type": "text",     "id": "amount_header", "label": "Amount header", "default": "Amount Per Serving" },
    { "type": "text",     "id": "dv_header",     "label": "DV header",     "default": "%DV" },
    { "type": "text",     "id": "dv_note",       "label": "DV note (inside card, below ingredients)", "default": "*Daily value not established" },
    { "type": "textarea", "id": "disclaimer",    "label": "Disclaimer",    "default": "* These supplements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Badge icon image (optional)" },
        { "type": "text",         "id": "label",      "label": "Label", "default": "Plastic Free" }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name",     "label": "Name",     "default": "Haritaki fruit powder" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Terminalia chebula" },
        { "type": "text", "id": "amount",   "label": "Amount",   "default": "500 mg" },
        { "type": "text", "id": "dv",       "label": "%DV",      "default": "**" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Nature Info",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "Plastic Free" } },
        { "type": "badge", "settings": { "label": "No Synthetic" } },
        { "type": "badge", "settings": { "label": "Non Gmo" } },
        { "type": "badge", "settings": { "label": "Sugar Free" } },
        { "type": "badge", "settings": { "label": "Gluten Free" } },
        { "type": "ingredient", "settings": { "name": "Haritaki fruit powder", "subtitle": "Terminalia chebula", "amount": "500 mg", "dv": "**" } }
      ]
    }
  ]
}
{% endschema %}
