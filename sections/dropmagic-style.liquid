    --accent-90: #2D4805;
  --accent-90-rgb: 45, 72, 5;
    --accent-100: #182603;
  --accent-100-rgb: 24, 38, 3;

  /* Colors - Neutral */
    --neutral-0: #FAFAFA;
  --neutral-0-rgb: 250, 250, 250;
    --neutral-10: #F2F2F2;
  --neutral-10-rgb: 242, 242, 242;
    --neutral-20: #D9D9D9;
