{% comment %}
  UGC Video Reviews section — sits below the Haritaki benefits.
  Built from Figma: Trypeptiques 2.0 / PDP / "UGC" frame (12 May 2026).
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.headingFontFamily_text | default: 'Georgia, "Times New Roman", serif'
  assign body_font    = section.settings.bodyFontFamily_text    | default: '"DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif'
  assign sid          = section.id
  assign s            = section.settings

  assign video_count = 0
  for block in section.blocks
    if block.type == 'video'
      assign video_count = video_count | plus: 1
    endif
  endfor

  assign show_nav = false
  if s.show_nav_checkbox and video_count > 1
    assign show_nav = true
  endif
-%}

<style>
  /* ============================================ */
  /* DESKTOP                                      */
  /* ============================================ */

  :root {
    --uv-{{ sid }}-pt: {{ s.sectionPaddingTop_responsive_range_desktop    | default: 100 }}px;
    --uv-{{ sid }}-pb: {{ s.sectionPaddingBottom_responsive_range_desktop | default: 100 }}px;
    --uv-{{ sid }}-pl: {{ s.sectionPaddingLeft_responsive_range_desktop   | default: 50 }}px;
    --uv-{{ sid }}-pr: {{ s.sectionPaddingRight_responsive_range_desktop  | default: 50 }}px;
  }

  #shopify-section-{{ sid }} .uv-section{
    padding: var(--uv-{{ sid }}-pt) var(--uv-{{ sid }}-pr) var(--uv-{{ sid }}-pb) var(--uv-{{ sid }}-pl);
    {%- if s.sectionBackgroundImage_picker != blank -%}
      background-color: {{ s.sectionBackground_color | default: '#f5e1ff' }};
      background-image: url({{ s.sectionBackgroundImage_picker | image_url: width: 2000 }});
      background-size: cover;
      background-position: {{ s.sectionBackgroundPosition_text | default: 'center center' }};
      background-repeat: no-repeat;
    {%- else -%}
      background: linear-gradient(90deg, #F5E1FF 0%, #FFF 50%, #F5E1FF 100%);
    {%- endif -%}
  }

  #shopify-section-{{ sid }} .uv-container{
    max-width: 100%;
    margin-inline: auto;
  }

  #shopify-section-{{ sid }} .uv-eyebrow{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: {{ body_font }};
    font-size: 14px;
    color: {{ s.eyebrowTextColor_color | default: '#1d1027' }};
    margin: 0 0 12px;
  }
  #shopify-section-{{ sid }} .uv-eyebrow a{ color: inherit; text-decoration: underline; }
  #shopify-section-{{ sid }} .uv-stars{ display: inline-flex; gap: 1px; color: {{ s.starsColor_color | default: '#f5b301' }}; }
  #shopify-section-{{ sid }} .uv-stars svg{ width: 16px; height: 16px; }

  #shopify-section-{{ sid }} .uv-heading{
    font-family: {{ heading_font }};
    color: {{ s.headingTextColor_color | default: '#000000' }};
    text-align: center;
    margin: 0 auto 40px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.07em;
    max-width: 24ch;
    font-size: clamp(1.75rem, 2.4vw + 1rem, {{ s.headingSize_desktop_number | default: 46 }}px);
  }

  #shopify-section-{{ sid }} .uv-carousel-wrap{
    position: relative;
    /* Allow the side peeks to extend past the container edges */
    margin-inline: calc(var(--uv-{{ sid }}-pl) * -1) calc(var(--uv-{{ sid }}-pr) * -1);
  }

  /* Swiper container */
  #shopify-section-{{ sid }} .uv-swiper{
    overflow: hidden;
    padding: 0 var(--uv-{{ sid }}-pl);
    padding-bottom: 8px;
  }

  #shopify-section-{{ sid }} .uv-swiper .swiper-wrapper{
    display: flex;
    align-items: stretch;
  }

  /* Each slide: width controlled by Swiper JS via slidesPerView,
     but we set a fallback flex-basis for safety. */
  #shopify-section-{{ sid }} .swiper-slide{
    height: auto;
    box-sizing: border-box;
  }

  #shopify-section-{{ sid }} .uv-card{
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 12;
    border-radius: {{ s.cardRadius_number | default: 16 }}px;
    overflow: hidden;
    background: #0a0010;
    box-shadow: 0 10px 30px rgba(60, 20, 90, 0.18);
    isolation: isolate;
    cursor: pointer;
  }

  #shopify-section-{{ sid }} .uv-card-media{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    z-index: 0;
  }

  /* Inline video element (shown after click) */
  #shopify-section-{{ sid }} .uv-card-video{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: none;
    z-index: 3;
    background: #000;
    border: 0;
  }
  #shopify-section-{{ sid }} .uv-card[data-playing="true"] .uv-card-video{
    display: block;
  }
  #shopify-section-{{ sid }} .uv-card[data-playing="true"] .uv-card-media,
  #shopify-section-{{ sid }} .uv-card[data-playing="true"] .uv-play,
  #shopify-section-{{ sid }} .uv-card[data-playing="true"] .uv-quote,
  #shopify-section-{{ sid }} .uv-card[data-playing="true"] .uv-meta,
  #shopify-section-{{ sid }} .uv-card[data-playing="true"] .uv-card-overlay,
  #shopify-section-{{ sid }} .uv-card[data-playing="true"]::before{
    display: none;
  }

  #shopify-section-{{ sid }} .uv-card-overlay{
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.55) 100%);
    pointer-events: none;
    z-index: 2;
  }

  #shopify-section-{{ sid }} .uv-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.90) 0%, rgba(0, 0, 0, 0.00) 42.48%);
    pointer-events: none;
    border-radius: inherit;
    z-index: 1;
  }

  #shopify-section-{{ sid }} .uv-play{
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 56px; height: 56px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: 0;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    transition: transform 180ms ease, background 180ms ease;
    z-index: 2;
    pointer-events: none; /* card itself is clickable */
  }
  #shopify-section-{{ sid }} .uv-card:hover .uv-play{ transform: translate(-50%, -50%) scale(1.06); background: #fff; }
  #shopify-section-{{ sid }} .uv-play svg{ width: 22px; height: 22px; color: #1d1027; margin-left: 3px; }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ sid }} .uv-play{ transition: none; }
  }

  #shopify-section-{{ sid }} .uv-meta{
    position: absolute; left: 12px; right: 12px; bottom: 10px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px;
    color: #fff;
    font-family: {{ body_font }};
    font-size: 13px;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .uv-name{ font-weight: 600; line-height: 1.2; }
  #shopify-section-{{ sid }} .uv-quote{
    position: absolute; left: 12px; right: 12px; bottom: 30px;
    color: #fff;
    font-family: {{ body_font }};
    font-size: 12px;
    line-height: 1.35;
    max-width: 90%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .uv-badge{
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(255,255,255,0.16);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .uv-badge svg{ width: 10px; height: 10px; color: #c1a0f0; }

  /* Navigation buttons */
  #shopify-section-{{ sid }} .uv-nav{
    position: absolute; top: 50%;
    transform: translateY(-50%);
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.95);
    border: 0;
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
    display: inline-flex;
    align-items: center; justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: opacity 180ms ease;
  }
  #shopify-section-{{ sid }} .uv-nav.swiper-button-disabled{
    opacity: 0.35;
    cursor: default;
  }
  #shopify-section-{{ sid }} .uv-nav svg{ width: 18px; height: 18px; color: #1d1027; }
  #shopify-section-{{ sid }} .uv-nav--prev{ left: 8px; }
  #shopify-section-{{ sid }} .uv-nav--next{ right: 8px; }

  #shopify-section-{{ sid }} .uv-stats{
    margin: {{ s.statsMarginTop_number | default: 52 }}px auto 0;
    max-width: 800px;
    min-height: 130px;
    background: {{ s.statsBackground_color | default: '#47184d' }};
    color: #fff;
    border-radius: {{ s.statsRadius_number | default: 16 }}px;
    padding: 22px 16px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    text-align: center;
    font-family: {{ body_font }};
    align-items: center;
  }
  #shopify-section-{{ sid }} .uv-stat-value{
    font-family: {{ heading_font }};
    font-size: clamp(1.5rem, 1.5vw + 1rem, 36px);
    line-height: 1.2;
    font-weight: 400;
  }
  #shopify-section-{{ sid }} .uv-stat-label{
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    margin-top: 13px;
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .uv-stat + .uv-stat{
    border-left: 1px solid rgba(255,255,255,0.18);
  }

  /* ============================================ */
  /* MOBILE (max-width: 767px)                    */
  /* ============================================ */
  @media (max-width: 767px) {
    :root {
      --uv-{{ sid }}-pt: {{ s.sectionPaddingTop_responsive_range_mobile    | default: s.sectionPaddingTop_responsive_range_desktop    | default: 56 }}px;
      --uv-{{ sid }}-pb: {{ s.sectionPaddingBottom_responsive_range_mobile | default: s.sectionPaddingBottom_responsive_range_desktop | default: 56 }}px;
      --uv-{{ sid }}-pl: {{ s.sectionPaddingLeft_responsive_range_mobile   | default: s.sectionPaddingLeft_responsive_range_desktop   | default: 16 }}px;
      --uv-{{ sid }}-pr: {{ s.sectionPaddingRight_responsive_range_mobile  | default: s.sectionPaddingRight_responsive_range_desktop  | default: 16 }}px;
    }
    #shopify-section-{{ sid }} .uv-nav{
      width: 36px; height: 36px;
    }
  }
</style>

{%- comment -%} Swiper CSS + JS from CDN {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<div
  class="uv-section"
  role="region"
  aria-labelledby="uv-heading-{{ sid }}"
  {{ section.shopify_attributes }}
>
  <div class="uv-container">
    {%- if s.eyebrow_text != blank or s.show_stars_checkbox -%}
      <p class="uv-eyebrow">
        {%- if s.show_stars_checkbox -%}
          <span class="uv-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z"/></svg>
            {%- endfor -%}
          </span>
        {%- endif -%}
        {%- if s.eyebrow_link != blank -%}
          <a href="{{ s.eyebrow_link }}">{{ s.eyebrow_text | default: '10,500+ 5-Star Reviews' }}</a>
        {%- else -%}
          <span>{{ s.eyebrow_text | default: '10,500+ 5-Star Reviews' }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    <h2 id="uv-heading-{{ sid }}" class="uv-heading">
      {{- s.heading_text | default: 'Wellness creators, mindful users,' -}}
    </h2>

    <div class="uv-carousel-wrap">
      <div class="swiper uv-swiper" data-uv-swiper>
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'video' -%}
              {%- liquid
                assign b = block.settings
                assign embed_url = ''
                assign mp4_url = ''
                if b.video_url contains 'youtube.com' or b.video_url contains 'youtu.be'
                  assign yt_id = b.video_url | split: 'v=' | last | split: '&' | first
                  if b.video_url contains 'youtu.be/'
                    assign yt_id = b.video_url | split: 'youtu.be/' | last | split: '?' | first
                  endif
                  assign embed_url = 'https://www.youtube.com/embed/' | append: yt_id | append: '?autoplay=1&rel=0&playsinline=1'
                elsif b.video_url contains 'vimeo.com'
                  assign vid = b.video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first
                  assign embed_url = 'https://player.vimeo.com/video/' | append: vid | append: '?autoplay=1'
                endif
                if b.video_file != blank
                  for src in b.video_file.sources
                    if src.format == 'mp4'
                      assign mp4_url = src.url
                    endif
                  endfor
                endif
                assign thumb_img = b.thumbnail_image
                if thumb_img == blank and b.video_file != blank
                  assign thumb_img = b.video_file.preview_image
                endif
              -%}
              <div class="swiper-slide">
                <div class="uv-card" {{ block.shopify_attributes }}
                    itemscope itemtype="https://schema.org/VideoObject"
                    data-uv-card
                    data-embed="{{ embed_url }}"
                    data-mp4="{{ mp4_url }}"
                    role="button"
                    tabindex="0"
                    aria-label="Play video by {{ b.reviewer_name | default: 'reviewer' }}"
                >
                  {%- if thumb_img != blank -%}
                    {{ thumb_img
                      | image_url: width: 640
                      | image_tag:
                        class: 'uv-card-media',
                        loading: 'lazy',
                        decoding: 'async',
                        widths: '240,320,480,640,800',
                        sizes: '(min-width: 768px) 25vw, 80vw',
                        alt: b.reviewer_name | default: 'Customer video review'
                    }}
                    <meta itemprop="thumbnailUrl" content="{{ thumb_img | image_url: width: 640 }}">
                  {%- else -%}
                    <div class="uv-card-media" style="background:#1d1027;"></div>
                  {%- endif -%}

                  <meta itemprop="name"        content="{{ b.reviewer_name | default: 'Customer review' }}">
                  <meta itemprop="description" content="{{ b.review_quote | default: 'Customer video review' | strip_html }}">
                  {%- if b.upload_date != blank -%}<meta itemprop="uploadDate" content="{{ b.upload_date }}">{%- endif -%}

                  <div class="uv-card-overlay" aria-hidden="true"></div>

                  <span class="uv-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8V4z"/></svg>
                  </span>

                  {%- if b.review_quote != blank -%}
                    <p class="uv-quote">{{ b.review_quote }}</p>
                  {%- endif -%}

                  <div class="uv-meta">
                    <span class="uv-name">{{ b.reviewer_name | default: 'Verified Customer' }}</span>
                    {%- if b.verified_checkbox -%}
                      <span class="uv-badge">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.39 4.84L20 8l-4 3.9.94 5.49L12 14.77 7.06 17.39 8 11.9 4 8l5.61-1.16L12 2z"/></svg>
                        {{ b.badge_text | default: 'Verified Buyer' }}
                      </span>
                    {%- endif -%}
                  </div>

                  {%- comment -%} Inline player placeholder — filled on click {%- endcomment -%}
                  <div class="uv-card-video" data-uv-video-slot></div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if show_nav -%}
        <button type="button" class="uv-nav uv-nav--prev" data-uv-prev aria-label="Previous video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="uv-nav uv-nav--next" data-uv-next aria-label="Next video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {%- endif -%}
    </div>

    {%- if s.show_stats_checkbox -%}
      <div class="uv-stats" role="list">
        <div class="uv-stat" role="listitem">
          <div class="uv-stat-value">{{ s.stat1_value | default: '22,926+' }}</div>
          <div class="uv-stat-label">{{ s.stat1_label | default: 'Verified Reviews' }}</div>
        </div>
        <div class="uv-stat" role="listitem">
          <div class="uv-stat-value">{{ s.stat2_value | default: '4.8/5' }}</div>
          <div class="uv-stat-label">{{ s.stat2_label | default: 'Average Rating' }}</div>
        </div>
        <div class="uv-stat" role="listitem">
          <div class="uv-stat-value">{{ s.stat3_value | default: '90 days' }}</div>
          <div class="uv-stat-label">{{ s.stat3_label | default: 'Money-Back Guarantee' }}</div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Load Swiper library {%- endcomment -%}
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />



{%- comment -%} ─── 1. SWIPER (carousel) ─── {%- endcomment -%}
<script>
  var swiper = new Swiper(".uv-swiper", {
    slidesPerView: 2.6,
    spaceBetween: 16,
    centeredSlides: true,
    navigation: {
      nextEl: ".uv-nav--next",
      prevEl: ".uv-nav--prev",
    },
    breakpoints: {
      640:  { slidesPerView: 1.6, spaceBetween: 16 },
      900:  { slidesPerView: 2.2, spaceBetween: 16 },
      1200: { slidesPerView: 3.8, spaceBetween: 16 }
    }
  });
</script>


{%- comment -%} ─── 2. VIDEO PLAY (inline play on card click) ─── {%- endcomment -%}
<script>
  (function(){
    function initVideoPlay(){
      var root = document.getElementById('shopify-section-{{ sid }}');
      if (!root) return;

      function stopAllVideos(except){
        root.querySelectorAll('[data-uv-card][data-playing="true"]').forEach(function(c){
          if (c === except) return;
          var slot = c.querySelector('[data-uv-video-slot]');
          if (slot) slot.innerHTML = '';
          c.removeAttribute('data-playing');
        });
      }

      function playCard(card){
        if (card.getAttribute('data-playing') === 'true') return;
        var embed = card.getAttribute('data-embed');
        var mp4   = card.getAttribute('data-mp4');
        var slot  = card.querySelector('[data-uv-video-slot]');
        if (!slot) return;

        stopAllVideos(card);
        slot.innerHTML = '';

        if (embed){
          var f = document.createElement('iframe');
          f.src = embed;
          f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
          f.allowFullscreen = true;
          f.loading = 'lazy';
          f.style.width = '100%';
          f.style.height = '100%';
          f.style.border = '0';
          slot.appendChild(f);
        } else if (mp4){
          var v = document.createElement('video');
          v.src = mp4;
          v.controls = true;
          v.autoplay = true;
          v.playsInline = true;
          v.style.width = '100%';
          v.style.height = '100%';
          v.style.objectFit = 'cover';
          slot.appendChild(v);
        } else {
          return;
        }
        card.setAttribute('data-playing', 'true');
      }

      // Card click → play inline
      root.querySelectorAll('[data-uv-card]').forEach(function(card){
        card.addEventListener('click', function(){
          if (card.getAttribute('data-playing') === 'true') return;
          playCard(card);
        });
        card.addEventListener('keydown', function(e){
          if (e.key === 'Enter' || e.key === ' '){
            e.preventDefault();
            playCard(card);
          }
        });
      });

      // Stop playing video when user slides — hook into Swiper if/when ready
      function bindSwiperEvents(swiper){
        if (!swiper) return;
        swiper.on('slideChange', function(){ stopAllVideos(null); });
      }

      if (root._uvSwiper) {
        bindSwiperEvents(root._uvSwiper);
      } else {
        root.addEventListener('uv:swiper-ready', function(e){
          bindSwiperEvents(e.detail.swiper);
        });
      }
    }

    if (document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', initVideoPlay);
    } else {
      initVideoPlay();
    }
  })();
</script>

{% schema %}
{
  "name": "UGC Video Reviews",
  "tag": "section",
  "class": "uv-section-wrap",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Spacing — Desktop" },
    { "type": "range", "id": "sectionPaddingTop_responsive_range_desktop",    "label": "Section padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "sectionPaddingBottom_responsive_range_desktop", "label": "Section padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "sectionPaddingLeft_responsive_range_desktop",   "label": "Section padding left (Desktop)",   "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "sectionPaddingRight_responsive_range_desktop",  "label": "Section padding right (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 },

    { "type": "header", "content": "Spacing — Mobile" },
    { "type": "range", "id": "sectionPaddingTop_responsive_range_mobile",    "label": "Section padding top (Mobile)",    "min": 0, "max": 200, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "sectionPaddingBottom_responsive_range_mobile", "label": "Section padding bottom (Mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "sectionPaddingLeft_responsive_range_mobile",   "label": "Section padding left (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "sectionPaddingRight_responsive_range_mobile",  "label": "Section padding right (Mobile)",  "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },

    { "type": "header", "content": "Background" },
    { "type": "color",        "id": "sectionBackground_color",       "label": "Background color",  "default": "#ffffff" },
    { "type": "color",        "id": "sectionGradientFrom_color",     "label": "Gradient edge color (both sides)", "default": "#f5e1ff" },
    { "type": "color",        "id": "sectionGradientTo_color",       "label": "Gradient end (unused — kept for back-compat)", "default": "#f5e1ff" },
    { "type": "image_picker", "id": "sectionBackgroundImage_picker", "label": "Background image (optional)", "info": "When set, replaces the gradient. ≥ 2000px wide recommended." },
