{% comment %}
  Ancient Wisdom / Modern Strength — tabbed timeline section.
  • Middle card (featured) is taller than first & third.
  • Each card supports image OR video (autoplay muted loop).
  • Mobile: same structure — image/video left, text right.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign bg_image = nil
  if s.bg_image_desktop != blank
    assign bg_image = s.bg_image_desktop
  endif
  assign mobile_bg = nil
  if s.bg_image_mobile != blank
    assign mobile_bg = s.bg_image_mobile
  elsif bg_image != blank
    assign mobile_bg = bg_image
  endif

  assign phases = section.blocks | map: 'settings' | map: 'phase_label' | uniq
-%}

<style>
  /* ─── Section ───────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-section {
    position: relative;
    padding: {{ s.section_padding_top | default: 40 }}px {{ s.section_padding_x | default: 16 }}px {{ s.section_padding_bottom | default: 40 }}px;
    background-color: {{ s.section_background | default: '#1d1027' }};
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    color: {{ s.heading_color | default: '#ffffff' }};
    overflow: hidden;
    min-height: 956px;
    {% if mobile_bg != blank %}
      background-image:
        linear-gradient({{ s.overlay_color | default: '#1d1027' }}66, {{ s.overlay_color | default: '#1d1027' }}66),
        url({{ mobile_bg | image_url: width: 1200 }});
    {% endif %}
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-section {
      padding: {{ s.section_padding_top_desktop | default: 80 }}px {{ s.section_padding_x_desktop | default: 50 }}px {{ s.section_padding_bottom_desktop | default: 80 }}px;
      {% if bg_image != blank %}
        background-image:
          linear-gradient({{ s.overlay_color | default: '#1d1027' }}66, {{ s.overlay_color | default: '#1d1027' }}66),
          url({{ bg_image | image_url: width: 2000 }});
      {% endif %}
    }
  }

  /* ─── Wrap ──────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-wrap {
    max-width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 239px;
    height: 650px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-wrap {
      gap: 337px;
      height: 956px;
    }
  }

  /* ─── Heading ───────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-heading {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: {{ s.heading_color | default: '#ffffff' }};
    text-align: center;
    margin: 0 auto;
    max-width: 380px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.07em;
    font-size: clamp(1.75rem, 2.4vw + 1rem, 46px);
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-heading {
      padding-top: 80px;
      padding-bottom: 80px;
    }
  }

  /* ─── Tab shell ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-tabs-shell {
    background: #00000033;
    border-radius: 16px;
    padding: 32px;
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ─── Tabs row ──────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-tabs {
    display: flex;
    gap: 16px;
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ sid }} .pt-tabs::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-tabs { justify-content: center; gap: 32px; }
  }

  #shopify-section-{{ sid }} .pt-tab {
    flex: 0 0 auto;
    background: transparent;
    border: 0;
    color: #ffffff;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 19.6px;
    letter-spacing: -0.02em;
    padding: 0 0 8px;
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    opacity: 0.6;
    border-bottom: 1px solid #ffffff;
    min-width: 100px;
  }
  #shopify-section-{{ sid }} .pt-tab[aria-selected="true"] {
    opacity: 1;
    border-bottom: 2px solid #ffffff;
  }

  /* ─── Panels ────────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-panel { display: none; }
  #shopify-section-{{ sid }} .pt-panel[data-pt-active="true"] { display: block; }

  /* ─── Cards grid ────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }
  #shopify-section-{{ sid }} .pt-cards::-webkit-scrollbar { display: none; }

  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-cards {
      grid-auto-flow: row;
      grid-template-columns: repeat({{ s.cards_per_row_desktop | default: 3 }}, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow-x: visible;
      gap: 0 12px;
      align-items: center;
    }
  }

  /* ─── Card base ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-card {
    scroll-snap-align: start;
    background: {{ s.card_background | default: '#ffffff' }};
    color: #000000;
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    align-items: stretch;
  }

  /* Desktop: explicit heights — center card taller, outer cards shorter */
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-card {
      grid-template-columns: 151px minmax(0, 1fr);
      height: 142px;
    }
    #shopify-section-{{ sid }} .pt-cards .pt-card:nth-child(2) {
      height: 173px;
    }
  }

  /* ─── Media column (image or video) ────────────────────────── */
  #shopify-section-{{ sid }} .pt-card-media {
    background: #e8d5f5;
    display: flex;
    overflow: hidden;
    position: relative;
    aspect-ratio: 151 / 142;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-card-media {
      aspect-ratio: unset;
      height: 100%;
    }
  }
  #shopify-section-{{ sid }} .pt-card-media img,
  #shopify-section-{{ sid }} .pt-card-media video {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
  }

  /* ─── Text column ───────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pt-card-text {
    padding: 12px 8px 12px 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pt-card-text { padding: 8px 8px 8px 15px; }
    #shopify-section-{{ sid }} .pt-card--featured .pt-card-text {
      justify-content: flex-start;
      padding-top: 24px;
    }
  }

  #shopify-section-{{ sid }} .pt-card-title {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    font-weight: 400;
    font-size: 24px;
    line-height: 1.2;
    margin: 0;
    color: #000000;
  }
  #shopify-section-{{ sid }} .pt-card-body {
    margin: 0;
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 14.6px;
    line-height: 18.8px;
    letter-spacing: -3%;
    color: #000000;
  }

  /* ─── Mobile overrides ──────────────────────────────────────── */
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pt-section {
      min-height: 650px;
      padding: 40px 0px 0px;
    }
    #shopify-section-{{ sid }} .pt-wrap {
      gap: 239px;
      height: 650px;
    }
    #shopify-section-{{ sid }} .pt-tabs-shell {
      padding: 24px 0;
    }
    #shopify-section-{{ sid }} .pt-cards {
      grid-auto-columns: 85%;
      scroll-snap-type: x mandatory;
      padding: 0 1.5%;
      gap: 12px;
      align-items: center;
    }
    #shopify-section-{{ sid }} .pt-card {
      height: 142px;
      scroll-snap-align: center;
    }
    #shopify-section-{{ sid }} .pt-cards .pt-card:nth-child(2) {
      height: 173px;
    }
    #shopify-section-{{ sid }} .pt-card-media {
      aspect-ratio: unset;
      height: 100%;
    }
  }
</style>

<section class="pt-section" {{ section.shopify_attributes }}>
  <div class="pt-wrap">
    <h2 class="pt-heading">{{ s.heading_text | default: 'Ancient Wisdom. Modern Strength' }}</h2>

    {%- if phases.size > 0 -%}
      <div class="pt-tabs-shell">

        <div class="pt-tabs" role="tablist" data-pt-tabs>
          {%- for phase in phases -%}
            <button type="button"
                    class="pt-tab"
                    role="tab"
                    data-pt-tab="{{ phase | handle }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ phase }}
            </button>
          {%- endfor -%}
        </div>

        <div class="pt-panels">
          {%- for phase in phases -%}
            <div class="pt-panel"
                 role="tabpanel"
                 data-pt-panel="{{ phase | handle }}"
                 data-pt-active="{% if forloop.first %}true{% else %}false{% endif %}">

              <div class="pt-cards">
                {%- assign phase_index = 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.settings.phase_label == phase -%}
                    {%- assign phase_index = phase_index | plus: 1 -%}
                    {%- assign is_featured = false -%}
                    {%- if block.settings.featured -%}
                      {%- assign is_featured = true -%}
                    {%- endif -%}

                    {%- assign has_video = false -%}
                    {%- assign video_mp4 = '' -%}
                    {%- if block.settings.video_file != blank -%}
                      {%- assign has_video = true -%}
                      {%- for src in block.settings.video_file.sources -%}
                        {%- if src.format == 'mp4' -%}
                          {%- assign video_mp4 = src.url -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}

                    <article class="pt-card{% if is_featured %} pt-card--featured{% endif %}" {{ block.shopify_attributes }}>
                      <div class="pt-card-media">
                        {%- if has_video and video_mp4 != '' -%}
                          <video src="{{ video_mp4 }}" autoplay muted loop playsinline preload="none" aria-hidden="true"></video>
                        {%- elsif block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 400 | image_tag:
                               loading: 'lazy',
                               widths: '160,240,320,400',
                               sizes: '(min-width: 1024px) 151px, 120px',
                               alt: block.settings.title_text }}
                        {%- endif -%}
                      </div>
                      <div class="pt-card-text">
                        <h3 class="pt-card-title">{{ block.settings.title_text }}</h3>
                        {%- if block.settings.body_text != blank -%}
                          <p class="pt-card-body">{{ block.settings.body_text }}</p>
                        {%- endif -%}
                      </div>
                    </article>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            </div>
          {%- endfor -%}
        </div>

      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  var tabs   = root.querySelectorAll('[data-pt-tab]');
  var panels = root.querySelectorAll('[data-pt-panel]');
  if (!tabs.length || !panels.length) return;

  /* ── Center 2nd card in scroll container ── */
  function centerSecondCard(container) {
    if (!container) return;
    var cards = container.querySelectorAll('.pt-card');
    if (cards.length < 2) return;
    var second = cards[1];
    var containerW = container.offsetWidth;
    var cardLeft   = second.offsetLeft;
    var cardW      = second.offsetWidth;
    container.scrollLeft = cardLeft - (containerW / 2) + (cardW / 2);
  }

  /* ── Activate tab ── */
  function activate(id) {
    tabs.forEach(function (t) {
      t.setAttribute('aria-selected', t.getAttribute('data-pt-tab') === id ? 'true' : 'false');
    });
    panels.forEach(function (p) {
      var isActive = p.getAttribute('data-pt-panel') === id;
      p.setAttribute('data-pt-active', isActive ? 'true' : 'false');
      p.querySelectorAll('video').forEach(function (v) {
        isActive ? v.play && v.play() : v.pause && v.pause();
      });
      if (isActive && window.innerWidth <= 768) {
        setTimeout(function () {
          centerSecondCard(p.querySelector('.pt-cards'));
        }, 50);
      }
    });
  }

  tabs.forEach(function (t) {
    t.addEventListener('click', function () {
      activate(t.getAttribute('data-pt-tab'));
    });
  });

  /* ── On load: center 2nd card on mobile ── */
  function initMobileCenter() {
    if (window.innerWidth > 768) return;
    var firstPanel = root.querySelector('[data-pt-active="true"] .pt-cards');
    centerSecondCard(firstPanel);
  }

  /* window.load — sab resources load hone ke baad */
  window.addEventListener('load', function () {
    initMobileCenter();
  });

  /* IntersectionObserver — section viewport mein aaye tab */
  if ('IntersectionObserver' in window) {
    var sectionEl = root.querySelector('.pt-section');
    var once = false;
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting && !once) {
        once = true;
        initMobileCenter();
      }
    }, { threshold: 0.1 });
    if (sectionEl) io.observe(sectionEl);
  }

  /* Shopify editor reload */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ sid }}') {
      setTimeout(initMobileCenter, 150);
    }
  });
})();
</script>

{% schema %}
{
  "name": "Timeline Tabs",
  "tag": "section",
  "class": "pt-timeline-tabs",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Background image — Desktop" },
    { "type": "image_picker", "id": "bg_image_mobile",  "label": "Background image — Mobile (falls back to desktop)" },
    { "type": "color", "id": "section_background", "label": "Background color (fallback)", "default": "#47184d" },
    { "type": "color", "id": "overlay_color",      "label": "Overlay color (over image)",  "default": "#47184d" },

    { "type": "header", "content": "Cards" },
    { "type": "color", "id": "card_background",       "label": "Card background",         "default": "#ffffff" },
    { "type": "color", "id": "heading_color",         "label": "Heading color",            "default": "#ffffff" },
    { "type": "range", "id": "cards_per_row_desktop", "label": "Cards per row (Desktop)",  "min": 1, "max": 4, "step": 1, "default": 3 },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading_text",        "label": "Heading",            "default": "Ancient Wisdom. Modern Strength" },
    { "type": "text", "id": "heading_font_family", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",            "label": "Padding top (Mobile)",     "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "section_padding_bottom",         "label": "Padding bottom (Mobile)",  "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "section_padding_x",              "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",    "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop", "label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",      "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Timeline card",
      "settings": [
        { "type": "text",         "id": "phase_label", "label": "Phase / tab label", "info": "Cards with the same label group under the same tab.", "default": "1-2 Weeks" },
        { "type": "text",         "id": "title_text",  "label": "Card title" },
        { "type": "textarea",     "id": "body_text",   "label": "Card body" },
        { "type": "image_picker", "id": "image",       "label": "Card image (shown if no video)" },
        { "type": "video",        "id": "video_file",  "label": "Card video (autoplay, overrides image)" },
        { "type": "checkbox",     "id": "featured",    "label": "Featured card (taller on desktop)", "default": false }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Timeline Tabs",
      "category": "Custom",
      "blocks": [
        { "type": "card", "settings": { "phase_label": "1-2 Weeks", "title_text": "Cellular Rejuvenation Deepens", "body_text": "Full cellular rejuvenation. Notice radiant skin and a profound shift in spiritual awareness.", "featured": false } },
        { "type": "card", "settings": { "phase_label": "1-2 Weeks", "title_text": "The First Signs Begin",          "body_text": "Feel the initial awakening. Gentle detox and sharper morning focus begin to take hold.",            "featured": true  } },
        { "type": "card", "settings": { "phase_label": "1-2 Weeks", "title_text": "Gut-Brain Alignment Starts",     "body_text": "Gut-brain alignment begins. Enjoy deeper sleep cycles and sustained natural energy.",              "featured": false } },
