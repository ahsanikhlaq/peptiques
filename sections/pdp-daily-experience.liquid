{% comment %}
  Daily Experience — Morning / Evening tab section.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign phase_count = 0
  for block in section.blocks
    if block.type == 'phase'
      assign phase_count = phase_count | plus: 1
    endif
  endfor
-%}

<style>
  #shopify-section-{{ sid }} .pe-section {
    background:
      linear-gradient(to right,
        var(--pe-bg-{{ sid }}, {{ s.fallback_background | default: '#ffffe1' }}) 0%,
        #ffffff 50%,
        var(--pe-bg-{{ sid }}, {{ s.fallback_background | default: '#ffffe1' }}) 100%);
    padding: {{ s.section_padding_top | default: 48 }}px {{ s.section_padding_x | default: 16 }}px {{ s.section_padding_bottom | default: 48 }}px;
    color: {{ s.text_color | default: '#000000' }};
    transition: background 400ms ease;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pe-section {
      padding: {{ s.section_padding_top_desktop | default: 80 }}px {{ s.section_padding_x_desktop | default: 50 }}px {{ s.section_padding_bottom_desktop | default: 80 }}px;
    }
  }

  #shopify-section-{{ sid }} .pe-wrap {
    max-width: 1340px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 42px;
  }

  #shopify-section-{{ sid }} .pe-heading {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: #000000;
    text-align: center;
    margin: 0 auto;
    font-weight: 400;
    line-height: 54.4px;
    letter-spacing: -0.03em;
    font-size: clamp(1.75rem, 2.4vw + 1rem, 48px);
    max-width: 14ch;
  }
  #shopify-section-{{ sid }} .pe-heading em {
    font-style: italic;
    color: rgba(71, 24, 77, 1);
  }

  #shopify-section-{{ sid }} .pe-tabs {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin: 0;
  }
  #shopify-section-{{ sid }} .pe-tab {
    background: #ffffff;
    color: #000000;
    border: 2px solid {{ s.tab_border | default: '#e1dcf4' }};
    border-radius: 0;
    padding: 16px 20px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    font-size: 24px;
    font-style: italic;
    line-height: 1.2;
    letter-spacing: -0.024em;
    transition: background 200ms ease, border-color 200ms ease;
  }
  #shopify-section-{{ sid }} .pe-tab[aria-selected="true"] {
    background: linear-gradient(90deg, #FFFFE1 0%, #FFFFFF 50%, #FFFFE1 100%);
    border-color: var(--pe-tab-border-{{ sid }}, #FFCE2F);
  }
  #shopify-section-{{ sid }} .pe-tab-icon {
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  #shopify-section-{{ sid }} .pe-tab-icon svg { width: 100%; height: 100%; }

  /* ── Pill (richtext) ── */
  #shopify-section-{{ sid }} .pe-pill {
    background: linear-gradient(90deg, #FFFFE1 0%, #FFFFFF 50%, #FFFFE1 100%) !important;
    color: #000000;
    border-radius: 0;
    padding: 6px 12px;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 18px;
    line-height: 22.4px;
    letter-spacing: -0.03em;
    margin-top: 0px;
    text-align: center;
    max-width: 90%;
  }
  #shopify-section-{{ sid }} .pe-pill p { margin: 0; }
  #shopify-section-{{ sid }} .pe-pill strong { font-weight: 700; }
  #shopify-section-{{ sid }} .pe-pill a { color: inherit; }

  /* ── Pro Tip ── */
  #shopify-section-{{ sid }} .pe-protip {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 14.6px;
    line-height: 18.8px;
    letter-spacing: -0.03em;
    text-align: center;
    text-transform: capitalize;
    color: rgba(0, 0, 0, 1);
    margin: 0;
    padding: 0 12px;
    max-width: 90%;
  }
  #shopify-section-{{ sid }} .pe-protip p { margin: 0; }
  #shopify-section-{{ sid }} .pe-protip strong { font-weight: 700; }

  #shopify-section-{{ sid }} .pe-panel {
    display: none;
    width: 100%;
  }
  #shopify-section-{{ sid }} .pe-panel[data-pe-active="true"] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ sid }} .pe-visual {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 17px auto 0;
    aspect-ratio: 1 / 1;
  }
  #shopify-section-{{ sid }} .pe-visual > img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .pe-visual img.pe-visual-desktop { display: block; }
  #shopify-section-{{ sid }} .pe-visual img.pe-visual-mobile  { display: none; }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pe-visual img.pe-visual-desktop { display: none; }
    #shopify-section-{{ sid }} .pe-visual img.pe-visual-mobile  { display: block; }
  }

  /* ─── Stat card ─────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pe-stat {
    position: relative;
    z-index: 1;
    background: {{ s.stat_card_background | default: '#ffffff' }};
    padding: 24px 0px;
    text-align: center;
    max-width: 251px;
    margin: 28% auto 0;
    border: 1px solid #E1DCF4;
  }
  #shopify-section-{{ sid }} .pe-stat-figure {
    font-family: 'DM Sans', system-ui, sans-serif;
    color: {{ s.stat_figure_color | default: '#47184d' }};
    font-size: 48px;
    line-height: 100%;
    letter-spacing: -0.018em;
    font-weight: 900;
    margin: 0 0 10px;
  }
  #shopify-section-{{ sid }} .pe-stat-avatars {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0 0 8px;
    gap: 3px;
  }
  #shopify-section-{{ sid }} .pe-stat-avatars .pe-avatar {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 2.5px solid #ffffff;
    overflow: hidden;
    flex-shrink: 0;
    margin-left: -10px;
    background: #e8d5f5;
  }
  #shopify-section-{{ sid }} .pe-stat-avatars .pe-avatar:first-child { margin-left: 0; }
  #shopify-section-{{ sid }} .pe-stat-avatars .pe-avatar img {
    width: 100%; height: 100%;
    object-fit: cover; display: block; border-radius: 50%;
  }
  #shopify-section-{{ sid }} .pe-stat-caption {
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 12px;
    line-height: 120%;
    letter-spacing: -0.04em;
    text-align: center;
    margin: 0 0 12px;
    color: #47184D;
  }
  #shopify-section-{{ sid }} .pe-stat-body {
    font-family: 'DM Sans';
    font-weight: 400;
    font-size: 12.8px;
    line-height: 16.4px;
    letter-spacing: -0.03em;
    text-align: center;
    color: #000000;
    margin: 0 auto;
    max-width: 203px;
  }

  /* ─── Mobile overrides ──────────────────────────────────────── */
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pe-wrap { gap: 22px; }
    #shopify-section-{{ sid }} .pe-heading {
      font-size: 30px;
      line-height: 110%;
      letter-spacing: -0.04em;
      text-align: center;
      color: #000000;
    }
    #shopify-section-{{ sid }} .pe-heading em { color: #000000; }
    #shopify-section-{{ sid }} .pe-tab-icon { width: 28px; height: 28px; }
    #shopify-section-{{ sid }} .pe-tab { padding: 14px 16px; gap: 14px; font-size: 20px; }
    #shopify-section-{{ sid }} .pe-pill { max-width: 100%; margin: 0 16px; }
    #shopify-section-{{ sid }} .pe-protip {
      font-size: 12.6px;
      line-height: 18.8px;
      letter-spacing: -0.03em;
      margin: 0;
    }
    #shopify-section-{{ sid }} .pe-panel[data-pe-active="true"] { gap: 4px; }
    #shopify-section-{{ sid }} .pe-visual { max-width: 100%; }
    #shopify-section-{{ sid }} .pe-stat {
      padding: 16px;
      text-align: center;
      max-width: 196px;
      margin: 24% auto 0;
    }
    #shopify-section-{{ sid }} .pe-stat-figure { font-size: 34px; letter-spacing: -0.018em; margin: 0 0 6px; }
    #shopify-section-{{ sid }} .pe-stat-avatars { margin: 0 0 6px; }
    #shopify-section-{{ sid }} .pe-stat-caption { margin: 0 0 8px; }
    #shopify-section-{{ sid }} .pe-stat-body { font-size: 11.8px; line-height: 16.4px; letter-spacing: -0.03em; }
    #shopify-section-{{ sid }} .pe-tabs { gap: 16px; }
  }
</style>

<section class="pe-section" data-pe-root {{ section.shopify_attributes }}>
  <div class="pe-wrap">
    <h2 class="pe-heading">
      {%- if s.heading_italic_text != blank -%}
        <em>{{ s.heading_italic_text }}</em>
      {%- endif -%}
      {%- if s.heading_text != blank %} {{ s.heading_text }}{%- endif -%}
    </h2>

    {%- if phase_count > 0 -%}
      <div class="pe-tabs" role="tablist">
        {%- for block in section.blocks -%}
          {%- if block.type == 'phase' -%}
            <button type="button"
                    class="pe-tab"
                    role="tab"
                    data-pe-tab="{{ forloop.index }}"
                    data-pe-bg="{{ block.settings.bg_color }}"
                    data-pe-pill-bg="{{ block.settings.pill_bg }}"
                    data-pe-tab-bg="{{ block.settings.tab_active_bg }}"
                    data-pe-tab-border="{{ block.settings.tab_active_border }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}>
              <span class="pe-tab-icon" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 40 | image_tag: loading: 'lazy', widths: '18,36', alt: '' }}
                {%- elsif block.settings.tab_label contains 'Morning' or block.settings.tab_label contains 'morning' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: {{ block.settings.icon_color | default: '#f5b301' }};"><circle cx="12" cy="12" r="4" fill="currentColor"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: {{ block.settings.icon_color | default: '#5a2a78' }};"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                {%- endif -%}
              </span>
              <span>{{ block.settings.tab_label }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'phase' -%}
          <div class="pe-panel" role="tabpanel" data-pe-panel="{{ forloop.index }}" data-pe-active="{% if forloop.first %}true{% else %}false{% endif %}">

            {%- if block.settings.pill_richtext != blank -%}
              <div class="pe-pill" style="background: {{ block.settings.pill_bg | default: '#fff2a0' }};">
                {{ block.settings.pill_richtext }}
              </div>
            {%- endif -%}

            {%- if block.settings.protip_text != blank -%}
              <p class="pe-protip">{{ block.settings.protip_text }}</p>
            {%- endif -%}

            <div class="pe-visual">
              {%- if block.settings.visual_image != blank -%}
                {{ block.settings.visual_image | image_url: width: 1200 | image_tag:
                     class: 'pe-visual-desktop',
                     loading: 'lazy',
                     widths: '400,600,800,1200',
                     alt: block.settings.tab_label }}
              {%- endif -%}

              {%- if block.settings.visual_image_mobile != blank -%}
                {{ block.settings.visual_image_mobile | image_url: width: 800 | image_tag:
                     class: 'pe-visual-mobile',
                     loading: 'lazy',
                     widths: '360,480,640,800',
                     alt: block.settings.tab_label }}
              {%- elsif block.settings.visual_image != blank -%}
                {{ block.settings.visual_image | image_url: width: 800 | image_tag:
                     class: 'pe-visual-mobile',
                     loading: 'lazy',
                     widths: '360,480,640,800',
                     alt: block.settings.tab_label }}
              {%- endif -%}

              {%- if block.settings.stat_figure_text != blank -%}
                <div class="pe-stat">
                  <p class="pe-stat-figure">{{ block.settings.stat_figure_text }}</p>

                  {%- assign has_avatar = false -%}
                  {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank or block.settings.avatar_4 != blank -%}
                    {%- assign has_avatar = true -%}
                  {%- endif -%}
                  {%- if has_avatar -%}
                    <div class="pe-stat-avatars" aria-hidden="true">
                      {%- if block.settings.avatar_1 != blank -%}<div class="pe-avatar">{{ block.settings.avatar_1 | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', widths: '36,72,80' }}</div>{%- endif -%}
                      {%- if block.settings.avatar_2 != blank -%}<div class="pe-avatar">{{ block.settings.avatar_2 | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', widths: '36,72,80' }}</div>{%- endif -%}
                      {%- if block.settings.avatar_3 != blank -%}<div class="pe-avatar">{{ block.settings.avatar_3 | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', widths: '36,72,80' }}</div>{%- endif -%}
                      {%- if block.settings.avatar_4 != blank -%}<div class="pe-avatar">{{ block.settings.avatar_4 | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', widths: '36,72,80' }}</div>{%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.stat_caption != blank -%}
                    <p class="pe-stat-caption">{{ block.settings.stat_caption }}</p>
                  {%- endif -%}
                  {%- if block.settings.stat_body != blank -%}
                    <p class="pe-stat-body">{{ block.settings.stat_body }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  var sec    = root.querySelector('[data-pe-root]');
  var tabs   = root.querySelectorAll('[data-pe-tab]');
  var panels = root.querySelectorAll('[data-pe-panel]');
  if (!sec || !tabs.length) return;

  function apply(tab) {
    var idx       = tab.getAttribute('data-pe-tab');
    var bg        = tab.getAttribute('data-pe-bg');
    var tabBorder = tab.getAttribute('data-pe-tab-border');

    if (bg)        sec.style.setProperty('--pe-bg-{{ sid }}', bg);
    if (tabBorder) sec.style.setProperty('--pe-tab-border-{{ sid }}', tabBorder);

    tabs.forEach(function (t) {
      t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
    });
    panels.forEach(function (p) {
      p.setAttribute('data-pe-active', p.getAttribute('data-pe-panel') === idx ? 'true' : 'false');
    });
  }

  tabs.forEach(function (t) { t.addEventListener('click', function () { apply(t); }); });
  if (tabs[0]) apply(tabs[0]);
})();
</script>

{% schema %}
{
  "name": "Daily Experience",
  "tag": "section",
  "class": "pe-daily-experience",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "fallback_background", "label": "Fallback background (gradient edges)", "default": "#ffffe1" },
    { "type": "color", "id": "text_color",           "label": "Text color",           "default": "#000000" },
    { "type": "color", "id": "tab_border",           "label": "Tab inactive border",  "default": "#e1dcf4" },
    { "type": "color", "id": "stat_card_background", "label": "Stat card background", "default": "#ffffff" },
    { "type": "color", "id": "stat_figure_color",    "label": "Stat figure color",    "default": "#47184d" },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_italic_text", "label": "Heading — italic part",  "default": "Compact visual" },
    { "type": "text", "id": "heading_text",        "label": "Heading — regular part", "default": "of the daily experience." },
    { "type": "text", "id": "heading_font_family", "label": "Heading font-family",    "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",            "label": "Padding top (Mobile)",     "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom",         "label": "Padding bottom (Mobile)",  "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x",              "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",    "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop", "label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",      "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase tab",
      "settings": [
        { "type": "text",         "id": "tab_label",           "label": "Tab label",                   "default": "Morning" },
        { "type": "image_picker", "id": "icon_image",          "label": "Tab icon image (optional)" },
        { "type": "color",        "id": "icon_color",          "label": "Icon color (default SVG)",    "default": "#f5b301" },
        { "type": "color",        "id": "bg_color",            "label": "Section bg when active",      "default": "#fff8d6" },
        { "type": "color",        "id": "pill_bg",             "label": "Pill bg when active",         "default": "#fff2a0" },
        { "type": "color",        "id": "tab_active_bg",       "label": "Active tab bg",               "default": "#fff2a0" },
        { "type": "color",        "id": "tab_active_border",   "label": "Active tab border",           "default": "#f5d04a" },
        { "type": "richtext",     "id": "pill_richtext",       "label": "Main text (rich text)", "default": "<p>Take 1 capsule with water upon waking, <strong>before breakfast</strong>.</p>" },
        { "type": "text",         "id": "protip_text",         "label": "Pro Tip text",                "default": "Pro Tip: For Better Absorption Take It With Warm Water." },
        { "type": "header",       "content": "Visual images" },
        { "type": "image_picker", "id": "visual_image",        "label": "Main image — Desktop" },
        { "type": "image_picker", "id": "visual_image_mobile", "label": "Main image — Mobile (falls back to desktop if empty)" },
        { "type": "header",       "content": "Stat card" },
        { "type": "text",         "id": "stat_figure_text",    "label": "Stat figure",                "default": "97%" },
        { "type": "text",         "id": "stat_caption",        "label": "Stat caption",               "default": "Of people Like You" },
        { "type": "textarea",     "id": "stat_body",           "label": "Stat body",                  "default": "Experience the simplicity of complete daily nutrition in just two capsules." },
        { "type": "image_picker", "id": "avatar_1",            "label": "Avatar 1" },
        { "type": "image_picker", "id": "avatar_2",            "label": "Avatar 2" },
        { "type": "image_picker", "id": "avatar_3",            "label": "Avatar 3" },
        { "type": "image_picker", "id": "avatar_4",            "label": "Avatar 4" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Daily Experience",
      "category": "Custom",
      "blocks": [
        {
          "type": "phase",
          "settings": {
            "tab_label": "Morning",
            "icon_color": "#ffce2f",
            "bg_color": "#ffffe1",
            "pill_bg": "#ffffe1",
            "tab_active_bg": "#ffffe1",
            "tab_active_border": "#ffce2f",
            "pill_richtext": "<p>Take 1 capsule with water upon waking, <strong>before breakfast</strong>.</p>",
            "protip_text": "Pro Tip: For Better Absorption Take It With Warm Water.",
            "stat_figure_text": "97%",
            "stat_caption": "Of people Like You",
            "stat_body": "Experience the simplicity of complete Pineal Cleansing & Third Eye Activation in just two capsules."
          }
        },
        {
          "type": "phase",
          "settings": {
            "tab_label": "Evening",
            "icon_color": "#5a2a78",
            "bg_color": "#ece1f8",
            "pill_bg": "#e0d0f6",
            "tab_active_bg": "#e0d0f6",
            "tab_active_border": "#bba0d4",
            "pill_richtext": "<p>Take 1 capsule with water before bed, <strong>after dinner</strong>.</p>",
            "protip_text": "Pro Tip: For Best Results Take It At Least 30 Minutes Before Sleep.",
            "stat_figure_text": "93%",
            "stat_caption": "Of people Like You",
            "stat_body": "Wind down the day with the second capsule — supports restorative sleep and overnight cellular renewal."
          }
        }
      ]
    }
  ]
}
{% endschema %}
