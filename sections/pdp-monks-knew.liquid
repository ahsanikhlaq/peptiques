{% comment %}
  Monks Knew 5,000 Years Ago — PDP section.
  Left: video player (thumbnail + play/pause). Right: content card.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign badge_count  = 0
  assign footer_count = 0
  for block in section.blocks
    case block.type
      when 'trust_badge'
        assign badge_count = badge_count | plus: 1
      when 'footer_item'
        assign footer_count = footer_count | plus: 1
    endcase
  endfor

  assign embed_url = ''
  assign mp4_url   = ''
  if s.video_url != blank
    if s.video_url contains 'youtube.com' or s.video_url contains 'youtu.be'
      assign yt_id = s.video_url | split: 'v=' | last | split: '&' | first
      if s.video_url contains 'youtu.be/'
        assign yt_id = s.video_url | split: 'youtu.be/' | last | split: '?' | first
      endif
      assign embed_url = 'https://www.youtube.com/embed/' | append: yt_id | append: '?autoplay=1&rel=0&playsinline=1'
    elsif s.video_url contains 'vimeo.com'
      assign vid = s.video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first
      assign embed_url = 'https://player.vimeo.com/video/' | append: vid | append: '?autoplay=1'
    endif
  endif
  if s.video_file != blank
    for src in s.video_file.sources
      if src.format == 'mp4'
        assign mp4_url = src.url
      endif
    endfor
  endif

  assign thumb = s.video_thumbnail
  if thumb == blank and s.video_file != blank
    assign thumb = s.video_file.preview_image
  endif
-%}

<style>
  #shopify-section-{{ sid }} .pm-section {
    padding: {{ s.section_padding_top | default: 48 }}px {{ s.section_padding_x | default: 16 }}px {{ s.section_padding_bottom | default: 48 }}px;
    background: {{ s.section_background | default: '#ffffff' }};
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-section {
      padding: {{ s.section_padding_top_desktop | default: 80 }}px {{ s.section_padding_x_desktop | default: 50 }}px {{ s.section_padding_bottom_desktop | default: 80 }}px;
    }
  }

  /* ─── 2-column flex ─────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-wrap {
    max-width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-wrap {
      flex-direction: row;
      gap: 40px;
      align-items: stretch;
    }
  }

  /* ─── LEFT: video player ────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-media {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    background: {{ s.media_background | default: '#cdb6e6' }};
    aspect-ratio: 1 / 1;
    position: relative;
    cursor: pointer;
    isolation: isolate;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-media {
      border-radius: 16px;
      aspect-ratio: auto;
    }
  }

  /* Thumbnail */
  #shopify-section-{{ sid }} .pm-media-thumb {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    z-index: 0;
    transition: transform 0.4s ease;
  }
  #shopify-section-{{ sid }} .pm-media:hover .pm-media-thumb {
    transform: scale(1.03);
  }
  #shopify-section-{{ sid }} .pm-media[data-playing="true"] .pm-media-thumb { display: none; }

  /* Dark overlay on thumbnail */
  #shopify-section-{{ sid }} .pm-media-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 55%);
    z-index: 1;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .pm-media[data-playing="true"] .pm-media-overlay { display: none; }

  /* Play / Pause button */
  #shopify-section-{{ sid }} .pm-play-btn {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: none;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,0.28);
    z-index: 3;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(.22,.68,0,1.2), background 0.2s ease;
  }
  #shopify-section-{{ sid }} .pm-media:hover .pm-play-btn {
    transform: translate(-50%, -50%) scale(1.08);
    background: #fff;
  }
  #shopify-section-{{ sid }} .pm-play-btn .icon-play  { display: block; }
  #shopify-section-{{ sid }} .pm-play-btn .icon-pause { display: none; }
  #shopify-section-{{ sid }} .pm-media[data-playing="true"] .pm-play-btn .icon-play  { display: none; }
  #shopify-section-{{ sid }} .pm-media[data-playing="true"] .pm-play-btn .icon-pause { display: block; }
  #shopify-section-{{ sid }} .pm-play-btn svg { width: 22px; height: 22px; color: #1d1027; }
  #shopify-section-{{ sid }} .icon-play { margin-left: 3px; }

  /* Inline video / iframe slot */
  #shopify-section-{{ sid }} .pm-video-slot {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: none;
    z-index: 2;
    background: #000;
  }
  #shopify-section-{{ sid }} .pm-video-slot iframe,
  #shopify-section-{{ sid }} .pm-video-slot video {
    width: 100%; height: 100%;
    border: 0;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  #shopify-section-{{ sid }} .pm-media[data-playing="true"] .pm-video-slot { display: block; }

  /* ─── RIGHT: content card ───────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-content {
    flex: 1;
    background: linear-gradient(90deg, #F5E1FF 0%, #FFFFFF 50%, #F5E1FF 100%);
    border-radius: 12px;
    padding: 17px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-content {
      border-radius: 16px;
      padding: 28px 40px;
      gap: 16px;
    }
  }

  /* ─── Heading ───────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-heading {
    font-family: {{ s.heading_font_family | default: 'Georgia, "Times New Roman", serif' }};
    color: {{ s.heading_color | default: '#000000' }};
    text-align: center;
    margin: 0 auto;
    font-weight: 400;
    line-height: 110%;
    letter-spacing: -0.04em;
    max-width: 496px;
    font-size: 30px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-heading {
      font-size: clamp(1.75rem, 2.4vw + 1rem, 46px);
      letter-spacing: -0.07em;
      line-height: 1;
    }
  }

  /* ─── Subheading ────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-sub {
    color: #000000;
    text-align: center;
    margin: 4px auto 0;
    line-height: 18.8px;
    letter-spacing: -0.03em;
    max-width: 380px;
    font-size: 14.6px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-sub { font-size: 16px; line-height: 1.3; }
  }

  /* ─── Trust badges ──────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 20px 0;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-badges { margin: 120px 0 16px; }
  }
  #shopify-section-{{ sid }} .pm-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 6px;
    gap: 16px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-badge { padding: 0 12px; }
  }
  #shopify-section-{{ sid }} .pm-badge + .pm-badge { border-left: 1px solid #0000003D; }
  #shopify-section-{{ sid }} .pm-badge-icon {
    width: 42px; height: 42px;
    display: inline-flex; align-items: center; justify-content: center;
    color: {{ s.badge_icon_color | default: '#5a2a78' }};
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-badge-icon { width: 60px; height: 60px; }
  }
  #shopify-section-{{ sid }} .pm-badge-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ sid }} .pm-badge-label {
    color: {{ s.badge_label_color | default: '#000000' }};
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 120%;
    letter-spacing: -0.03em;
    text-align: center;
    margin: 0;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-badge-label { font-size: 14px; line-height: 20.3px; max-width: 160px; }
  }

  /* ─── CTA button ────────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-cta {
    display: flex; align-items: center; justify-content: center;
    background: {{ s.cta_background | default: '#47184d' }};
    color: {{ s.cta_text_color | default: '#ffffff' }};
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 14px;
    border-radius: 100px;
    padding: 14px 24px;
    border: 1px solid #ffffff;
    line-height: 1.2;
    transition: background 0.2s ease;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-cta { padding: 20px 24px; }
  }
  #shopify-section-{{ sid }} .pm-cta:hover {
    background: {{ s.cta_hover_background | default: '#5a2a78' }};
  }

  /* ─── Footer items ──────────────────────────────────────────── */
  #shopify-section-{{ sid }} .pm-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 12px;
    align-items: start;
    justify-items: center;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-footer {
      display: flex; flex-direction: row;
      align-items: center; justify-content: center;
      gap: 0;
    }
  }
  #shopify-section-{{ sid }} .pm-footer-item {
    display: flex; flex-direction: column;
    align-items: center; gap: 8px; text-align: center;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-footer-item {
      flex-direction: row; gap: 10px; text-align: left;
      padding: 0 14px; position: relative;
    }
    #shopify-section-{{ sid }} .pm-footer-item + .pm-footer-item { border-left: none; }
    #shopify-section-{{ sid }} .pm-footer-item + .pm-footer-item::before {
      content: '';
      position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      width: 1.5px;
      height: {{ s.footer_divider_height | default: 32 }}px;
      background: #000000;
    }
  }
  #shopify-section-{{ sid }} .pm-footer-icon {
    width: 20px; height: 20px;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: {{ s.footer_icon_color | default: '#000000' }};
  }
  #shopify-section-{{ sid }} .pm-footer-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ sid }} .pm-footer-text {
    color: {{ s.footer_color | default: '#000000' }};
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; line-height: 1.3;
    letter-spacing: -0.02em; margin: 0; max-width: 120px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .pm-footer-text { font-size: 14.2px; max-width: none; white-space: nowrap; }
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} .pm-sub { margin: 0; }
    #shopify-section-{{ sid }} .pm-footer-text { font-size: 12px; line-height: 14.4px; letter-spacing: -3%; }
  }
</style>

<section class="pm-section" {{ section.shopify_attributes }}>
  <div class="pm-wrap">

    {%- comment -%} LEFT: video player {%- endcomment -%}
    <div
      class="pm-media"
      data-pm-player
      data-embed="{{ embed_url }}"
      data-mp4="{{ mp4_url }}"
      role="button"
      tabindex="0"
      aria-label="Play video"
    >
      {%- if thumb != blank -%}
        {{ thumb | image_url: width: 1200 | image_tag:
             class: 'pm-media-thumb',
             loading: 'lazy',
             widths: '480,640,900,1200',
             sizes: '(min-width: 1024px) 50vw, 100vw',
             alt: '' }}
      {%- elsif s.left_image != blank -%}
        {{ s.left_image | image_url: width: 1200 | image_tag:
             class: 'pm-media-thumb',
             loading: 'lazy',
             widths: '480,640,900,1200',
             sizes: '(min-width: 1024px) 50vw, 100vw',
             alt: s.left_image_alt | default: '' }}
      {%- endif -%}

      <div class="pm-media-overlay" aria-hidden="true"></div>

      <span class="pm-play-btn" aria-hidden="true">
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8V4z"/></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
      </span>

      <div class="pm-video-slot" data-pm-slot></div>
    </div>

    {%- comment -%} RIGHT: content card {%- endcomment -%}
    <div class="pm-content">

      <h2 class="pm-heading">{{ s.heading_text | default: 'Monks knew 5,000 years ago, now you do too' }}</h2>

      {%- if s.subheading_text != blank -%}
        <p class="pm-sub">{{ s.subheading_text }}</p>
      {%- endif -%}

      {%- if badge_count > 0 -%}
        <div class="pm-badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="pm-badge" {{ block.shopify_attributes }}>
                <div class="pm-badge-icon">
                  {%- if block.settings.icon_image != blank -%}
                    {{ block.settings.icon_image | image_url: width: 120 | image_tag:
                         loading: 'lazy', widths: '44,88,120', alt: block.settings.label_text }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6L9 17l-5-5"/>
                    </svg>
                  {%- endif -%}
                </div>
                <p class="pm-badge-label">{{ block.settings.label_text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.cta_text != blank -%}
        <a href="{{ s.cta_url | default: '#' }}" class="pm-cta">{{ s.cta_text }}</a>
      {%- endif -%}

      {%- if footer_count > 0 -%}
        <div class="pm-footer">
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_item' -%}
              <div class="pm-footer-item" {{ block.shopify_attributes }}>
                <span class="pm-footer-icon" aria-hidden="true">
                  {%- if block.settings.icon_image != blank -%}
                    {{ block.settings.icon_image | image_url: width: 60 | image_tag:
                         loading: 'lazy', widths: '28,56,60', alt: '' }}
                  {%- else -%}
                    {%- if block.settings.icon_type == 'pause' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10"/><line x1="9" y1="8" x2="9" y2="16"/><line x1="15" y1="8" x2="15" y2="16"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3"/>
                      </svg>
                    {%- endif -%}
                  {%- endif -%}
                </span>
                <p class="pm-footer-text">{{ block.settings.item_text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;

  var player = root.querySelector('[data-pm-player]');
  var slot   = root.querySelector('[data-pm-slot]');
  if (!player || !slot) return;

  var embed  = player.getAttribute('data-embed');
  var mp4    = player.getAttribute('data-mp4');
  var playing = false;

  function play() {
    slot.innerHTML = '';

    if (embed) {
      var f = document.createElement('iframe');
      f.src = embed;
      f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
      f.allowFullscreen = true;
      f.loading = 'lazy';
      slot.appendChild(f);
    } else if (mp4) {
      var v = document.createElement('video');
      v.src = mp4;
      v.controls = true;
      v.autoplay  = true;
      v.playsInline = true;
      slot.appendChild(v);
    } else {
      return;
    }

    player.setAttribute('data-playing', 'true');
    playing = true;
  }

  function stop() {
    slot.innerHTML = '';
    player.removeAttribute('data-playing');
    playing = false;
  }

  player.addEventListener('click', function () {
    playing ? stop() : play();
  });

  player.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); playing ? stop() : play(); }
  });
})();
</script>

{% schema %}
{
  "name": "Monks Knew",
  "tag": "section",
  "class": "pm-monks-knew",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Left — Video" },
    { "type": "image_picker", "id": "video_thumbnail", "label": "Video thumbnail (poster image)", "info": "Shown before the video plays. If blank, falls back to the image below." },
    { "type": "url",          "id": "video_url",       "label": "Video URL (YouTube / Vimeo)" },
    { "type": "video",        "id": "video_file",      "label": "Or upload a video (Shopify-hosted)", "info": "If both URL and file are set, the URL takes priority." },

    { "type": "header", "content": "Left — Fallback image (shown if no video set)" },
    { "type": "image_picker", "id": "left_image",     "label": "Image" },
    { "type": "text",         "id": "left_image_alt", "label": "Image alt text" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background",   "label": "Section background",             "default": "#ffffff" },
    { "type": "color", "id": "media_background",     "label": "Player fallback background",     "default": "#cdb6e6" },
    { "type": "color", "id": "heading_color",        "label": "Heading color",                  "default": "#000000" },
    { "type": "color", "id": "badge_icon_color",     "label": "Badge icon color",               "default": "#5a2a78" },
    { "type": "color", "id": "badge_label_color",    "label": "Badge label color",              "default": "#000000" },
    { "type": "color", "id": "cta_background",       "label": "CTA background",                 "default": "#47184d" },
    { "type": "color", "id": "cta_text_color",       "label": "CTA text color",                 "default": "#ffffff" },
    { "type": "color", "id": "cta_hover_background", "label": "CTA hover background",           "default": "#5a2a78" },
    { "type": "color", "id": "footer_color",         "label": "Footer text color",              "default": "#000000" },
    { "type": "color", "id": "footer_icon_color",    "label": "Footer icon color (SVG fallback)","default": "#000000" },

    { "type": "header", "content": "Footer divider" },
    { "type": "range", "id": "footer_divider_height", "label": "Divider height (px)", "min": 10, "max": 80, "step": 2, "unit": "px", "default": 32 },

    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "heading_text",        "label": "Heading",    "default": "Monks knew 5,000 years ago, now you do too" },
    { "type": "textarea", "id": "subheading_text",     "label": "Subheading", "default": "What monks understood thousands of years ago can now support your daily routine." },
    { "type": "text",     "id": "heading_font_family", "label": "Heading font-family", "default": "Georgia, \"Times New Roman\", serif" },

    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "UNLOCK YOUR TRUE POWER" },
    { "type": "url",  "id": "cta_url",  "label": "CTA URL" },

    { "type": "header", "content": "Spacing (px)" },
    { "type": "range", "id": "section_padding_top",            "label": "Padding top (Mobile)",     "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom",         "label": "Padding bottom (Mobile)",  "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_x",              "label": "Padding sides (Mobile)",   "min": 0, "max": 80,  "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding_top_desktop",    "label": "Padding top (Desktop)",    "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_bottom_desktop", "label": "Padding bottom (Desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "section_padding_x_desktop",      "label": "Padding sides (Desktop)",  "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50 }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (optional)" },
        { "type": "text",         "id": "label_text", "label": "Label", "default": "Trust badge" }
      ]
    },
    {
      "type": "footer_item",
      "name": "Footer item",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image" },
        { "type": "select", "id": "icon_type", "label": "Fallback SVG icon (if no image)",
          "options": [
            { "value": "pause",   "label": "Pause circle" },
            { "value": "refresh", "label": "Refresh / repeat" }
          ],
          "default": "pause"
        },
        { "type": "text", "id": "item_text", "label": "Text", "default": "Stop or Cancel Anytime" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
