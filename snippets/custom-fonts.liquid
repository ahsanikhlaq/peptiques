{% comment %}
  custom-fonts.liquid
  Loads merchant-uploaded Georgia + DM Sans font files from
  Settings → Files (file_url resolves there).

  Upload every .woff and .woff2 referenced below to:
  Shopify Admin → Settings → Files → Upload files.

  Render this snippet from layout/theme.liquid:
    {% render 'custom-fonts' %}
{% endcomment %}

{% style %}
  /* ───── Georgia ───── */
  @font-face {
    font-family: 'Georgia';
    src: url('{{ "Georgia.woff2" | file_url }}') format('woff2'),
         url('{{ "Georgia.woff"  | file_url }}') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Georgia';
    src: url('{{ "Georgia-Bold.woff2" | file_url }}') format('woff2'),
         url('{{ "Georgia-Bold.woff"  | file_url }}') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Georgia';
    src: url('{{ "Georgia-Italic.woff2" | file_url }}') format('woff2'),
         url('{{ "Georgia-Italic.woff"  | file_url }}') format('woff');
    font-weight: normal;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Georgia';
    src: url('{{ "Georgia-BoldItalic.woff2" | file_url }}') format('woff2'),
         url('{{ "Georgia-BoldItalic.woff"  | file_url }}') format('woff');
    font-weight: bold;
    font-style: italic;
    font-display: swap;
  }

  /* ───── DM Sans ───── */
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Thin.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-Thin.woff"  | file_url }}') format('woff');
    font-weight: 100;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Regular.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-Regular.woff"  | file_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Medium.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-Medium.woff"  | file_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-SemiBold.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-SemiBold.woff"  | file_url }}') format('woff');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Bold.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-Bold.woff"  | file_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-BoldItalic.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-BoldItalic.woff"  | file_url }}') format('woff');
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-ExtraBoldItalic.woff2" | file_url }}') format('woff2'),
         url('{{ "DMSans-ExtraBoldItalic.woff"  | file_url }}') format('woff');
    font-weight: 800;
    font-style: italic;
    font-display: swap;
  }
{% endstyle %}