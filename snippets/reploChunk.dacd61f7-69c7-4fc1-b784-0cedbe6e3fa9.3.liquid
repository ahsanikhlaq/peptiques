<style>
.timeline-line-wrapper {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  height: 100%;
}

.line-default,
.line-active {
  display: block !important;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
}

.line-default {
  height: 100%;
  border-left: 2px dashed #2a2a2a;
}

.line-active {
  height: 0;
  border-left: 2px solid #C7A857;
  transition: height 0.5s ease;
}
</style>

<script>
const timelineLine = document.querySelector('.line-active');

function updateTimelineLine() {
  const parent = timelineLine.parentElement;
  const rect = parent.getBoundingClientRect();
  const triggerPoint = window.innerHeight * 0.7;
  const parentHeight = parent.offsetHeight;

  if (rect.top < triggerPoint) {
    const visible = triggerPoint - rect.top;
    const progress = Math.min(visible / parentHeight, 1);
    timelineLine.style.height = progress * parentHeight + 'px';
  } else {
    timelineLine.style.height = '0px';
  }
}

window.addEventListener('scroll', updateTimelineLine);
window.addEventListener('load', updateTimelineLine);
</script></div></div><div data-rid="53a9a952-0bed-4c59-b357-2c251843c4a7" data-cards="box" class="r-1wqibtt"><div data-rid="d8fa3cda-3b9a-4792-885e-78bed14182f9" data-dot="color" class="r-1q85twr"><div data-rid="7bdb7ce0-62db-4dfe-ba5b-a0d50f0466d0" class="r-h7agtd"></div></div><div data-rid="ad98d4ef-fcdb-4a73-9fbb-2b56de050a05" class="r-atvni3"><div data-rid="abc3ba4c-8b56-4a1f-93ee-a62a5f6c908d" class="r-gcrx46"><div data-rid="4a41f10c-0f52-4031-b6ba-4a972b7e879b" class="r-lbyeh2 alchemy-rte"><span style="width:100%"><p>1-2 Weeks</p></span></div></div><div data-rid="c363304e-53e4-4b83-a0d5-92ce32824582" data-dot="color" class="r-1dt3xki"><div data-rid="a14ede4e-5ca7-4b3d-821e-3aca3406120a" class="r-1r8kgof"></div></div><div data-rid="ef0adcd6-9b21-41c5-a860-a039d6d6e251" data-animation="card" class="r-phezys"><div data-rid="5cbf6d31-b2cc-401d-9493-23b45a256397" data-box="color" class="r-lmpfm6"></div><div data-rid="29459c8c-608b-400d-9463-ab0fdb9eee36" data-card="color" class="r-123zqpk"><div data-rid="b21e6183-7e75-420f-9bab-0670a084c094" class="r-y6iu8m"><div data-rid="a3a510cf-6ce8-4480-a9bf-2022c51b8b89" data-icon="color" class="r-obrnxa"><svg xmlns="http://www.w3.org/2000/svg" fill="#2a2a2a" height="32" viewBox="0 0 32 32" width="32">
