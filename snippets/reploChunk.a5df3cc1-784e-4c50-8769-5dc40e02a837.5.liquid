<script>
  (function () {
  
    /* ---------------- UTIL ---------------- */
  
    function formatMoney(amount) {
      const currency = window.Shopify?.currency?.active || 'USD';
  
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(amount);
    }
  
    function extractNumber(text) {
      if (!text) return 0;
  
      let cleaned = text.replace(/\s/g, '').replace(/[^\d.,]/g, '');
  
      if (cleaned.includes(',') && cleaned.includes('.')) {
        cleaned = cleaned.replace(/,/g, '');
      } else if (cleaned.includes(',')) {
        cleaned = cleaned.replace(',', '.');
      }
  
      return parseFloat(cleaned) || 0;
    }
  
    function getBundleData() {
      const selected = document.querySelector('.kaching-bundles__bar--selected');
      if (!selected) return null;
  
      const priceEl = selected.querySelector('.kaching-bundles__bar-price');
      const compareEl = selected.querySelector('.kaching-bundles__bar-full-price');
  
      const priceText = priceEl?.textContent?.trim();
      const compareText = compareEl?.textContent?.trim() || '';
  
      if (!priceText) return null;
  
      return { priceText, compareText };
    }
  
    /* ---------------- UI UPDATE ---------------- */
  
    function updatePriceUI(priceText, compareText) {
      const priceTarget = document.getElementById('bundle-price');
      const compareTarget = document.getElementById('bundle-compare');
      const saveTarget = document.getElementById('bundle-save');
  
      if (priceTarget) {
        priceTarget.textContent = priceText;
      }
  
      if (compareTarget) {
        if (compareText) {
          compareTarget.textContent = compareText;
          compareTarget.style.display = 'inline';
        } else {
          compareTarget.style.display = 'none';
        }
      }
  
      const priceNum = extractNumber(priceText);
      const compareNum = extractNumber(compareText);
  
      if (saveTarget && priceNum && compareNum && compareNum > priceNum) {
        const savedAmount = compareNum - priceNum;
        saveTarget.textContent = `Save ${formatMoney(savedAmount)}`;
      }
    }
  
    function updateATC(priceText, compareText) {
      const atcBtn = document.querySelector(
        '[data-replo-add-product-variant-to-cart] [data-custom="price"]'
      );
  
      if (!atcBtn) return;
  
      // 🔥 Prevent unnecessary DOM updates
      const newHTML = `
        Add to Cart • ${priceText}
        ${compareText ? `<span style="text-decoration:line-through;opacity:0.6;margin-left:6px;">${compareText}</span>` : ''}
      `;
  
      if (atcBtn.innerHTML.trim() !== newHTML.trim()) {
        atcBtn.innerHTML = newHTML;
      }
    }
  
    function updateAll(retry = 0) {
      const data = getBundleData();
  
      if (!data) {
        if (retry < 20) {
          setTimeout(() => updateAll(retry + 1), 100);
        }
        return;
      }
  
      updatePriceUI(data.priceText, data.compareText);
      updateATC(data.priceText, data.compareText);
    }
  
    /* ---------------- OBSERVERS (LIGHTWEIGHT) ---------------- */
  
    function observeBundleSelection() {
      document.addEventListener('click', function (e) {
        if (e.target.closest('.kaching-bundles__bar')) {
          setTimeout(updateAll, 80);
        }
      });
    }
  
    function observeATCContainer() {
      const container = document.querySelector('[data-replo-add-product-variant-to-cart]');
      if (!container) return;
  
      const observer = new MutationObserver(() => {
        updateAll();
      });
  
      observer.observe(container, {
        childList: true,
        subtree: true
      });
    }
  
    /* ---------------- INIT ---------------- */
  
    function init() {
      updateAll();              // initial load fix
      observeBundleSelection(); // bundle click
      observeATCContainer();    // replo re-render fix
    }
  
    document.addEventListener("DOMContentLoaded", init);
  
  })();
  </script>

