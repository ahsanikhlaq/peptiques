<script> 
  const cards = document.querySelectorAll('[data-cards]');
  function updateActiveCards() { 
    const triggerPoint = window.innerHeight * 0.7;
    cards.forEach(card => { const rect = card.getBoundingClientRect();
    const cardTop = rect.top;
    const cardHeight = rect.height;
    
    if (cardTop + cardHeight * 0.3 <= triggerPoint) {
      card.setAttribute('data-cards', 'active');
      } else {
        card.setAttribute('data-cards', 'box'); }
        });
      }
      
      window.addEventListener('scroll', updateActiveCards);
      window.addEventListener('load', updateActiveCards);
