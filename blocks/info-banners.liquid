    },
    {
      "type": "color",
      "id": "bg_2",
      "label": "Background color",
      "default": "#FFF0EE"
    },
    {
      "type": "color",
      "id": "border_color_2",
      "label": "Border color",
      "default": "#E8A39A"
    },
    {
      "type": "select",
