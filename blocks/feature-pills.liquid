{% comment %} /blocks/feature-pills.liquid {% endcomment %}

<div class="feature-pills-block" {{ block.shopify_attributes }}>
  <div class="feature-pills-grid">
    {% for i in (1..6) %}
      {% assign icon_key = 'icon_' | append: i %}
      {% assign text_key = 'text_' | append: i %}
      {% assign icon = block.settings[icon_key] %}
      {% assign text = block.settings[text_key] %}

      {% if text != blank %}
        <div class="feature-pill">
          {% if icon != blank %}
            <div class="feature-pill__icon">
              <img
                src="{{ icon | image_url: width: 60 }}"
                alt="{{ text | escape }}"
                width="24"
                height="24"
                loading="lazy"
              >
            </div>
          {% endif %}
          <span class="feature-pill__text">{{ text }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .section-{{ section.id }} .feature-pills-block {
    width: 100%;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .section-{{ section.id }} .feature-pills-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, 1fr);
  }

  .section-{{ section.id }} .feature-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.bg_color }};
  }

 .feature-pill__text{
  color: #47184D;
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: 14.4px;
    letter-spacing: -0.36px;
    margin: 0;
}
.feature-pill{
  border-radius: 999px;
    border: 1px solid rgba(71, 24, 77, 0.25);
    background: #FFF;
    padding: 6px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.feature-pills-grid{
  display: grid;
    /* row-gap: 10px; */
    gap: 12px;
    margin-top: 16px;
  grid-template-columns: repeat(3, 1fr);
}
.main-prodcut .rich-text-block{
  margin: 0 !important;
  margin-top: 24px !important;
}

.main-prodcut .rich-text-block p{
  color: var(--Black, #000);

/* Georgia/Georgia/dm sans regular */
font-family: "DM Sans";
font-size: 14.6px;
font-style: normal;
font-weight: 400;
line-height: 18.8px; /* 128.767% */
letter-spacing: -0.438px;
}

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .feature-pills-grid {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr) !important;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .section-{{ section.id }} .feature-pill {
      padding: {{ block.settings.mobile_padding_y }}px {{ block.settings.mobile_padding_x }}px;
    }

    .section-{{ section.id }} .feature-pill__text {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
    .feature-pills-grid {
       gap: 6px;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 12px;
    
    }

    .feature-pill__text {
      font-size: 13px;
          letter-spacing: -0.39px;
    }
    .feature-pill {
          padding: 6px 8px;
    }
    .feature-pill__icon img{
      width: 15px;
      height: 15px
    }
    .feature-pill__icon{
      display: flex;
    }
    
  }
</style>

