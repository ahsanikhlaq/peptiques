{% comment %} /blocks/bundle-selector.liquid {% endcomment %}

{%- liquid
  comment
    Discount percentage from settings (default 25). We'll apply it on top of
    the regular price to produce the final "discounted" price shown to the user.
    Also used to compute the discounted total for the selected option.
  endcomment
  assign discount_percent = block.settings.discount_percent | default: 25
  assign discount_multiplier = 100 | minus: discount_percent
-%}

<div
  id="main-ancher-btn"
  class="bundle-selector-block"
  data-discount-percent="{{ discount_percent }}"
  data-selling-plan-id="{{ block.settings.selling_plan_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h3 class="bundle-selector__heading">{{ block.settings.heading }}</h3>
  {% endif %}

  <div class="bundle-selector__list">

    {% comment %} ============ VARIANT-BASED MODE ============ {% endcomment %}
    {% if block.settings.mode == 'variant' %}
      {%- for variant in product.variants -%}
        {%- liquid
          comment
            Apply customer discount on top of variant.price to get the final price.
            Compare-at is the original (pre-discount) variant.price OR the
            variant.compare_at_price if higher.
          endcomment
          assign discounted_price = variant.price | times: discount_multiplier | divided_by: 100

          assign original_for_compare = variant.price
          if variant.compare_at_price > variant.price
            assign original_for_compare = variant.compare_at_price
          endif

          assign save_percent = 0
          if original_for_compare > discounted_price
            assign diff = original_for_compare | minus: discounted_price
            assign save_percent = diff | times: 100.0 | divided_by: original_for_compare | round
          endif

          assign tag_label = ''
          if forloop.index == 2
            assign tag_label = block.settings.variant_tag_2
          elsif forloop.index == 3
            assign tag_label = block.settings.variant_tag_3
          elsif forloop.index == 4
            assign tag_label = block.settings.variant_tag_4
          endif

          assign bonus_text = ''
          if forloop.index == 2
            assign bonus_text = block.settings.variant_bonus_2
          elsif forloop.index == 3
            assign bonus_text = block.settings.variant_bonus_3
          elsif forloop.index == 4
            assign bonus_text = block.settings.variant_bonus_4
          endif

          assign is_selected = false
          if variant.id == product.selected_or_first_available_variant.id
            assign is_selected = true
          endif
        -%}

        <label
          class="bundle-option{% if is_selected %} is-selected{% endif %}{% if tag_label != blank %} has-tag{% endif %}"
          data-variant-id="{{ variant.id }}"
          data-qty="1"
          data-selling-plan-id="{{ block.settings.selling_plan_id }}"
        >
          <input
            type="radio"
            name="bundle-select-{{ block.id }}"
            value="{{ variant.id }}"
            class="bundle-option__radio visually-hidden"
            {% if is_selected %}checked{% endif %}
            data-variant-input
            id='{{ product.selected_or_first_available_variant.id }}'
          >

          {% if tag_label != blank %}
            <div class='new-tag-wrapper'>
              <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
                  <path d="M4 4L8 0V8H0L4 4Z" fill="#47184D"/>
                </svg>
              </span>
              <span class="bundle-option__tag">{{ tag_label }}</span>
              <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
                  <path d="M4 4L0 0V8H8L4 4Z" fill="#47184D"/>
                </svg>
              </span>
            </div>
          {% endif %}

          <div class="bundle-option__inner">
            {%- liquid
              assign variant_img = variant.featured_image | default: product.featured_image
            -%}
            {% if variant_img %}
              <div class="bundle-option__image">
                <img src="{{ variant_img | image_url: width: 160 }}" alt="{{ variant.title | escape }}" width="80" height="80" loading="lazy">
              </div>
            {% endif %}

            <div class="bundle-option__info">
              <div class="bundle-option__title">{{ variant.title }}</div>
              {% if save_percent > 0 %}
                <div class="bundle-option__save">You save {{ save_percent }}%{% if bonus_text != blank %} {{ bonus_text }}{% endif %}</div>
              {% endif %}
            </div>

            <div class="bundle-option__price">
              <div class="bundle-option__price-current">{{ discounted_price | money }}</div>
              {% if original_for_compare > discounted_price %}
                <div class="bundle-option__price-compare">{{ original_for_compare | money }}</div>
              {% endif %}
            </div>
          </div>
        </label>
      {%- endfor -%}

    {% comment %} ============ QUANTITY-BASED MODE ============ {% endcomment %}
    {% else %}
      {%- assign current_variant = product.selected_or_first_available_variant -%}
      {%- assign base_price = current_variant.price -%}
      {%- assign base_compare = current_variant.compare_at_price -%}

      {% for i in (1..6) %}
        {%- liquid
          assign show_key = 'qty_show_' | append: i
          assign show_item = block.settings[show_key]
        -%}

        {% if show_item %}
          {%- liquid
            assign title_key   = 'qty_title_'  | append: i
            assign buy_qty_key = 'qty_buy_'    | append: i
            assign all_qty_key = 'qty_all_'    | append: i
            assign tag_key     = 'qty_tag_'    | append: i
            assign bonus_key   = 'qty_bonus_'  | append: i
            assign image_key   = 'qty_image_'  | append: i

            assign qty_title    = block.settings[title_key]
            assign buy_qty      = block.settings[buy_qty_key] | default: i
            assign all_qty      = block.settings[all_qty_key] | default: buy_qty
            assign tag_label    = block.settings[tag_key]
            assign bonus_text   = block.settings[bonus_key]
            assign custom_image = block.settings[image_key]

            comment
              Original total (before customer discount):
                If product has compare_at_price -> base_compare × all_qty
                Else                            -> base_price   × all_qty
              Final price (after customer discount):
                base_price × buy_qty × (100 - discount_percent) / 100
              Save % is calculated from original total vs final discounted price.
            endcomment

            assign raw_total_price = base_price | times: buy_qty
            assign total_price = raw_total_price | times: discount_multiplier | divided_by: 100

            assign has_compare = false
            assign total_compare = 0

            if base_compare and base_compare > 0
              assign total_compare = base_compare | times: all_qty
              if total_compare > total_price
                assign has_compare = true
              endif
            else
              assign total_compare = base_price | times: all_qty
              if total_compare > total_price
                assign has_compare = true
              endif
            endif

            assign save_percent = 0
            if has_compare
              assign diff = total_compare | minus: total_price
              assign save_percent = diff | times: 100.0 | divided_by: total_compare | round
            endif

            assign is_selected = false
            if i == block.settings.default_qty_option
              assign is_selected = true
            endif
          -%}

          <label
            class="bundle-option{% if is_selected %} is-selected{% endif %}{% if tag_label != blank %} has-tag{% endif %}"
            data-qty="{{ buy_qty }}"
            data-all-qty="{{ all_qty }}"
            data-selling-plan-id="{{ block.settings.selling_plan_id }}"
          >
            <input
              type="radio"
              name="bundle-select-{{ block.id }}"
              value="{{ buy_qty }}"
              class="bundle-option__radio visually-hidden"
              {% if is_selected %}checked{% endif %}
              data-qty-input
              id='{{ product.selected_or_first_available_variant.id }}'
            >

            {% if tag_label != blank %}
              <div class='new-tag-wrapper'>
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
                    <path d="M4 4L8 0V8H0L4 4Z" fill="#47184D"/>
                  </svg>
                </span>
                <span class="bundle-option__tag">{{ tag_label }}</span>
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
                    <path d="M4 4L0 0V8H8L4 4Z" fill="#47184D"/>
                  </svg>
                </span>
              </div>
            {% endif %}

            <div class="bundle-option__inner">
              {%- liquid
                assign display_img = custom_image | default: product.featured_image
              -%}
              {% if display_img %}
                <div class="bundle-option__image">
                  <img src="{{ display_img | image_url: width: 160 }}" alt="{{ qty_title | escape }}" width="80" height="80" loading="lazy">
                </div>
              {% endif %}

              <div class="bundle-option__info">
                <div class="bundle-option__title">{{ qty_title }}</div>
                {% if has_compare and save_percent > 0 %}
                  <div class="bundle-option__save">You save {{ save_percent }}%{% if bonus_text != blank %} {{ bonus_text }}{% endif %}</div>
                {% elsif bonus_text != blank %}
                  <div class="bundle-option__save">{{ bonus_text }}</div>
                {% endif %}
              </div>

              <div class="bundle-option__price">
                <div class="bundle-option__price-current">{{ total_price | money }}</div>
                {% if has_compare %}
                  <div class="bundle-option__price-compare">{{ total_compare | money }}</div>
                {% endif %}
              </div>
            </div>
          </label>
        {% endif %}
      {% endfor %}
    {% endif %}

  </div>
</div>

<style>
  .bundle-selector-block {
    width: 100%;
    margin: 24px 0px 16px 0px;
  }

  .bundle-selector__heading {
    margin: 0 0 24px;
    color: #47184D;
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    letter-spacing: 1.76px;
    text-transform: uppercase;
  }

  .bundle-selector__list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bundle-option {
    position: relative;
    display: block;
    background: {{ block.settings.option_bg }};
    border: 1.5px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .bundle-option:hover {
    border-color: {{ block.settings.border_color_hover }};
  }

  .bundle-option.is-selected {
    border-radius: 12px;
    border: 2px solid #47184D;
    background: #EDE1FF;
  }

  .bundle-option__tag {
    border-radius: 0 0 5px 5px;
    background: #8A38F5;
    padding: 6px 8px;
    color: #FFF;
    font-family: "DM Sans";
    font-size: 11.6px;
    font-style: normal;
    font-weight: 700;
    line-height: 12px;
  }
  .new-tag-wrapper{
    position: absolute;
    top: -8px;
    right: 16px;
    display: flex;
    align-items: start;
  }
  .new-tag-wrapper span{
    display: flex;
  }

  .bundle-option__inner {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 9px 18px;
    border-radius: 12px;
    border: 1px solid rgba(71, 24, 77, 0.25);
  }

  .bundle-option__image {
    flex-shrink: 0;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bundle-option__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bundle-option__info {
    flex: 1;
    min-width: 0;
  }

  .bundle-option__title {
    color: var(--Black, #000);
    font-family: Georgia;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 100%;
    letter-spacing: -1px;
  }

  .bundle-option__save {
    margin-top: 8px;
    color: #47184D;
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: 14.4px;
    letter-spacing: -0.42px;
  }

  .bundle-option__price {
    flex-shrink: 0;
    text-align: right;
  }

  .bundle-option__price-current {
    color: var(--Black, #000);
    font-family: Georgia;
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: 100%;
    letter-spacing: -1px;
  }

  .bundle-option__price-compare {
    color: rgba(0, 0, 0, 0.70);
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 19.6px;
    text-decoration-line: line-through;
    margin-top: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .bundle-option__inner {
      padding: 5px 12px;
      gap: 18px;
    }

    .bundle-option__title {
      font-size: 16px;
      letter-spacing: -0.8px;
    }

    .bundle-option__price-current {
      font-size: 16px;
      letter-spacing: -0.8px;
    }

    .bundle-option__save,
    .bundle-option__price-compare {
      font-size: 12.8px;
      letter-spacing: -0.384px;
    }
    .bundle-selector__heading{
      margin: 0 0 12px;
    }
    .bundle-selector__list {
      gap: 12px;
    }
    .ritual-kit__tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .new-tag-wrapper {
      right: 8px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var blocks = document.querySelectorAll('.bundle-selector-block');
    blocks.forEach(function (block) {
      var sellingPlanId = block.getAttribute('data-selling-plan-id') || '';
      var options = block.querySelectorAll('.bundle-option');

      // Ensure the cart form has a line item property input for the selling plan id.
      // Shopify reads properties[Name] from the /cart/add form and attaches them
      // to the cart line item as a custom attribute.
      function ensureSellingPlanAttr() {
        var form = document.querySelector('form[action*="/cart/add"]');
        if (!form) return null;
        var input = form.querySelector('input[name="properties[_selling_plan_id]"]');
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          // Leading underscore = hidden property (won't show in cart UI / order confirmation)
          input.name = 'properties[_selling_plan_id]';
          form.appendChild(input);
        }
        return input;
      }

      function applySelection(option) {
        options.forEach(function (o) { o.classList.remove('is-selected'); });
        option.classList.add('is-selected');

        var radio = option.querySelector('input[type="radio"]');
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }

        var variantId = option.getAttribute('data-variant-id');
        var qty = option.getAttribute('data-qty');
        var optionSellingPlan = option.getAttribute('data-selling-plan-id') || sellingPlanId;

        if (variantId) {
          var variantInput = document.querySelector('form[action*="/cart/add"] input[name="id"]');
          if (variantInput) variantInput.value = variantId;
        }

        if (qty) {
          var qtyInput = document.querySelector('form[action*="/cart/add"] input[name="quantity"]');
          if (qtyInput) qtyInput.value = qty;
        }

        // Save the selling plan id as a line item property (attribute).
        var spAttr = ensureSellingPlanAttr();
        if (spAttr) {
          spAttr.value = optionSellingPlan && optionSellingPlan !== '' ? optionSellingPlan : '';
        }
      }

      options.forEach(function (option) {
        option.addEventListener('click', function () {
          applySelection(option);
        });
      });

      // Initialise attribute on page load using the currently selected option.
      var preSelected = block.querySelector('.bundle-option.is-selected') || options[0];
      if (preSelected) {
        var optionSellingPlan = preSelected.getAttribute('data-selling-plan-id') || sellingPlanId;
        var spAttr = ensureSellingPlanAttr();
        if (spAttr) {
          spAttr.value = optionSellingPlan && optionSellingPlan !== '' ? optionSellingPlan : '';
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Bundle Selector",
  "settings": [
    {
      "type": "header",
      "content": "Mode"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Pricing mode",
      "info": "Variant: auto-loops through all product variants. Quantity: configure each option manually below.",
      "options": [
        { "value": "variant", "label": "Variant-based (auto from product variants)" },
        { "value": "quantity", "label": "Quantity-based (configure each option)" }
      ],
      "default": "quantity"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHOOSE YOUR HARITAKI SUPPLY:"
    },

    {
      "type": "header",
      "content": "Discount & Selling Plan",
      "info": "Discount % is applied on top of the product price to calculate the final price shown. Selling Plan ID is passed to the cart so the customer is charged the subscription/discounted price."
    },
    {
      "type": "range",
      "id": "discount_percent",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "label": "Discount percentage",
      "default": 25
    },
    {
      "type": "text",
      "id": "selling_plan_id",
      "label": "Selling Plan ID",
      "info": "Paste the Shopify Selling Plan ID that applies this discount. Leave blank for one-time purchase."
    },

    {
      "type": "header",
      "content": "Variant Mode Tags",
      "info": "These appear on top of each variant card (only used when mode is Variant-based)."
    },
    { "type": "text", "id": "variant_tag_2", "label": "Tag on 2nd variant", "default": "Most Popular" },
    { "type": "text", "id": "variant_bonus_2", "label": "Bonus text on 2nd variant" },
    { "type": "text", "id": "variant_tag_3", "label": "Tag on 3rd variant", "default": "Best Value" },
    { "type": "text", "id": "variant_bonus_3", "label": "Bonus text on 3rd variant", "default": "+ FREE shipping" },
    { "type": "text", "id": "variant_tag_4", "label": "Tag on 4th variant" },
    { "type": "text", "id": "variant_bonus_4", "label": "Bonus text on 4th variant" },

    {
      "type": "header",
      "content": "Quantity Mode — Settings",
      "info": "Buy Qty = how many the customer pays for (used to calculate the price). All Qty = total items the customer receives (used for the strike-through compare price). Save % is calculated automatically from product compare-at vs price."
    },
    {
      "type": "range",
      "id": "default_qty_option",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Default selected option",
      "default": 2
    },

    { "type": "header", "content": "Option 1" },
    { "type": "checkbox", "id": "qty_show_1", "label": "Show this option", "default": true },
    { "type": "text", "id": "qty_title_1", "label": "Title", "default": "Buy One" },
    { "type": "range", "id": "qty_buy_1", "min": 1, "max": 20, "step": 1, "label": "Buy Qty (price × this)", "default": 1 },
    { "type": "range", "id": "qty_all_1", "min": 1, "max": 20, "step": 1, "label": "All Qty (compare-at × this)", "default": 1 },
    { "type": "text", "id": "qty_tag_1", "label": "Tag (optional)" },
    { "type": "text", "id": "qty_bonus_1", "label": "Bonus text (optional)" },
    { "type": "image_picker", "id": "qty_image_1", "label": "Image (optional, falls back to product image)" },

    { "type": "header", "content": "Option 2" },
    { "type": "checkbox", "id": "qty_show_2", "label": "Show this option", "default": true },
    { "type": "text", "id": "qty_title_2", "label": "Title", "default": "Buy 2 Get 1 Free" },
    { "type": "range", "id": "qty_buy_2", "min": 1, "max": 20, "step": 1, "label": "Buy Qty (price × this)", "default": 2 },
    { "type": "range", "id": "qty_all_2", "min": 1, "max": 20, "step": 1, "label": "All Qty (compare-at × this)", "default": 3 },
    { "type": "text", "id": "qty_tag_2", "label": "Tag (optional)", "default": "Most Popular" },
    { "type": "text", "id": "qty_bonus_2", "label": "Bonus text (optional)" },
    { "type": "image_picker", "id": "qty_image_2", "label": "Image (optional, falls back to product image)" },

    { "type": "header", "content": "Option 3" },
    { "type": "checkbox", "id": "qty_show_3", "label": "Show this option", "default": true },
    { "type": "text", "id": "qty_title_3", "label": "Title", "default": "Buy 3, Get 2 Free" },
    { "type": "range", "id": "qty_buy_3", "min": 1, "max": 20, "step": 1, "label": "Buy Qty (price × this)", "default": 3 },
    { "type": "range", "id": "qty_all_3", "min": 1, "max": 20, "step": 1, "label": "All Qty (compare-at × this)", "default": 5 },
    { "type": "text", "id": "qty_tag_3", "label": "Tag (optional)", "default": "Best Value" },
    { "type": "text", "id": "qty_bonus_3", "label": "Bonus text (optional)", "default": "+ FREE shipping" },
    { "type": "image_picker", "id": "qty_image_3", "label": "Image (optional, falls back to product image)" },

    { "type": "header", "content": "Option 4" },
    { "type": "checkbox", "id": "qty_show_4", "label": "Show this option", "default": false },
    { "type": "text", "id": "qty_title_4", "label": "Title" },
    { "type": "range", "id": "qty_buy_4", "min": 1, "max": 20, "step": 1, "label": "Buy Qty (price × this)", "default": 4 },
    { "type": "range", "id": "qty_all_4", "min": 1, "max": 20, "step": 1, "label": "All Qty (compare-at × this)", "default": 4 },
    { "type": "text", "id": "qty_tag_4", "label": "Tag (optional)" },
    { "type": "text", "id": "qty_bonus_4", "label": "Bonus text (optional)" },
    { "type": "image_picker", "id": "qty_image_4", "label": "Image (optional, falls back to product image)" },

    { "type": "header", "content": "Option 5" },
    { "type": "checkbox", "id": "qty_show_5", "label": "Show this option", "default": false },
    { "type": "text", "id": "qty_title_5", "label": "Title" },
    { "type": "range", "id": "qty_buy_5", "min": 1, "max": 20, "step": 1, "label": "Buy Qty (price × this)", "default": 5 },
    { "type": "range", "id": "qty_all_5", "min": 1, "max": 20, "step": 1, "label": "All Qty (compare-at × this)", "default": 5 },
    { "type": "text", "id": "qty_tag_5", "label": "Tag (optional)" },
    { "type": "text", "id": "qty_bonus_5", "label": "Bonus text (optional)" },
    { "type": "image_picker", "id": "qty_image_5", "label": "Image (optional, falls back to product image)" },

    { "type": "header", "content": "Option 6" },
    { "type": "checkbox", "id": "qty_show_6", "label": "Show this option", "default": false },
    { "type": "text", "id": "qty_title_6", "label": "Title" },
    { "type": "range", "id": "qty_buy_6", "min": 1, "max": 20, "step": 1, "label": "Buy Qty (price × this)", "default": 6 },
    { "type": "range", "id": "qty_all_6", "min": 1, "max": 20, "step": 1, "label": "All Qty (compare-at × this)", "default": 6 },
