{% comment %} /blocks/benefits-list.liquid {% endcomment %}


<style>
.benefits-list-wrapper{
    border-radius: 14px;
    border: 1px solid rgba(71, 24, 77, 0.25);
    background: linear-gradient(90deg, #F5E1FF 0%, #FFF 50%, #F5E1FF 100%);
    padding: 24px;
    margin-top: 24px;

}
.benefits-list__heading{
    margin: 0;
    color: var(--Black, #000);
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    text-align: center;
    letter-spacing: 0px;
    padding-bottom: 16px;
}
.benefit-item__title{
        margin: 0;
    color: #1A1A1A;
    font-family: "DM Sans";
    font-size: 13.5px;
    font-style: normal;
    font-weight: 700;
    line-height: 16.2px;
    letter-spacing: -0.2px;
}
.benefit-item__text{
    margin: 0;
    color: #000;
    font-family: "DM Sans";
    font-size: 11.5px;
    font-style: normal;
    font-weight: 400;
    line-height: 13.8px;
    margin-top: 4px;
}
.benefit-item__percent{
        color: #000;
    font-family: "DM Sans";
    font-size: 15px;
    font-style: normal;
    font-weight: 700;
    line-height: 27px;
    letter-spacing: -0.5px;
}
.icon-text-wrapper{
    display: flex;
    gap: 12px;
    align-items: center;
}
.benefit-item__text{
  margin: 0;
    color: #000;
    font-family: "DM Sans";
    font-size: 11.5px;
    font-style: normal;
    font-weight: 400;
    line-height: 13.8px;
    letter-spacing: 0px;
    padding-top: 4px;
}
.benefit-item__percent{
  color: #000;
    font-family: "DM Sans";
    font-size: 15px;
    font-style: normal;
    font-weight: 700;
    line-height: 27px;
    letter-spacing: -0.5px;
}
.benefit-item{
      display: flex;
    align-items: center;
    justify-content: space-between;
}
.benefits-list{
  display: flex;
    flex-direction: column;
    gap: 25px;
}
.desktop-view{
  display: none;
}
@media screen and (max-width: 749px) {
  .mobile-class{
    display: none;
  }
  .desktop-view{
  display: block;
}
.benefits-list-wrapper {
  padding: 16px;
}
.benefits-list__heading {
  padding-bottom: 14px;
}
.benefit-item__title {
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: -0.428px;
}
.benefit-item__percent {
    font-size: 18px;
    line-height: 22px;
    letter-spacing: -0.54px;
}
.benefit-item {
  gap: 12px;
}
.product-accordion-list {
      margin-top: 12px;
}
.accordion-item__content p {
  font-size: 12.6px;
    font-style: normal;
    font-weight: 400;
    line-height: 16.8px;
}
}
</style>


<div class="benefits-list-block {% if block.settings.mobile_view == true %} mobile-class {% else %} desktop-view {% endif %}" {{ block.shopify_attributes }}>
  <div class="benefits-list-wrapper">
    {% if block.settings.heading != blank %}
      <h2 class="benefits-list__heading">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="benefits-list">
      {% for i in (1..6) %}
        {% assign icon_key = 'icon_' | append: i %}
        {% assign title_key = 'title_' | append: i %}
        {% assign text_key = 'text_' | append: i %}
        {% assign percent_key = 'percent_' | append: i %}
        {% assign show_key = 'show_' | append: i %}

        {% assign icon = block.settings[icon_key] %}
        {% assign title = block.settings[title_key] %}
        {% assign text = block.settings[text_key] %}
        {% assign percent = block.settings[percent_key] %}
        {% assign show_item = block.settings[show_key] %}

        {% if show_item and title != blank %}
          <div class="benefit-item">
            <div class='icon-text-wrapper'>
            {% if icon != blank %}
              <div class="benefit-item__icon">
                <img
                  src="{{ icon | image_url: width: 100 }}"
                  alt="{{ title | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="benefit-item__content">
              <h3 class="benefit-item__title">{{ title }}</h3>
              {% if text != blank %}
                <p class="benefit-item__text">{{ text }}</p>
              {% endif %}
            </div>
        </div>

            {% if percent != blank %}
              <div class="benefit-item__percent">{{ percent }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} .benefits-list-block {
    width: 100%;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .section-{{ section.id }} .benefits-list-wrapper {
    padding: {{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;
    background: {{ block.settings.bg_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .benefits-list__heading {
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    text-align: {{ block.settings.heading_align }};
    color: {{ block.settings.heading_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  .section-{{ section.id }} .benefits-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .section-{{ section.id }} .benefit-item {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
    padding: {{ block.settings.item_padding_y }}px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .section-{{ section.id }} .benefit-item:last-child {
    border-bottom: none;
  }

  .section-{{ section.id }} .benefit-item__icon {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.icon_bg_color }};
    border-radius: {{ block.settings.icon_radius }}px;
    padding: 8px;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .benefit-item__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .section-{{ section.id }} .benefit-item__content {
    flex: 1;
    min-width: 0;
  }

  .section-{{ section.id }} .benefit-item__title {
    margin: 0 0 4px;
    color: {{ block.settings.title_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  .section-{{ section.id }} .benefit-item__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 400;
    line-height: 1.4;
  }

  .section-{{ section.id }} .benefit-item__percent {
    flex-shrink: 0;
    color: {{ block.settings.percent_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: {{ block.settings.percent_size }}px;
    font-weight: 700;
    line-height: 1;
    margin-left: 12px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .benefits-list-wrapper {
      padding: {{ block.settings.mobile_padding_y }}px {{ block.settings.mobile_padding_x }}px;
    }

    .section-{{ section.id }} .benefits-list__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .section-{{ section.id }} .benefit-item {
      gap: {{ block.settings.mobile_item_gap }}px;
      padding: {{ block.settings.mobile_item_padding_y }}px 0;
    }

    .section-{{ section.id }} .benefit-item__icon {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .section-{{ section.id }} .benefit-item__title {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .section-{{ section.id }} .benefit-item__text {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .section-{{ section.id }} .benefit-item__percent {
      font-size: {{ block.settings.mobile_percent_size }}px;
    }
  }
</style>

