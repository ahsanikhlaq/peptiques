{% comment %} /blocks/product-accordion.liquid {% endcomment %}

<div class="product-accordion-block {% if block.settings.mobile_view == true %} mobile-class {% else %} desktop-view {% endif %}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="product-accordion__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="product-accordion-list">
    {% for i in (1..8) %}
      {% assign title_key = 'title_' | append: i %}
      {% assign content_key = 'content_' | append: i %}
      {% assign show_key = 'show_' | append: i %}
      {% assign open_key = 'open_' | append: i %}

      {% assign title = block.settings[title_key] %}
      {% assign content = block.settings[content_key] %}
      {% assign show_item = block.settings[show_key] %}
      {% assign open_by_default = block.settings[open_key] %}

      {% if show_item and title != blank %}
        <div class="accordion-item{% if open_by_default %} is-open{% endif %}">
          <button type="button" class="accordion-item__summary" aria-expanded="{% if open_by_default %}true{% else %}false{% endif %}">
            <span class="accordion-item__title">{{ title }}</span>
            <span class="accordion-item__icon" aria-hidden="true">
              <svg class="icon-plus" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <svg class="icon-minus" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
          <div class="accordion-item__content-wrap">
            <div class="accordion-item__content">
              {{ content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .section-{{ section.id }} .product-accordion-block {
    width: 100%;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .section-{{ section.id }} .product-accordion__heading {
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    text-align: {{ block.settings.heading_align }};
    color: {{ block.settings.heading_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  /* ========= YOUR CUSTOM STYLES (kept as-is) ========= */
  .product-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .accordion-item {
    border-radius: 8px;
    border: 1px solid rgba(71, 24, 77, 0.25);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: {{ block.settings.item_bg_color }};
    transition: border-color 0.3s ease;
  }

  .accordion-item.is-open {
    border-color: {{ block.settings.border_color_open }};
  }

  .accordion-item__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    color: inherit;
  }

  .accordion-item__summary:focus {
    outline: none;
  }

  .accordion-item__summary:focus-visible {
    outline: 2px solid {{ block.settings.border_color_open }};
    outline-offset: 4px;
    border-radius: 4px;
  }

  .accordion-item__title {
    color: #1A1A1A;
    font-family: "DM Sans";
    font-size: 14.6px;
    font-style: normal;
    font-weight: 700;
    line-height: 18.8px;
    letter-spacing: -0.438px;
  }

  .accordion-item__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: {{ block.settings.icon_color }};
    position: relative;
  }

  /* Icon toggle — only one visible at a time */
  .accordion-item__icon .icon-plus,
  .accordion-item__icon .icon-minus {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .accordion-item__icon .icon-minus {
    display: none;
  }

  .accordion-item.is-open .icon-plus {
    display: none;
  }

  .accordion-item.is-open .icon-minus {
    display: block;
  }

  /* ========= SMOOTH HEIGHT ANIMATION ========= */
  .accordion-item__content-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  .accordion-item.is-open .accordion-item__content-wrap {
    grid-template-rows: 1fr;
  }

  .accordion-item__content {
    overflow: hidden;
    min-height: 0;
  }

  .accordion-item__content p {
    margin: 0;
    color: var(--Black, #000);
    font-family: "DM Sans";
    font-size: 14.6px;
    font-style: normal;
    font-weight: 400;
    line-height: 18.8px;
    letter-spacing: -0.438px;
    padding-top: 10px;
  }
  .desktop-view{
  display: none;
}
.accordion-item__content ul{
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.accordion-item__content ul li{
 color: var(--Black, #000);
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    list-style: none;
    letter-spacing: 0px;
     position: relative;
     padding-left: 20px;
}
.accordion-item__content ul li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 2px;
  width: 13px;
  height: 10px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='13' height='10' viewBox='0 0 13 10' fill='none'><path d='M8.88705e-05 5.13752L1.7025 3.42907L4.4976 6.17587L10.6975 8.88705e-05L12.412 1.70854L4.4976 9.5807L8.88705e-05 5.13752Z' fill='%239473F5'/></svg>");
  background-repeat: no-repeat;
  background-size: contain;
}
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .product-accordion__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .section-{{ section.id }} .accordion-item__title {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .section-{{ section.id }} .accordion-item__content p {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
    .mobile-class{
    display: none;
  }
  .desktop-view{
  display: block;
}
  }
</style>

<script>
  (function () {
    var blockEl = document.currentScript.previousElementSibling;
    while (blockEl && !blockEl.classList.contains('product-accordion-block')) {
      blockEl = blockEl.previousElementSibling;
    }
    if (!blockEl) return;

    var items = blockEl.querySelectorAll('.accordion-item');
    items.forEach(function (item) {
      var summary = item.querySelector('.accordion-item__summary');
      if (!summary) return;

      summary.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');
        item.classList.toggle('is-open');
        summary.setAttribute('aria-expanded', !isOpen);
      });
    });
  })();
</script>

{% schema %}
