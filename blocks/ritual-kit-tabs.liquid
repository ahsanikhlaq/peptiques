{% comment %} /blocks/ritual-kit-tabs.liquid {% endcomment %}

<div class="ritual-kit-block" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h3 class="ritual-kit__heading">{{ block.settings.heading }}</h3>
  {% endif %}

  {% if block.settings.description != blank %}
    <p class="ritual-kit__description">{{ block.settings.description }}</p>
  {% endif %}

  {% comment %} =========== Hidden Radio Inputs (control tab switching with CSS only) =========== {% endcomment %}
  {% for i in (1..3) %}
    {%- assign show_key = 'tab_' | append: i | append: '_show' -%}
    {% if block.settings[show_key] %}
      <input
        type="radio"
        name="ritual-tab-{{ block.id }}"
        id="ritual-tab-{{ block.id }}-{{ i }}"
        class="ritual-kit__radio"
        {% if i == block.settings.default_tab %}checked{% endif %}
      >
    {% endif %}
  {% endfor %}

  {% comment %} =========== Circle Tabs =========== {% endcomment %}
  <div class="ritual-kit__tabs">
    {% for i in (1..3) %}
      {%- liquid
        assign show_key = 'tab_' | append: i | append: '_show'
        assign label_key = 'tab_' | append: i | append: '_label'
        assign image_key = 'tab_' | append: i | append: '_circle_image'
        assign badge_key = 'tab_' | append: i | append: '_top_badge'
      -%}

      {% if block.settings[show_key] %}
        <label
          for="ritual-tab-{{ block.id }}-{{ i }}"
          class="ritual-kit__tab"
          data-tab="{{ i }}"
        >
          <div class="ritual-kit__tab-circle">
            {% if block.settings[badge_key] != blank %}
              <span class="ritual-kit__tab-top-badge">{{ block.settings[badge_key] }}</span>
            {% endif %}
            {% if block.settings[image_key] %}
              <img
                src="{{ block.settings[image_key] | image_url: width: 200 }}"
                alt="{{ block.settings[label_key] | escape }}"
                width="80"
                height="80"
                loading="lazy"
              >
            {% endif %}
          </div>
          <span class="ritual-kit__tab-label">{{ block.settings[label_key] }}</span>
        </label>
      {% endif %}
    {% endfor %}
  </div>

  {% comment %} =========== Tab Panels =========== {% endcomment %}
  <div class="ritual-kit__panels">
    {% for i in (1..3) %}
      {%- liquid
        assign show_key = 'tab_' | append: i | append: '_show'
      -%}

      {% if block.settings[show_key] %}
        {%- liquid
          assign title_key = 'tab_' | append: i | append: '_title'
          assign price_key = 'tab_' | append: i | append: '_price'
          assign compare_key = 'tab_' | append: i | append: '_compare_price'
          assign price_label_key = 'tab_' | append: i | append: '_price_label'
          assign subtitle_key = 'tab_' | append: i | append: '_subtitle'
          assign save_badge_key = 'tab_' | append: i | append: '_save_badge'
          assign benefits_key = 'tab_' | append: i | append: '_benefits'
          assign contents_heading_key = 'tab_' | append: i | append: '_contents_heading'
          assign kit_products_key = 'tab_' | append: i | append: '_products'
          assign cta_text_key = 'tab_' | append: i | append: '_cta_text'
          assign pack_dis_key = 'tab_' | append: i | append: '_pack_dis'

          comment
            =========== HIDDEN MAIN PRODUCT (per tab) ===========
            This is selected in the theme editor but NOT rendered in the UI.
            We only expose its IDs (variant_id + optional selling_plan) via
            data-attributes on the CTA so JS / cart can use it.
          endcomment
          assign main_product_key = 'tab_' | append: i | append: '_main_product'
          assign main_product = block.settings[main_product_key]

          assign tab_title = block.settings[title_key]
          assign tab_price = block.settings[price_key]
          assign tab_compare = block.settings[compare_key]
          assign tab_price_label = block.settings[price_label_key]
          assign tab_subtitle = block.settings[subtitle_key]
          assign tab_save_badge = block.settings[save_badge_key]
          assign tab_benefits = block.settings[benefits_key]
          assign tab_contents_heading = block.settings[contents_heading_key]
          assign tab_cta_text = block.settings[cta_text_key]
          assign tab_pack_dis = block.settings[pack_dis_key]
          assign kit_products = block.settings[kit_products_key]
        -%}

        <div class="ritual-kit__panel" data-panel="{{ i }}">
          <div class="ritual-kit__panel-inner">

            {% if tab_save_badge != blank %}
            <div class='new-tag-wrapper-new'>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
<path d="M4 4L8 0V8H0L4 4Z" fill="#47184D"/>
</svg>
            </span>
            <span class="ritual-kit__save-badge">{{ tab_save_badge }}</span>
             <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
<path d="M4 4L0 0V8H8L4 4Z" fill="#47184D"/>
</svg>
             </span>
            </div>
          {% endif %}

            <div class='new-title-tag'>
              {% if tab_title != blank %}
                <h4 class="ritual-kit__panel-title">{{ tab_title }}</h4>
              {% endif %}

              {% if tab_pack_dis != blank %}
                <div class='price-discount'>
                  {{ tab_pack_dis }}
                </div>
              {% endif %}
            </div>

            <div class="ritual-kit__pricing">
              {% if tab_price != blank %}
                <span class="ritual-kit__price">{{ tab_price }}</span>
              {% endif %}
              {% if tab_compare != blank %}
                <span class="ritual-kit__price-compare">{{ tab_compare }}</span>
              {% endif %}
              {% if tab_price_label != blank %}
                <span class="ritual-kit__price-label">{{ tab_price_label }}</span>
              {% endif %}
            </div>

            {% if tab_subtitle != blank %}
              <p class="ritual-kit__subtitle">{{ tab_subtitle }}</p>
            {% endif %}

            {% if tab_benefits != blank %}
              <div class="ritual-kit__divider"></div>
              <div class="ritual-kit__benefits">
                {%- assign benefit_lines = tab_benefits | newline_to_br | split: '<br />' -%}
                {% for line in benefit_lines %}
                  {%- assign clean_line = line | strip -%}
                  {% if clean_line != blank %}
                    <span>{{ clean_line }}</span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% comment %} ----- Kit Products Section ----- {% endcomment %}
            {% if kit_products != blank and kit_products.count > 0 %}

              {% if tab_contents_heading != blank %}
                <h5 class="ritual-kit__contents-heading">{{ tab_contents_heading }}</h5>
              {% endif %}

              {% comment %} ----- Kit Contents Grid ----- {% endcomment %}
              <div class="ritual-kit__product-grid">
                {% for kit_product in kit_products %}
                  {%- liquid
                    assign first_variant = kit_product.selected_or_first_available_variant

                    if i == 2
                      assign price_override_raw = kit_product.metafields.custom["price-tab2"]
                    elsif i == 3
                      assign price_override_raw = kit_product.metafields.custom["price-tab3"]
                    else
                      assign price_override_raw = kit_product.metafields.custom.price
                    endif

                    assign base_price = first_variant.price
                    if price_override_raw != blank
                      assign price_override_num = price_override_raw | times: 1.0
                      assign base_price = price_override_num | times: 100 | round
                    endif

                    assign refill_discount_raw = kit_product.metafields.custom.refill_discountt
                    assign refill_discount_cents = 0
                    if refill_discount_raw != blank
                      assign refill_discount_num = refill_discount_raw | times: 1.0
                      assign refill_discount_cents = refill_discount_num | times: 100 | round
                    endif

                    assign compare_at = first_variant.compare_at_price | default: 0

                    assign display_price = base_price
                    assign strike_price = 0
                    assign has_strike = false

                    if refill_discount_cents > 0
                      assign display_price = base_price | minus: refill_discount_cents
                      assign strike_price = base_price
                      assign has_strike = true
                    elsif compare_at > base_price
                      assign strike_price = compare_at
                      assign has_strike = true
                    endif

                    assign gift_tag = kit_product.metafields.custom.gift_tag
                  -%}

                  <div class="ritual-kit__product-card">
                    {% if kit_product.featured_image %}
                      <div class="ritual-kit__product-img">
                        <img
                          src="{{ kit_product.featured_image | image_url: width: 200 }}"
                          alt="{{ kit_product.title | escape }}"
                          width="100"
                          height="100"
                          loading="lazy"
                        >
                      </div>
                    {% endif %}
                    <div class="ritual-kit__product-title">{{ kit_product.title }}</div>

                    {% if gift_tag == blank %}
                      <div class="ritual-kit__product-price">
                        {% if has_strike %}
                          <span class="ritual-kit__product-price-compare">{{ strike_price | money_without_trailing_zeros }}</span>
                        {% endif %}
                        <span class="ritual-kit__product-price-current">{{ display_price | money_without_trailing_zeros }}</span>
                      </div>
                    {% endif %}

                    {% if gift_tag != blank %}
                      <div class="ritual-kit__product-gift-tag">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                          <path d="M9.28125 3.4375H1.71875C1.5289 3.4375 1.375 3.5914 1.375 3.78125V5.15625C1.375 5.3461 1.5289 5.5 1.71875 5.5H9.28125C9.47111 5.5 9.625 5.3461 9.625 5.15625V3.78125C9.625 3.5914 9.47111 3.4375 9.28125 3.4375Z" stroke="#47184D" stroke-width="0.55" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M8.9375 5.5V8.59375C8.9375 8.68494 8.90131 8.77234 8.8368 8.8368C8.77234 8.90131 8.68494 8.9375 8.59375 8.9375H2.40625C2.31508 8.9375 2.22765 8.90131 2.16318 8.8368C2.09872 8.77234 2.0625 8.68494 2.0625 8.59375V5.5" stroke="#47184D" stroke-width="0.55" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M5.5 3.4375V8.9375" stroke="#47184D" stroke-width="0.55" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M7.59643 1.34117C7.99777 1.7425 8.02142 2.41797 7.59643 2.79438C6.86983 3.43762 5.5 3.43762 5.5 3.43762C5.5 3.43762 5.5 2.06777 6.14454 1.34117C6.51964 0.91621 7.1951 0.939844 7.59643 1.34117Z" stroke="#47184D" stroke-width="0.55" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M3.40367 1.34117C3.00234 1.7425 2.97871 2.41797 3.40367 2.79438C4.13027 3.43762 5.50012 3.43762 5.50012 3.43762C5.50012 3.43762 5.50012 2.06777 4.85558 1.34117C4.48047 0.91621 3.805 0.939844 3.40367 1.34117Z" stroke="#47184D" stroke-width="0.55" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{ gift_tag }}</span>
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>

              {% comment %} ----- Future Refills Accordion (only products WITH a selling plan) ----- {% endcomment %}
              {%- liquid
                assign refill_count = 0
                for kit_product in kit_products
                  if kit_product.selling_plan_groups.size > 0
                    assign first_group = kit_product.selling_plan_groups[0]
                    if first_group.selling_plans.size > 0
                      assign refill_count = refill_count | plus: 1
                    endif
                  endif
                endfor
              -%}

              {% if refill_count > 0 %}
                <details class="ritual-kit__refills">
                  <summary class="ritual-kit__refills-summary">
                    <span>{{ block.settings.refills_label | default: 'Future refills' }}</span>
                    <svg class="ritual-kit__refills-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                      <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <div class="ritual-kit__refills-list">
                    {% for kit_product in kit_products %}
                      {%- liquid
                        assign first_variant = kit_product.selected_or_first_available_variant
                        assign selling_plan = nil
                        assign has_plan = false

                        if kit_product.selling_plan_groups.size > 0
                          assign first_group = kit_product.selling_plan_groups[0]
                          if first_group.selling_plans.size > 0
                            assign selling_plan = first_group.selling_plans[0]
                            assign has_plan = true
                          endif
                        endif

                        if i == 2
                          assign price_override_raw = kit_product.metafields.custom["price-tab2"]
                        elsif i == 3
                          assign price_override_raw = kit_product.metafields.custom["price-tab3"]
                        else
                          assign price_override_raw = kit_product.metafields.custom.price
                        endif

                        assign base_price = first_variant.price
                        if price_override_raw != blank
                          assign price_override_num = price_override_raw | times: 1.0
                          assign base_price = price_override_num | times: 100 | round
                        endif

                        assign refill_discount_raw = kit_product.metafields.custom.refill_discountt
                        assign refill_discount_cents = 0
                        if refill_discount_raw != blank
                          assign refill_discount_num = refill_discount_raw | times: 1.0
                          assign refill_discount_cents = refill_discount_num | times: 100 | round
                        endif

                        assign compare_at = first_variant.compare_at_price | default: 0

                        assign refill_price = base_price
                        assign refill_strike = 0
                        assign refill_has_strike = false

                        if refill_discount_cents > 0
                          assign refill_price = base_price | minus: refill_discount_cents
                          assign refill_strike = base_price
                          assign refill_has_strike = true
                        elsif compare_at > base_price
                          assign refill_strike = compare_at
                          assign refill_has_strike = true
                        endif
                      -%}

                      {% if has_plan %}
                        <div class="ritual-kit__refill-row">
                          <div class="ritual-kit__refill-name">{{ kit_product.title }}</div>
                          <div class='new-kit-wrapper'>
                            <div class="ritual-kit__refill-price">
                              {% if refill_has_strike %}
                                <span class="ritual-kit__refill-compare">{{ refill_strike | money_without_trailing_zeros }}</span>
                              {% endif %}
                              <span class="ritual-kit__refill-current">{{ refill_price | money_without_trailing_zeros }}</span>
                            </div>
                            <div class="ritual-kit__refill-freq">
                              {{ selling_plan.name }}
                            </div>
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </details>
              {% endif %}

            {% endif %}

          </div>

          {% if block.settings.show_continue_without %}
            <div href="{{ block.settings.continue_without_link | default: '#' }}" class="ritual-kit__continue-without">
              {{ block.settings.continue_without_text | default: 'Continue Without Kit' }}
            </div>
            {% if block.settings.continue_without_subtitle != blank %}
              <p class="ritual-kit__continue-subtitle">{{ block.settings.continue_without_subtitle }}</p>
            {% endif %}
          {% endif %}

         {% if tab_cta_text != blank %}
  {%- comment -%} Build a JSON array of products in this kit for JS to read {%- endcomment -%}
  {%- capture kit_products_json -%}
    [
    {%- for kit_product in kit_products -%}
      {%- liquid
        assign first_variant = kit_product.selected_or_first_available_variant
        assign sp_id = ''
        if kit_product.selling_plan_groups.size > 0
          assign first_group = kit_product.selling_plan_groups[0]
          if first_group.selling_plans.size > 0
            assign sp_id = first_group.selling_plans[0].id
          endif
        endif
      -%}
      {
        "variant_id": {{ first_variant.id }},
        "selling_plan": {% if sp_id != '' %}{{ sp_id }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- comment -%}
    Build hidden MAIN product data for this tab.
    We expose:
      - data-main-product-id    -> product.id
      - data-main-product-handle-> product.handle
      - data-main-variant-id    -> first/selected variant id
      - data-main-selling-plan  -> first selling plan id (if any) or empty
    These are only on the CTA so JS can read them; nothing is rendered on screen.
  {%- endcomment -%}
  {%- liquid
    assign main_variant_id = ''
    assign main_selling_plan_id = ''
    assign main_product_id = ''
    assign main_product_handle = ''
    if main_product != blank
      assign main_product_id = main_product.id
      assign main_product_handle = main_product.handle
      assign main_first_variant = main_product.selected_or_first_available_variant
      if main_first_variant
        assign main_variant_id = main_first_variant.id
      endif
      if main_product.selling_plan_groups.size > 0
        assign main_first_group = main_product.selling_plan_groups[0]
        if main_first_group.selling_plans.size > 0
          assign main_selling_plan_id = main_first_group.selling_plans[0].id
        endif
      endif
    endif
  -%}

  <button
    type="button"
    class="ritual-kit__cta-btn"
    data-kit-cta
    data-kit-index="{{ i }}"
    data-kit-products='{{ kit_products_json | strip_newlines | escape }}'
    data-main-product-id="{{ main_product_id }}"
    data-main-product-handle="{{ main_product_handle }}"
    data-main-variant-id="{{ main_variant_id }}"
    data-main-selling-plan="{{ main_selling_plan_id }}"
  >
    {{ tab_cta_text }}
  </button>
{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .ritual-kit-block {
    width: 100%;
    margin: 24px 0 10px 0px;
    font-family: 'DM Sans', sans-serif;
  }

  .ritual-kit__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .ritual-kit__heading {
    margin: 0 0 7px;
    color: #47184D;
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    letter-spacing: 1.76px;
    text-transform: uppercase;
  }

  .ritual-kit__description {
    margin: 0 0 24px;
    color: rgba(71, 24, 77, 0.60);
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0px;
  }

  /* ===== Tabs ===== */
  .ritual-kit__tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .ritual-kit__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .ritual-kit__tab-circle {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: #EADDFF;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    transition: border-color 0.2s ease, transform 0.2s ease;
    overflow: visible;
  }

  .ritual-kit__tab-circle img {
    width: 75%;
    object-fit: contain;
    border-radius: 0px;
  }

  .ritual-kit__tab-top-badge {
    position: absolute;
    top: -8px;
    left: 52%;
    transform: translateX(-50%);
    border-radius: 4px;
    background: #8A38F5;
    color: #FFF;
    font-family: "DM Sans";
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    line-height: 10px;
    letter-spacing: 0.8px;
    padding: 4px 10px;
  }

  .ritual-kit__tab-label {
    color: #47184D;
    text-align: center;
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: 13.8px;
    letter-spacing: 0px;
  }

  /* Active tab state */
  #ritual-tab-{{ block.id }}-1:checked ~ .ritual-kit__tabs .ritual-kit__tab[data-tab="1"] .ritual-kit__tab-circle,
  #ritual-tab-{{ block.id }}-2:checked ~ .ritual-kit__tabs .ritual-kit__tab[data-tab="2"] .ritual-kit__tab-circle,
  #ritual-tab-{{ block.id }}-3:checked ~ .ritual-kit__tabs .ritual-kit__tab[data-tab="3"] .ritual-kit__tab-circle {
    border: 2px solid #47184D;
  }

  /* ===== Panels ===== */
  .ritual-kit__panels {
    position: relative;
  }

  .ritual-kit__panel {
    display: none;
  }

  #ritual-tab-{{ block.id }}-1:checked ~ .ritual-kit__panels .ritual-kit__panel[data-panel="1"],
  #ritual-tab-{{ block.id }}-2:checked ~ .ritual-kit__panels .ritual-kit__panel[data-panel="2"],
  #ritual-tab-{{ block.id }}-3:checked ~ .ritual-kit__panels .ritual-kit__panel[data-panel="3"] {
    display: block;
  }

  .ritual-kit__panel-inner {
    position: relative;
    background: #EDDFFB;
    border-radius: 18px;
    padding: 20px;
    border-radius: 12px;
    border: 2px solid #47184D;
    background: #EDE1FF;
  }

  .ritual-kit__save-badge {
    background: #7B3FA8;
    padding: 6px 14px;
    border-radius: 0 0 5px 5px;
    background: #8A38F5;
    letter-spacing: 0.4px;
    color: #FFF;
    font-family: "DM Sans";
    font-size: 11.6px;
    font-style: normal;
    font-weight: 700;
    line-height: 12px;
    padding: 6px 8px;
  }
  .new-tag-wrapper-new{
 position: absolute;
    top: -10px;
    right: 24px;
    display: flex;
        align-items: start;
  }
  .new-tag-wrapper-new span{
    display: flex;
  }

  .ritual-kit__panel-title {
    color: #47184D;
    font-family: Georgia;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 100%;
    letter-spacing: -1px;
    margin: 0;
  }
  .price-discount{
    border-radius: 999px;
    border: 1px solid rgba(71, 24, 77, 0.40);
    background: #FDEA46;
    color: #47184D;
    font-family: "DM Sans";
    font-size: 10.3px;
    font-style: normal;
    font-weight: 700;
    line-height: 10.5px;
    letter-spacing: 0.84px;
    text-transform: uppercase;
    padding: 3.5px 8px;
    width: max-content;
  }
  .new-title-tag{
    display: flex;
    align-items: center;
    gap: 17px;
    margin-bottom: 6px;
  }

  .ritual-kit__pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px;
    margin-bottom: 8px;
  }

  .ritual-kit__price {
    color: #47184D;
    text-align: right;
    font-family: Georgia;
    font-size: 30px;
    font-style: normal;
    font-weight: 400;
    line-height: 33px;
    letter-spacing: -0.3px;
  }

  .ritual-kit__price-compare {
    text-decoration: line-through;
    color: rgba(71, 24, 77, 0.62);
    text-align: right;
    font-family: "DM Sans";
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-decoration-line: line-through;
  }

  .ritual-kit__price-label {
    color: rgba(71, 24, 77, 0.62);
    text-align: right;
    font-family: "DM Sans";
